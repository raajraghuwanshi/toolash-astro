---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'bottleneck-calculator')!;
---

<ToolLayout tool={tool} customLayout={true}>
  <div class="tool-page-wrap">
    <!-- Toolarsh Hardware Profiling Engine Hero -->
    <div class="tool-hero-box">
      <div class="inline-flex items-center gap-2 tool-badge-pill mb-3">
        <i class="fas fa-microchip text-[var(--brand)]"></i> Hardware Profiling Engine
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-[var(--txt)]">
        PC Bottleneck <span class="bg-gradient-to-r from-[var(--brand)] to-[var(--brand-dark)] bg-clip-text text-transparent">Calculator</span>
      </h1>
      <p class="text-sm sm:text-base mt-2 max-w-2xl text-[var(--txt-muted)] leading-relaxed">
        Simulate CPU & GPU workload distribution across 1080p, 1440p, and 4K resolutions. Detect gaming bottlenecks before upgrading.
      </p>
    </div>

    <!-- Hardware Pairing Console -->
    <div class="tool-card-surface space-y-6 mb-10">
      <div class="grid grid-cols-1 md:grid-cols-11 gap-4 items-center">
        <!-- CPU Select -->
        <div class="md:col-span-5 tool-inner-panel p-5 space-y-2">
          <label for="bn-cpu" class="block text-xs font-bold uppercase tracking-wider text-[var(--brand)] flex items-center gap-1.5">
            <i class="fas fa-microchip"></i> Processor (CPU)
          </label>
          <select id="bn-cpu" class="tool-control-input text-xs sm:text-sm font-semibold cursor-pointer">
            <optgroup label="Intel Core">
              <option value="i3-10100|4|3.6|6">Intel Core i3-10100</option>
              <option value="i5-10400|6|2.9|12">Intel Core i5-10400</option>
              <option value="i5-12400|6|2.5|18">Intel Core i5-12400</option>
              <option value="i7-10700K|8|3.8|30">Intel Core i7-10700K</option>
              <option value="i7-12700K|12|3.6|45">Intel Core i7-12700K</option>
              <option value="i9-12900K|16|3.2|65">Intel Core i9-12900K</option>
              <option value="i9-13900K|24|3.0|85">Intel Core i9-13900K</option>
              <option value="i5-13600K|14|3.5|50" selected>Intel Core i5-13600K</option>
            </optgroup>
            <optgroup label="AMD Ryzen">
              <option value="ryzen3-3300X|4|3.8|10">AMD Ryzen 3 3300X</option>
              <option value="ryzen5-3600|6|3.6|20">AMD Ryzen 5 3600</option>
              <option value="ryzen5-5600X|6|3.7|35">AMD Ryzen 5 5600X</option>
              <option value="ryzen7-5800X|8|3.8|55">AMD Ryzen 7 5800X</option>
              <option value="ryzen9-5900X|12|3.7|75">AMD Ryzen 9 5900X</option>
              <option value="ryzen9-7900X|12|4.7|90">AMD Ryzen 9 7900X</option>
              <option value="ryzen7-7700X|8|4.5|70">AMD Ryzen 7 7700X</option>
            </optgroup>
          </select>
        </div>

        <!-- VS Badge -->
        <div class="md:col-span-1 flex justify-center py-2">
          <div class="w-10 h-10 rounded-full bg-[var(--brand)] flex items-center justify-center font-black text-xs text-white shadow-lg shadow-[var(--brand)]/30">
            VS
          </div>
        </div>

        <!-- GPU Select -->
        <div class="md:col-span-5 tool-inner-panel p-5 space-y-2">
          <label for="bn-gpu" class="block text-xs font-bold uppercase tracking-wider text-[var(--amber)] flex items-center gap-1.5">
            <i class="fas fa-display"></i> Graphics Card (GPU)
          </label>
          <select id="bn-gpu" class="tool-control-input text-xs sm:text-sm font-semibold cursor-pointer">
            <optgroup label="NVIDIA GeForce">
              <option value="GTX1060|16">NVIDIA GTX 1060</option>
              <option value="GTX1070|28">NVIDIA GTX 1070</option>
              <option value="RTX2060|40">NVIDIA RTX 2060</option>
              <option value="RTX2070|50">NVIDIA RTX 2070 Super</option>
              <option value="RTX3060|55">NVIDIA RTX 3060</option>
              <option value="RTX3070|70">NVIDIA RTX 3070</option>
              <option value="RTX3080|85" selected>NVIDIA RTX 3080</option>
              <option value="RTX3090|95">NVIDIA RTX 3090</option>
              <option value="RTX4070|80">NVIDIA RTX 4070</option>
              <option value="RTX4080|92">NVIDIA RTX 4080</option>
              <option value="RTX4090|100">NVIDIA RTX 4090</option>
            </optgroup>
            <optgroup label="AMD Radeon">
              <option value="RX5600XT|35">AMD RX 5600 XT</option>
              <option value="RX5700XT|50">AMD RX 5700 XT</option>
              <option value="RX6600|48">AMD RX 6600</option>
              <option value="RX6700XT|62">AMD RX 6700 XT</option>
              <option value="RX6800XT|80">AMD RX 6800 XT</option>
              <option value="RX7900XT|90">AMD RX 7900 XT</option>
            </optgroup>
          </select>
        </div>
      </div>

      <!-- Resolution Tabs & Calc Button -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-[var(--border)]">
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--txt-muted)] mr-1">Target Res:</span>
          <div class="tool-tab-segment">
            <button class="tool-tab-btn active bn-res-btn" data-res="1080">
              1080p FHD
            </button>
            <button class="tool-tab-btn bn-res-btn" data-res="1440">
              1440p QHD
            </button>
            <button class="tool-tab-btn bn-res-btn" data-res="4k">
              4K UHD
            </button>
          </div>
        </div>

        <button
          id="bn-calc"
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-[var(--brand)] hover:opacity-90 text-white font-black text-xs sm:text-sm tracking-wider uppercase transition-all shadow-lg shadow-[var(--brand)]/20 flex items-center justify-center gap-2 cursor-pointer"
        >
          <i class="fas fa-microchip"></i> Calculate Bottleneck
        </button>
      </div>

      <!-- Real-time HUD Result -->
      <div id="bn-result" class="pt-6 border-t border-[var(--border)] space-y-6" style="display:none">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- CPU Load Meter -->
          <div class="tool-inner-panel p-5 space-y-2">
            <div class="flex justify-between items-center mb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--brand)] flex items-center gap-1.5">
                <i class="fas fa-microchip"></i> CPU Utilization
              </span>
              <span id="bn-cpu-pct" class="font-mono font-black text-[var(--brand)] text-base">0%</span>
            </div>
            <div class="h-3 rounded-full bg-[var(--surface-3)] overflow-hidden">
              <div id="bn-cpu-fill" class="h-full bg-[var(--brand)] transition-all duration-700" style="width: 0%;"></div>
            </div>
          </div>

          <!-- GPU Load Meter -->
          <div class="tool-inner-panel p-5 space-y-2">
            <div class="flex justify-between items-center mb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--amber)] flex items-center gap-1.5">
                <i class="fas fa-display"></i> GPU Utilization
              </span>
              <span id="bn-gpu-pct" class="font-mono font-black text-[var(--amber)] text-base">0%</span>
            </div>
            <div class="h-3 rounded-full bg-[var(--surface-3)] overflow-hidden">
              <div id="bn-gpu-fill" class="h-full bg-[var(--amber)] transition-all duration-700" style="width: 0%;"></div>
            </div>
          </div>
        </div>

        <!-- Verdict Box -->
        <div class="tool-inner-panel p-5 flex items-start gap-4">
          <div id="bn-verdict-icon" class="text-3xl flex-shrink-0">✅</div>
          <div class="space-y-1">
            <div id="bn-verdict-title" class="text-base font-bold text-[var(--txt)]">Analyzing Hardware Pairing...</div>
            <p id="bn-verdict-desc" class="text-xs text-[var(--txt-muted)] leading-relaxed"></p>
          </div>
        </div>

        <!-- Optimization Tips Deck -->
        <div id="bn-tips" class="space-y-2"></div>
      </div>
    </div>

    <!-- Hardware Systems Engineering & Pipeline Architecture (Tabs Archetype) -->
    <div class="tool-content-wrap">

      <!-- Interactive Tabbed Interface Card -->
      <section class="tool-content-card">
        <div class="tool-content-header">
          <span class="tool-badge-pill mb-3">
            <i class="fas fa-microchip text-[var(--brand)]"></i> Systems Architecture
          </span>
          <h2>Hardware Systems Engineering: The Graphics Pipeline Bottleneck</h2>
          <p>
            A deep technical examination into graphics pipeline synchronization, draw call dispatch overhead, memory bus saturation, and 1% low frame pacing stability.
          </p>
        </div>

        <!-- Tab Navigation Strip -->
        <div class="tool-tab-nav" role="tablist" aria-label="Hardware Architecture Tabs">
          <button
            class="tool-tab-btn bn-tab-btn active"
            data-tab="draw-calls"
            role="tab"
            aria-selected="true"
          >
            <i class="fas fa-bolt"></i> 01 Draw Calls &amp; CPU IPC
          </button>
          <button
            class="tool-tab-btn bn-tab-btn"
            data-tab="fill-rate"
            role="tab"
            aria-selected="false"
          >
            <i class="fas fa-tv"></i> 02 Resolution &amp; Fill-Rate
          </button>
          <button
            class="tool-tab-btn bn-tab-btn"
            data-tab="frame-pacing"
            role="tab"
            aria-selected="false"
          >
            <i class="fas fa-chart-line"></i> 03 Frame Pacing &amp; 1% Lows
          </button>
          <button
            class="tool-tab-btn bn-tab-btn"
            data-tab="vram-bus"
            role="tab"
            aria-selected="false"
          >
            <i class="fas fa-memory"></i> 04 VRAM &amp; PCIe Lanes
          </button>
        </div>

        <!-- Tab Panels Container -->
        <div class="pt-2">

          <!-- Panel 1: Draw Calls & CPU IPC -->
          <div class="tool-tab-panel bn-tab-panel space-y-4" id="panel-draw-calls" role="tabpanel">
            <h3 class="text-xl sm:text-2xl font-bold text-[var(--txt)] tracking-tight">
              API Draw Calls, Main-Thread Bottlenecks &amp; L3 Cache Scaling
            </h3>
            <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
              Every frame rendered by your GPU begins as a sequence of <strong class="text-[var(--txt)]">draw calls</strong> issued by the CPU. Before the graphics card can shade a single polygon, the CPU must compute player physics, query collision spatial trees, evaluate enemy AI routines, and batch vertex buffers via DirectX 12 or Vulkan command lists.
            </p>
            <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
              When a game engine is bound to a single thread&apos;s execution speed, having 16 or 24 CPU cores offers zero performance advantage. Instead, raw <strong class="text-[var(--txt)]">IPC (Instructions Per Cycle)</strong> and massive L3 cache capacity (such as AMD&apos;s 3D V-Cache) prevent the CPU from stalling while waiting for DRAM memory fetches. If the CPU cannot dispatch draw calls in under 6.9 milliseconds, your 144Hz monitor will drop frames regardless of how fast your GPU is.
            </p>
            <div class="p-4 rounded-xl bg-[var(--surface-2)] border border-[var(--border)] font-mono text-xs text-[var(--txt-muted)] space-y-1.5 shadow-sm">
              <div class="text-[var(--txt)] font-bold">// Frame Time Pipeline Equation</div>
              <div>Frame Time (ms) = max(T_CPU_render_thread, T_GPU_pipeline)</div>
              <div>If T_CPU &gt; T_GPU &rarr; GPU Idles (CPU Bottleneck)</div>
            </div>
          </div>

          <!-- Panel 2: Fill-Rate Physics -->
          <div class="tool-tab-panel bn-tab-panel space-y-4 hidden" id="panel-fill-rate" role="tabpanel">
            <h3 class="text-xl sm:text-2xl font-bold text-[var(--txt)] tracking-tight">
              Resolution Inversion: The 400% Pixel Fill-Rate Surge
            </h3>
            <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
              Display resolution dictates the fundamental division of hardware labor. At <strong class="text-[var(--txt)]">1080p Full HD (1920 &times; 1080)</strong>, the GPU rasterizes approximately 2.07 million pixels per frame. High-end cards (like the RTX 4080 or RX 7900 XTX) chew through this workload in under 2 milliseconds, spending most of their cycle time waiting for the CPU to feed subsequent scene batches.
            </p>
            <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
              When you scale to <strong class="text-[var(--txt)]">4K Ultra HD (3840 &times; 2160)</strong>, the rasterizer must shade <strong class="text-[var(--txt)]">8.29 million pixels</strong>&mdash;a 300% surge in pixel density. Volumetric lighting, screen-space reflections, and ray tracing denoisers aggressively load shader execution units and texture mapping units (TMUs). At 4K, almost every modern 6-core or 8-core CPU operates with zero bottleneck, as the graphics processor becomes 100% saturated.
            </p>
          </div>

          <!-- Panel 3: Frame Pacing & 1% Lows -->
          <div class="tool-tab-panel bn-tab-panel space-y-4 hidden" id="panel-frame-pacing" role="tabpanel">
            <h3 class="text-xl sm:text-2xl font-bold text-[var(--txt)] tracking-tight">
              The Fallacy of Average FPS: Frame Pacing &amp; 1% Low Stutters
            </h3>
            <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
              Looking exclusively at average framerates is the most common diagnostic mistake among PC builders. A system reporting 120 FPS can still feel unplayable if the framerate exhibits severe <strong class="text-[var(--txt)]">frame pacing variance</strong> (micro-stuttering).
            </p>
            <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
              If 119 frames render at 6ms, but a single frame requires 85ms because the CPU stalled on an un-cached asset stream or page fault, the player perceives an abrupt hitch. True gaming smoothness is dictated by the <strong class="text-[var(--txt)]">1% Low</strong> and <strong class="text-[var(--txt)]">0.1% Low</strong> metrics. Severe discrepancies between average FPS and 1% lows almost universally point to memory latency bottlenecks, sub-optimal DRAM timings, or background CPU thread contention.
            </p>
          </div>

          <!-- Panel 4: VRAM & PCIe Lanes -->
          <div class="tool-tab-panel bn-tab-panel space-y-4 hidden" id="panel-vram-bus" role="tabpanel">
            <h3 class="text-xl sm:text-2xl font-bold text-[var(--txt)] tracking-tight">
              Memory Bus Width Traps &amp; PCIe Lane Starvation
            </h3>
            <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
              A graphics card is only as capable as the memory bus feeding its compute units. Modern 128-bit memory buses (common on mid-range GPUs) restrict memory bandwidth to under 300 GB/s. When playing at 1440p or enabling ray tracing, high-resolution geometry and texture mipmaps overflow dedicated video RAM.
            </p>
            <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
              Once VRAM capacity is exhausted, the GPU is forced to spill textures over the PCIe bus into system RAM (DDR4/DDR5), which operates at a fraction of GDDR6 bandwidth. On cards physically limited to PCIe 4.0 x8 lanes running in PCIe 3.0 motherboards, this spillover causes catastrophic 30–50 FPS plunges, turning gameplay into an unstable slide-show.
            </p>
          </div>

        </div>
      </section>

      <!-- Hairline Accordion FAQ Section Card -->
      <section class="tool-content-card">
        <div class="tool-content-header">
          <span class="tool-badge-pill mb-3">
            <i class="fas fa-circle-question text-[var(--brand)]"></i> Common Inquiries
          </span>
          <h3>PC Bottleneck &amp; Hardware Pairing Frequently Asked Questions</h3>
          <p>
            Upgrade priorities, upscaling interactions, and dual-channel memory impact.
          </p>
        </div>

        <div class="tool-faq-accordion">
          <details class="tool-faq-item">
            <summary>
              <span>Is a 0% bottleneck ever practically achievable in real-world gaming?</span>
              <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
            </summary>
            <div class="faq-answer">
              No. A &ldquo;bottleneck&rdquo; simply describes whichever component reaches 100% capacity first, thereby preventing the machine from rendering infinite frames per second. If there were no bottleneck, your system would output unlimited FPS. In an ideal gaming rig, the bottleneck resides entirely in the GPU (GPU running at 98–99% while the CPU sits at 40–70%), ensuring maximum return on your graphics investment without framerate stuttering.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>Does enabling DLSS, FSR, or XeSS induce a CPU bottleneck?</span>
              <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
            </summary>
            <div class="faq-answer">
              Yes, frequently. Temporal upscaling algorithms render the game internally at a lower base resolution (e.g., DLSS Quality mode on a 1440p monitor renders internally at 1080p). Because the GPU&apos;s rendering workload is reduced dramatically, frame production speeds up until the CPU can no longer dispatch draw calls quickly enough. If you enable DLSS and notice zero increase in framerate, your system is CPU-bound.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>How does single-channel vs dual-channel RAM affect CPU bottlenecks?</span>
              <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
            </summary>
            <div class="faq-answer">
              Running a single stick of RAM limits the memory controller to a 64-bit bus width, cutting memory bandwidth in half. In CPU-heavy modern titles, running single-channel memory can reduce 1% low framerates by up to 25–40% and trigger persistent micro-stutters. Always install RAM in matching pairs across interleaved dual-channel DIMM slots (slots 2 and 4 on standard motherboards) and verify XMP/EXPO profiles are enabled in BIOS.
            </div>
          </details>
        </div>
      </section>

    </div>
  </div>
</ToolLayout>

<script>
  let resolution = '1080';

  document.querySelectorAll('.bn-res-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.bn-res-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      resolution = (btn as HTMLElement).dataset.res!;
    });
  });

  document.getElementById('bn-calc')?.addEventListener('click', () => {
    const cpuVal = (document.getElementById('bn-cpu') as HTMLSelectElement).value;
    const gpuVal = (document.getElementById('bn-gpu') as HTMLSelectElement).value;
    const [cpuName, cpuCores, cpuGhz, cpuScore] = cpuVal.split('|');
    const [gpuName, gpuScore] = gpuVal.split('|');

    const cpuS = parseInt(cpuScore);
    const gpuS = parseInt(gpuScore);

    // Resolution multiplier: 1080p = CPU-heavy, 4K = GPU-heavy
    const resMultipliers = { '1080': { cpu: 1.3, gpu: 0.7 }, '1440': { cpu: 1.0, gpu: 1.0 }, '4k': { cpu: 0.7, gpu: 1.3 } };
    const mult = (resMultipliers as any)[resolution] || { cpu: 1, gpu: 1 };

    const cpuLoad = Math.min(100, Math.round((cpuS / Math.max(cpuS, gpuS)) * 100 * mult.cpu));
    const gpuLoad = Math.min(100, Math.round((gpuS / Math.max(cpuS, gpuS)) * 100 * mult.gpu));

    // Animate bars
    setTimeout(() => {
      (document.getElementById('bn-cpu-fill') as HTMLElement).style.width = `${cpuLoad}%`;
      (document.getElementById('bn-gpu-fill') as HTMLElement).style.width = `${gpuLoad}%`;
    }, 100);

    document.getElementById('bn-cpu-pct')!.textContent = `${cpuLoad}%`;
    document.getElementById('bn-gpu-pct')!.textContent = `${gpuLoad}%`;

    const diff = Math.abs(cpuS - gpuS);
    const bottleneck = diff / Math.max(cpuS, gpuS) * 100;

    let icon = '✅', title = '', desc = '', tips: string[] = [];

    if (bottleneck < 10) {
      icon = '✅'; title = 'Excellent Balance!';
      desc = 'Your CPU and GPU are very well matched. You\'ll experience maximum performance in most games and workloads.';
    } else if (cpuS < gpuS) {
      if (bottleneck < 20) {
        icon = '🟡'; title = 'Minor CPU Bottleneck';
        desc = `Your CPU is slightly limiting your GPU performance. At ${resolution}p, you may notice small dips in CPU-heavy games.`;
        tips = ['Increase resolution to shift load to GPU', 'Enable XMP/EXPO in BIOS for RAM speed boost', 'Close background apps to free CPU resources'];
      } else if (bottleneck < 40) {
        icon = '🟠'; title = 'Moderate CPU Bottleneck';
        desc = `Your CPU is holding back your GPU significantly at ${resolution}p. Consider upgrading your CPU for better 1% lows and frame consistency.`;
        tips = ['Upgrade to a faster CPU with same socket', 'Switch to a higher resolution to reduce CPU load', 'Disable CPU-heavy overlays/programs'];
      } else {
        icon = '🔴'; title = 'Severe CPU Bottleneck';
        desc = `Your CPU is a major limitation for this GPU. You\'re leaving significant GPU performance unused.`;
        tips = ['Prioritize CPU upgrade', 'Play at 4K to maximize GPU utilization', 'Check if CPU is running at max boost clock'];
      }
    } else {
      if (bottleneck < 20) {
        icon = '🟡'; title = 'Minor GPU Bottleneck';
        desc = `Your GPU is slightly limiting performance at ${resolution}p. This is normal and means you can upgrade your GPU for a nice boost.`;
      } else if (bottleneck < 40) {
        icon = '🟠'; title = 'Moderate GPU Bottleneck';
        desc = `Your GPU is noticeably holding back what your CPU can deliver. Consider upgrading your GPU.`;
        tips = ['Upgrade GPU for better fps', 'Lower graphics settings temporarily', 'Enable DLSS/FSR if available'];
      } else {
        icon = '🔴'; title = 'Severe GPU Bottleneck';
        desc = `Your GPU is significantly limiting performance. Your CPU is being heavily underutilized.`;
        tips = ['Upgrade to a more powerful GPU', 'Lower resolution or settings to increase fps', 'Enable upscaling technology'];
      }
    }

    document.getElementById('bn-verdict-icon')!.textContent = icon;
    document.getElementById('bn-verdict-title')!.textContent = title;
    document.getElementById('bn-verdict-desc')!.textContent = desc;
    document.getElementById('bn-tips')!.innerHTML = tips.map(t => `<div class="p-3 rounded-xl border border-[var(--border)] bg-[var(--surface-2)] text-xs text-[var(--txt-muted)] flex items-center gap-2"><i class="fas fa-lightbulb text-[var(--amber)]"></i> ${t}</div>`).join('');
    document.getElementById('bn-result')!.style.display = '';
  });

  // Technical Architecture Tabs
  const bnTabBtns = document.querySelectorAll<HTMLButtonElement>('.bn-tab-btn');
  const bnTabPanels = document.querySelectorAll<HTMLElement>('.bn-tab-panel');

  bnTabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-tab');
      bnTabBtns.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      bnTabPanels.forEach(p => p.classList.add('hidden'));

      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      const activePanel = document.getElementById(`panel-${target}`);
      if (activePanel) activePanel.classList.remove('hidden');
    });
  });

  document.getElementById('bn-calc')?.click();
</script>
