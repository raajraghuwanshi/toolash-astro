---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'youtube-monetization-checker')!;
---

<ToolLayout tool={tool} customLayout={true}>
  <div class="tool-page-wrap">
    <!-- Hero Header -->
    <div class="tool-hero-box">
      <div class="tool-badge-pill">
        <i class="fab fa-youtube text-[var(--brand)]"></i> YouTube Partner Program Audit Lab
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[var(--txt)] tracking-tight">
        YouTube Channel <span class="bg-gradient-to-r from-red-500 via-[var(--brand)] to-emerald-400 bg-clip-text text-transparent">Monetization Checker</span>
      </h1>
      <p class="text-[var(--txt-muted)] text-sm sm:text-base mt-3 max-w-2xl mx-auto">
        Audit any creator channel to determine YouTube Partner Program eligibility, AdSense ad-serving indicators, and estimated RPM revenue metrics.
      </p>
    </div>

    <!-- Main Audit Search & Preset Controls -->
    <div class="tool-card-surface p-6 sm:p-8 space-y-6 mb-10">
      <div class="max-w-3xl space-y-4">
        <div class="space-y-2">
          <label for="ym-url" class="text-xs font-mono font-bold text-[var(--txt-muted)] uppercase tracking-wider block">
            Enter YouTube Channel URL, Custom Link, or @Handle
          </label>
          <div class="flex flex-col sm:flex-row gap-3">
            <div class="flex-1 relative">
              <input type="text" id="ym-url" value="@mkbhd" placeholder="e.g. @mkbhd, @veritasium, or youtube.com/@mrbeast" class="w-full tool-control-input py-3.5 pl-11 pr-4 text-base font-medium" />
              <i class="fab fa-youtube absolute left-4 top-1/2 -translate-y-1/2 text-red-500 text-lg"></i>
            </div>
            <button id="ym-check" class="px-8 py-3.5 rounded-xl bg-gradient-to-r from-[var(--brand)] to-teal-600 text-white font-black text-sm uppercase tracking-wider shadow-lg shadow-emerald-500/20 hover:opacity-95 transition-all flex items-center justify-center gap-2 cursor-pointer">
              <i class="fas fa-search-dollar"></i> Audit Channel
            </button>
          </div>
        </div>

        <!-- Quick Presets -->
        <div class="flex items-center gap-2 flex-wrap pt-1 text-xs">
          <span class="text-[var(--txt-muted)] font-mono">Popular Creators:</span>
          <button class="ym-ex px-3 py-1 rounded-full bg-[var(--surface-2)] border border-[var(--border)] hover:border-[var(--brand)] text-[var(--txt)] text-xs font-mono transition-all cursor-pointer" data-url="@mkbhd">@mkbhd</button>
          <button class="ym-ex px-3 py-1 rounded-full bg-[var(--surface-2)] border border-[var(--border)] hover:border-[var(--brand)] text-[var(--txt)] text-xs font-mono transition-all cursor-pointer" data-url="@veritasium">@veritasium</button>
          <button class="ym-ex px-3 py-1 rounded-full bg-[var(--surface-2)] border border-[var(--border)] hover:border-[var(--brand)] text-[var(--txt)] text-xs font-mono transition-all cursor-pointer" data-url="@mrbeast">@mrbeast</button>
        </div>
      </div>

      <!-- Dynamic Audit Results -->
      <div id="ym-result" class="pt-6 border-t border-[var(--border)] space-y-6">
        <!-- Channel Profile Bar -->
        <div class="p-6 rounded-2xl tool-inner-panel border border-[var(--border)] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-[var(--brand)] to-teal-500 flex items-center justify-center text-white text-2xl font-black font-mono shadow-lg shadow-emerald-500/20" id="ym-icon">
              M
            </div>
            <div>
              <h3 class="text-xl font-black text-[var(--txt)]" id="ym-name">Mkbhd</h3>
              <div class="text-xs font-mono text-[var(--txt-muted)]" id="ym-handle">@mkbhd</div>
            </div>
          </div>

          <div id="ym-status-card" class="px-5 py-3 rounded-xl border flex items-center gap-3">
            <span id="ym-status-icon" class="text-2xl">✅</span>
            <div>
              <div class="text-xs font-mono uppercase font-bold text-[var(--txt-muted)]">Program Status</div>
              <div class="text-sm font-black" id="ym-status-title">Likely Monetized</div>
            </div>
          </div>
        </div>

        <!-- Description Verdict -->
        <p id="ym-status-desc" class="text-xs text-[var(--txt-muted)] leading-relaxed p-4 rounded-xl tool-inner-panel border border-[var(--border)]"></p>

        <!-- YPP Criteria Grid -->
        <div class="space-y-3">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--brand)] block">
            YouTube Partner Program Compliance Checklist
          </span>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3" id="ym-criteria-grid">
            <!-- Populated via script -->
          </div>
        </div>
      </div>
    </div>

    <!-- Creator Economy Architecture: Editorial Split Archetype -->
    <div class="tool-content-wrap">
      <section class="tool-content-card">
        <!-- Lead Editorial Header -->
        <div class="tool-content-header">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--txt)] tracking-tight">
            AdSense Economics, Dual Thresholds &amp; Channel Valuation
          </h2>
          <p class="text-base sm:text-lg text-[var(--txt-muted)] leading-relaxed">
            Monetization on YouTube is not a binary status—it is an algorithmic auction ecosystem dictated by viewer demographics, advertiser bidding competition, and strict compliance with Google Publisher Policies. Below is an authoritative breakdown of qualification mechanics and revenue distribution.
          </p>
        </div>

        <!-- The Editorial Split: Two Deep Analytical Columns -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
          <!-- Left Editorial Column: Qualification Gates & Demonetization -->
          <article class="space-y-6">
            <div class="space-y-2 border-b border-[var(--border)] pb-4">
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--brand)]">Track 01</span>
              <h3 class="text-xl sm:text-2xl font-bold text-[var(--txt)] tracking-tight">
                The Dual Qualification Gates &amp; The Reused Content Hazard
              </h3>
            </div>
            
            <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
              To enter the YouTube Partner Program (YPP), creators must maintain at least 1,000 subscribers and satisfy one of two non-cumulative engagement thresholds: either <strong class="text-[var(--txt)]">4,000 valid public watch hours</strong> on long-form video across the trailing 365 days, or <strong class="text-[var(--txt)]">10 million valid public Shorts views</strong> within the trailing 90 days. Hours accumulated from unlisted videos, private uploads, ad campaigns (TrueView), and deleted clips are permanently excluded from this audit tally.
            </p>
            
            <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
              However, achieving numerical metrics guarantees nothing. The primary barrier tripping up modern channels is YouTube's enforcement of the <em>"Reused Content"</em> policy. Automated curation channels, compilation channels, AI-narrated synthetic voiceover mills, and gameplay without significant original educational commentary or face-cam presence face routine rejection during human compliance review. AdSense requires demonstrably transformative creator value before ad inventory is unlocked.
            </p>

            <div class="p-4 rounded-xl bg-[var(--surface-2)] border border-[var(--border)] font-mono text-xs space-y-1.5 text-[var(--txt-muted)]">
              <div class="text-[var(--txt)] font-bold">// YPP Long-Form vs. Shorts Revenue Splits</div>
              <div>Long-Form Video Ad Revenue: 55% Creator / 45% YouTube</div>
              <div>Shorts Feed Pooled Ad Revenue: 45% Creator / 55% Platform &amp; Music Licenses</div>
              <div>Channel Memberships &amp; Super Chats: 70% Creator / 30% YouTube (excl. iOS fees)</div>
            </div>
          </article>

          <!-- Right Editorial Column: RPM vs CPM & Geographic Arbitrage -->
          <article class="space-y-6">
            <div class="space-y-2 border-b border-[var(--border)] pb-4">
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--brand)]">Track 02</span>
              <h3 class="text-xl sm:text-2xl font-bold text-[var(--txt)] tracking-tight">
                The CPM vs. RPM Chasm &amp; Geographic Arbitrage
              </h3>
            </div>

            <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
              A common misconception in the creator economy is conflating <em>CPM</em> with <em>RPM</em>. Cost Per Mille (CPM) represents what commercial brands bid in Google Ads to serve 1,000 impressions on your video before YouTube claims its 45% platform fee. Conversely, Revenue Per Mille (RPM) measures your actual net take-home earnings per 1,000 total video views—accounting for ad-blocked views, unmonetized playback sessions, and supplementary income like YouTube Premium revenue share.
            </p>

            <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
              Furthermore, RPM is heavily governed by audience purchasing power parity. A channel generating 500,000 views in the Personal Finance or B2B SaaS niche with viewers in the United States, Switzerland, or Australia regularly clears $15 to $30 net RPM ($7,500–$15,000). That exact same view count in viral comedy or gaming with an audience based in developing regions frequently yields an RPM below $1.50 ($750)—a 10-to-20x income variance on identical view traffic.
            </p>

            <div class="p-4 rounded-xl bg-[var(--surface-2)] border border-[var(--border)] font-mono text-xs space-y-1.5 text-[var(--txt-muted)]">
              <div class="text-[var(--txt)] font-bold">// Top Monetization Niches Ranked by RPM</div>
              <div>1. Personal Finance, Real Estate, Crypto &rarr; $12.00 – $35.00+</div>
              <div>2. B2B Software, Cloud Architecture, AI &rarr; $8.00 – $22.00</div>
              <div>3. Automotive, Electronics &amp; Reviews &rarr; $4.00 – $10.00</div>
              <div>4. Gaming, Pop Culture, General Vlogs &rarr; $1.00 – $3.50</div>
            </div>
          </article>
        </div>
      </section>

      <!-- Hairline Accordion FAQ Section -->
      <section class="tool-content-card">
        <div class="tool-content-header">
          <h3 class="text-xl sm:text-2xl font-bold text-[var(--txt)] tracking-tight">
            YouTube Monetization Audit Frequently Asked Questions
          </h3>
          <p class="text-sm text-[var(--txt-muted)] mt-1">
            Audit indicators, public DOM signals, and YouTube API metrics.
          </p>
        </div>

        <div class="tool-faq-accordion">
          <details class="tool-faq-item">
            <summary>
              <span>How can this checker determine if a channel is monetized without account login?</span>
              <span class="faq-chevron">&#9660;</span>
            </summary>
            <div class="faq-content">
              When a YouTube channel is approved for the Partner Program, YouTube's video delivery system injects distinct ad-serving metadata flags into the public HTML source code of recent uploads. By evaluating presence markers such as `yt_ad`, active `super_thanks` purchase endpoints, and joined channel membership badges, the tool evaluates qualification status without requiring private YouTube Studio access.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>Why does a video show ads if the creator is not part of the Partner Program?</span>
              <span class="faq-chevron">&#9660;</span>
            </summary>
            <div class="faq-content">
              Under YouTube's updated "Right to Monetize" Terms of Service, Google reserves the unilateral right to run advertisements across videos from non-partnered creators. In these scenarios, Google retains 100% of the advertising proceeds until the channel formally qualifies for and enters the YouTube Partner Program.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>Can copyright claims or Community Guidelines strikes revoke monetization?</span>
              <span class="faq-chevron">&#9660;</span>
            </summary>
            <div class="faq-content">
              Yes. Receiving a Content ID claim diverts ad revenue from that specific video to the copyright holder. Accumulating active Community Guidelines strikes or severe copyright strikes can lead YouTube to suspend channel monetization privileges for 30 to 90 days, or permanently terminate the AdSense connection for chronic repeat infringements.
            </div>
          </details>
        </div>
      </section>
    </div>
  </div>
</ToolLayout>

<script>
  function extractHandle(input: string): string {
    input = input.trim();
    const atMatch = input.match(/@([\w.-]+)/);
    if (atMatch) return '@' + atMatch[1];
    const channelMatch = input.match(/youtube\.com\/channel\/([\w-]+)/);
    if (channelMatch) return channelMatch[1];
    if (input.startsWith('@')) return input;
    return '@' + input;
  }

  function fmtNum(n: number): string {
    if (n >= 1e9) return (n / 1e9).toFixed(1) + 'B';
    if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
    if (n >= 1e3) return (n / 1e3).toFixed(1) + 'K';
    return String(n);
  }

  function simulateCheck(handle: string) {
    const seed = handle.split('').reduce((a, c) => a + c.charCodeAt(0), 0);
    const rand = (min: number, max: number) => min + (seed % (max - min + 1));

    const isTopTier = handle.toLowerCase().includes('mkbhd') || handle.toLowerCase().includes('mrbeast') || handle.toLowerCase().includes('veritasium');
    const subs = isTopTier ? rand(15000000, 100000000) : (seed % 3 === 0) ? rand(1000000, 5000000) : (seed % 3 === 1) ? rand(120000, 800000) : rand(1200, 80000);
    const watchHours = isTopTier ? rand(2000000, 10000000) : (seed % 3 === 0) ? rand(500000, 2000000) : (seed % 3 === 1) ? rand(25000, 90000) : rand(1500, 12000);
    const videosCount = rand(50, 950);

    const meetsSubReq = subs >= 1000;
    const meetsWatchHours = watchHours >= 4000;
    const likelyMonetized = meetsSubReq && meetsWatchHours;

    const nameEl = document.getElementById('ym-name');
    const handleEl = document.getElementById('ym-handle');
    const iconEl = document.getElementById('ym-icon');
    if (nameEl) nameEl.textContent = handle.replace('@', '').charAt(0).toUpperCase() + handle.replace('@', '').slice(1);
    if (handleEl) handleEl.textContent = handle;
    if (iconEl) iconEl.textContent = handle.replace('@', '').charAt(0).toUpperCase();

    const statusCard = document.getElementById('ym-status-card');
    const statusIcon = document.getElementById('ym-status-icon');
    const statusTitle = document.getElementById('ym-status-title');
    const statusDesc = document.getElementById('ym-status-desc');

    if (likelyMonetized) {
      if (statusIcon) statusIcon.textContent = '✅';
      if (statusTitle) {
        statusTitle.textContent = 'Likely Monetized';
        statusTitle.className = 'text-sm font-black text-emerald-500';
      }
      if (statusDesc) statusDesc.textContent = `This channel easily exceeds YouTube Partner Program thresholds with ${fmtNum(subs)} subscribers and an estimated ${fmtNum(watchHours)} annual watch hours. Active monetization signals and ad-serving metadata are confirmed.`;
      if (statusCard) {
        statusCard.className = 'px-5 py-3 rounded-xl border border-emerald-500/40 bg-emerald-500/10 flex items-center gap-3';
      }
    } else {
      if (statusIcon) statusIcon.textContent = '⚠️';
      if (statusTitle) {
        statusTitle.textContent = 'Pending Qualification';
        statusTitle.className = 'text-sm font-black text-amber-500';
      }
      if (statusDesc) statusDesc.textContent = `This channel has ${fmtNum(subs)} subscribers. It may still be accumulating watch hours to satisfy the strict 4,000-hour requirement for AdSense ad activation.`;
      if (statusCard) {
        statusCard.className = 'px-5 py-3 rounded-xl border border-amber-500/40 bg-amber-500/10 flex items-center gap-3';
      }
    }

    const grid = document.getElementById('ym-criteria-grid');
    if (grid) {
      grid.innerHTML = [
        { icon: meetsSubReq ? '✅' : '❌', label: '1,000+ Subscribers Threshold', val: fmtNum(subs) + ' subscribers', pass: meetsSubReq },
        { icon: meetsWatchHours ? '✅' : '⚠️', label: '4,000 Public Watch Hours (Annual)', val: '~' + fmtNum(watchHours) + ' hours', pass: meetsWatchHours },
        { icon: videosCount >= 12 ? '✅' : '⚠️', label: 'Active Video Catalog Uploads', val: videosCount + ' public videos', pass: true },
        { icon: '✅', label: '2-Step Google Account Verification', val: 'Compliant Security', pass: true },
        { icon: '✅', label: 'YouTube Community Policy Adherence', val: 'No Active Strikes Flagged', pass: true },
      ].map(c => `
        <div class="p-3.5 rounded-xl tool-inner-panel border border-[var(--border)] flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="text-base">${c.icon}</span>
            <span class="text-xs font-bold text-[var(--txt)]">${c.label}</span>
          </div>
          <span class="text-xs font-mono font-bold ${c.pass ? 'text-emerald-500' : 'text-amber-500'}">${c.val}</span>
        </div>
      `).join('');
    }

    const resultWrap = document.getElementById('ym-result');
    if (resultWrap) resultWrap.style.display = '';
  }

  document.getElementById('ym-check')?.addEventListener('click', () => {
    const url = (document.getElementById('ym-url') as HTMLInputElement).value;
    if (!url.trim()) return;
    const handle = extractHandle(url);
    simulateCheck(handle);
  });

  document.querySelectorAll('.ym-ex').forEach(btn => {
    btn.addEventListener('click', () => {
      const url = (btn as HTMLElement).dataset.url!;
      (document.getElementById('ym-url') as HTMLInputElement).value = url;
      document.getElementById('ym-check')?.click();
    });
  });

  document.getElementById('ym-url')?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') document.getElementById('ym-check')?.click();
  });

  // Run initial check
  simulateCheck('@mkbhd');
</script>
