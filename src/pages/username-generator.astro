---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'username-generator')!;
---

<ToolLayout tool={tool}>
  <div class="ug-wrap">
    <div class="ug-controls">
      <div class="ug-field">
        <label for="ug-keyword">Keyword or name (optional)</label>
        <input type="text" id="ug-keyword" class="ug-input" placeholder="e.g. gaming, ninja, shadow…" maxlength="20" />
      </div>
      <div class="ug-options-grid">
        <div class="ug-check-group">
          <label class="ug-label-sm">Style</label>
          <div class="ug-checks">
            <label class="ug-check"><input type="radio" name="ug-style" value="mixed" checked /> Mixed</label>
            <label class="ug-check"><input type="radio" name="ug-style" value="gamer" /> Gamer</label>
            <label class="ug-check"><input type="radio" name="ug-style" value="professional" /> Professional</label>
            <label class="ug-check"><input type="radio" name="ug-style" value="social" /> Social Media</label>
          </div>
        </div>
        <div class="ug-check-group">
          <label class="ug-label-sm">Options</label>
          <div class="ug-checks">
            <label class="ug-check"><input type="checkbox" id="ug-numbers" checked /> Add numbers</label>
            <label class="ug-check"><input type="checkbox" id="ug-underscores" /> Allow underscores</label>
          </div>
        </div>
      </div>
      <button class="btn btn-primary" id="ug-generate">
        <i class="fas fa-user"></i> Generate Usernames
      </button>
    </div>

    <div class="ug-results" id="ug-results">
      <div class="ug-results-header">
        <span class="ug-results-label">Generated Usernames</span>
        <button class="btn btn-ghost btn-sm" id="ug-copy-all"><i class="fas fa-copy"></i> Copy All</button>
      </div>
      <div class="ug-grid" id="ug-grid">
        <div class="ug-placeholder">Click "Generate Usernames" to get started.</div>
      </div>
    </div>
  </div>
</ToolLayout>

<style>
  .ug-wrap { display: flex; flex-direction: column; gap: 20px; }
  .ug-controls { display: flex; flex-direction: column; gap: 16px; padding: 20px; background: var(--bg-soft); border: 1.5px solid var(--border); border-radius: var(--radius-md); }
  .ug-field { display: flex; flex-direction: column; gap: 8px; }
  .ug-field label { font-size: 14px; font-weight: 600; color: var(--txt); }
  .ug-input {
    padding: 11px 14px;
    font-size: 15px;
    font-family: 'Inter', sans-serif;
    color: var(--txt);
    background: #fff;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    outline: none;
    transition: border-color .15s;
  }
  .ug-input:focus { border-color: var(--brand); }
  .ug-options-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .ug-check-group { display: flex; flex-direction: column; gap: 8px; }
  .ug-label-sm { font-size: 12px; font-weight: 700; color: var(--txt-muted); text-transform: uppercase; letter-spacing: .04em; }
  .ug-checks { display: flex; flex-direction: column; gap: 6px; }
  .ug-check { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--txt); cursor: pointer; }
  .ug-check input { accent-color: var(--brand); width: 14px; height: 14px; }

  .ug-results { border: 1.5px solid var(--border); border-radius: var(--radius-md); overflow: hidden; }
  .ug-results-header { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: var(--bg-soft); border-bottom: 1px solid var(--border); }
  .ug-results-label { font-size: 13px; font-weight: 700; color: var(--txt); }
  .btn-sm { padding: 6px 14px; font-size: 12px; }
  .ug-grid { padding: 16px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .ug-placeholder { padding: 24px; text-align: center; color: var(--txt-dim); font-style: italic; font-size: 14px; grid-column: 1/-1; }
  .ug-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    background: var(--bg-soft);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: 'Courier New', monospace;
    font-size: 13px;
    color: var(--txt);
    transition: border-color .15s, background .15s;
  }
  .ug-item:hover { border-color: var(--brand); background: var(--brand-light); }
  .ug-copy-btn { background: none; border: none; cursor: pointer; color: var(--txt-muted); padding: 2px 6px; border-radius: 4px; font-size: 11px; flex-shrink: 0; }
  .ug-copy-btn:hover { color: var(--brand); }

  @media (max-width: 500px) { .ug-grid { grid-template-columns: 1fr 1fr; } .ug-options-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const gamerWords = ['dark','shadow','neon','blaze','frost','void','steel','phantom','storm','viper','rogue','cyber','pixel','glitch','ultra'];
  const proWords = ['pro','expert','guru','master','chief','lead','prime','elite','ace','top'];
  const socialWords = ['vibes','mode','life','world','zone','hub','space','daily','real','original'];
  const animals = ['wolf','fox','hawk','lynx','bear','tiger','eagle','viper','raven','puma'];
  const colors = ['red','blue','gold','silver','black','white','purple','crimson','azure','jade'];
  const adjectives = ['rapid','silent','fierce','bold','keen','swift','sharp','mighty','brave','epic'];

  function randItem<T>(arr: T[]): T { return arr[Math.floor(Math.random() * arr.length)]; }
  function randNum(): string { return String(Math.floor(Math.random() * 999) + 1); }

  function gen(style: string, keyword: string, useNumbers: boolean, useUnder: boolean): string {
    const sep = useUnder && Math.random() > .5 ? '_' : '';
    let name = '';

    if (keyword) {
      const kw = keyword.toLowerCase().replace(/\s+/g, sep || '');
      if (style === 'gamer') name = `${kw}${sep}${randItem(gamerWords)}`;
      else if (style === 'professional') name = `${randItem(proWords)}${sep}${kw}`;
      else if (style === 'social') name = `${kw}${sep}${randItem(socialWords)}`;
      else name = `${randItem(adjectives)}${sep}${kw}`;
    } else {
      if (style === 'gamer') name = `${randItem(gamerWords)}${sep}${randItem(animals)}`;
      else if (style === 'professional') name = `${randItem(proWords)}${sep}${randItem(adjectives)}`;
      else if (style === 'social') name = `${randItem(adjectives)}${sep}${randItem(socialWords)}`;
      else name = `${randItem(colors)}${sep}${randItem(animals)}`;
    }

    if (useNumbers) name += randNum();
    return name;
  }

  function generate() {
    const keyword = (document.getElementById('ug-keyword') as HTMLInputElement).value.trim();
    const style = (document.querySelector('input[name="ug-style"]:checked') as HTMLInputElement).value;
    const useNumbers = (document.getElementById('ug-numbers') as HTMLInputElement).checked;
    const useUnder = (document.getElementById('ug-underscores') as HTMLInputElement).checked;

    const names = new Set<string>();
    while (names.size < 18) names.add(gen(style, keyword, useNumbers, useUnder));
    const arr = Array.from(names);

    const grid = document.getElementById('ug-grid')!;
    grid.innerHTML = arr.map(n => `
      <div class="ug-item">
        <span>${n}</span>
        <button class="ug-copy-btn" data-name="${n}"><i class="fas fa-copy"></i></button>
      </div>
    `).join('');

    grid.querySelectorAll('.ug-copy-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const name = (btn as HTMLElement).dataset.name!;
        await navigator.clipboard.writeText(name);
        btn.innerHTML = '<i class="fas fa-check"></i>';
        setTimeout(() => btn.innerHTML = '<i class="fas fa-copy"></i>', 1500);
      });
    });
  }

  document.getElementById('ug-generate')?.addEventListener('click', generate);
  document.getElementById('ug-copy-all')?.addEventListener('click', async () => {
    const items = document.querySelectorAll('.ug-item span');
    if (!items.length) return;
    await navigator.clipboard.writeText(Array.from(items).map(i => i.textContent).join('\n'));
    const btn = document.getElementById('ug-copy-all')!;
    btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
    setTimeout(() => btn.innerHTML = '<i class="fas fa-copy"></i> Copy All', 2000);
  });

  generate();
</script>
