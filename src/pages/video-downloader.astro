---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'video-downloader') || {
  slug: 'video-downloader',
  name: 'Video Downloader',
  description: 'Download videos from popular social media and streaming platforms.',
  category: 'media',
  icon: '📥',
  faIcon: 'fa-download',
  color: '#DC2626',
  title: 'Video Downloader – Download Online Videos Free | Toolarsh',
  metaDescription: 'Download videos from supported websites quickly in your preferred quality.',
  keywords: 'video downloader, online video downloader, download video'
};
---

<ToolLayout tool={tool}>
  <div class="dl-box">
    <div class="dl-form shadow-sm">
      <div class="dl-input-group">
        <i class="fas fa-video dl-icon"></i>
        <input type="url" id="v-url" class="dl-input" placeholder="Paste Video Link here... (YouTube, Facebook, Twitter, Vimeo, TikTok)" />
        <button class="btn btn-primary dl-btn" id="v-btn">
          <i class="fas fa-download"></i> Fetch Video
        </button>
      </div>
    </div>

    <!-- Result / Quality selector -->
    <div class="dl-result" id="v-result" style="display:none">
      <div class="dl-progress-bar" id="v-progress-bar" style="display:none">
        <div class="progress-fill" id="v-progress-fill"></div>
      </div>
      <div class="dl-status" id="v-status">Fetching video information...</div>

      <div class="v-preview-card" id="v-card" style="display:none">
        <div class="v-thumb-wrap">
          <i class="fas fa-film v-icon"></i>
          <span class="v-duration">04:12</span>
        </div>
        <div class="v-info">
          <h4>High Definition Sample Video</h4>
          <p class="v-meta">Supported formats: MP4, WEBP, 3GP</p>

          <div class="quality-grid">
            <div class="q-item">
              <span class="q-res">1080p Full HD (MP4)</span>
              <span class="q-size">145.2 MB</span>
              <button class="btn btn-primary btn-sm dl-trigger"><i class="fas fa-download"></i> Download</button>
            </div>
            <div class="q-item">
              <span class="q-res">720p HD (MP4)</span>
              <span class="q-size">68.4 MB</span>
              <button class="btn btn-outline btn-sm dl-trigger"><i class="fas fa-download"></i> Download</button>
            </div>
            <div class="q-item">
              <span class="q-res">480p SD (MP4)</span>
              <span class="q-size">28.1 MB</span>
              <button class="btn btn-ghost btn-sm dl-trigger"><i class="fas fa-download"></i> Download</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>

<style>
  .dl-box { display: flex; flex-direction: column; gap: 24px; }
  .dl-form { background: var(--bg-soft); border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: 24px; }
  .dl-input-group { display: flex; align-items: center; background: #fff; border: 2px solid var(--border); border-radius: var(--radius-md); padding: 6px 6px 6px 16px; gap: 12px; transition: border-color .2s; }
  .dl-input-group:focus-within { border-color: var(--brand); }
  .dl-icon { color: var(--txt-muted); font-size: 18px; }
  .dl-input { flex: 1; border: none; outline: none; font-size: 15px; background: transparent; }
  .dl-btn { flex-shrink: 0; }

  .dl-result { background: #fff; border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: 24px; text-align: center; }
  .dl-progress-bar { height: 8px; background: #E2E8F0; border-radius: 100px; overflow: hidden; margin-bottom: 16px; }
  .progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, #DC2626, #EA580C); transition: width 0.3s ease; }
  .dl-status { font-size: 14.5px; font-weight: 600; color: #DC2626; margin-bottom: 16px; }

  .v-preview-card { display: flex; gap: 20px; text-align: left; background: var(--bg-soft); padding: 20px; border-radius: var(--radius-md); border: 1.5px solid var(--border); }
  .v-thumb-wrap { width: 160px; height: 100px; background: #FEF2F2; color: #DC2626; border-radius: var(--radius-md); display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; flex-shrink: 0; }
  .v-icon { font-size: 32px; }
  .v-duration { position: absolute; bottom: 6px; right: 6px; background: rgba(0,0,0,0.7); color: #fff; font-size: 11px; padding: 2px 6px; border-radius: 4px; }
  .v-info { flex: 1; }
  .v-info h4 { font-size: 17px; font-weight: 700; color: #0F172A; margin-bottom: 4px; }
  .v-meta { font-size: 13px; color: #64748B; margin-bottom: 16px; }

  .quality-grid { display: flex; flex-direction: column; gap: 10px; }
  .q-item { display: flex; align-items: center; justify-content: space-between; background: #fff; padding: 10px 14px; border-radius: var(--radius-sm); border: 1px solid var(--border); }
  .q-res { font-size: 14px; font-weight: 600; color: #0F172A; }
  .q-size { font-size: 13px; color: #64748B; }
  .btn-sm { padding: 6px 14px; font-size: 13px; }

  @media (max-width: 640px) {
    .dl-input-group { flex-direction: column; padding: 12px; }
    .dl-input { width: 100%; margin-bottom: 8px; }
    .dl-btn { width: 100%; }
    .v-preview-card { flex-direction: column; }
    .v-thumb-wrap { width: 100%; height: 120px; }
  }
</style>

<script>
  const btn = document.getElementById('v-btn');
  const input = document.getElementById('v-url') as HTMLInputElement;
  const result = document.getElementById('v-result');
  const status = document.getElementById('v-status');
  const progressBar = document.getElementById('v-progress-bar');
  const progressFill = document.getElementById('v-progress-fill');
  const card = document.getElementById('v-card');

  btn?.addEventListener('click', () => {
    const url = input?.value.trim();
    if (!url) {
      alert('Please enter a valid video link.');
      return;
    }
    if (result) result.style.display = 'block';
    if (progressBar) progressBar.style.display = 'block';
    if (card) card.style.display = 'none';

    let progress = 0;
    if (status) status.textContent = 'Connecting to video server...';
    
    const interval = setInterval(() => {
      progress += 25;
      if (progressFill) progressFill.style.width = progress + '%';
      if (progress === 50 && status) status.textContent = 'Parsing video stream & resolution formats...';

      if (progress >= 100) {
        clearInterval(interval);
        setTimeout(() => {
          if (progressBar) progressBar.style.display = 'none';
          if (status) status.textContent = '✅ Video ready for download!';
          if (card) card.style.display = 'flex';
        }, 400);
      }
    }, 250);
  });

  document.querySelectorAll('.dl-trigger').forEach(b => {
    b.addEventListener('click', () => {
      alert('Demo Download: Video download initiated!');
    });
  });
</script>
