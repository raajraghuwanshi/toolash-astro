---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'business-name-generator')!;
---

<ToolLayout tool={tool} customLayout={true}>
  <div class="tool-page-wrap">
    <!-- Hero Header -->
    <div class="tool-hero-box">
      <div class="tool-badge-pill">
        <i class="fas fa-lightbulb animate-pulse"></i> Venture Studio Naming Engine
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[var(--txt)] tracking-tight">
        Business & Startup <span class="bg-gradient-to-r from-[var(--brand)] via-emerald-400 to-amber-400 bg-clip-text text-transparent">Name Generator</span>
      </h1>
      <p class="text-[var(--txt-muted)] text-sm sm:text-base mt-3 max-w-2xl mx-auto">
        Algorithmically generate memorable, domain-ready brand names for technology startups, agencies, SaaS platforms, and boutique ventures.
      </p>
    </div>

    <!-- Main Interactive Studio Console -->
    <div class="tool-card-surface p-6 sm:p-8 space-y-6 mb-10">
      <div class="max-w-3xl space-y-4">
        <div class="space-y-2">
          <label for="bn-keyword" class="text-xs font-mono font-bold text-[var(--txt-muted)] uppercase tracking-wider block">
            What is your business or product about? (Core Keyword)
          </label>
          <div class="flex items-center tool-inner-panel p-2.5 focus-within:border-[var(--brand)] transition-all">
            <i class="fas fa-magnifying-glass text-[var(--txt-dim)] pl-3 pr-2 text-sm"></i>
            <input type="text" id="bn-keyword" value="Apex" placeholder="e.g. coffee, cloud, fitness, data, craft…" maxlength="30" class="flex-1 bg-transparent text-[var(--txt)] font-medium text-base sm:text-lg outline-none px-2 placeholder:text-[var(--txt-dim)]" />
          </div>
        </div>

        <!-- Industry Filter Chips -->
        <div class="space-y-2 pt-2">
          <span class="text-xs font-mono font-bold text-[var(--txt-muted)] uppercase tracking-wider block">Select Industry Category:</span>
          <div class="flex flex-wrap gap-2" id="bn-industry-chips">
            <button class="filter-chip bn-chip active" data-val="tech">
              💻 Technology &amp; SaaS
            </button>
            <button class="filter-chip bn-chip" data-val="creative">
              🎨 Design &amp; Studio
            </button>
            <button class="filter-chip bn-chip" data-val="finance">
              💰 Finance &amp; Capital
            </button>
            <button class="filter-chip bn-chip" data-val="health">
              🏋️ Health &amp; Bio
            </button>
            <button class="filter-chip bn-chip" data-val="food">
              🍔 Food &amp; Hospitality
            </button>
            <button class="filter-chip bn-chip" data-val="retail">
              🛍️ Retail &amp; Commerce
            </button>
            <button class="filter-chip bn-chip" data-val="any">
              ✨ Universal / Cross-Industry
            </button>
          </div>
        </div>

        <button id="bn-generate" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-gradient-to-r from-[var(--brand)] to-teal-600 text-white font-black text-sm uppercase tracking-wider shadow-lg shadow-emerald-500/20 hover:opacity-95 transition-all flex items-center justify-center gap-2 cursor-pointer mt-3">
          <i class="fas fa-sparkles"></i> Generate 18 Brand Names
        </button>
      </div>

      <!-- Live Generated Names Grid -->
      <div class="pt-6 border-t border-[var(--border)]">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--brand)]">Generated Brand Portfolio</span>
          <span class="text-xs font-mono text-[var(--txt-muted)]">Click copy button on any name</span>
        </div>
        <div id="bn-results" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
          <!-- Populated via script -->
        </div>
      </div>
    </div>

    <!-- Brand Taxonomy & Trademark Clearance Architecture (Comparison Table Archetype) -->
    <div class="tool-content-wrap">
      <section class="tool-content-card">
        <!-- Table 1: Master Brand Taxonomy Comparison Matrix -->
        <div class="tool-content-header">
          <h2>Startup Naming Paradigms: Legal, Marketing &amp; Namespace Comparison</h2>
          <p>
            Every venture name belongs to a distinct linguistic category. Choosing your paradigm determines trademark defensibility, early customer acquisition cost (CAC), and international namespace competition.
          </p>
        </div>

        <div class="overflow-x-auto border border-[var(--border)] rounded-2xl bg-[var(--surface-1)]">
          <table class="w-full text-left border-collapse text-xs sm:text-sm">
            <thead>
              <tr class="border-b border-[var(--border)] bg-[var(--surface-2)] text-[var(--txt)] font-mono uppercase tracking-wider text-[11px]">
                <th class="py-3.5 px-4 font-bold">Archetype</th>
                <th class="py-3.5 px-4 font-bold">Canonical Examples</th>
                <th class="py-3.5 px-4 font-bold">USPTO Legal Strength</th>
                <th class="py-3.5 px-4 font-bold">Initial Marketing Drag</th>
                <th class="py-3.5 px-4 font-bold">Radio Test Score</th>
                <th class="py-3.5 px-4 font-bold">Primary Advantage</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--border)] font-sans text-[var(--txt-muted)]">
              <tr class="hover:bg-[var(--surface-2)]/60 transition-colors">
                <td class="py-4 px-4 font-bold text-[var(--txt)]">
                  Neologism (Invented)
                </td>
                <td class="py-4 px-4 font-mono text-xs text-[var(--txt)]">
                  Spotify, Uber, Figma, Canva
                </td>
                <td class="py-4 px-4">
                  <span class="inline-flex items-center px-2 py-0.5 rounded font-mono text-[11px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    Fanciful (Highest)
                  </span>
                </td>
                <td class="py-4 px-4">
                  <span class="text-amber-400 font-medium">Heavy</span> (Zero preconceived semantic meaning)
                </td>
                <td class="py-4 px-4 font-mono font-bold text-[var(--txt)]">
                  9 / 10
                </td>
                <td class="py-4 px-4 text-xs leading-relaxed">
                  Clean trademark clearance; instant global namespace defensibility; unencumbered brand vessel.
                </td>
              </tr>
              <tr class="hover:bg-[var(--surface-2)]/60 transition-colors">
                <td class="py-4 px-4 font-bold text-[var(--txt)]">
                  Compound Blend
                </td>
                <td class="py-4 px-4 font-mono text-xs text-[var(--txt)]">
                  PayPal, DoorDash, Snapchat, Coinbase
                </td>
                <td class="py-4 px-4">
                  <span class="inline-flex items-center px-2 py-0.5 rounded font-mono text-[11px] font-bold bg-blue-500/10 text-blue-400 border border-blue-500/20">
                    Suggestive (Strong)
                  </span>
                </td>
                <td class="py-4 px-4">
                  <span class="text-emerald-400 font-medium">Low</span> (Combines familiar functional anchors)
                </td>
                <td class="py-4 px-4 font-mono font-bold text-[var(--txt)]">
                  10 / 10
                </td>
                <td class="py-4 px-4 text-xs leading-relaxed">
                  Rapid user onboarding; intuitive mental model; perfect phonetic clarity on audio media.
                </td>
              </tr>
              <tr class="hover:bg-[var(--surface-2)]/60 transition-colors">
                <td class="py-4 px-4 font-bold text-[var(--txt)]">
                  Arbitrary Metaphor
                </td>
                <td class="py-4 px-4 font-mono text-xs text-[var(--txt)]">
                  Apple, Amazon, Nike, Stripe
                </td>
                <td class="py-4 px-4">
                  <span class="inline-flex items-center px-2 py-0.5 rounded font-mono text-[11px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    Arbitrary (High)
                  </span>
                </td>
                <td class="py-4 px-4">
                  <span class="text-amber-400 font-medium">Moderate</span> (Repurposes existing worldly symbols)
                </td>
                <td class="py-4 px-4 font-mono font-bold text-[var(--txt)]">
                  9 / 10
                </td>
                <td class="py-4 px-4 text-xs leading-relaxed">
                  Deep subconscious resonance; emotional gravitas; elevated perceived authority from day one.
                </td>
              </tr>
              <tr class="hover:bg-[var(--surface-2)]/60 transition-colors">
                <td class="py-4 px-4 font-bold text-[var(--txt)]">
                  Descriptive / Utility
                </td>
                <td class="py-4 px-4 font-mono text-xs text-[var(--txt)]">
                  CarMax, Hotels.com, Booking.com
                </td>
                <td class="py-4 px-4">
                  <span class="inline-flex items-center px-2 py-0.5 rounded font-mono text-[11px] font-bold bg-red-500/10 text-red-400 border border-red-500/20">
                    Weak / Disclaimed
                  </span>
                </td>
                <td class="py-4 px-4">
                  <span class="text-emerald-400 font-medium">Zero</span> (Self-evident direct proposition)
                </td>
                <td class="py-4 px-4 font-mono font-bold text-[var(--txt)]">
                  10 / 10
                </td>
                <td class="py-4 px-4 text-xs leading-relaxed">
                  Instant search engine intent matching; vulnerable to direct copycats and impossible trademark barriers.
                </td>
              </tr>
              <tr class="hover:bg-[var(--surface-2)]/60 transition-colors">
                <td class="py-4 px-4 font-bold text-[var(--txt)]">
                  Suffix Modifier
                </td>
                <td class="py-4 px-4 font-mono text-xs text-[var(--txt)]">
                  Shopify, Cloudinary, Grammarly, Optimizely
                </td>
                <td class="py-4 px-4">
                  <span class="inline-flex items-center px-2 py-0.5 rounded font-mono text-[11px] font-bold bg-blue-500/10 text-blue-400 border border-blue-500/20">
                    Suggestive (Medium)
                  </span>
                </td>
                <td class="py-4 px-4">
                  <span class="text-blue-400 font-medium">Low</span> (Signals modern cloud/software automation)
                </td>
                <td class="py-4 px-4 font-mono font-bold text-[var(--txt)]">
                  8 / 10
                </td>
                <td class="py-4 px-4 text-xs leading-relaxed">
                  Ideal for enterprise B2B SaaS; effortlessly turns static verbs into energetic product identities.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Table 2: 4-Tier Legal Clearance Gate Matrix -->
      <section class="space-y-4">
        <div class="max-w-3xl space-y-2">
          <h2 class="text-2xl sm:text-3xl font-black text-[var(--txt)] tracking-tight">
            Brand Clearance Protocol: The 4 Validation Tiers
          </h2>
          <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
            Before purchasing domain assets or printing merchandise, vet your prospective moniker across all four legal and digital clearinghouses.
          </p>
        </div>

        <div class="overflow-x-auto border border-[var(--border)] rounded-2xl bg-[var(--surface-1)]">
          <table class="w-full text-left border-collapse text-xs sm:text-sm">
            <thead>
              <tr class="border-b border-[var(--border)] bg-[var(--surface-2)] text-[var(--txt)] font-mono uppercase tracking-wider text-[11px]">
                <th class="py-3.5 px-4 font-bold">Clearance Gate</th>
                <th class="py-3.5 px-4 font-bold">Investigation Surface</th>
                <th class="py-3.5 px-4 font-bold">Failure Severity</th>
                <th class="py-3.5 px-4 font-bold">Mandatory Verification Step</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--border)] font-sans text-[var(--txt-muted)]">
              <tr class="hover:bg-[var(--surface-2)]/60 transition-colors">
                <td class="py-4 px-4 font-bold text-[var(--txt)]">
                  USPTO / WIPO Registry
                </td>
                <td class="py-4 px-4 text-xs">
                  Federal Trademark Register (Nice Classes 9, 35, 42)
                </td>
                <td class="py-4 px-4">
                  <span class="inline-flex items-center px-2 py-0.5 rounded font-mono text-[11px] font-bold bg-red-500/10 text-red-400 border border-red-500/20">
                    Catastrophic
                  </span>
                  <div class="text-[11px] text-[var(--txt-muted)] mt-1">Cease &amp; Desist, disgorgement of profits</div>
                </td>
                <td class="py-4 px-4 text-xs leading-relaxed">
                  Execute TESS search for identical marks + phonetic equivalents across overlapping Nice software and commerce classes.
                </td>
              </tr>
              <tr class="hover:bg-[var(--surface-2)]/60 transition-colors">
                <td class="py-4 px-4 font-bold text-[var(--txt)]">
                  State Common Law
                </td>
                <td class="py-4 px-4 text-xs">
                  State SOS business entity registries &amp; trade names
                </td>
                <td class="py-4 px-4">
                  <span class="inline-flex items-center px-2 py-0.5 rounded font-mono text-[11px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                    High
                  </span>
                  <div class="text-[11px] text-[var(--txt-muted)] mt-1">Territorial injunctions, geographic freeze</div>
                </td>
                <td class="py-4 px-4 text-xs leading-relaxed">
                  Search state LLC registers, Crunchbase, GitHub repositories, and product directory indices for prior commercial adoption.
                </td>
              </tr>
              <tr class="hover:bg-[var(--surface-2)]/60 transition-colors">
                <td class="py-4 px-4 font-bold text-[var(--txt)]">
                  ICANN DNS Namespace
                </td>
                <td class="py-4 px-4 text-xs">
                  Global TLD registries (.com, .io, .ai, .co)
                </td>
                <td class="py-4 px-4">
                  <span class="inline-flex items-center px-2 py-0.5 rounded font-mono text-[11px] font-bold bg-blue-500/10 text-blue-400 border border-blue-500/20">
                    Moderate
                  </span>
                  <div class="text-[11px] text-[var(--txt-muted)] mt-1">Secondary market extortion, traffic loss</div>
                </td>
                <td class="py-4 px-4 text-xs leading-relaxed">
                  Verify pure `.com` availability or standard broker valuation; confirm fallback ccTLD policies if selecting `.ai` or `.io`.
                </td>
              </tr>
              <tr class="hover:bg-[var(--surface-2)]/60 transition-colors">
                <td class="py-4 px-4 font-bold text-[var(--txt)]">
                  Social Handle Ecosystem
                </td>
                <td class="py-4 px-4 text-xs">
                  X (Twitter), LinkedIn, GitHub, YouTube, Instagram
                </td>
                <td class="py-4 px-4">
                  <span class="inline-flex items-center px-2 py-0.5 rounded font-mono text-[11px] font-bold bg-slate-500/10 text-slate-400 border border-slate-500/20">
                    Manageable
                  </span>
                  <div class="text-[11px] text-[var(--txt-muted)] mt-1">Impersonation confusion, fragmented marketing</div>
                </td>
                <td class="py-4 px-4 text-xs leading-relaxed">
                  Check uniform handle consistency (`@brand` or `@getbrand`) across all core distribution channels before corporate filing.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Table 3: Phonetic Mechanics & Radio Test Matrix -->
      <section class="space-y-4">
        <div class="max-w-3xl space-y-2">
          <h2 class="text-2xl sm:text-3xl font-black text-[var(--txt)] tracking-tight">
            The Radio Test: Phonetic Mechanics &amp; Acoustic Clarity
          </h2>
          <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
            If a customer hears your company name on a podcast or voice search, will they arrive at your actual URL without typographical friction?
          </p>
        </div>

        <div class="overflow-x-auto border border-[var(--border)] rounded-2xl bg-[var(--surface-1)]">
          <table class="w-full text-left border-collapse text-xs sm:text-sm">
            <thead>
              <tr class="border-b border-[var(--border)] bg-[var(--surface-2)] text-[var(--txt)] font-mono uppercase tracking-wider text-[11px]">
                <th class="py-3.5 px-4 font-bold">Linguistic Trait</th>
                <th class="py-3.5 px-4 font-bold">Acoustic Principle</th>
                <th class="py-3.5 px-4 font-bold">Radio Test Viability</th>
                <th class="py-3.5 px-4 font-bold">Real-World Case Study</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--border)] font-sans text-[var(--txt-muted)]">
              <tr class="hover:bg-[var(--surface-2)]/60 transition-colors">
                <td class="py-4 px-4 font-bold text-[var(--txt)]">
                  Plosive Consonants
                </td>
                <td class="py-4 px-4 text-xs">
                  Hard stops (P, T, K, B, D, G) create neurological attention spikes.
                </td>
                <td class="py-4 px-4">
                  <span class="text-emerald-400 font-bold font-mono">PASS (98%)</span>
                </td>
                <td class="py-4 px-4 text-xs">
                  <strong class="text-[var(--txt)]">Stripe, PayPal, TikTok:</strong> Crisp phonetic separation ensures immediate mental retention.
                </td>
              </tr>
              <tr class="hover:bg-[var(--surface-2)]/60 transition-colors">
                <td class="py-4 px-4 font-bold text-[var(--txt)]">
                  Vowel Dropping
                </td>
                <td class="py-4 px-4 text-xs">
                  Removing vowels (e.g., -er to -r) to acquire cheap domains.
                </td>
                <td class="py-4 px-4">
                  <span class="text-red-400 font-bold font-mono">FAIL (28%)</span>
                </td>
                <td class="py-4 px-4 text-xs">
                  <strong class="text-[var(--txt)]">Flickr, Tumblr, Grindr:</strong> Required millions in corrective marketing to prevent users typing the natural vowel.
                </td>
              </tr>
              <tr class="hover:bg-[var(--surface-2)]/60 transition-colors">
                <td class="py-4 px-4 font-bold text-[var(--txt)]">
                  Homophonic Ambiguity
                </td>
                <td class="py-4 px-4 text-xs">
                  Words that sound identical to other common spellings (Right / Write / Rite).
                </td>
                <td class="py-4 px-4">
                  <span class="text-amber-400 font-bold font-mono">RISK (45%)</span>
                </td>
                <td class="py-4 px-4 text-xs">
                  <strong class="text-[var(--txt)]">SiteRite, Synk:</strong> Forcing customers to ask "is that with a C or an S?" leaks 15–30% of direct navigation traffic.
                </td>
              </tr>
              <tr class="hover:bg-[var(--surface-2)]/60 transition-colors">
                <td class="py-4 px-4 font-bold text-[var(--txt)]">
                  Trochaic Rhythm
                </td>
                <td class="py-4 px-4 text-xs">
                  Two-syllable cadence with stress on the first syllable (DUM-da).
                </td>
                <td class="py-4 px-4">
                  <span class="text-emerald-400 font-bold font-mono">PASS (95%)</span>
                </td>
                <td class="py-4 px-4 text-xs">
                  <strong class="text-[var(--txt)]">Google, Apple, Uber, Twitter:</strong> Matches human conversational cadence and naturally becomes a colloquial verb.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Hairline Accordion FAQ Section -->
      <section class="tool-content-card">
        <div class="tool-content-header">
          <h2>Startup Naming &amp; Brand Equity Frequently Asked Questions</h2>
          <p>
            Clearance strategies, international considerations, and domain valuation fundamentals.
          </p>
        </div>

        <div class="tool-faq-accordion">
          <details class="tool-faq-item">
            <summary>
              <span>Does owning the exact-match .com still matter for modern startups?</span>
              <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
            </summary>
            <div class="faq-answer">
              While developer tools and AI startups thrive on `.io`, `.dev`, and `.ai`, the exact-match `.com` remains the ultimate signal of enterprise legitimacy. When pitching corporate procurement teams, institutions subconsciously equate `.com` ownership with capitalization, permanence, and security. You can launch on an alternative extension, but budget to acquire the `.com` prior to Series B.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>What defines legal "Likelihood of Confusion" in trademark disputes?</span>
              <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
            </summary>
            <div class="faq-answer">
              Trademark law does not require exact identical spelling to rule an infringement. Courts evaluate whether an ordinary consumer would reasonably assume two products originate from the same enterprise, based on phonetic similarity, visual appearance, and overlapping commercial channels. A cybersecurity company named "Fortify" would immediately clash with an existing "FortiFi" in software.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>How can founders validate customer resonance before legal incorporation?</span>
              <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
            </summary>
            <div class="faq-answer">
              Run a blind smoke test. Create 3 simple landing pages or unbranded social ads with identical value propositions but differing candidate names. Measure click-through rates (CTR) and email signup conversions across $100 in traffic. The name with superior semantic resonance will consistently yield 20–40% lower cost-per-acquisition.
            </div>
          </details>
        </div>
      </section>

    </div>
  </div>
</ToolLayout>

<script>
  const techSuffixes = ['io','Hub','Stack','Labs','Forge','Sync','Nexus','Wave','Edge','Core','Tech','Soft','AI','Data','Cloud'];
  const creativeSuffixes = ['Studio','Creative','Design','Works','Art','Craft','Agency','Co','Brand','Media'];
  const foodSuffixes = ['Kitchen','Bites','Eats','Table','Feast','Grill','Bowl','Garden','Fresh','House'];
  const healthSuffixes = ['Fit','Wellness','Health','Life','Boost','Active','Strong','Vital','Body','Mind'];
  const financeSuffixes = ['Capital','Wealth','Finance','Trust','Invest','Bank','Fund','Asset','Pro','Plus'];
  const retailSuffixes = ['Shop','Store','Mart','Place','Goods','Market','Co','World','Zone','Hub'];
  const anySuffixes = ['Pro','Plus','360','One','Group','Inc','Co','Solutions','Global','Prime'];

  const prefixes = ['Prime','Smart','Fast','Bold','Next','Pure','Max','Top','Best','Nova','Apex','Peak','Elite','True','Real'];
  const adjectives = ['Brilliant','Dynamic','Crisp','Sharp','Elegant','Swift','Creative','Unique','Modern','Premium'];

  const suffixMap: Record<string, string[]> = {
    tech: techSuffixes,
    creative: creativeSuffixes,
    food: foodSuffixes,
    health: healthSuffixes,
    finance: financeSuffixes,
    retail: retailSuffixes,
    any: anySuffixes,
  };

  const nameTypes = [
    { type: 'Compound', gen: (kw: string, sfx: string[]) => kw + randItem(sfx) },
    { type: 'Prefix + Keyword', gen: (kw: string, sfx: string[]) => randItem(prefixes) + kw },
    { type: 'Keyword + Suffix', gen: (kw: string, sfx: string[]) => kw + randItem(sfx) },
    { type: 'Adj + Keyword', gen: (kw: string, sfx: string[]) => randItem(adjectives) + kw },
    { type: 'Short & Catchy', gen: (kw: string, sfx: string[]) => kw.slice(0,4) + randItem(sfx).slice(0,3) },
    { type: 'Branded', gen: (kw: string, sfx: string[]) => kw[0].toUpperCase() + kw.slice(1) + randItem(sfx) },
  ];

  function randItem<T>(arr: T[]): T { return arr[Math.floor(Math.random() * arr.length)]; }

  function capitalize(s: string): string { return s ? s[0].toUpperCase() + s.slice(1).toLowerCase() : ''; }

  let selectedIndustry = 'tech';

  document.querySelectorAll('.bn-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      document.querySelectorAll('.bn-chip').forEach(c => {
        c.classList.remove('active');
      });
      chip.classList.add('active');
      selectedIndustry = (chip as HTMLElement).dataset.val || 'any';
      generateAndRender();
    });
  });

  function generateNames(keyword: string, industry: string): string[] {
    const sfx = suffixMap[industry] || anySuffixes;
    const kw = capitalize(keyword || randItem(['Ace','Nova','Sky','Bold','Prime']));
    const names: string[] = [];
    for (const nt of nameTypes) {
      for (let i = 0; i < 3; i++) {
        const n = capitalize(nt.gen(kw, sfx));
        if (!names.includes(n)) names.push(n);
      }
    }
    while (names.length < 18) {
      const n = capitalize(randItem(prefixes) + kw + randItem(sfx));
      if (!names.includes(n)) names.push(n);
    }
    return names.slice(0, 18);
  }

  function generateAndRender() {
    const keyword = (document.getElementById('bn-keyword') as HTMLInputElement).value.trim();
    const names = generateNames(keyword, selectedIndustry);
    const container = document.getElementById('bn-results');
    if (!container) return;

    container.innerHTML = names.map(name => `
      <div class="p-4 rounded-2xl tool-inner-panel border border-[var(--border)] hover:border-[var(--brand)] transition-all flex items-center justify-between group">
        <div>
          <div class="font-bold text-[var(--txt)] text-base group-hover:text-[var(--brand)] transition-colors font-mono">${name}</div>
          <div class="text-[11px] font-mono text-[var(--txt-dim)] mt-0.5 flex items-center gap-2">
            <span>${selectedIndustry.toUpperCase()}</span>
            <span class="text-emerald-500 font-bold">✓ .com likely</span>
          </div>
        </div>
        <button class="bn-copy-btn px-3 py-1.5 rounded-lg bg-[var(--surface-3)] hover:bg-[var(--surface-2)] text-[var(--txt-muted)] hover:text-[var(--txt)] border border-[var(--border)] text-xs font-mono font-bold transition-all cursor-pointer" data-name="${name}">
          <i class="fas fa-copy"></i>
        </button>
      </div>
    `).join('');

    container.querySelectorAll('.bn-copy-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const name = (btn as HTMLElement).dataset.name!;
        await navigator.clipboard.writeText(name);
        btn.innerHTML = '<i class="fas fa-check text-emerald-500"></i>';
        setTimeout(() => btn.innerHTML = '<i class="fas fa-copy"></i>', 1500);
      });
    });
  }

  document.getElementById('bn-generate')?.addEventListener('click', generateAndRender);
  document.getElementById('bn-keyword')?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') generateAndRender();
  });

  // Run on mount
  generateAndRender();
</script>
