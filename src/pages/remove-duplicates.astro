---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'remove-duplicates')!;
---

<ToolLayout tool={tool}>
  <div class="rd-wrap">
    <div class="rd-options">
      <label class="rd-check"><input type="checkbox" id="rd-trim" checked /> Trim whitespace from lines</label>
      <label class="rd-check"><input type="checkbox" id="rd-case" /> Case-insensitive comparison</label>
      <label class="rd-check"><input type="checkbox" id="rd-blank" checked /> Remove blank lines</label>
      <label class="rd-check"><input type="checkbox" id="rd-sort" /> Sort lines alphabetically</label>
    </div>
    <div class="rd-grid">
      <div class="rd-col">
        <label class="rd-label">Input <span id="rd-in-count" class="rd-count">0 lines</span></label>
        <textarea id="rd-input" class="rd-textarea" placeholder="Paste your list here, one item per line…" rows="12"></textarea>
        <button class="btn btn-primary" id="rd-process" style="margin-top:10px;">
          <i class="fas fa-filter"></i> Remove Duplicates
        </button>
      </div>
      <div class="rd-col">
        <label class="rd-label">Output <span id="rd-out-count" class="rd-count">0 lines</span></label>
        <textarea id="rd-output" class="rd-textarea rd-output-ta" rows="12" readonly placeholder="Result will appear here…"></textarea>
        <div class="rd-actions">
          <button class="btn btn-ghost" id="rd-copy"><i class="fas fa-copy"></i> Copy</button>
          <button class="btn btn-ghost" id="rd-clear"><i class="fas fa-trash"></i> Clear</button>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>

<style>
  .rd-wrap { display: flex; flex-direction: column; gap: 16px; }
  .rd-options { display: flex; gap: 12px; flex-wrap: wrap; padding: 12px 16px; background: var(--bg-soft); border-radius: var(--radius-sm); border: 1.5px solid var(--border); }
  .rd-check { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--txt); cursor: pointer; }
  .rd-check input { accent-color: var(--brand); width: 15px; height: 15px; }
  .rd-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .rd-col { display: flex; flex-direction: column; }
  .rd-label { font-size: 14px; font-weight: 600; color: var(--txt); display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .rd-count { font-size: 12px; font-weight: 600; color: var(--brand); background: var(--brand-light); padding: 2px 8px; border-radius: 100px; }
  .rd-textarea {
    flex: 1;
    width: 100%;
    padding: 14px;
    font-size: 13.5px;
    font-family: 'Courier New', monospace;
    color: var(--txt);
    background: var(--bg-soft);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    resize: vertical;
    outline: none;
    line-height: 1.7;
    transition: border-color .2s;
  }
  .rd-textarea:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(37,99,235,.1); }
  .rd-output-ta { background: #F0FDF4; border-color: #BBF7D0; }
  .rd-actions { display: flex; gap: 10px; margin-top: 10px; }

  @media (max-width: 640px) { .rd-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const input = document.getElementById('rd-input') as HTMLTextAreaElement;
  const output = document.getElementById('rd-output') as HTMLTextAreaElement;

  function countLines(text: string) {
    if (!text.trim()) return 0;
    return text.split('\n').filter(l => l.trim()).length;
  }

  input?.addEventListener('input', () => {
    document.getElementById('rd-in-count')!.textContent = `${input.value.split('\n').length} lines`;
  });

  document.getElementById('rd-process')?.addEventListener('click', () => {
    const trim = (document.getElementById('rd-trim') as HTMLInputElement).checked;
    const caseInsensitive = (document.getElementById('rd-case') as HTMLInputElement).checked;
    const removeBlank = (document.getElementById('rd-blank') as HTMLInputElement).checked;
    const sort = (document.getElementById('rd-sort') as HTMLInputElement).checked;

    let lines = input.value.split('\n');
    if (trim) lines = lines.map(l => l.trim());
    if (removeBlank) lines = lines.filter(l => l.trim() !== '');

    const seen = new Set<string>();
    lines = lines.filter(l => {
      const key = caseInsensitive ? l.toLowerCase() : l;
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    });

    if (sort) lines.sort((a, b) => a.localeCompare(b));

    output.value = lines.join('\n');
    document.getElementById('rd-out-count')!.textContent = `${lines.length} lines`;
  });

  document.getElementById('rd-copy')?.addEventListener('click', async () => {
    if (!output.value) return;
    await navigator.clipboard.writeText(output.value);
    const btn = document.getElementById('rd-copy')!;
    btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
    setTimeout(() => btn.innerHTML = '<i class="fas fa-copy"></i> Copy', 2000);
  });

  document.getElementById('rd-clear')?.addEventListener('click', () => {
    input.value = '';
    output.value = '';
    document.getElementById('rd-in-count')!.textContent = '0 lines';
    document.getElementById('rd-out-count')!.textContent = '0 lines';
  });
</script>
