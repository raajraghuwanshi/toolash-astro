---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'thumbnail-downloader')!;
---

<ToolLayout tool={tool} customLayout={true}>
  <div class="tool-page-wrap">
    <!-- Hero Header -->
    <div class="tool-hero-box">
      <div class="tool-badge-pill">
        <i class="fab fa-youtube text-[var(--brand)]"></i> YouTube CDN Graphic Ripper &bull; 1280&times;720 MaxRes
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[var(--txt)] tracking-tight">
        YouTube <span class="bg-gradient-to-r from-[var(--brand)] via-emerald-400 to-amber-400 bg-clip-text text-transparent">Thumbnail Downloader</span>
      </h1>
      <p class="text-[var(--txt-muted)] text-sm sm:text-base mt-3 max-w-2xl mx-auto">
        Extract and download full-resolution YouTube video cover art in HD, HQ, and SD formats. Compatible with YouTube shorts, standard videos, and direct video IDs.
      </p>
      <div class="mt-4 flex items-center justify-center gap-2 flex-wrap text-xs text-[var(--txt-dim)]">
        <i class="fas fa-circle-info text-[var(--brand)]"></i>
        <span>Supports: youtu.be/xxx, youtube.com/watch?v=xxx, youtube.com/shorts/xxx, or direct 11-char ID</span>
      </div>
    </div>

    <!-- Interactive Studio Downloader Form -->
    <div class="tool-card-surface p-6 sm:p-8 mb-10 flex flex-col gap-6">
      <!-- Input Searchbar -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 p-2 rounded-2xl tool-inner-panel border border-[var(--border)] focus-within:border-[var(--brand)] transition-all">
        <div class="flex items-center gap-3 flex-1 px-3">
          <i class="fab fa-youtube text-2xl text-[var(--brand)]"></i>
          <input
            type="text"
            id="td-url"
            class="w-full py-2 bg-transparent text-sm sm:text-base text-[var(--txt)] outline-none placeholder:text-[var(--txt-dim)]"
            placeholder="Paste YouTube video URL or 11-char Video ID here…"
          />
        </div>
        <button
          id="td-fetch"
          class="px-6 py-3 rounded-xl font-bold text-sm text-white bg-gradient-to-r from-[var(--brand)] to-teal-600 hover:opacity-95 shadow-lg shadow-emerald-500/20 active:scale-95 transition-all flex items-center justify-center gap-2 flex-shrink-0 cursor-pointer"
        >
          <i class="fas fa-search"></i> Get Thumbnails
        </button>
      </div>

      <!-- Result Card -->
      <div id="td-result" class="flex flex-col gap-6" style="display:none">
        <div id="td-video-info" class="p-4 rounded-2xl tool-inner-panel border border-[var(--border)] flex items-center gap-4"></div>
        <div id="td-thumbnails" class="grid grid-cols-1 sm:grid-cols-2 gap-5"></div>
      </div>
    </div>

    <!-- CDN Resolution Architecture: Comparison Table Archetype -->
    <div class="tool-content-wrap">
      <section class="tool-content-card">
        <!-- Comparison Section Header -->
        <div class="tool-content-header">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-[var(--brand)]/10 border border-[var(--brand)]/20 text-[var(--brand)] font-mono text-xs uppercase tracking-wider mb-4">
            Google CDN Image Resolution &bull; Serving Specifications
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-[var(--txt)] tracking-tight leading-tight mb-4">
            The Architectural Hierarchy of YouTube Thumbnail Resampling &amp; CDN Delivery
          </h2>
          <p class="text-[var(--txt-muted)] text-sm sm:text-base leading-relaxed max-w-3xl font-serif italic">
            When a creator uploads a video cover, YouTube's ingestion cluster generates five distinct raster assets across disparate aspect ratios and resolutions. The comparison tables below detail the pixel geometry, aspect ratio letterboxing rules, and viewport rendering contexts for each CDN endpoint.
          </p>
        </div>

        <!-- Comparison Table 1: YouTube CDN Asset Tier Comparison Matrix -->
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-xl sm:text-2xl font-bold text-[var(--txt)] tracking-tight">
              1. Official YouTube CDN Asset Tier Matrix
            </h3>
            <span class="text-xs font-mono text-[var(--brand)] uppercase font-semibold">Endpoint: img.youtube.com/vi/[id]/</span>
          </div>
          <p class="text-xs sm:text-sm text-[var(--txt-muted)] leading-relaxed">
            The table below contrasts the five static image files cached across Google's edge delivery network for every published YouTube video ID:
          </p>

          <div class="tool-specs-table-wrap">
            <table class="tool-specs-table">
              <thead>
                <tr>
                  <th>CDN Filename</th>
                  <th>Pixel Dimensions</th>
                  <th>Aspect Ratio</th>
                  <th>Generation Criteria</th>
                  <th>Average Weight</th>
                  <th>Letterbox Status</th>
                </tr>
              </thead>
              <tbody class="font-mono">
                <tr>
                  <td class="font-bold text-[var(--brand)]">maxresdefault.jpg</td>
                  <td class="text-[var(--txt)] font-bold">1280 &times; 720 px</td>
                  <td class="text-emerald-400 font-bold">16:9 Widescreen</td>
                  <td class="text-[var(--txt-muted)] font-sans">Requires 720p+ HD video source upload</td>
                  <td class="text-[var(--txt)]">120 &ndash; 240 KB</td>
                  <td class="text-emerald-400 font-bold font-sans">Clean (No bars)</td>
                </tr>
                <tr>
                  <td class="font-bold text-[var(--txt)]">sddefault.jpg</td>
                  <td class="text-[var(--txt)]">640 &times; 480 px</td>
                  <td class="text-amber-400">4:3 Box / Scaled</td>
                  <td class="text-[var(--txt-muted)] font-sans">Standard definition uploads and previews</td>
                  <td class="text-[var(--txt)]">45 &ndash; 85 KB</td>
                  <td class="text-amber-400 font-sans">Padding on 16:9</td>
                </tr>
                <tr>
                  <td class="font-bold text-[var(--txt)]">hqdefault.jpg</td>
                  <td class="text-[var(--txt)]">480 &times; 360 px</td>
                  <td class="text-amber-400">4:3 Boxed</td>
                  <td class="text-[var(--txt-muted)] font-sans">Generated for 100% of all public videos</td>
                  <td class="text-[var(--txt)]">25 &ndash; 50 KB</td>
                  <td class="text-amber-400 font-sans">Hardcoded letterbox bars</td>
                </tr>
                <tr>
                  <td class="font-bold text-[var(--txt)]">mqdefault.jpg</td>
                  <td class="text-[var(--txt)]">320 &times; 180 px</td>
                  <td class="text-emerald-400 font-bold">16:9 Widescreen</td>
                  <td class="text-[var(--txt-muted)] font-sans">Mobile cellular feeds and low-bandwidth UI</td>
                  <td class="text-[var(--txt)]">12 &ndash; 22 KB</td>
                  <td class="text-emerald-400 font-bold font-sans">Clean 16:9 crop</td>
                </tr>
                <tr>
                  <td class="font-bold text-[var(--txt-dim)]">default.jpg</td>
                  <td class="text-[var(--txt-dim)]">120 &times; 90 px</td>
                  <td class="text-amber-400">4:3 Boxed</td>
                  <td class="text-[var(--txt-muted)] font-sans">Legacy search snippets and playlist rails</td>
                  <td class="text-[var(--txt)]">3 &ndash; 6 KB</td>
                  <td class="text-amber-400 font-sans">Hardcoded letterbox bars</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Comparison Table 2: Viewport Rendering Dimensions vs CTR Collision Zones -->
        <div class="space-y-4 pt-6 border-t border-[var(--border)]">
          <h3 class="text-xl sm:text-2xl font-bold text-[var(--txt)] tracking-tight">
            2. Viewport Display Contexts vs. Safe Zone Constraints
          </h3>
          <p class="text-xs sm:text-sm text-[var(--txt-muted)] leading-relaxed">
            A thumbnail is displayed across radically different display scales, from 6.1-inch smartphones to 75-inch 4K living room televisions. Below is the viewport design matrix:
          </p>

          <div class="tool-specs-table-wrap">
            <table class="tool-specs-table">
              <thead>
                <tr>
                  <th>User Context / Interface</th>
                  <th>CSS Display Size</th>
                  <th>Downsampling Ratio</th>
                  <th>Min. Legible Font Size</th>
                  <th>Timestamp Hazard Overlay</th>
                </tr>
              </thead>
              <tbody class="font-mono">
                <tr>
                  <td class="font-bold text-[var(--txt)] font-sans">Mobile App Home Feed</td>
                  <td class="text-[var(--txt)]">375 &times; 211 px</td>
                  <td class="text-[var(--brand)] font-bold">~3.4&times; Downscaled</td>
                  <td class="text-emerald-400 font-bold">&ge; 72pt Heavy Weight</td>
                  <td class="text-rose-400 font-sans font-bold">Bottom-Right 80 &times; 24px badge</td>
                </tr>
                <tr>
                  <td class="font-bold text-[var(--txt)] font-sans">Desktop Sidebar "Up Next"</td>
                  <td class="text-[var(--txt)]">168 &times; 94 px</td>
                  <td class="text-amber-400 font-bold">~7.6&times; Downscaled</td>
                  <td class="text-amber-400 font-bold">&ge; 96pt Ultra Bold</td>
                  <td class="text-rose-400 font-sans font-bold">Covers 20% of right boundary</td>
                </tr>
                <tr>
                  <td class="font-bold text-[var(--txt)] font-sans">Desktop Channel Page Grid</td>
                  <td class="text-[var(--txt)]">210 &times; 118 px</td>
                  <td class="text-[var(--txt-muted)]">~6.0&times; Downscaled</td>
                  <td class="text-[var(--txt)]">&ge; 84pt Sans-Serif</td>
                  <td class="text-rose-400 font-sans">Standard timestamp block</td>
                </tr>
                <tr>
                  <td class="font-bold text-[var(--txt)] font-sans">Smart TV / Android TV App</td>
                  <td class="text-[var(--txt)]">640 &times; 360 px</td>
                  <td class="text-emerald-400 font-bold">~2.0&times; Native HD</td>
                  <td class="text-emerald-400">&ge; 48pt High Contrast</td>
                  <td class="text-[var(--txt-dim)] font-sans">10-Foot UI safe margin</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Hairline Accordion YouTube CDN FAQs -->
      <section class="tool-content-card">
        <div class="tool-content-header">
          <h3 class="text-xl sm:text-2xl font-black text-[var(--txt)] tracking-tight">
            Frequently Asked Thumbnail Architecture FAQs
          </h3>
          <p class="text-xs sm:text-sm text-[var(--txt-muted)] mt-1">
            Resolution mechanics, letterbox padding, legal fair use, and CDN parameters.
          </p>
        </div>

        <div class="tool-faq-accordion">
          <details class="tool-faq-item">
            <summary>
              <span>Why does `maxresdefault.jpg` return an HTTP 404 error on some videos?</span>
              <span class="faq-chevron">&#9660;</span>
            </summary>
            <div class="faq-content">
              YouTube's media transcoding pipeline only instantiates the <code>maxresdefault.jpg</code> (1280 &times; 720) asset if the uploaded video source resolution was 720p, 1080p, or 4K. If the video was uploaded in legacy 480p standard definition or if the creator never uploaded a dedicated custom high-res thumbnail, the server returns an HTTP 404 response. In such instances, <code>hqdefault.jpg</code> or <code>sddefault.jpg</code> represents the highest available resolution.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>Why does `hqdefault.jpg` have black letterbox bars at the top and bottom?</span>
              <span class="faq-chevron">&#9660;</span>
            </summary>
            <div class="faq-content">
              The <code>hqdefault.jpg</code> format has a fixed 4:3 aspect ratio (480 &times; 360 pixels), which dates back to the original 2005 cathode-ray tube (CRT) television web standard. When modern 16:9 widescreen videos are encoded into this 4:3 box, YouTube's rasterizer inserts horizontal black letterbox bars to maintain the aspect ratio without stretching the image. If you need clean widescreen assets without black bars, always download <code>maxresdefault.jpg</code> or <code>mqdefault.jpg</code>.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>Can I legally use downloaded YouTube thumbnails for my own articles or presentations?</span>
              <span class="faq-chevron">&#9660;</span>
            </summary>
            <div class="faq-content">
              Thumbnails are intellectual property protected by copyright law. However, using a thumbnail as editorial visual citation, criticism, news commentary, educational study, or parody qualifies under statutory Fair Use (17 U.S. Code &sect; 107). You cannot re-upload another creator's thumbnail to your own YouTube video or commercial advertising campaign without explicit permission.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>How does YouTube's A/B "Test &amp; Compare" thumbnail feature work with the CDN?</span>
              <span class="faq-chevron">&#9660;</span>
            </summary>
            <div class="faq-content">
              When a creator activates YouTube's multi-thumbnail A/B testing tool, YouTube stores up to three experimental images in its internal asset cluster and serves them dynamically to randomized traffic cohorts. The public static endpoint <code>img.youtube.com/vi/[id]/maxresdefault.jpg</code> always maps to the primary designated master cover until the creator formally declares a test winner in YouTube Studio.
            </div>
          </details>
        </div>
      </section>
    </div>
  </div>
</ToolLayout>

<script>
  function extractId(url: string): string | null {
    url = url.trim();
    if (/^[a-zA-Z0-9_-]{11}$/.test(url)) return url;
    const short = url.match(/youtu\.be\/([a-zA-Z0-9_-]{11})/);
    if (short) return short[1];
    const long = url.match(/[?&]v=([a-zA-Z0-9_-]{11})/);
    if (long) return long[1];
    const shorts = url.match(/shorts\/([a-zA-Z0-9_-]{11})/);
    if (shorts) return shorts[1];
    return null;
  }

  document.getElementById('td-fetch')?.addEventListener('click', () => {
    const urlVal = (document.getElementById('td-url') as HTMLInputElement).value;
    const id = extractId(urlVal);
    if (!id) {
      alert('Could not extract YouTube video ID. Please check the URL.');
      return;
    }

    const qualities = [
      { label: 'Max Resolution (HD)', key: 'maxresdefault', size: '1280 × 720' },
      { label: 'Standard High Def (HQ)', key: 'hqdefault', size: '480 × 360' },
      { label: 'Medium Quality (MQ)', key: 'mqdefault', size: '320 × 180' },
      { label: 'Standard Quality (SD)', key: 'sddefault', size: '640 × 480' }
    ];

    const infoEl = document.getElementById('td-video-info')!;
    infoEl.innerHTML = `
      <img class="w-20 h-14 object-cover rounded-lg border border-[var(--border)]" src="https://img.youtube.com/vi/${id}/default.jpg" alt="Video thumbnail" />
      <div>
        <div class="text-xs font-mono font-bold text-[var(--brand)]">VIDEO ID: ${id}</div>
        <div class="text-xs text-[var(--txt-muted)]">YouTube CDN graphics fetched successfully</div>
      </div>
    `;

    const thumbsEl = document.getElementById('td-thumbnails')!;
    thumbsEl.innerHTML = qualities.map(q => {
      const src = `https://img.youtube.com/vi/${id}/${q.key}.jpg`;
      return `
        <div class="rounded-2xl border border-[var(--border)] overflow-hidden tool-inner-panel flex flex-col justify-between">
          <img src="${src}" class="w-full object-cover bg-[var(--surface-3)]" alt="${q.label}" loading="lazy" />
          <div class="p-3 border-t border-[var(--border)] flex items-center justify-between">
            <div>
              <div class="text-xs font-bold text-[var(--txt)]">${q.label}</div>
              <div class="text-[10px] text-[var(--txt-dim)] font-mono">${q.size}</div>
            </div>
            <a href="${src}" target="_blank" download="youtube_thumbnail_${id}_${q.key}.jpg" class="px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-[var(--brand)] hover:opacity-90 transition-opacity flex items-center gap-1.5 cursor-pointer shadow-sm">
              <i class="fas fa-download"></i> Save
            </a>
          </div>
        </div>
      `;
    }).join('');

    document.getElementById('td-result')!.style.display = 'flex';
  });
</script>
