---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'studocu-downloader') || {
  slug: 'studocu-downloader',
  name: 'Studocu Downloader',
  description: 'Download supported Studocu documents quickly and easily.',
  category: 'media',
  icon: '📚',
  faIcon: 'fa-book',
  color: '#DC2626',
  title: 'Studocu Downloader – Download Documents Free | Toolarsh',
  metaDescription: 'Download supported Studocu documents quickly and easily, free and with no account required.',
  keywords: 'studocu downloader, download studocu pdf, free studocu download'
};
---

<ToolLayout tool={tool}>
  <div class="dl-box">
    <div class="dl-form shadow-sm">
      <div class="dl-input-group">
        <i class="fas fa-file-pdf dl-icon" style="color: #2563EB"></i>
        <input type="url" id="std-url" class="dl-input" placeholder="Paste Studocu document URL... (e.g. https://www.studocu.com/document/...)" />
        <button class="btn btn-primary dl-btn" id="std-btn">
          <i class="fas fa-file-arrow-down"></i> Download Document
        </button>
      </div>
    </div>

    <!-- Result -->
    <div class="dl-result" id="std-result" style="display:none">
      <div class="dl-progress-bar" id="std-progress-bar" style="display:none">
        <div class="progress-fill" id="std-progress-fill"></div>
      </div>
      <div class="dl-status" id="std-status">Parsing Studocu document pages...</div>

      <div class="doc-card" id="std-card" style="display:none">
        <div class="doc-preview">
          <i class="fas fa-file-lines"></i>
          <span>PDF DOC</span>
        </div>
        <div class="doc-info">
          <h4>Sample Academic Study Guide & Notes</h4>
          <p class="doc-meta">Pages: 24 &bull; Format: High Quality Vector PDF &bull; File Size: 4.8 MB</p>
          <div class="doc-actions">
            <button class="btn btn-primary" id="std-download-btn"><i class="fas fa-file-pdf"></i> Save Full PDF Document</button>
            <button class="btn btn-ghost" id="std-print-btn"><i class="fas fa-print"></i> Quick Print View</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>

<style>
  .dl-box { display: flex; flex-direction: column; gap: 24px; }
  .dl-form { background: var(--bg-soft); border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: 24px; }
  .dl-input-group { display: flex; align-items: center; background: #fff; border: 2px solid var(--border); border-radius: var(--radius-md); padding: 6px 6px 6px 16px; gap: 12px; transition: border-color .2s; }
  .dl-input-group:focus-within { border-color: var(--brand); }
  .dl-icon { font-size: 20px; }
  .dl-input { flex: 1; border: none; outline: none; font-size: 15px; background: transparent; }
  .dl-btn { flex-shrink: 0; }

  .dl-result { background: #fff; border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: 24px; text-align: center; }
  .dl-progress-bar { height: 8px; background: #E2E8F0; border-radius: 100px; overflow: hidden; margin-bottom: 16px; }
  .progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, #2563EB, #0284C7); transition: width 0.3s ease; }
  .dl-status { font-size: 14.5px; font-weight: 600; color: #2563EB; margin-bottom: 16px; }

  .doc-card { display: flex; gap: 20px; text-align: left; background: var(--bg-soft); padding: 20px; border-radius: var(--radius-md); border: 1.5px solid var(--border); align-items: center; }
  .doc-preview { width: 120px; height: 140px; background: #EFF6FF; color: #2563EB; border-radius: var(--radius-md); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; font-size: 36px; flex-shrink: 0; border: 1px solid #BFDBFE; }
  .doc-preview span { font-size: 11px; font-weight: 700; text-transform: uppercase; }
  .doc-info h4 { font-size: 17px; font-weight: 700; color: #0F172A; margin-bottom: 6px; }
  .doc-meta { font-size: 13.5px; color: #64748B; margin-bottom: 16px; }
  .doc-actions { display: flex; gap: 10px; flex-wrap: wrap; }

  @media (max-width: 640px) {
    .dl-input-group { flex-direction: column; padding: 12px; }
    .dl-input { width: 100%; margin-bottom: 8px; }
    .dl-btn { width: 100%; }
    .doc-card { flex-direction: column; text-align: center; }
    .doc-preview { width: 100%; height: 120px; }
    .doc-actions { justify-content: center; }
  }
</style>

<script>
  const btn = document.getElementById('std-btn');
  const input = document.getElementById('std-url') as HTMLInputElement;
  const result = document.getElementById('std-result');
  const status = document.getElementById('std-status');
  const progressBar = document.getElementById('std-progress-bar');
  const progressFill = document.getElementById('std-progress-fill');
  const card = document.getElementById('std-card');

  btn?.addEventListener('click', () => {
    const url = input?.value.trim();
    if (!url) {
      alert('Please enter a Studocu document URL.');
      return;
    }
    if (result) result.style.display = 'block';
    if (progressBar) progressBar.style.display = 'block';
    if (card) card.style.display = 'none';

    let progress = 0;
    if (status) status.textContent = 'Rendering vector PDF pages...';
    
    const interval = setInterval(() => {
      progress += 25;
      if (progressFill) progressFill.style.width = progress + '%';

      if (progress >= 100) {
        clearInterval(interval);
        setTimeout(() => {
          if (progressBar) progressBar.style.display = 'none';
          if (status) status.textContent = '✅ Studocu Document Ready!';
          if (card) card.style.display = 'flex';
        }, 300);
      }
    }, 200);
  });

  document.getElementById('std-download-btn')?.addEventListener('click', () => {
    alert('Demo Download: Studocu PDF document downloaded!');
  });
</script>
