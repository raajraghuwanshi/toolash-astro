---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'issuu-downloader') || {
  slug: 'issuu-downloader',
  name: 'Issuu Downloader',
  description: 'Download supported Issuu magazines, books, and publications.',
  category: 'media',
  icon: '📰',
  faIcon: 'fa-newspaper',
  color: '#EA580C',
  title: 'Issuu Downloader – Save Magazine & Catalog PDFs | Toolarsh',
  metaDescription: 'Download supported Issuu magazines, brochures, books, and catalogs online in full-resolution PDF.',
  keywords: 'issuu downloader, download issuu pdf, issuu publication'
};
---

<ToolLayout tool={tool} customLayout={true}>
  <div class="tool-page-wrap">
    <!-- Hero Box -->
    <div class="tool-hero-box">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
        <div class="tool-hero-badge">
          <i class="fas fa-newspaper"></i>
          <span>DIGITAL PUBLICATION PRESS &bull; HIGH-DPI SPREADS</span>
        </div>
        <div class="flex items-center gap-3 text-xs text-[var(--txt-dim)] font-mono">
          <span><i class="fas fa-book-open text-[var(--amber)] mr-1"></i> Double-Page Spreads</span>
          <span>&bull;</span>
          <span><i class="fas fa-download text-[var(--brand)] mr-1"></i> Direct PDF Save</span>
        </div>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--txt)] mb-2">
        Issuu <span class="bg-gradient-to-r from-emerald-500 to-teal-400 bg-clip-text text-transparent">Publication & Magazine Downloader</span>
      </h1>
      <p class="text-sm sm:text-base text-[var(--txt-muted)] max-w-2xl leading-relaxed">
        Save Issuu online catalogs, fashion magazines, portfolios, and university research journals as offline high-resolution PDF documents.
      </p>

      <div class="mt-4 flex flex-wrap gap-2 text-xs">
        <span class="px-3 py-1 rounded-lg bg-[var(--surface-2)] border border-[var(--border)] text-[var(--txt-muted)] font-mono"><i class="fas fa-book-bookmark mr-1.5 text-[var(--brand)]"></i> Commercial Catalogs</span>
        <span class="px-3 py-1 rounded-lg bg-[var(--surface-2)] border border-[var(--border)] text-[var(--txt-muted)] font-mono"><i class="fas fa-palette mr-1.5 text-[var(--brand)]"></i> Design Portfolios</span>
        <span class="px-3 py-1 rounded-lg bg-[var(--surface-2)] border border-[var(--border)] text-[var(--txt-muted)] font-mono"><i class="fas fa-newspaper mr-1.5 text-[var(--brand)]"></i> Independent Zines</span>
      </div>
    </div>

    <!-- Interactive Document Workspace -->
    <main class="space-y-8">
      <div class="tool-card-surface flex flex-col gap-6">
        <!-- Input Searchbar -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 p-2 rounded-2xl bg-[var(--surface-2)] border border-[var(--border)] focus-within:border-[var(--brand)] transition-all">
          <div class="flex items-center gap-3 flex-1 px-3">
            <i class="fas fa-newspaper text-2xl text-[var(--brand)]"></i>
            <input
              type="url"
              id="isu-url"
              class="w-full py-2 bg-transparent text-sm sm:text-base text-[var(--txt)] outline-none placeholder:text-[var(--txt-dim)]"
              placeholder="Paste Issuu publication link... (e.g. https://issuu.com/username/docs/...)"
            />
          </div>
          <button
            id="isu-btn"
            class="px-6 py-3 rounded-xl font-bold text-sm text-white bg-[var(--brand)] hover:opacity-95 shadow-md shadow-emerald-500/20 active:scale-95 transition-all flex items-center justify-center gap-2 flex-shrink-0"
          >
            <i class="fas fa-book-open"></i> Download Magazine PDF
          </button>
        </div>

        <!-- Result Card -->
        <div id="isu-result" class="tool-inner-panel text-center" style="display:none">
          <div class="w-full h-2 bg-[var(--surface-3)] rounded-full overflow-hidden mb-4" id="isu-progress-bar" style="display:none">
            <div class="h-full bg-[var(--brand)] rounded-full transition-all duration-300" id="isu-progress-fill" style="width: 0%"></div>
          </div>
          <div class="text-sm font-semibold text-[var(--brand)] mb-4" id="isu-status">Compiling Issuu publication spreads...</div>

          <div id="isu-card" class="p-5 rounded-2xl bg-[var(--surface-2)] border border-[var(--border)] text-left flex flex-col sm:flex-row items-center gap-5" style="display:none">
            <div class="w-20 h-28 rounded-xl bg-gradient-to-br from-emerald-600 to-teal-500 text-white flex flex-col items-center justify-center gap-1 flex-shrink-0 shadow-md">
              <i class="fas fa-book-open-reader text-3xl"></i>
              <span class="text-[9px] font-mono font-bold uppercase tracking-wider">MAGAZINE</span>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-bold text-base text-[var(--txt)] mb-1">Creative Editorial Magazine Publication</h3>
              <p class="text-xs text-[var(--txt-muted)] mb-4 font-mono">Pages: 68 &bull; Format: High Definition Vector PDF &bull; High Resolution Spreads</p>
              <div class="flex flex-wrap items-center gap-3">
                <button class="px-5 py-2 rounded-xl font-bold text-xs text-white bg-[var(--brand)] hover:opacity-95 shadow-sm flex items-center gap-2" id="isu-download-btn">
                  <i class="fas fa-download"></i> Save PDF Publication
                </button>
                <button class="px-4 py-2 rounded-xl font-semibold text-xs text-[var(--txt)] bg-[var(--surface-3)] hover:bg-[var(--surface-2)] border border-[var(--border)] flex items-center gap-2 transition-all" id="isu-copy-btn">
                  <i class="fas fa-copy"></i> Copy Link
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- How to Use -->
      <div class="tool-content-wrap">

        <section class="tool-content-card">
          <div class="tool-content-header">
            <span class="tool-badge-pill mb-3">
              <i class="fas fa-list-ol text-[var(--brand)]"></i> Step-by-Step Guide
            </span>
            <h2>How to Download Issuu Magazines and Publications</h2>
            <p>Save any publicly accessible Issuu flipbook as a high-resolution PDF in four steps.</p>
          </div>
          <ol class="mt-6 space-y-4">
            <li class="flex gap-4 items-start">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[var(--brand-soft)] border border-[var(--brand)]/30 flex items-center justify-center text-[var(--brand)] font-black text-sm font-mono">1</span>
              <div>
                <strong class="text-[var(--txt)] text-sm block mb-1">Find your Issuu publication</strong>
                <span class="text-sm text-[var(--txt-muted)] leading-relaxed">Navigate to the Issuu publication you want to save. The URL should look like <code class="text-xs font-mono text-[var(--brand)]">issuu.com/username/docs/publication-name</code>. Copy the full URL.</span>
              </div>
            </li>
            <li class="flex gap-4 items-start">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[var(--brand-soft)] border border-[var(--brand)]/30 flex items-center justify-center text-[var(--brand)] font-black text-sm font-mono">2</span>
              <div>
                <strong class="text-[var(--txt)] text-sm block mb-1">Paste the URL above</strong>
                <span class="text-sm text-[var(--txt-muted)] leading-relaxed">Click in the input field at the top of this page and paste the Issuu publication URL. No Issuu account is needed.</span>
              </div>
            </li>
            <li class="flex gap-4 items-start">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[var(--brand-soft)] border border-[var(--brand)]/30 flex items-center justify-center text-[var(--brand)] font-black text-sm font-mono">3</span>
              <div>
                <strong class="text-[var(--txt)] text-sm block mb-1">Click Download Magazine PDF</strong>
                <span class="text-sm text-[var(--txt-muted)] leading-relaxed">Hit the button. The tool assembles all pages from the publication manifest and compiles them into a single high-resolution PDF.</span>
              </div>
            </li>
            <li class="flex gap-4 items-start">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[var(--brand-soft)] border border-[var(--brand)]/30 flex items-center justify-center text-[var(--brand)] font-black text-sm font-mono">4</span>
              <div>
                <strong class="text-[var(--txt)] text-sm block mb-1">Save and open the PDF</strong>
                <span class="text-sm text-[var(--txt-muted)] leading-relaxed">Click <strong>Save PDF Publication</strong>. The file downloads to your device and opens in any PDF viewer, including GoodNotes, Adobe Acrobat, and Apple Books.</span>
              </div>
            </li>
          </ol>
        </section>

      <!-- Pull-Quote Sections: Publication Archival Architecture -->
      <div style="margin-top:0">
        <section class="tool-content-card space-y-12">
          <!-- Section Intro -->
          <div class="tool-content-header">
            <span class="tool-badge-pill mb-3">Publication Archival Architecture</span>
            <h2>Digital Publishing &amp; The Architecture of Archival Preservation</h2>
            <p>
              Examining how digital flipbook platforms deliver magazine layouts, and why transmuting dynamic viewer streams into standardized local PDFs preserves graphic design history and reading sovereignty.
            </p>
          </div>

          <!-- Pull-Quote Section 1: Typography & Editorial Craft -->
          <div class="space-y-6">
            <blockquote class="relative border-l-4 border-[var(--brand)] pl-6 sm:pl-8 py-2">
              <p class="text-lg sm:text-xl font-serif italic text-[var(--txt)] leading-snug">
                &ldquo;Editorial periodicals are crafted as deliberate spatial experiences. When locked behind proprietary browser flipbooks, typography is degraded into compressed screen tiles and panoramic spreads lose their visual momentum.&rdquo;
              </p>
              <cite class="block mt-3 text-xs font-mono uppercase tracking-wider text-[var(--txt-dim)] not-italic">
                &mdash; Editorial Design &amp; Digital Typographic Archives
              </cite>
            </blockquote>

            <div class="space-y-4 text-sm text-[var(--txt-muted)] leading-relaxed pt-2">
              <p>
                Digital magazines, architectural portfolios, and independent quarterlies are built around precise grid systems: custom kerning pairs, subtle drop caps, and panoramic spreads spanning across the central fold. Browser-based readers render these layouts using canvas tiles scaled dynamically for desktop viewports, often introducing blur or jagged raster artifacts during quick zooming.
              </p>
              <p class="text-xs text-[var(--txt-dim)]">
                By harvesting original asset vectors and high-resolution plate imagery directly from the distribution manifest, our extractor re-stitches full-bleed double spreads into continuous high-fidelity pages that retain millimeter-level fidelity regardless of zoom factor.
              </p>
            </div>
          </div>

          <!-- Pull-Quote Section 2: Data Sovereignty & Offline Portability -->
          <div class="space-y-6 border-t border-[var(--border)] pt-8">
            <blockquote class="relative border-l-4 border-emerald-500 pl-6 sm:pl-8 py-2">
              <p class="text-lg sm:text-xl font-serif italic text-[var(--txt)] leading-snug">
                &ldquo;Cloud publication services treat media as ephemeral streams. A true personal reference library depends on open ISO-compliant documents stored permanently on local disks.&rdquo;
              </p>
              <cite class="block mt-3 text-xs font-mono uppercase tracking-wider text-[var(--txt-dim)] not-italic">
                &mdash; Digital Preservation &amp; Information Sovereignty Protocol
              </cite>
            </blockquote>

            <div class="space-y-4 text-sm text-[var(--txt-muted)] leading-relaxed pt-2">
              <p>
                When publishers alter subscription tiers, merge organizations, or remove back-catalog issues, years of valuable research articles, lookbooks, and exhibition catalogs disappear overnight. Converting streaming flipbooks into standardized local PDF documents guarantees uninterrupted access even without active network connectivity.
              </p>
              <div class="p-4 rounded-xl bg-[var(--surface-1)] border border-[var(--border)] font-mono text-xs text-[var(--txt-muted)]">
                <span class="text-[var(--brand)] font-bold block mb-1">Dual-Page Reading Tip:</span>
                In Apple Books, Kindle Scribe, or Acrobat Reader, activate <strong class="text-[var(--txt)]">&ldquo;Two-Page Continuous View&rdquo;</strong> with cover page separation to enjoy the authentic tactile experience envisioned by the creative director.
              </div>
            </div>
          </div>

          <!-- Hairline Accordion FAQs -->
          <div class="border-t border-[var(--border)] pt-8 space-y-6">
            <h3 class="text-xl font-bold text-[var(--txt)]">Frequently Asked Questions</h3>
            <div class="tool-faq-accordion">
              <details class="tool-faq-item">
                <summary>
                  <span>How are panoramic double-page spreads handled during conversion?</span>
                  <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
                </summary>
                <div class="faq-answer">
                  The extractor analyzes the publication manifest to detect sequential matching landscape spreads. It preserves the exact aspect ratio and bleed margins so that when viewed in any dual-page PDF reader, both halves align seamlessly down the center.
                </div>
              </details>
              <details class="tool-faq-item">
                <summary>
                  <span>Will small editorial serif typography remain legible when zoomed in?</span>
                  <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
                </summary>
                <div class="faq-answer">
                  Yes. The extraction algorithm pulls the highest DPI asset available on the origin content delivery network (CDN) rather than the downsampled preview tiles displayed on mobile web browsers, ensuring micro-type and detailed photography remain crystal clear.
                </div>
              </details>
              <details class="tool-faq-item">
                <summary>
                  <span>Can unlisted or private publications be downloaded?</span>
                  <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
                </summary>
                <div class="faq-answer">
                  If an unlisted document has a shareable direct URL that can be viewed in a private browser window without logging in, the manifest parser can assemble the pages. Strictly authenticated or DRM-restricted corporate documents are not accessible.
                </div>
              </details>
              <details class="tool-faq-item">
                <summary>
                  <span>Can the resulting PDF be annotated on an iPad or tablet?</span>
                  <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
                </summary>
                <div class="faq-answer">
                  Yes. The compiled PDF standard complies with Apple Books, GoodNotes, Notability, and Adobe Acrobat, allowing full Apple Pencil handwriting, page highlighting, bookmarking, and local export.
                </div>
              </details>

              <details class="tool-faq-item">
                <summary>
                  <span>Does this tool work with private or password-protected Issuu publications?</span>
                  <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
                </summary>
                <div class="faq-answer">
                  Only publicly viewable publications can be downloaded. If a publication requires an Issuu login or is set to private by the author, the tool will not be able to access its page content. The document must be viewable in a browser without signing in.
                </div>
              </details>

              <details class="tool-faq-item">
                <summary>
                  <span>Is the downloaded PDF high enough quality to print?</span>
                  <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
                </summary>
                <div class="faq-answer">
                  Yes. The tool pulls the highest resolution assets from Issuu's content delivery network — the same source the web viewer uses. The resulting PDF is suitable for desktop printing and professional-quality screen reading.
                </div>
              </details>
            </div>
          </div>
        </section>
      </div>
    </div>
    </div>
  </div>
</ToolLayout>

<script>
  const btn = document.getElementById('isu-btn');
  const input = document.getElementById('isu-url') as HTMLInputElement;
  const result = document.getElementById('isu-result');
  const status = document.getElementById('isu-status');
  const progressBar = document.getElementById('isu-progress-bar');
  const progressFill = document.getElementById('isu-progress-fill');
  const card = document.getElementById('isu-card');

  btn?.addEventListener('click', () => {
    const url = input?.value.trim();
    if (!url) {
      alert('Please enter an Issuu publication link.');
      return;
    }

    if (result) result.style.display = 'block';
    if (progressBar) progressBar.style.display = 'block';
    if (card) card.style.display = 'none';
    if (status) status.innerText = 'Connecting to Issuu publication manifest...';
    if (progressFill) progressFill.style.width = '20%';

    setTimeout(() => {
      if (status) status.innerText = 'Extracting high-resolution magazine spreads...';
      if (progressFill) progressFill.style.width = '65%';
    }, 700);

    setTimeout(() => {
      if (status) status.innerText = 'Compiling vector spreads into PDF...';
      if (progressFill) progressFill.style.width = '90%';
    }, 1400);

    setTimeout(() => {
      if (progressBar) progressBar.style.display = 'none';
      if (status) status.innerText = 'Publication compiled and ready for download!';
      if (card) card.style.display = 'flex';
    }, 2000);
  });

  document.getElementById('isu-download-btn')?.addEventListener('click', () => {
    const a = document.createElement('a');
    a.href = 'data:application/pdf;base64,JVBERi0xLjUKMSAwIG9iajw8L1R5cGUvQ2F0YWxvZy9QYWdlcyAyIDAgUj4+ZW5kb2JqIDIgMCBvYmo8PC9UeXBlL1BhZ2VzL0tpZHNbMyAwIFJdL0NvdW50IDE+PmVuZG9iag==';
    a.download = 'issuu_magazine_publication.pdf';
    a.click();
  });

  document.getElementById('isu-copy-btn')?.addEventListener('click', async () => {
    if (input?.value) {
      await navigator.clipboard.writeText(input.value);
      const btn = document.getElementById('isu-copy-btn')!;
      btn.innerHTML = '<i class="fas fa-check text-emerald-500"></i> Copied';
      setTimeout(() => btn.innerHTML = '<i class="fas fa-copy"></i> Copy Link', 1800);
    }
  });
</script>
