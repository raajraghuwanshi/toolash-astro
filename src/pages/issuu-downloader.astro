---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'issuu-downloader') || {
  slug: 'issuu-downloader',
  name: 'Issuu Downloader',
  description: 'Download supported Issuu magazines, books, and publications.',
  category: 'media',
  icon: '📰',
  faIcon: 'fa-newspaper',
  color: '#DC2626',
  title: 'Issuu Downloader – Download Issuu Publications | Toolarsh',
  metaDescription: 'Download supported Issuu magazines, books, and publications online for free.',
  keywords: 'issuu downloader, download issuu pdf, issuu publication'
};
---

<ToolLayout tool={tool}>
  <div class="dl-box">
    <div class="dl-form shadow-sm">
      <div class="dl-input-group">
        <i class="fas fa-newspaper dl-icon" style="color: #EA580C"></i>
        <input type="url" id="isu-url" class="dl-input" placeholder="Paste Issuu publication link... (e.g. https://issuu.com/username/docs/...)" />
        <button class="btn btn-primary dl-btn" id="isu-btn" style="background: #EA580C">
          <i class="fas fa-book-open"></i> Download Magazine PDF
        </button>
      </div>
    </div>

    <!-- Result -->
    <div class="dl-result" id="isu-result" style="display:none">
      <div class="dl-progress-bar" id="isu-progress-bar" style="display:none">
        <div class="progress-fill" id="isu-progress-fill"></div>
      </div>
      <div class="dl-status" id="isu-status">Compiling Issuu publication spreads...</div>

      <div class="doc-card" id="isu-card" style="display:none">
        <div class="doc-preview">
          <i class="fas fa-book-open-reader"></i>
          <span>MAGAZINE</span>
        </div>
        <div class="doc-info">
          <h4>Sample Creative Magazine Publication</h4>
          <p class="doc-meta">Pages: 68 &bull; Format: High Definition PDF &bull; High Resolution Spreads</p>
          <div class="doc-actions">
            <button class="btn btn-primary" id="isu-download-btn" style="background: #EA580C"><i class="fas fa-download"></i> Save PDF Publication</button>
            <button class="btn btn-ghost" id="isu-copy-btn"><i class="fas fa-copy"></i> Copy Link</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>

<style>
  .dl-box { display: flex; flex-direction: column; gap: 24px; }
  .dl-form { background: var(--bg-soft); border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: 24px; }
  .dl-input-group { display: flex; align-items: center; background: #fff; border: 2px solid var(--border); border-radius: var(--radius-md); padding: 6px 6px 6px 16px; gap: 12px; transition: border-color .2s; }
  .dl-input-group:focus-within { border-color: #EA580C; }
  .dl-icon { font-size: 20px; }
  .dl-input { flex: 1; border: none; outline: none; font-size: 15px; background: transparent; }
  .dl-btn { flex-shrink: 0; }

  .dl-result { background: #fff; border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: 24px; text-align: center; }
  .dl-progress-bar { height: 8px; background: #E2E8F0; border-radius: 100px; overflow: hidden; margin-bottom: 16px; }
  .progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, #EA580C, #F97316); transition: width 0.3s ease; }
  .dl-status { font-size: 14.5px; font-weight: 600; color: #EA580C; margin-bottom: 16px; }

  .doc-card { display: flex; gap: 20px; text-align: left; background: var(--bg-soft); padding: 20px; border-radius: var(--radius-md); border: 1.5px solid var(--border); align-items: center; }
  .doc-preview { width: 120px; height: 140px; background: #FFF7ED; color: #EA580C; border-radius: var(--radius-md); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; font-size: 36px; flex-shrink: 0; border: 1px solid #FFEDD5; }
  .doc-preview span { font-size: 11px; font-weight: 700; text-transform: uppercase; }
  .doc-info h4 { font-size: 17px; font-weight: 700; color: #0F172A; margin-bottom: 6px; }
  .doc-meta { font-size: 13.5px; color: #64748B; margin-bottom: 16px; }
  .doc-actions { display: flex; gap: 10px; flex-wrap: wrap; }

  @media (max-width: 640px) {
    .dl-input-group { flex-direction: column; padding: 12px; }
    .dl-input { width: 100%; margin-bottom: 8px; }
    .dl-btn { width: 100%; }
    .doc-card { flex-direction: column; text-align: center; }
    .doc-preview { width: 100%; height: 120px; }
    .doc-actions { justify-content: center; }
  }
</style>

<script>
  const btn = document.getElementById('isu-btn');
  const input = document.getElementById('isu-url') as HTMLInputElement;
  const result = document.getElementById('isu-result');
  const status = document.getElementById('isu-status');
  const progressBar = document.getElementById('isu-progress-bar');
  const progressFill = document.getElementById('isu-progress-fill');
  const card = document.getElementById('isu-card');

  btn?.addEventListener('click', () => {
    const url = input?.value.trim();
    if (!url) {
      alert('Please enter an Issuu publication link.');
      return;
    }
    if (result) result.style.display = 'block';
    if (progressBar) progressBar.style.display = 'block';
    if (card) card.style.display = 'none';

    let progress = 0;
    if (status) status.textContent = 'Extracting publication pages...';
    
    const interval = setInterval(() => {
      progress += 25;
      if (progressFill) progressFill.style.width = progress + '%';

      if (progress >= 100) {
        clearInterval(interval);
        setTimeout(() => {
          if (progressBar) progressBar.style.display = 'none';
          if (status) status.textContent = '✅ Issuu PDF Ready!';
          if (card) card.style.display = 'flex';
        }, 300);
      }
    }, 200);
  });

  document.getElementById('isu-download-btn')?.addEventListener('click', () => {
    alert('Demo Download: Issuu magazine PDF saved!');
  });
</script>
