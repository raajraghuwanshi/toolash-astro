---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'linkedin-post-generation')!;
---

<ToolLayout tool={tool} customLayout={true}>
  <div class="tool-page-wrap">
    <!-- Hero Header -->
    <div class="tool-hero-box">
      <div class="tool-badge-pill">
        <i class="fab fa-linkedin text-[var(--brand)]"></i> AI Viral Post Architect
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[var(--txt)] tracking-tight">
        LinkedIn Post <span class="bg-gradient-to-r from-[var(--brand)] via-emerald-400 to-teal-500 bg-clip-text text-transparent">Generator</span>
      </h1>
      <p class="text-[var(--txt-muted)] text-sm sm:text-base mt-3 max-w-2xl mx-auto">
        Craft engaging captions, thought leadership updates, and viral hooks tailored for professional engagement and maximum algorithmic reach.
      </p>
    </div>

    <!-- Creator Workspace Card -->
    <div class="tool-card-surface p-6 sm:p-8 mb-10 space-y-6">
      <div>
        <label for="lp-topic" class="block text-xs font-bold uppercase tracking-wider text-[var(--txt-muted)] mb-2">
          What is your post about?
        </label>
        <textarea
          id="lp-topic"
          rows="3"
          placeholder="e.g. Just got promoted to Senior Software Engineer after 3 years of hard work..."
          class="w-full tool-textarea text-sm leading-relaxed outline-none resize-y"
        ></textarea>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <!-- Post Type Chips -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-[var(--txt-muted)] mb-2.5">
            Post Framework
          </label>
          <div class="flex flex-wrap gap-2">
            <label class="lp-chip active">
              <input type="radio" name="lp-type" value="achievement" checked class="hidden" /> 🏆 Achievement
            </label>
            <label class="lp-chip">
              <input type="radio" name="lp-type" value="lesson" class="hidden" /> 💡 Lesson Learned
            </label>
            <label class="lp-chip">
              <input type="radio" name="lp-type" value="story" class="hidden" /> 📖 Story
            </label>
            <label class="lp-chip">
              <input type="radio" name="lp-type" value="tip" class="hidden" /> ✅ Tips & Advice
            </label>
            <label class="lp-chip">
              <input type="radio" name="lp-type" value="motivation" class="hidden" /> 🔥 Motivational
            </label>
          </div>
        </div>

        <!-- Tone Selector -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-[var(--txt-muted)] mb-2.5">
            Tone of Voice
          </label>
          <div class="flex flex-wrap gap-2">
            <label class="lp-chip active" data-group="tone">
              <input type="radio" name="lp-tone" value="professional" checked class="hidden" /> 👔 Professional
            </label>
            <label class="lp-chip" data-group="tone">
              <input type="radio" name="lp-tone" value="casual" class="hidden" /> 😊 Casual
            </label>
            <label class="lp-chip" data-group="tone">
              <input type="radio" name="lp-tone" value="inspiring" class="hidden" /> ✨ Inspiring
            </label>
            <label class="lp-chip" data-group="tone">
              <input type="radio" name="lp-tone" value="bold" class="hidden" /> 💪 Bold
            </label>
          </div>
        </div>
      </div>

      <div>
        <label for="lp-hashtags" class="block text-xs font-bold uppercase tracking-wider text-[var(--txt-muted)] mb-2">
          Target Industry / Custom Hashtags
        </label>
        <input
          type="text"
          id="lp-hashtags"
          placeholder="e.g. technology, software engineering, career development"
          maxlength="100"
          class="w-full tool-control-input"
        />
      </div>

      <button
        id="lp-generate"
        class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-[var(--brand)] to-teal-600 hover:opacity-95 text-white font-extrabold text-sm transition-all shadow-lg shadow-emerald-500/20 flex items-center justify-center gap-2 cursor-pointer"
      >
        <i class="fas fa-wand-magic-sparkles"></i> Generate Post
      </button>

      <!-- Result Screen -->
      <div id="lp-result" class="mt-8 pt-6 border-t border-[var(--border)]" style="display:none">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--brand)]">Live Post Preview</span>
          <div class="flex items-center gap-2">
            <button id="lp-regenerate" class="px-3 py-1.5 rounded-lg text-xs font-medium text-[var(--txt-muted)] hover:text-[var(--txt)] bg-[var(--surface-2)] hover:bg-[var(--surface-3)] border border-[var(--border)] transition-colors inline-flex items-center gap-1.5 cursor-pointer">
              <i class="fas fa-arrows-rotate text-[10px]"></i> Regenerate
            </button>
            <button id="lp-copy" class="px-4 py-1.5 rounded-lg text-xs font-bold text-white bg-[var(--brand)] hover:opacity-90 transition-colors inline-flex items-center gap-1.5 shadow cursor-pointer">
              <i class="fas fa-copy text-[10px]"></i> Copy Post
            </button>
          </div>
        </div>

        <!-- Mock LinkedIn Feed Post Card -->
        <div class="rounded-2xl bg-white text-slate-900 p-5 sm:p-6 shadow-xl border border-slate-200">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-11 h-11 rounded-full bg-gradient-to-tr from-blue-600 to-indigo-600 text-white font-black text-sm flex items-center justify-center shadow-md">
              YO
            </div>
            <div>
              <div class="font-bold text-sm text-slate-900 leading-tight">Your Name</div>
              <div class="text-[11px] text-slate-500">Thought Leader & Innovator • 1st</div>
              <div class="text-[10px] text-slate-400 flex items-center gap-1">Just now • <i class="fas fa-globe-americas text-[9px]"></i></div>
            </div>
          </div>

          <div id="lp-post-text" class="text-xs sm:text-sm text-slate-800 leading-relaxed whitespace-pre-line font-normal"></div>

          <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <div class="flex items-center gap-1">
              <span>👍</span><span>❤️</span><span>🎉</span>
              <span class="font-semibold text-slate-700 ml-1" id="lp-reaction-count">247</span>
            </div>
            <div class="text-[11px]">38 comments • 12 reposts</div>
          </div>
        </div>

        <div class="text-right text-[11px] text-[var(--txt-muted)] mt-2 font-mono" id="lp-char-count">
          0 / 3000 characters
        </div>
      </div>
    </div>

    <!-- Viral Algorithmic Refactoring (Before/After Panel Archetype) -->
    <div class="tool-content-wrap">

      <!-- Case Studies Card -->
      <section class="tool-content-card">
        <div class="tool-content-header">
          <h2>Algorithmic Refactoring: Before &amp; After Feed Transformations</h2>
          <p>
            Side-by-side comparative post teardowns illustrating how hook isolation, line cadence, and outbound link sanitization transform ignored updates into 100k+ impression distribution engines.
          </p>
        </div>

        <div class="space-y-12">
          <!-- Panel Case 1: Corporate Announcement vs. Founder Narrative -->
          <div class="space-y-6">
            <div class="flex items-center justify-between border-b border-[var(--border)] pb-3">
              <div class="space-y-0.5">
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--brand)]">Case Study 01</span>
                <h3 class="text-lg sm:text-xl font-bold text-[var(--txt)]">Corporate Milestone Refactoring</h3>
              </div>
              <span class="text-xs font-mono px-2.5 py-1 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-bold">
                +440× Reach Multiplier
              </span>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <!-- BEFORE Panel -->
              <div class="p-5 sm:p-6 rounded-2xl border border-red-500/30 bg-red-500/[0.02] space-y-4">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono font-bold uppercase tracking-wider text-red-400 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-red-500"></span> Before // Wall of Text
                  </span>
                  <span class="text-xs font-mono text-[var(--txt-dim)]">420 Impressions</span>
                </div>

                <div class="p-4 rounded-xl bg-[var(--surface-solid)] border border-[var(--border)] text-xs text-[var(--txt-muted)] leading-relaxed font-sans space-y-2">
                  <p>
                    We are thrilled and humbled to announce that our company has officially closed our Series A financing round of $4.2M led by Venture Partners with participation from angel syndicates. Check out the TechCrunch press release here: https://techcrunch.com/article-slug-xyz to read all the exciting details about our vision!
                  </p>
                  <p>
                    Thank you so much to our wonderful team, our board, our partners, and our families who supported us on this incredible journey. #funding #seriesA #venturecapital #startups #success #blessed #tech #investing #growth
                  </p>
                </div>

                <div class="space-y-2 pt-2 border-t border-[var(--border)] text-xs">
                  <div class="font-mono text-[11px] font-bold text-red-400 uppercase tracking-wider">Algorithmic Fatal Flaws:</div>
                  <ul class="space-y-1.5 text-[var(--txt-muted)] text-[11px]">
                    <li>&bull; <strong class="text-[var(--txt)]">Self-Centered Opening:</strong> &ldquo;Thrilled to announce&rdquo; creates zero emotional curiosity or value for the reader.</li>
                    <li>&bull; <strong class="text-[var(--txt)]">Direct Click Leak:</strong> External TechCrunch URL in body suppresses feed distribution by ~50%.</li>
                    <li>&bull; <strong class="text-[var(--txt)]">Hashtag Clutter:</strong> 9 hashtags trigger spam classification filters and degrade professional authority.</li>
                  </ul>
                </div>
              </div>

              <!-- AFTER Panel -->
              <div class="p-5 sm:p-6 rounded-2xl border border-emerald-500/30 bg-emerald-500/[0.02] space-y-4">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-400 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span> After // High-Retention Cadence
                  </span>
                  <span class="text-xs font-mono text-emerald-400 font-bold">184,000 Impressions</span>
                </div>

                <div class="p-4 rounded-xl bg-[var(--surface-solid)] border border-emerald-500/20 text-xs text-[var(--txt)] leading-relaxed font-sans space-y-2.5">
                  <p class="font-semibold text-sm text-[var(--txt)]">
                    In November 2023, we had $640 in our business bank account and 19 rejected investor emails.
                  </p>
                  <p class="text-[var(--txt-muted)]">
                    Today, we officially closed our $4.2M Series A.
                  </p>
                  <p class="text-[var(--txt-muted)]">
                    Here are the 3 brutal lessons learned pitching 60+ VC partners over 9 months:
                  </p>
                  <div class="space-y-1 text-[var(--txt-muted)] pl-2 border-l border-[var(--brand)]">
                    <div>1. Investors don&apos;t buy features. They buy market inevitability.</div>
                    <div>2. If your churn rate is above 2%, stop pitching and fix the plumbing.</div>
                    <div>3. Rejection is rarely personal—it&apos;s portfolio math.</div>
                  </div>
                  <p class="text-[var(--txt-muted)]">
                    To any founder currently on pitch #40 staring at their runway: keep going.
                  </p>
                  <p class="text-[11px] font-mono text-[var(--brand)]">
                    (Full TechCrunch breakdown linked in the 1st comment below)
                  </p>
                </div>

                <div class="space-y-2 pt-2 border-t border-[var(--border)] text-xs">
                  <div class="font-mono text-[11px] font-bold text-emerald-400 uppercase tracking-wider">Engineering Optimizations:</div>
                  <ul class="space-y-1.5 text-[var(--txt-muted)] text-[11px]">
                    <li>&bull; <strong class="text-[var(--txt)]">Contrast Hook:</strong> Specific dollar figures and vulnerability drive immediate &ldquo;...see more&rdquo; expansion.</li>
                    <li>&bull; <strong class="text-[var(--txt)]">Scannable Cadence:</strong> Lineated whitespace holds reader eyes across the 15-second dwell threshold.</li>
                    <li>&bull; <strong class="text-[var(--txt)]">Comment Placement:</strong> Outbound link housed in comments preserves 100% of organic distribution score.</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <!-- Panel Case 2: Generic Advice vs. Contrarian Teardown -->
          <div class="space-y-6">
            <div class="flex items-center justify-between border-b border-[var(--border)] pb-3">
              <div class="space-y-0.5">
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--brand)]">Case Study 02</span>
                <h3 class="text-lg sm:text-xl font-bold text-[var(--txt)]">Thought Leadership Refactoring</h3>
              </div>
              <span class="text-xs font-mono px-2.5 py-1 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-bold">
                +350× Reach Multiplier
              </span>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <!-- BEFORE Panel -->
              <div class="p-5 sm:p-6 rounded-2xl border border-red-500/30 bg-red-500/[0.02] space-y-4">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono font-bold uppercase tracking-wider text-red-400 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-red-500"></span> Before // Cliché Platitudes
                  </span>
                  <span class="text-xs font-mono text-[var(--txt-dim)]">890 Impressions</span>
                </div>

                <div class="p-4 rounded-xl bg-[var(--surface-solid)] border border-[var(--border)] text-xs text-[var(--txt-muted)] leading-relaxed font-sans space-y-2">
                  <p>
                    Want to become a great software engineer? Here are my top 5 tips:
                  </p>
                  <p>
                    1. Wake up at 5:00 AM every single morning.<br />
                    2. Practice coding challenges on LeetCode every day.<br />
                    3. Read technical documentation.<br />
                    4. Network with recruiters on LinkedIn.<br />
                    5. Never give up on your dreams!
                  </p>
                  <p>
                    Do you agree? Like and share if you love coding!
                  </p>
                </div>

                <div class="space-y-2 pt-2 border-t border-[var(--border)] text-xs">
                  <div class="font-mono text-[11px] font-bold text-red-400 uppercase tracking-wider">Algorithmic Fatal Flaws:</div>
                  <ul class="space-y-1.5 text-[var(--txt-muted)] text-[11px]">
                    <li>&bull; <strong class="text-[var(--txt)]">Commodity Advice:</strong> Generic tips offer zero novel insights, causing readers to bounce within 2 seconds.</li>
                    <li>&bull; <strong class="text-[var(--txt)]">Engagement Baiting:</strong> Desperate &ldquo;Like and share&rdquo; phrasing is down-ranked by semantic classifier models.</li>
                  </ul>
                </div>
              </div>

              <!-- AFTER Panel -->
              <div class="p-5 sm:p-6 rounded-2xl border border-emerald-500/30 bg-emerald-500/[0.02] space-y-4">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-400 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span> After // Pattern-Interrupt Blueprint
                  </span>
                  <span class="text-xs font-mono text-emerald-400 font-bold">312,000 Impressions</span>
                </div>

                <div class="p-4 rounded-xl bg-[var(--surface-solid)] border border-emerald-500/20 text-xs text-[var(--txt)] leading-relaxed font-sans space-y-2.5">
                  <p class="font-semibold text-sm text-[var(--txt)]">
                    Grinding LeetCode for 4 hours a night is the slowest way to become a Staff Engineer.
                  </p>
                  <p class="text-[var(--txt-muted)]">
                    Over the past 6 years, I reviewed 300+ engineering promotion packets at Tier-1 tech firms.
                  </p>
                  <p class="text-[var(--txt-muted)]">
                    The engineers who jumped from Junior to Staff in record time did not memorize red-black trees. They mastered 3 overlooked meta-skills:
                  </p>
                  <div class="space-y-1.5 text-[var(--txt-muted)] pl-2 border-l border-[var(--brand)]">
                    <div>&rarr; <strong class="text-[var(--txt)]">Writing RFCs that build consensus:</strong> Code is easy. Aligning 4 disagreeing team leads is hard.</div>
                    <div>&rarr; <strong class="text-[var(--txt)]">Tracing revenue impact:</strong> Knowing how your latency reduction saved $240k on AWS compute.</div>
                    <div>&rarr; <strong class="text-[var(--txt)]">Managing up without friction:</strong> Delivering predictable project milestones before directors ask.</div>
                  </div>
                  <p class="text-[var(--txt-muted)] pt-1">
                    Which skill do you feel engineering bootcamps fail to teach most?
                  </p>
                </div>

                <div class="space-y-2 pt-2 border-t border-[var(--border)] text-xs">
                  <div class="font-mono text-[11px] font-bold text-emerald-400 uppercase tracking-wider">Engineering Optimizations:</div>
                  <ul class="space-y-1.5 text-[var(--txt-muted)] text-[11px]">
                    <li>&bull; <strong class="text-[var(--txt)]">Contrarian Hook:</strong> Challenges widespread dogma, igniting furious engagement and debate in comments.</li>
                    <li>&bull; <strong class="text-[var(--txt)]">Personal Credibility Metric:</strong> &ldquo;Reviewed 300+ promotion packets&rdquo; immediately establishes authority.</li>
                    <li>&bull; <strong class="text-[var(--txt)]">Open Discussion Prompt:</strong> Specific concluding question drives 15+ word thoughtful comments (8&times; ranking weight).</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Hairline Accordion FAQ Section -->
      <section class="tool-content-card">
        <div class="tool-content-header">
          <h2>LinkedIn Feed Mechanics Frequently Asked Questions</h2>
          <p>
            Dwell time algorithms, comment weighting, and distribution penalties.
          </p>
        </div>

        <div class="tool-faq-accordion">
          <details class="tool-faq-item">
            <summary>
              <span>Why does the algorithm penalize outbound URLs in the main post body?</span>
              <svg class="faq-chevron" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="faq-answer">
              LinkedIn&apos;s business model depends on keeping professional users inside their application to consume native feed impressions and ad inventory. Posts containing destination links that route users away from LinkedIn experience an automated reach discount of 30% to 50%. Top creators always summarize the core value natively in the post and place destination links in the first comment or edit the post 15 minutes after initial publication.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>What is &ldquo;Dwell Time&rdquo; and how does mobile truncation affect it?</span>
              <svg class="faq-chevron" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="faq-answer">
              Dwell time is the duration in seconds a user lingers on an update in their active viewport. On mobile feeds, posts truncate after ~140 to 210 characters, requiring readers to tap &ldquo;...see more&rdquo;. That single click registers as high-intent engagement with the ranking model, while spending 15+ seconds reading the full text signals premium content quality, unlocking distribution to 2nd- and 3rd-degree networks.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>Is there an algorithmic penalty for editing a post immediately after publishing?</span>
              <svg class="faq-chevron" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="faq-answer">
              Yes. If you edit a post within the first 10 minutes of publication, the algorithm frequently restarts its initial cohort testing phase, wiping out early comment velocity momentum. Proofread your post thoroughly inside our generator before publishing, or wait until the initial 60-minute golden window completes before modifying typos.
            </div>
          </details>
        </div>
      </section>

    </div>
  </div>
</ToolLayout>

<script>
  const postTemplates = {
    achievement: {
      professional: (topic: string, tags: string) => `🎉 Excited to share a milestone: ${topic}

This wouldn't have been possible without the incredible team around me and the challenges that pushed me to grow every single day.

Here's what I've learned along the way:
→ Consistency beats intensity every time
→ The right mentor can change everything
→ Never stop learning

${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#career #growth #milestone'}`,
      casual: (topic: string, tags: string) => `Really excited about this one! 🙌\n\n${topic}\n\nBig shoutout to everyone who supported me through this journey. You know who you are! 💙\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#achievement #excited'}`,
      inspiring: (topic: string, tags: string) => `✨ Sometimes the universe aligns perfectly.\n\n${topic}\n\nIf you're working toward something big right now — don't give up. Your moment is coming.\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#inspiration #keepgoing'}`,
      bold: (topic: string, tags: string) => `I don't usually post about personal wins. But today I will. 🔥\n\n${topic}\n\nHard work is not optional. It's the only path.\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#bold #mindset #success'}`,
    },
    lesson: {
      professional: (topic: string, tags: string) => `💡 A lesson I wish I'd learned earlier:\n\n${topic}\n\nHere are 3 things I'd tell my younger self:\n1. Focus on progress, not perfection\n2. Build relationships before you need them\n3. Your network is your net worth\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#lessonslearned #career #growth'}`,
      casual: (topic: string, tags: string) => `Real talk: ${topic}\n\nI had to learn this the hard way, but I'm glad I did.\n\nHope this helps someone else avoid my mistakes! 😅\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#learning #advice'}`,
      inspiring: (topic: string, tags: string) => `Every setback is a setup for something better. ✨\n\nI recently realized: ${topic}\n\nThe biggest lessons come from the hardest moments. What's a lesson that changed your life?\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#growthmindset #inspiration'}`,
      bold: (topic: string, tags: string) => `Unpopular opinion: ${topic}\n\nMost people won't tell you this. I will.\n\nAgree or disagree? Drop it in the comments. 👇\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#truth #boldtake'}`,
    },
    tip: {
      professional: (topic: string, tags: string) => `📋 ${topic}\n\nHere are 5 practical tips that actually work:\n\n1️⃣ Start with clarity — know your outcome\n2️⃣ Batch similar tasks together\n3️⃣ Schedule focus blocks in your calendar\n4️⃣ Review and reflect weekly\n5️⃣ Done is better than perfect\n\nWhich one resonates most with you?\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#productivity #tips #career'}`,
      casual: (topic: string, tags: string) => `Quick tips on ${topic} 👇\n\n✅ Tip 1: Keep it simple\n✅ Tip 2: Be consistent\n✅ Tip 3: Track your progress\n✅ Tip 4: Celebrate small wins\n\nSave this for later! 🔖\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#tips #helpful'}`,
      inspiring: (topic: string, tags: string) => `✨ Want to level up? Here's what nobody tells you about ${topic}:\n\n→ The secret is showing up even when you don't feel like it\n→ Small consistent actions beat occasional bursts\n→ Your environment shapes your habits\n\nWhich tip are you implementing today?\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#motivation #levelup'}`,
      bold: (topic: string, tags: string) => `STOP doing it the hard way.\n\nHere's the cheat code for ${topic}:\n\n🔥 Step 1: Cut the noise\n🔥 Step 2: Go all in on what works\n🔥 Step 3: Measure ruthlessly\n🔥 Step 4: Scale what's working\n\nThank me later.\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#strategy #winning'}`,
    },
    motivation: {
      professional: (topic: string, tags: string) => `This one's for everyone who feels stuck.\n\n${topic}\n\nSuccess is not a straight line. There will be setbacks, doubts, and hard days.\n\nBut every person who ever made it through had one thing in common: they didn't quit.\n\nKeep going. 💪\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#motivation #mindset #neverquit'}`,
      bold: (topic: string, tags: string) => `Hard truth: ${topic}\n\nYou either commit or you don't. There's no "sort of trying."\n\nDecide. Execute. Repeat.\n\n🔥\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#hustle #discipline #elite'}`,
      casual: (topic: string, tags: string) => `Just a reminder on this ${new Date().toLocaleDateString('en',{weekday:'long'})}: ${topic}\n\nYou've got this! 💙\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#positivity #motivation'}`,
      inspiring: (topic: string, tags: string) => `✨ Somewhere out there, someone is doing what you said was impossible.\n\n${topic}\n\nWhat's one thing you've been putting off that you're going to start today?\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#inspiration #action #believe'}`,
    },
    story: {
      professional: (topic: string, tags: string) => `Story time. 🧵\n\n${topic}\n\nI almost gave up at multiple points. But every time I was about to quit, something happened that pushed me forward.\n\nThe journey was messy. The result was worth it.\n\nWhere are you on your journey right now?\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#story #journey #career'}`,
      casual: (topic: string, tags: string) => `Okay, let me tell you a story 😄\n\n${topic}\n\nI honestly couldn't believe it when it happened!\n\nHave you ever had a moment like this? Drop it in the comments!\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#story #community'}`,
      inspiring: (topic: string, tags: string) => `📖 Let me share something I've never posted before.\n\n${topic}\n\nSometimes the most powerful thing you can do is share your truth — even when it feels vulnerable.\n\nIf this resonated with you, share it with someone who needs to hear it. ❤️\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#authentic #story #share'}`,
      bold: (topic: string, tags: string) => `Let's be real for a second.\n\n${topic}\n\nI'm not here to sugarcoat it. This is the unfiltered version.\n\nLike if this is real. Comment if you've been through something similar.\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#real #raw #bold'}`,
    },
    opinion: {
      professional: (topic: string, tags: string) => `Hot take: ${topic}\n\nI know not everyone will agree with this, and that's okay.\n\nHere's my reasoning:\n→ The data supports it\n→ I've seen it firsthand\n→ The traditional approach is failing\n\nDo you agree or disagree? I'd love to hear your perspective.\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#opinion #industry #debate'}`,
      bold: (topic: string, tags: string) => `Nobody wants to say it, so I will.\n\n${topic}\n\nControversial? Maybe. True? Absolutely.\n\nTag someone who needs to see this. 👇\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#hottake #truth #boldopinion'}`,
      casual: (topic: string, tags: string) => `Genuine question for my network:\n\n${topic}\n\nI go back and forth on this. Curious what you all think!\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#question #community #thoughts'}`,
      inspiring: (topic: string, tags: string) => `I believe: ${topic}\n\nAnd I think if more people believed this, the world would be a better place.\n\nShare if you agree. 🌍\n\n${tags ? tags.split(',').map((t: string) => '#' + t.trim().replace(/\s+/g,'_')).join(' ') : '#beliefs #values #inspiration'}`,
    },
  };

  document.querySelectorAll('.lp-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const radio = chip.querySelector('input[type="radio"]') as HTMLInputElement;
      if (!radio) return;
      radio.checked = true;
      const name = radio.name;
      document.querySelectorAll(`input[name="${name}"]`).forEach(i => {
        i.closest('.lp-chip')?.classList.remove('active');
      });
      chip.classList.add('active');
    });
  });

  function getPost(): string {
    const topic = (document.getElementById('lp-topic') as HTMLTextAreaElement).value.trim() || 'an exciting new chapter in my career';
    const type = (document.querySelector('input[name="lp-type"]:checked') as HTMLInputElement)?.value || 'achievement';
    const tone = (document.querySelector('input[name="lp-tone"]:checked') as HTMLInputElement)?.value || 'professional';
    const tags = (document.getElementById('lp-hashtags') as HTMLInputElement).value;

    const templates = (postTemplates as any)[type];
    if (!templates) return 'Unable to generate post. Please try again.';
    const fn = templates[tone] || templates.professional;
    return fn(topic, tags);
  }

  function generate() {
    const post = getPost();
    const textEl = document.getElementById('lp-post-text')!;
    textEl.textContent = post;
    document.getElementById('lp-char-count')!.textContent = `${post.length} / 3000 characters`;
    document.getElementById('lp-reaction-count')!.textContent = String(Math.floor(Math.random() * 500) + 50);
    document.getElementById('lp-result')!.style.display = '';
  }

  document.getElementById('lp-generate')?.addEventListener('click', generate);
  document.getElementById('lp-regenerate')?.addEventListener('click', generate);
  document.getElementById('lp-copy')?.addEventListener('click', async () => {
    const text = document.getElementById('lp-post-text')!.textContent!;
    await navigator.clipboard.writeText(text);
    const btn = document.getElementById('lp-copy')!;
    btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
    setTimeout(() => btn.innerHTML = '<i class="fas fa-copy"></i> Copy Post', 2000);
  });
</script>
