---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'emi-calculator')!;
---

<ToolLayout tool={tool} customLayout={true}>
  <div class="tool-page-wrap">
    <!-- Toolarsh Loan Amortization Hero -->
    <div class="tool-hero-box">
      <div class="inline-flex items-center gap-2 tool-badge-pill mb-3">
        <i class="fas fa-hand-holding-dollar text-[var(--brand)]"></i> Reducing Balance Amortization Engine
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-[var(--txt)]">
        EMI & Loan <span class="bg-gradient-to-r from-[var(--brand)] to-[var(--brand-dark)] bg-clip-text text-transparent">Calculator</span>
      </h1>
      <p class="text-sm sm:text-base mt-2 max-w-2xl text-[var(--txt-muted)] leading-relaxed">
        Accurately simulate monthly equated installments, total interest liabilities, and principal equity schedules for home mortgages, vehicle financing, and personal credit.
      </p>
    </div>

    <!-- Main 2-Column Split Financial Deck -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-10">
      <!-- Left Column: Sliders & Form Inputs (7 cols) -->
      <div class="lg:col-span-7 tool-card-surface space-y-6">
        <div class="flex items-center justify-between border-b border-[var(--border)] pb-4">
          <h2 class="text-sm font-bold text-[var(--txt)] uppercase tracking-wider flex items-center gap-2">
            <i class="fas fa-sliders text-[var(--brand)]"></i> Loan Terms & Configuration
          </h2>
          <span class="text-xs font-mono text-[var(--brand)] bg-[var(--brand)]/10 px-2.5 py-1 rounded-lg border border-[var(--brand)]/20 font-bold">Inputs</span>
        </div>

        <!-- Principal Loan Amount -->
        <div class="space-y-2">
          <div class="flex justify-between items-center">
            <label for="emi-principal" class="text-xs font-bold text-[var(--txt-muted)] uppercase tracking-wider">
              Principal Loan Amount (₹)
            </label>
            <span class="text-xs font-mono text-[var(--brand)] font-bold" id="emi-principal-display">₹5,00,000</span>
          </div>
          <div class="flex items-center tool-inner-panel p-2.5 focus-within:border-[var(--brand)] transition-all">
            <span class="text-sm font-mono text-[var(--txt-dim)] pl-2">₹</span>
            <input type="number" id="emi-principal" value="500000" min="10000" max="100000000" step="5000" class="flex-1 bg-transparent text-[var(--txt)] font-mono text-lg font-bold outline-none px-2" />
          </div>
        </div>

        <!-- Annual Interest Rate -->
        <div class="space-y-2">
          <div class="flex justify-between items-center">
            <label for="emi-rate" class="text-xs font-bold text-[var(--txt-muted)] uppercase tracking-wider">
              Annual Interest Rate (%)
            </label>
            <span class="text-xs font-mono text-[var(--brand)] font-bold" id="emi-rate-display">8.50%</span>
          </div>
          <div class="flex items-center tool-inner-panel p-2.5 focus-within:border-[var(--brand)] transition-all">
            <input type="number" id="emi-rate" value="8.5" min="1" max="30" step="0.05" class="flex-1 bg-transparent text-[var(--txt)] font-mono text-lg font-bold outline-none px-2" />
            <span class="text-xs font-mono font-bold text-[var(--brand)] px-3 py-1 rounded-lg bg-[var(--brand)]/10 border border-[var(--brand)]/20">% p.a.</span>
          </div>
        </div>

        <!-- Loan Tenure in Months -->
        <div class="space-y-2">
          <div class="flex justify-between items-center">
            <label for="emi-tenure" class="text-xs font-bold text-[var(--txt-muted)] uppercase tracking-wider">
              Tenure Duration (Months)
            </label>
            <span class="text-xs font-mono text-[var(--brand)] font-bold" id="emi-tenure-display">60 Months (5 Years)</span>
          </div>
          <div class="flex items-center tool-inner-panel p-2.5 focus-within:border-[var(--brand)] transition-all">
            <input type="number" id="emi-tenure" value="60" min="3" max="360" step="1" class="flex-1 bg-transparent text-[var(--txt)] font-mono text-lg font-bold outline-none px-2" />
            <span class="text-xs font-mono font-bold text-[var(--brand)] px-3 py-1 rounded-lg bg-[var(--brand)]/10 border border-[var(--brand)]/20">Months</span>
          </div>
        </div>

        <button id="emi-calc" class="w-full py-4 rounded-xl bg-[var(--brand)] text-white font-extrabold text-sm uppercase tracking-wider shadow-lg shadow-[var(--brand)]/25 hover:opacity-90 active:scale-[0.99] transition-all flex items-center justify-center gap-2 cursor-pointer">
          <i class="fas fa-calculator"></i> Calculate Monthly Installment
        </button>
      </div>

      <!-- Right Column: Visual Result HUD & Donut Breakdown (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        <div id="emi-result" class="tool-card-surface space-y-6">
          <div class="text-center p-6 rounded-2xl bg-[var(--surface-2)] border border-[var(--border)]">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--brand)] block mb-1">
              Equated Monthly Installment
            </span>
            <div id="emi-monthly" class="text-4xl sm:text-5xl font-black font-mono text-[var(--brand)] tracking-tight">
              ₹10,258
            </div>
            <span class="text-[11px] font-mono text-[var(--txt-muted)] mt-2 block">Fixed Monthly Outflow</span>
          </div>

          <!-- 4 Metrics Breakdown Grid -->
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 rounded-xl tool-inner-panel">
              <span class="text-[10px] font-mono text-[var(--txt-muted)] uppercase block mb-1">Principal Borrowed</span>
              <span id="emi-principal-out" class="text-base font-black font-mono text-[var(--txt)]">₹5,00,000</span>
            </div>
            <div class="p-4 rounded-xl tool-inner-panel">
              <span class="text-[10px] font-mono text-[var(--txt-muted)] uppercase block mb-1">Total Interest Owed</span>
              <span id="emi-interest-out" class="text-base font-black font-mono text-[var(--amber)]">₹1,15,480</span>
            </div>
            <div class="p-4 rounded-xl tool-inner-panel">
              <span class="text-[10px] font-mono text-[var(--txt-muted)] uppercase block mb-1">Total Bank Payment</span>
              <span id="emi-total-out" class="text-base font-black font-mono text-[var(--brand)]">₹6,15,480</span>
            </div>
            <div class="p-4 rounded-xl tool-inner-panel">
              <span class="text-[10px] font-mono text-[var(--txt-muted)] uppercase block mb-1">Annual APR</span>
              <span id="emi-rate-out" class="text-base font-black font-mono text-[var(--txt)]">8.5%</span>
            </div>
          </div>

          <!-- SVG Donut Chart for Equity vs Interest -->
          <div class="flex items-center justify-around pt-2">
            <svg viewBox="0 0 200 200" class="w-32 h-32">
              <circle cx="100" cy="100" r="70" fill="none" stroke="var(--surface-3)" stroke-width="26" />
              <circle cx="100" cy="100" r="70" fill="none" stroke="var(--brand)" stroke-width="26" stroke-dasharray="439.8" stroke-dashoffset="0" id="donut-principal" class="origin-center -rotate-90 transition-all duration-700" />
              <circle cx="100" cy="100" r="70" fill="none" stroke="var(--amber)" stroke-width="26" stroke-dasharray="439.8" stroke-dashoffset="0" id="donut-interest" class="origin-center -rotate-90 transition-all duration-700" />
            </svg>
            <div class="space-y-2 text-xs font-mono">
              <div class="flex items-center gap-2 text-[var(--txt)]">
                <span class="w-3 h-3 rounded-full bg-[var(--brand)]"></span>
                <span>Principal Amount</span>
              </div>
              <div class="flex items-center gap-2 text-[var(--txt)]">
                <span class="w-3 h-3 rounded-full bg-[var(--amber)]"></span>
                <span>Interest Burden</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Financial Mechanics & Amortization Strategy (Pull-Quote Sections Archetype) -->
    <div class="tool-content-wrap">
      <section class="tool-content-card">
        <!-- Section Title -->
        <div class="tool-content-header">
          <h2>The Mathematics of Debt: Reducing Balance Mechanics &amp; Compounding Dynamics</h2>
          <p>
            Behind every fixed monthly installment lies a dynamic financial curve. Understanding how bank amortization schedules allocate cash flow empowers borrowers to minimize cumulative interest liabilities.
          </p>
        </div>

      <!-- Pull-Quote Block 1: Front-Loaded Amortization Trap -->
      <section class="space-y-6">
        <blockquote class="border-y border-[var(--border)] py-8 px-2 sm:px-6 my-4">
          <p class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-[var(--txt)] tracking-tight leading-snug font-serif italic">
            &ldquo;In the first 36 months of a standard 20-year mortgage, upwards of 70% of every installment you transfer to the lender is consumed by interest liability. You are servicing the cost of capital before accumulating a single brick of equity.&rdquo;
          </p>
          <cite class="block mt-4 text-xs font-mono font-bold uppercase tracking-widest text-[var(--brand)] not-italic">
            &mdash; Principles of Reducing Balance Amortization Schedules
          </cite>
        </blockquote>

        <div class="max-w-3xl space-y-4 text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
          <p>
            The equated monthly installment formula, <code class="text-xs font-mono text-[var(--txt)] bg-[var(--surface-2)] px-1.5 py-0.5 rounded">E = P &times; r &times; (1 + r)&supn; &divide; ((1 + r)&supn; - 1)</code>, is mathematically designed to hold monthly cash outflows perfectly constant across the entire loan duration. However, the internal distribution between principal repayment and interest expense undergoes a dramatic inversion.
          </p>
          <p>
            Because interest is computed every 30 days against the remaining unpaid principal, the lender collects the lion&apos;s share of interest upfront when the debt balance is at its highest. A borrower who sells or refinances a property after 4 years often discovers they have barely reduced 10% of their actual loan principal, despite making 48 consecutive on-time monthly transfers.
          </p>
        </div>
      </section>

      <!-- Pull-Quote Block 2: The Prepayment Velocity Asymmetry -->
      <section class="space-y-6">
        <blockquote class="border-y border-[var(--border)] py-8 px-2 sm:px-6 my-4">
          <p class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-[var(--txt)] tracking-tight leading-snug font-serif italic">
            &ldquo;A single extra monthly installment deposited directly against the principal balance in Year 2 carries the compound financial impact of four installments paid in Year 16. Time is the compounder&apos;s greatest leverage or most aggressive predator.&rdquo;
          </p>
          <cite class="block mt-4 text-xs font-mono font-bold uppercase tracking-widest text-amber-500 dark:text-amber-400 not-italic">
            &mdash; Quantitative Capital Allocation &amp; Mortgage Acceleration
          </cite>
        </blockquote>

        <div class="max-w-3xl space-y-4 text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
          <p>
            Prepayments made during the early stages of an amortization schedule bypass future compounding entirely. When you instruct your bank to credit surplus capital directly toward principal reduction, the bank recalculates the remaining interest pool across all subsequent months.
          </p>
          <p>
            By adopting a simple &ldquo;13th month payment strategy&rdquo;&mdash;paying just one supplementary EMI per calendar year, or systematically increasing your monthly payment by 5% annually to match salary increments&mdash;borrowers routinely extinguish a 20-year home loan in 14.5 years, conserving hundreds of thousands in cumulative interest outflows.
          </p>
        </div>
      </section>

      <!-- Pull-Quote Block 3: The Flat Rate vs. Reducing Balance Illusion -->
      <section class="space-y-6">
        <blockquote class="border-y border-[var(--border)] py-8 px-2 sm:px-6 my-4">
          <p class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-[var(--txt)] tracking-tight leading-snug font-serif italic">
            &ldquo;A seemingly modest 7% &lsquo;flat rate&rsquo; vehicle loan actually conceals an effective reducing balance APR of nearly 13.5%. Never confuse non-reducing dealer quotes with true compound borrowing costs.&rdquo;
          </p>
          <cite class="block mt-4 text-xs font-mono font-bold uppercase tracking-widest text-teal-500 dark:text-teal-400 not-italic">
            &mdash; Consumer Credit Transparency &amp; APR Disclosures
          </cite>
        </blockquote>

        <div class="max-w-3xl space-y-4 text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
          <p>
            Auto dealerships and microfinance institutions frequently market loans using &ldquo;flat interest rates.&rdquo; Under flat-rate accounting, interest is calculated on the full original principal for the entire tenure, completely ignoring the fact that you repay principal every month.
          </p>
          <p>
            Under genuine reducing balance methodology (used by all regulated commercial banks for home mortgages), interest is assessed strictly on the outstanding balance remaining at each billing cycle. Always insist on receiving the standardized Annual Percentage Rate (APR) schedule before executing credit documentation.
          </p>
        </div>
      </section>

      </section>

      <!-- Hairline Accordion FAQ Section -->
      <section class="tool-content-card">
        <div class="tool-content-header">
          <h2>Amortization &amp; Borrowing Frequently Asked Questions</h2>
          <p>
            Tenure selection, prepayment math, and benchmark rate adjustments.
          </p>
        </div>

        <div class="tool-faq-accordion">
          <details class="tool-faq-item">
            <summary>
              <span>Does choosing a longer loan tenure save money if the monthly EMI is lower?</span>
              <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
            </summary>
            <div class="faq-answer">
              No, exactly the opposite. While stretching a tenure from 15 years to 30 years drops your monthly installment to ease immediate household cash flow, it dramatically inflates the total compounded interest paid to the lender. On a ₹50 lakh loan at 8.5%, a 15-year tenure generates approximately ₹38.6 lakh in total interest, whereas a 30-year tenure extracts a staggering ₹88.4 lakh in interest&mdash;more than 175% of the original amount borrowed.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>Should I prepay my mortgage or invest surplus capital in index funds?</span>
              <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
            </summary>
            <div class="faq-answer">
              Compare your post-tax borrowing interest rate against your conservative post-tax expected investment returns. If your home loan interest is 8.75%, prepaying provides a guaranteed, risk-free 8.75% return. Equities may yield 11–13% over multi-decade horizons, but carry market volatility and capital gains taxation. A balanced strategy directs 50% of surplus cash flow toward principal prepayments and 50% into equity SIPs.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>Are there foreclosure or prepayment penalty charges on retail home loans?</span>
              <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
            </summary>
            <div class="faq-answer">
              Under Reserve Bank of India (RBI) and global regulatory directives, commercial banks and housing finance corporations are strictly prohibited from levying foreclosure charges or prepayment penalties on floating-rate individual home loans. Fixed-rate loans and corporate business credit facilities, however, may still contractually mandate prepayment fees of 2% to 4%.
            </div>
          </details>
        </div>
      </section>

    </div>
  </div>
</ToolLayout>

<script>
  const fmt = (n: number) => '₹' + Math.round(n).toLocaleString('en-IN');
  const circ = 2 * Math.PI * 70; // 439.82

  function calc() {
    const P = parseFloat((document.getElementById('emi-principal') as HTMLInputElement).value);
    const annualRate = parseFloat((document.getElementById('emi-rate') as HTMLInputElement).value);
    const n = parseInt((document.getElementById('emi-tenure') as HTMLInputElement).value);

    if (!P || !annualRate || !n) return;

    // Display labels
    const pDisp = document.getElementById('emi-principal-display');
    const rDisp = document.getElementById('emi-rate-display');
    const tDisp = document.getElementById('emi-tenure-display');
    if (pDisp) pDisp.textContent = fmt(P);
    if (rDisp) rDisp.textContent = `${annualRate.toFixed(2)}%`;
    if (tDisp) tDisp.textContent = `${n} Months (${(n/12).toFixed(1)} Years)`;

    const r = annualRate / 12 / 100;
    const emi = r === 0 ? P / n : (P * r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
    const total = emi * n;
    const interest = total - P;

    const mEl = document.getElementById('emi-monthly');
    const poEl = document.getElementById('emi-principal-out');
    const ioEl = document.getElementById('emi-interest-out');
    const toEl = document.getElementById('emi-total-out');
    const roEl = document.getElementById('emi-rate-out');

    if (mEl) mEl.textContent = fmt(emi);
    if (poEl) poEl.textContent = fmt(P);
    if (ioEl) ioEl.textContent = fmt(interest);
    if (toEl) toEl.textContent = fmt(total);
    if (roEl) roEl.textContent = `${annualRate}%`;

    // Donut chart
    const principalPct = P / total;
    const principalDash = circ * principalPct;
    const interestDash = circ * (1 - principalPct);
    const donutP = document.getElementById('donut-principal');
    const donutI = document.getElementById('donut-interest');
    if (donutP && donutI) {
      donutP.setAttribute('stroke-dasharray', `${principalDash} ${circ}`);
      donutI.setAttribute('stroke-dasharray', `${interestDash} ${circ}`);
      donutI.setAttribute('stroke-dashoffset', String(-principalDash));
    }
  }

  document.getElementById('emi-calc')?.addEventListener('click', calc);
  document.getElementById('emi-principal')?.addEventListener('input', calc);
  document.getElementById('emi-rate')?.addEventListener('input', calc);
  document.getElementById('emi-tenure')?.addEventListener('input', calc);

  // Initial calculation
  calc();
</script>
