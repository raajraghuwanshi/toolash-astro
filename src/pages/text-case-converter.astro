---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'text-case-converter')!;
---

<ToolLayout tool={tool} customLayout={true}>
  <div class="tool-page-wrap">
    <!-- Toolarsh String Transformation Hero -->
    <div class="tool-hero-box">
      <div class="inline-flex items-center gap-2 tool-badge-pill mb-3">
        <i class="fas fa-font text-[var(--brand)]"></i> Regex Casing & Code Identifier Studio
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-[var(--txt)]">
        Text Case <span class="bg-gradient-to-r from-[var(--brand)] to-[var(--brand-dark)] bg-clip-text text-transparent">Morphing Lab</span>
      </h1>
      <p class="text-sm sm:text-base mt-2 max-w-2xl text-[var(--txt-muted)] leading-relaxed">
        Instantly transform plain text across 9 typography standards and programming notations, including camelCase, snake_case, Title Case, and UPPERCASE.
      </p>
    </div>

    <!-- Main Editor Workspace -->
    <div class="tool-card-surface space-y-6 mb-10">
      <!-- Input Text Area -->
      <div class="space-y-2">
        <div class="flex justify-between items-center text-xs font-mono">
          <span class="text-[var(--txt-muted)] uppercase font-bold">Source Text</span>
          <span class="text-[var(--txt-dim)]" id="cc-input-count">0 words • 0 chars</span>
        </div>
        <textarea id="cc-input" rows="5" placeholder="Type or paste your text here to transform casing…" class="tool-textarea"></textarea>
      </div>

      <!-- 9 Case Transformation Buttons Grid -->
      <div class="space-y-2">
        <span class="text-xs font-mono font-bold text-[var(--txt-muted)] uppercase tracking-wider block">Select Target Transformation:</span>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5">
          <button class="cc-btn px-3.5 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--surface-2)] hover:border-[var(--border-strong)] text-[var(--txt-muted)] hover:text-[var(--txt)] text-xs font-mono font-bold transition-all cursor-pointer flex items-center justify-center gap-2" data-mode="upper">
            <i class="fas fa-arrow-up text-[var(--brand)]"></i> UPPERCASE
          </button>
          <button class="cc-btn px-3.5 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--surface-2)] hover:border-[var(--border-strong)] text-[var(--txt-muted)] hover:text-[var(--txt)] text-xs font-mono font-bold transition-all cursor-pointer flex items-center justify-center gap-2" data-mode="lower">
            <i class="fas fa-arrow-down text-[var(--brand)]"></i> lowercase
          </button>
          <button class="cc-btn px-3.5 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--surface-2)] hover:border-[var(--border-strong)] text-[var(--txt-muted)] hover:text-[var(--txt)] text-xs font-mono font-bold transition-all cursor-pointer flex items-center justify-center gap-2" data-mode="title">
            <i class="fas fa-heading text-[var(--amber)]"></i> Title Case
          </button>
          <button class="cc-btn px-3.5 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--surface-2)] hover:border-[var(--border-strong)] text-[var(--txt-muted)] hover:text-[var(--txt)] text-xs font-mono font-bold transition-all cursor-pointer flex items-center justify-center gap-2" data-mode="sentence">
            <i class="fas fa-paragraph text-[var(--amber)]"></i> Sentence case
          </button>
          <button class="cc-btn px-3.5 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--surface-2)] hover:border-[var(--border-strong)] text-[var(--txt-muted)] hover:text-[var(--txt)] text-xs font-mono font-bold transition-all cursor-pointer flex items-center justify-center gap-2" data-mode="camel">
            <i class="fas fa-code text-[var(--brand)]"></i> camelCase
          </button>
          <button class="cc-btn px-3.5 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--surface-2)] hover:border-[var(--border-strong)] text-[var(--txt-muted)] hover:text-[var(--txt)] text-xs font-mono font-bold transition-all cursor-pointer flex items-center justify-center gap-2" data-mode="pascal">
            <i class="fas fa-file-code text-[var(--brand)]"></i> PascalCase
          </button>
          <button class="cc-btn px-3.5 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--surface-2)] hover:border-[var(--border-strong)] text-[var(--txt-muted)] hover:text-[var(--txt)] text-xs font-mono font-bold transition-all cursor-pointer flex items-center justify-center gap-2" data-mode="snake">
            <i class="fas fa-minus text-[var(--brand)]"></i> snake_case
          </button>
          <button class="cc-btn px-3.5 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--surface-2)] hover:border-[var(--border-strong)] text-[var(--txt-muted)] hover:text-[var(--txt)] text-xs font-mono font-bold transition-all cursor-pointer flex items-center justify-center gap-2" data-mode="kebab">
            <i class="fas fa-link text-[var(--brand)]"></i> kebab-case
          </button>
          <button class="cc-btn px-3.5 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--surface-2)] hover:border-[var(--border-strong)] text-[var(--txt-muted)] hover:text-[var(--txt)] text-xs font-mono font-bold transition-all cursor-pointer flex items-center justify-center gap-2" data-mode="alternate">
            <i class="fas fa-shuffle text-[var(--amber)]"></i> aLtErNaTe
          </button>
        </div>
      </div>

      <!-- Output Workspace -->
      <div id="cc-output-wrap" class="space-y-3 pt-4 border-t border-[var(--border)]" style="display: none;">
        <div class="flex justify-between items-center text-xs font-mono">
          <span class="text-[var(--brand)] font-bold uppercase">Transformed Result</span>
          <div class="flex items-center gap-2">
            <button id="cc-copy" class="px-3.5 py-1.5 rounded-xl bg-[var(--brand)] hover:opacity-90 text-white font-bold font-mono text-xs flex items-center gap-1.5 cursor-pointer transition-all shadow-sm">
              <i class="fas fa-copy"></i> Copy Result
            </button>
            <button id="cc-clear" class="px-3.5 py-1.5 rounded-xl border border-[var(--border)] bg-[var(--surface-2)] hover:border-[var(--border-strong)] text-[var(--txt-muted)] hover:text-[var(--txt)] font-mono text-xs flex items-center gap-1.5 cursor-pointer transition-all">
              <i class="fas fa-trash-can"></i> Clear
            </button>
          </div>
        </div>
        <textarea id="cc-output" rows="5" readonly class="tool-control-output font-mono text-sm leading-relaxed"></textarea>
      </div>
    </div>

    <!-- How to Use -->
    <div class="tool-content-wrap">

      <section class="tool-content-card">
        <div class="tool-content-header">
          <span class="tool-badge-pill mb-3">
            <i class="fas fa-list-ol text-[var(--brand)]"></i> Step-by-Step Guide
          </span>
          <h2>How to Use the Text Case Converter</h2>
          <p>Convert any text to uppercase, lowercase, title case, or a code identifier in one click.</p>
        </div>
        <ol class="mt-6 space-y-4">
          <li class="flex gap-4 items-start">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[var(--brand-soft)] border border-[var(--brand)]/30 flex items-center justify-center text-[var(--brand)] font-black text-sm font-mono">1</span>
            <div>
              <strong class="text-[var(--txt)] text-sm block mb-1">Paste or type your text</strong>
              <span class="text-sm text-[var(--txt-muted)] leading-relaxed">Enter your text in the Source Text box. It can be a single word, a paragraph, or anything in between.</span>
            </div>
          </li>
          <li class="flex gap-4 items-start">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[var(--brand-soft)] border border-[var(--brand)]/30 flex items-center justify-center text-[var(--brand)] font-black text-sm font-mono">2</span>
            <div>
              <strong class="text-[var(--txt)] text-sm block mb-1">Choose a transformation</strong>
              <span class="text-sm text-[var(--txt-muted)] leading-relaxed">Click any of the 9 buttons — UPPERCASE, lowercase, Title Case, Sentence case, camelCase, PascalCase, snake_case, kebab-case, or aLtErNaTiNg CaSe.</span>
            </div>
          </li>
          <li class="flex gap-4 items-start">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[var(--brand-soft)] border border-[var(--brand)]/30 flex items-center justify-center text-[var(--brand)] font-black text-sm font-mono">3</span>
            <div>
              <strong class="text-[var(--txt)] text-sm block mb-1">Review the result</strong>
              <span class="text-sm text-[var(--txt-muted)] leading-relaxed">The converted text appears instantly in the Result box below. You can switch between case styles as many times as you like.</span>
            </div>
          </li>
          <li class="flex gap-4 items-start">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[var(--brand-soft)] border border-[var(--brand)]/30 flex items-center justify-center text-[var(--brand)] font-black text-sm font-mono">4</span>
            <div>
              <strong class="text-[var(--txt)] text-sm block mb-1">Copy the result</strong>
              <span class="text-sm text-[var(--txt-muted)] leading-relaxed">Hit <strong>Copy Result</strong> to copy the transformed text to your clipboard, ready to paste wherever you need it.</span>
            </div>
          </li>
        </ol>
      </section>

      <!-- Timeline: The Evolutionary Chronology of Letter Casing -->

      <!-- Evolution Timeline Card -->
      <section class="tool-content-card space-y-10">
        <div class="tool-content-header">
          <span class="tool-badge-pill mb-3">
            <i class="fas fa-clock-rotate-left text-[var(--brand)]"></i> Historical Orthography
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-[var(--txt)] tracking-tight">
            From Roman Stone to Compilers: The Evolution of Casing
          </h2>
          <p>
            The distinction between uppercase and lowercase letters is not a natural property of spoken language—it is the product of two millennia of technological adaptation. Letter casing evolved from the physical constraints of chisel-carved stone monuments and medieval parchment shortages to movable lead type cases, early teleprinter relays, and modern programming language parsers.
          </p>
        </div>

        <!-- Vertical Timeline Spine -->
        <div class="timeline-track">

          <!-- Epoch 01 -->
          <article class="timeline-item space-y-2">
            <div class="timeline-pin"></div>
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono font-bold text-[var(--brand)] uppercase tracking-wider">Epoch 01 &bull; 1st Century BC</span>
              <span class="text-xs font-mono text-[var(--txt-dim)]">Roman Epigraphy</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-[var(--txt)] tracking-tight">
              Majuscules &amp; Scriptura Continua
            </h3>
            <p class="text-sm text-[var(--txt-muted)] leading-relaxed">
              Ancient Roman Latin existed in a single case: square capitals carved into imperial monuments and stone facades. Because chisel strokes favored clean geometric lines, lowercase curves did not yet exist. Inscriptions lacked spaces between words—a practice known as <em>scriptura continua</em>—requiring readers to decipher sentence boundaries through vocal recitation.
            </p>
            <div class="p-3 rounded-xl bg-[var(--surface-2)] border border-[var(--border)] font-mono text-xs text-[var(--txt)]">
              SENATVS&middot;POPVLVSQVE&middot;ROMANVS
            </div>
          </article>

          <!-- Epoch 02 -->
          <article class="timeline-item space-y-2">
            <div class="timeline-pin" style="border-color: var(--amber);"></div>
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono font-bold text-[var(--amber)] uppercase tracking-wider">Epoch 02 &bull; c. 780 AD</span>
              <span class="text-xs font-mono text-[var(--txt-dim)]">Monastic Scriptoriums</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-[var(--txt)] tracking-tight">
              Carolingian Minuscule &amp; The Birth of Lowercase
            </h3>
            <p class="text-sm text-[var(--txt-muted)] leading-relaxed">
              During the Carolingian Renaissance, Emperor Charlemagne commissioned scholar Alcuin of York to standardize script across European scriptoriums. Scribes created <em>minuscules</em>: smaller letters with distinctive vertical ascenders (d, b, h) and descenders (p, q, y). This breakthrough quadrupled transcription speed and conserved animal vellum parchment by packing more readable text per folio.
            </p>
            <p class="text-sm text-[var(--txt-muted)] leading-relaxed">
              For the first time, scribes established hierarchy: large capitals initiated chapter openings, while minuscules formed the continuous reading body.
            </p>
          </article>

          <!-- Epoch 03 -->
          <article class="timeline-item space-y-2">
            <div class="timeline-pin"></div>
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono font-bold text-[var(--brand)] uppercase tracking-wider">Epoch 03 &bull; 1450s</span>
              <span class="text-xs font-mono text-[var(--txt-dim)]">Movable Type</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-[var(--txt)] tracking-tight">
              The Compositor’s Wooden &ldquo;Cases&rdquo;
            </h3>
            <p class="text-sm text-[var(--txt-muted)] leading-relaxed">
              When Johannes Gutenberg invented the movable type printing press, individual metal glyphs were stored in divided wooden sorting trays called type cases. Compositors placed the less-frequently accessed capital letter blocks in the drawer positioned physically above (the &ldquo;upper case&rdquo;) and the daily body letters in the closer drawer below (the &ldquo;lower case&rdquo;), coining the terminology used in printing and digital computing today.
            </p>
          </article>

          <!-- Epoch 04 -->
          <article class="timeline-item space-y-2">
            <div class="timeline-pin" style="border-color: var(--amber);"></div>
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono font-bold text-[var(--amber)] uppercase tracking-wider">Epoch 04 &bull; 1900–1960</span>
              <span class="text-xs font-mono text-[var(--txt-dim)]">Early Telecommunications</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-[var(--txt)] tracking-tight">
              Teleprinters &amp; The Monocase Telegraph Age
            </h3>
            <p class="text-sm text-[var(--txt-muted)] leading-relaxed">
              Early telegraphic communication relied on the 5-bit Baudot code (ITA2), which provided only 32 unique binary states. Transmitting dual-case alphabets exceeded electrical transmission bandwidth. Teleprinters, ticker tapes, and early military computers standardized exclusively on uppercase text to maximize hardware simplicity and avoid telegraph relay jamming.
            </p>
            <div class="p-3 rounded-xl bg-[var(--surface-2)] border border-[var(--border)] font-mono text-xs text-[var(--txt-muted)]">
              TELEGRAPH TRANSMISSION: STOP ALL FREIGHT SHIPMENTS IMMEDIATELY STOP
            </div>
          </article>

          <!-- Epoch 05 -->
          <article class="timeline-item space-y-2">
            <div class="timeline-pin"></div>
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono font-bold text-[var(--brand)] uppercase tracking-wider">Epoch 05 &bull; 1963</span>
              <span class="text-xs font-mono text-[var(--txt-dim)]">ASCII Standardization</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-[var(--txt)] tracking-tight">
              The ASCII 32 Bit-Flip Architecture
            </h3>
            <p class="text-sm text-[var(--txt-muted)] leading-relaxed">
              The American Standard Code for Information Interchange (ASCII) established the fundamental binary mapping for modern text. Engineering architects allocated decimal 65–90 for uppercase &apos;A&apos;–&apos;Z&apos; and 97–122 for lowercase &apos;a&apos;–&apos;z&apos;.
            </p>
            <p class="text-sm text-[var(--txt-muted)] leading-relaxed">
              Notice that &apos;a&apos; (97) minus &apos;A&apos; (65) equals exactly 32 (binary 00100000 / hex 0x20). This deliberate mathematical symmetry allowed early microprocessors to convert case instantly with a single CPU bitwise instruction: setting bit 6 forces lowercase, while clearing bit 6 forces uppercase.
            </p>
            <div class="p-4 rounded-xl bg-[var(--surface-2)] border border-[var(--border)] font-mono text-xs text-[var(--txt-muted)] space-y-1">
              <div class="text-[var(--txt)] font-bold">// Bitwise Casing Toggle</div>
              <div>&apos;A&apos; = 01000001 (65)  |  &apos;A&apos; | 0x20 = 01100001 &rarr; &apos;a&apos; (97)</div>
              <div>&apos;a&apos; = 01100001 (97)  |  &apos;a&apos; &amp; ~0x20 = 01000001 &rarr; &apos;A&apos; (65)</div>
            </div>
          </article>

          <!-- Epoch 06 -->
          <article class="timeline-item space-y-2">
            <div class="timeline-pin" style="border-color: var(--amber);"></div>
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono font-bold text-[var(--amber)] uppercase tracking-wider">Epoch 06 &bull; 1970s–Present</span>
              <span class="text-xs font-mono text-[var(--txt-dim)]">Software Engineering</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-[var(--txt)] tracking-tight">
              Syntactic Casing in Programming Ecosystems
            </h3>
            <p class="text-sm text-[var(--txt-muted)] leading-relaxed">
              Because programming language compilers treat whitespace as token separators, engineers invented casing conventions to compress multi-word phrases into valid identifiers:
            </p>
            <dl class="divide-y divide-[var(--border)] text-xs font-mono pt-2">
              <div class="py-2.5 flex justify-between items-baseline">
                <dt class="text-[var(--txt)] font-bold">camelCase</dt>
                <dd class="text-[var(--brand)] font-semibold">JavaScript, TypeScript, Swift, Java methods</dd>
              </div>
              <div class="py-2.5 flex justify-between items-baseline">
                <dt class="text-[var(--txt)] font-bold">PascalCase</dt>
                <dd class="text-[var(--brand)] font-semibold">Classes, React Components, C# types</dd>
              </div>
              <div class="py-2.5 flex justify-between items-baseline">
                <dt class="text-[var(--txt)] font-bold">snake_case</dt>
                <dd class="text-[var(--txt-muted)] font-semibold">Python, Rust, C, SQL database columns</dd>
              </div>
              <div class="py-2.5 flex justify-between items-baseline">
                <dt class="text-[var(--txt)] font-bold">kebab-case</dt>
                <dd class="text-[var(--amber)] font-semibold">CSS classes, HTML attributes, REST URL slugs</dd>
              </div>
              <div class="py-2.5 flex justify-between items-baseline">
                <dt class="text-[var(--txt)] font-bold">SCREAMING_SNAKE</dt>
                <dd class="text-rose-500 font-semibold">Global immutable constants &amp; environment variables</dd>
              </div>
            </dl>
          </article>

        </div>
      </section>

      <!-- Full-Width Typographical Statement Card -->
      <section class="tool-content-card text-center py-8">
        <p class="text-xl sm:text-2xl font-black text-[var(--txt)] tracking-tight leading-snug max-w-3xl mx-auto">
          &ldquo;Case conventions in digital text are not merely decorative styles—they are machine-readable semantic agreements between human authors and computational parsers.&rdquo;
        </p>
        <cite class="block mt-4 text-xs font-mono font-bold uppercase tracking-widest text-[var(--brand)] not-italic">
          &mdash; History of Typographical Computing &amp; Orthography
        </cite>
      </section>

      <!-- Hairline FAQ Card -->
      <section class="tool-content-card">
        <div class="tool-content-header">
          <span class="tool-badge-pill mb-3">
            <i class="fas fa-circle-question text-[var(--brand)]"></i> Common Inquiries
          </span>
          <h3>Orthographic Standards &amp; Casing Frequently Asked Questions</h3>
          <p>
            Insights on ASCII bit flipping, URL kebab-case SEO standards, and client-side processing.
          </p>
        </div>

        <div class="tool-faq-accordion">
          <details class="tool-faq-item">
            <summary>
              <span>Why does the ASCII difference between uppercase and lowercase equal 32?</span>
              <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
            </summary>
            <div class="faq-answer">
              Binary 32 corresponds to the 6th bit (2^5). By placing uppercase &apos;A&apos; at 65 (01000001) and lowercase &apos;a&apos; at 97 (01100001), ASCII designers ensured that case conversion requires changing only a single bit. This allowed early 1960s mechanical circuits and computers with limited memory to convert text case with a single logical instruction.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>How does Title Case treat short prepositions and conjunctions?</span>
              <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
            </summary>
            <div class="faq-answer">
              Standard editorial style guides (Chicago Manual of Style and Associated Press) lowercase articles (a, an, the), coordinating conjunctions (and, but, or, for, nor), and prepositions under four letters (in, on, at, to, by) unless they are the first or last word of the title. Our Title Case converter capitalizes the initial letter of each word to ensure consistent visual balance.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>Why do web URLs and search engines prefer kebab-case?</span>
              <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
            </summary>
            <div class="faq-answer">
              Google&apos;s search indexing algorithms historically treat hyphens as word separators, recognizing &ldquo;word-counter&rdquo; as two separate search tokens (&ldquo;word&rdquo; and &ldquo;counter&rdquo;). Underscores in URLs (&ldquo;word_counter&rdquo;) are often indexed as a single combined term, making kebab-case the universal SEO standard for web addresses.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>Is my converted text processed locally or transmitted to external servers?</span>
              <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
            </summary>
            <div class="faq-answer">
              All transformations occur entirely on the client side in your web browser. Your text never leaves your device, is never transmitted across the network, and is never logged or stored.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>Which case format should I use for blog titles vs. product names vs. code?</span>
              <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
            </summary>
            <div class="faq-answer">
              For blog post and article titles, Title Case is the standard in English publishing. For headlines in news or AP style, Sentence case is preferred. In code, use camelCase for JavaScript variables and functions, PascalCase for class names and React components, snake_case for Python and database columns, and kebab-case for CSS classes and URL slugs.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>Does the converter handle text with emoji, numbers, or special characters?</span>
              <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
            </summary>
            <div class="faq-answer">
              Yes. Numbers, punctuation, and emoji pass through unchanged — only alphabetic characters are affected by case transforms. For code-safe modes like snake_case and kebab-case, non-alphanumeric characters are stripped to keep the identifier valid.
            </div>
          </details>
        </div>
      </section>

    </div>
  </div>
</ToolLayout>

<script>
  const input = document.getElementById('cc-input') as HTMLTextAreaElement;
  const output = document.getElementById('cc-output') as HTMLTextAreaElement;
  const wrap = document.getElementById('cc-output-wrap');

  function toTitleCase(str: string) {
    return str.replace(/\w\S*/g, w => w[0].toUpperCase() + w.slice(1).toLowerCase());
  }
  function toSentenceCase(str: string) {
    return str.toLowerCase().replace(/(^\s*\w|[.!?]\s*\w)/g, c => c.toUpperCase());
  }
  function toCamelCase(str: string) {
    return str.toLowerCase().replace(/[^a-z0-9]+(.)/g, (_, c) => c.toUpperCase());
  }
  function toPascalCase(str: string) {
    const c = toCamelCase(str);
    return c[0]?.toUpperCase() + c.slice(1);
  }
  function toSnakeCase(str: string) {
    return str.toLowerCase().replace(/\s+/g, '_').replace(/[^a-z0-9_]/g, '');
  }
  function toKebabCase(str: string) {
    return str.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
  }
  function toAlternate(str: string) {
    return str.split('').map((c, i) => i % 2 === 0 ? c.toLowerCase() : c.toUpperCase()).join('');
  }

  const transforms: Record<string, (s: string) => string> = {
    upper: s => s.toUpperCase(),
    lower: s => s.toLowerCase(),
    title: toTitleCase,
    sentence: toSentenceCase,
    camel: toCamelCase,
    pascal: toPascalCase,
    snake: toSnakeCase,
    kebab: toKebabCase,
    alternate: toAlternate,
  };

  function updateCounts() {
    const text = input.value.trim();
    const words = text ? text.split(/\s+/).length : 0;
    const chars = input.value.length;
    const countEl = document.getElementById('cc-input-count');
    if (countEl) countEl.textContent = `${words} words • ${chars} chars`;
  }

  input.addEventListener('input', updateCounts);

  document.querySelectorAll('.cc-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const mode = (btn as HTMLElement).dataset.mode!;
      const text = input.value;
      if (!text.trim()) { input.focus(); return; }

      if (output) output.value = transforms[mode](text);
      if (wrap) wrap.style.display = '';

      document.querySelectorAll('.cc-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });

  document.getElementById('cc-copy')?.addEventListener('click', async () => {
    if (!output.value) return;
    await navigator.clipboard.writeText(output.value);
    const btn = document.getElementById('cc-copy');
    if (btn) {
      btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
      setTimeout(() => btn.innerHTML = '<i class="fas fa-copy"></i> Copy Result', 2000);
    }
  });

  document.getElementById('cc-clear')?.addEventListener('click', () => {
    input.value = '';
    output.value = '';
    if (wrap) wrap.style.display = 'none';
    updateCounts();
  });
</script>

<style>
  .cc-btn.active {
    border-color: var(--brand) !important;
    background: var(--brand-soft) !important;
    color: var(--brand) !important;
  }
</style>
