---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'age-calculator')!;
---

<ToolLayout tool={tool}>
  <div class="age-wrap">
    <div class="age-form">
      <div class="age-field">
        <label for="age-dob">Your Date of Birth</label>
        <input type="date" id="age-dob" class="age-input" />
      </div>
      <div class="age-field">
        <label for="age-to">Calculate Age As Of</label>
        <input type="date" id="age-to" class="age-input" />
      </div>
      <button class="btn btn-primary" id="age-calc-btn" style="align-self:flex-end; padding: 12px 32px;">
        <i class="fas fa-calculator"></i> Calculate Age
      </button>
    </div>

    <div id="age-result" class="age-result" style="display:none">
      <div class="age-result-main">
        <div class="age-big">
          <span id="age-years" class="age-num">0</span>
          <span class="age-unit">years old</span>
        </div>
      </div>
      <div class="age-result-grid">
        <div class="age-stat">
          <div id="res-months" class="age-stat-num">0</div>
          <div class="age-stat-label">Total Months</div>
        </div>
        <div class="age-stat">
          <div id="res-weeks" class="age-stat-num">0</div>
          <div class="age-stat-label">Total Weeks</div>
        </div>
        <div class="age-stat">
          <div id="res-days" class="age-stat-num">0</div>
          <div class="age-stat-label">Total Days</div>
        </div>
        <div class="age-stat">
          <div id="res-hours" class="age-stat-num">0</div>
          <div class="age-stat-label">Total Hours</div>
        </div>
        <div class="age-stat">
          <div id="res-next-bd" class="age-stat-num">—</div>
          <div class="age-stat-label">Next Birthday</div>
        </div>
        <div class="age-stat">
          <div id="res-zodiac" class="age-stat-num">—</div>
          <div class="age-stat-label">Zodiac Sign</div>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>

<style>
  .age-wrap { display: flex; flex-direction: column; gap: 24px; }
  .age-form { display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap; }
  .age-field { display: flex; flex-direction: column; gap: 6px; flex: 1; min-width: 200px; }
  .age-field label { font-size: 14px; font-weight: 600; color: var(--txt); }
  .age-input {
    padding: 12px 14px;
    font-size: 15px;
    font-family: 'Inter', sans-serif;
    color: var(--txt);
    background: var(--bg-soft);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    outline: none;
    transition: border-color .2s;
    cursor: pointer;
  }
  .age-input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(37,99,235,.1); }
  .age-result { animation: fadeIn .4s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .age-result-main { text-align: center; padding: 24px; background: linear-gradient(135deg, #EFF6FF, #F5F3FF); border-radius: var(--radius-lg); margin-bottom: 16px; }
  .age-big { display: flex; align-items: baseline; justify-content: center; gap: 10px; }
  .age-num { font-size: 4rem; font-weight: 900; color: var(--brand); font-family: 'Outfit', sans-serif; }
  .age-unit { font-size: 1.4rem; font-weight: 600; color: #475569; }
  .age-result-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .age-stat { background: var(--bg-soft); border: 1.5px solid var(--border); border-radius: var(--radius-md); padding: 16px; text-align: center; }
  .age-stat-num { font-size: 22px; font-weight: 800; color: var(--brand); font-family: 'Outfit', sans-serif; margin-bottom: 4px; }
  .age-stat-label { font-size: 12px; color: var(--txt-muted); font-weight: 600; text-transform: uppercase; }

  @media (max-width: 500px) { .age-result-grid { grid-template-columns: 1fr 1fr; } }
</style>

<script>
  // Set defaults
  const today = new Date().toISOString().split('T')[0];
  (document.getElementById('age-to') as HTMLInputElement).value = today;

  const zodiacSigns = [
    { sign: 'Capricorn ♑', start: [1,1], end: [1,19] },
    { sign: 'Aquarius ♒', start: [1,20], end: [2,18] },
    { sign: 'Pisces ♓', start: [2,19], end: [3,20] },
    { sign: 'Aries ♈', start: [3,21], end: [4,19] },
    { sign: 'Taurus ♉', start: [4,20], end: [5,20] },
    { sign: 'Gemini ♊', start: [5,21], end: [6,20] },
    { sign: 'Cancer ♋', start: [6,21], end: [7,22] },
    { sign: 'Leo ♌', start: [7,23], end: [8,22] },
    { sign: 'Virgo ♍', start: [8,23], end: [9,22] },
    { sign: 'Libra ♎', start: [9,23], end: [10,22] },
    { sign: 'Scorpio ♏', start: [10,23], end: [11,21] },
    { sign: 'Sagittarius ♐', start: [11,22], end: [12,21] },
    { sign: 'Capricorn ♑', start: [12,22], end: [12,31] },
  ];

  function getZodiac(month: number, day: number): string {
    for (const z of zodiacSigns) {
      const [sm, sd] = z.start;
      const [em, ed] = z.end;
      if ((month === sm && day >= sd) || (month === em && day <= ed)) return z.sign;
    }
    return '—';
  }

  document.getElementById('age-calc-btn')?.addEventListener('click', () => {
    const dobVal = (document.getElementById('age-dob') as HTMLInputElement).value;
    const toVal = (document.getElementById('age-to') as HTMLInputElement).value;
    if (!dobVal) { alert('Please enter your date of birth.'); return; }

    const dob = new Date(dobVal);
    const to = toVal ? new Date(toVal) : new Date();

    let years = to.getFullYear() - dob.getFullYear();
    let m = to.getMonth() - dob.getMonth();
    if (m < 0 || (m === 0 && to.getDate() < dob.getDate())) years--;

    const totalDays = Math.floor((to.getTime() - dob.getTime()) / 86400000);
    const totalMonths = Math.floor(totalDays / 30.44);
    const totalWeeks = Math.floor(totalDays / 7);
    const totalHours = totalDays * 24;

    // Next birthday
    const nextBD = new Date(to.getFullYear(), dob.getMonth(), dob.getDate());
    if (nextBD <= to) nextBD.setFullYear(nextBD.getFullYear() + 1);
    const daysUntil = Math.ceil((nextBD.getTime() - to.getTime()) / 86400000);
    const bdStr = daysUntil === 0 ? '🎉 Today!' : `In ${daysUntil} days`;

    const zodiac = getZodiac(dob.getMonth() + 1, dob.getDate());

    document.getElementById('age-years')!.textContent = String(years);
    document.getElementById('res-months')!.textContent = totalMonths.toLocaleString();
    document.getElementById('res-weeks')!.textContent = totalWeeks.toLocaleString();
    document.getElementById('res-days')!.textContent = totalDays.toLocaleString();
    document.getElementById('res-hours')!.textContent = totalHours.toLocaleString();
    document.getElementById('res-next-bd')!.textContent = bdStr;
    document.getElementById('res-zodiac')!.textContent = zodiac;

    document.getElementById('age-result')!.style.display = '';
  });
</script>
