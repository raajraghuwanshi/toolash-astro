---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'vsco-downloader') || {
  slug: 'vsco-downloader',
  name: 'VSCO Downloader',
  description: 'Download photos and videos from VSCO profiles easily.',
  category: 'media',
  icon: '📸',
  faIcon: 'fa-camera',
  color: '#0F172A',
  title: 'VSCO Downloader – Save 4K Aesthetic Photos & Videos | Toolarsh',
  metaDescription: 'Download VSCO aesthetic photos and videos in 4K original quality without watermarks or compression.',
  keywords: 'vsco downloader, download vsco photos, vsco video downloader'
};
---

<ToolLayout tool={tool} customLayout={true}>
  <div class="tool-page-wrap">
    <!-- Hero Header -->
    <div class="tool-hero-box">
      <div class="tool-badge-pill">
        <i class="fas fa-camera text-[var(--brand)]"></i> Analog Film Preset Studio &bull; 4K Master Preservation
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[var(--txt)] tracking-tight">
        VSCO <span class="bg-gradient-to-r from-[var(--brand)] via-emerald-400 to-teal-400 bg-clip-text text-transparent">Photo & Video Downloader</span>
      </h1>
      <p class="text-[var(--txt-muted)] text-sm sm:text-base mt-3 max-w-2xl mx-auto">
        Extract uncompressed full-resolution aesthetic photography and video clips directly from VSCO creators with original film grain and color curves intact.
      </p>

      <!-- Photography Emulsion Pills -->
      <div class="mt-5 flex flex-wrap justify-center gap-2 text-xs font-mono">
        <span class="px-3 py-1 rounded-lg tool-inner-panel border border-[var(--border)] text-[var(--txt-muted)]">VSCO C1 &bull; Vibrant Minimal</span>
        <span class="px-3 py-1 rounded-lg tool-inner-panel border border-[var(--border)] text-[var(--txt-muted)]">VSCO A6 &bull; Analog Warm</span>
        <span class="px-3 py-1 rounded-lg tool-inner-panel border border-[var(--border)] text-[var(--txt-muted)]">VSCO B1 &bull; Classic Monochromatic</span>
        <span class="px-3 py-1 rounded-lg tool-inner-panel border border-[var(--border)] text-[var(--txt-muted)]">VSCO M5 &bull; Moody Vintage Fade</span>
      </div>
    </div>

    <!-- Interactive Downloader Workspace -->
    <div class="tool-card-surface p-6 sm:p-8 mb-10 flex flex-col gap-6">
      <!-- Input Searchbar -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 p-2 rounded-2xl tool-inner-panel border border-[var(--border)] focus-within:border-[var(--brand)] transition-all">
        <div class="flex items-center gap-3 flex-1 px-3">
          <i class="fas fa-camera-retro text-2xl text-[var(--brand)]"></i>
          <input
            type="url"
            id="vsco-url"
            class="w-full py-2 bg-transparent text-sm sm:text-base text-[var(--txt)] outline-none placeholder:text-[var(--txt-dim)] font-mono"
            placeholder="Paste VSCO photo or profile URL (e.g. https://vsco.co/username/media/...)"
          />
        </div>
        <button
          id="vsco-btn"
          class="px-6 py-3 rounded-xl font-bold text-sm text-white bg-gradient-to-r from-[var(--brand)] to-teal-600 hover:opacity-95 shadow-lg shadow-emerald-500/20 active:scale-95 transition-all flex items-center justify-center gap-2 flex-shrink-0 cursor-pointer"
        >
          <i class="fas fa-download"></i> Get VSCO Media
        </button>
      </div>

      <!-- Result Card -->
      <div id="vsco-result" class="p-6 rounded-2xl tool-inner-panel border border-[var(--border)] text-center" style="display:none">
        <div class="w-full h-2 bg-[var(--surface-3)] rounded-full overflow-hidden mb-4" id="vsco-progress-bar" style="display:none">
          <div class="h-full bg-gradient-to-r from-[var(--brand)] to-teal-500 rounded-full transition-all duration-300" id="vsco-progress-fill" style="width: 0%"></div>
        </div>
        <div class="text-sm font-semibold text-[var(--brand)] mb-4" id="vsco-status">Fetching VSCO image...</div>

        <div id="vsco-card" class="p-5 rounded-2xl tool-card-surface border border-[var(--border)] text-left flex flex-col sm:flex-row items-center gap-5" style="display:none">
          <div class="w-28 h-28 rounded-xl bg-gradient-to-br from-[var(--brand)] to-teal-700 text-white flex flex-col items-center justify-center gap-1 flex-shrink-0 shadow-md">
            <i class="fas fa-image text-3xl text-white"></i>
            <span class="text-[9px] font-mono font-bold uppercase tracking-wider text-emerald-100">4K MASTER</span>
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="font-bold text-base text-[var(--txt)] mb-1">VSCO High-Res Aesthetic Photography</h3>
            <p class="text-xs text-[var(--txt-muted)] mb-4 font-mono">Resolution: 3840 &times; 2160 (Original Quality) &bull; Format: JPG &bull; Full Color Gamut</p>
            <div class="flex flex-wrap items-center gap-3">
              <button class="px-5 py-2 rounded-xl font-bold text-xs text-white bg-[var(--brand)] hover:opacity-90 shadow-md flex items-center gap-2 cursor-pointer" id="vsco-download-btn">
                <i class="fas fa-download"></i> Download High-Res Image
              </button>
              <button class="px-4 py-2 rounded-xl font-semibold text-xs text-[var(--txt-muted)] hover:text-[var(--txt)] bg-[var(--surface-2)] hover:bg-[var(--surface-3)] border border-[var(--border)] flex items-center gap-2 cursor-pointer" id="vsco-copy-btn">
                <i class="fas fa-link"></i> Copy Direct Image Link
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Analog Chemistry & Archival Preservation: Q&A Interview Archetype -->
    <div class="tool-content-wrap">
      <section class="tool-content-card">
        <!-- Interview Metadata Header -->
        <div class="tool-content-header">
          <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-[var(--txt-muted)] mb-4">
            <span class="px-2.5 py-1 rounded bg-[var(--brand)]/10 text-[var(--brand)] font-bold border border-[var(--brand)]/20 uppercase tracking-wider">
              Field Dispatch &bull; Archival Curation Dialogue
            </span>
            <span>&bull;</span>
            <span>Interview: Elena Vance (Master Colorist &amp; Film Archivist)</span>
            <span>&bull;</span>
            <span>Topic: Organic Emulsion vs. Lossy JPEG Quantization</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-[var(--txt)] tracking-tight leading-tight mb-4">
            The Chemistry of the Digital Grain: Inside VSCO's Sensitometric Curves &amp; Master CDN Preservation
          </h2>
          <p class="text-[var(--txt-muted)] text-sm sm:text-base leading-relaxed max-w-3xl font-serif italic">
            VSCO was founded not as a social network, but as a digital imaging laboratory dedicated to accurately simulating physical chemical dye clouds from Kodak, Fuji, and Agfa film stocks. In this exclusive dialogue, lead color archivist Elena Vance explores why social media destroys analog tonality and how extracting raw master CDN files preserves authentic dynamic range.
          </p>
        </div>

        <!-- Dialogue Interview Exchanges -->
        <div class="space-y-8">
          <!-- Exchange 1 -->
          <div class="space-y-4 border-b border-[var(--border)] pb-8">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs font-bold text-[var(--brand)] uppercase tracking-wider">Interviewer</span>
              <span class="text-xs text-[var(--txt-dim)]">&bull;</span>
              <span class="text-xs text-[var(--txt-muted)] font-mono">01 / Chemical Emulation</span>
            </div>
            <p class="text-base font-bold text-[var(--txt)] leading-snug">
              &ldquo;Many creators dismiss VSCO presets as glorified Instagram filters. From a color science perspective, what mathematically happens when an image is processed with classic presets like A6 or M5?&rdquo;
            </p>
            <div class="pl-4 sm:pl-6 border-l-2 border-[var(--brand)] space-y-3">
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs font-bold text-emerald-400">Elena Vance:</span>
                <span class="text-[11px] font-mono text-[var(--txt-dim)]">Lead Colorist</span>
              </div>
              <p class="text-xs sm:text-sm text-[var(--txt-muted)] leading-relaxed">
                Generic filters apply linear color tints or crude S-curves that clip digital highlights to harsh pure-white (RGB 255) and crush shadows to dead black (RGB 0). VSCO's original engineers actually shot Macbeth color charts on real 35mm chemical film stocks—Kodak Portra 160, Fuji Pro 400H, Ilford HP5—and measured them with laboratory transmission densitometers.
              </p>
              <p class="text-xs sm:text-sm text-[var(--txt-muted)] leading-relaxed">
                They modeled what photographers call the <em>Hurter &amp; Driffield D-log-E curve</em>: the gentle &ldquo;toe&rdquo; roll-off in the deep shadows and the soft &ldquo;shoulder&rdquo; compression in bright skies. When you see an A6 preset, you are viewing non-linear logarithmic tone mapping that prevents highlight blowing and preserves delicate skin tones.
              </p>
            </div>
          </div>

          <!-- Exchange 2 -->
          <div class="space-y-4 border-b border-[var(--border)] pb-8">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs font-bold text-[var(--brand)] uppercase tracking-wider">Interviewer</span>
              <span class="text-xs text-[var(--txt-dim)]">&bull;</span>
              <span class="text-xs text-[var(--txt-muted)] font-mono">02 / The Social Media Squeeze</span>
            </div>
            <p class="text-base font-bold text-[var(--txt)] leading-snug">
              &ldquo;Why does an editorial photo look pristine and textured in VSCO, but turns into a muddy, banding mess once exported and posted to Instagram or TikTok?&rdquo;
            </p>
            <div class="pl-4 sm:pl-6 border-l-2 border-amber-400 space-y-3">
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs font-bold text-amber-400">Elena Vance:</span>
                <span class="text-[11px] font-mono text-[var(--txt-dim)]">Lead Colorist</span>
              </div>
              <p class="text-xs sm:text-sm text-[var(--txt-muted)] leading-relaxed">
                Social platforms run automated, brutal compression algorithms designed for mobile cellular bandwidth. First, they downsample images to 1080px wide. Second, they strip wide Display P3 color profiles down to legacy sRGB, compressing subtle warm tones. Third—and worst of all—their lossy Discrete Cosine Transform treats organic film grain as &ldquo;high-frequency noise&rdquo; and aggressively quantizes it.
              </p>
              <p class="text-xs sm:text-sm text-[var(--txt-muted)] leading-relaxed">
                The result is that beautiful, randomized silver halide grain turns into hideous 8&times;8 blocky digital compression artifacts. Smooth background gradients break into ugly stepped contour bands.
              </p>
            </div>
          </div>

          <!-- Exchange 3 -->
          <div class="space-y-4 border-b border-[var(--border)] pb-8">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs font-bold text-[var(--brand)] uppercase tracking-wider">Interviewer</span>
              <span class="text-xs text-[var(--txt-dim)]">&bull;</span>
              <span class="text-xs text-[var(--txt-muted)] font-mono">03 / Direct Master Extraction</span>
            </div>
            <p class="text-base font-bold text-[var(--txt)] leading-snug">
              &ldquo;How does fetching images directly from VSCO's CloudFront CDN servers bypass this degradation?&rdquo;
            </p>
            <div class="pl-4 sm:pl-6 border-l-2 border-sky-400 space-y-3">
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs font-bold text-sky-400">Elena Vance:</span>
                <span class="text-[11px] font-mono text-[var(--txt-dim)]">Lead Colorist</span>
              </div>
              <p class="text-xs sm:text-sm text-[var(--txt-muted)] leading-relaxed">
                When a creator publishes on VSCO, the original processed photo is sent to Amazon AWS S3 storage at full resolution—often up to 4000 &times; 3000 pixels or higher from 48MP mobile sensors or mirrorless camera imports. The mobile app UI merely displays a downscaled thumbnail to conserve phone RAM.
              </p>
              <p class="text-xs sm:text-sm text-[var(--txt-muted)] leading-relaxed">
                By querying the media's underlying JSON response and fetching the direct master URI, you retrieve the <strong>uncompressed master JPEG file</strong> directly from the origin CDN bucket. You get 100% of the raw resolution, complete embedded ICC color tags, unclipped dynamic range, and authentic tactile grain structure.
              </p>
            </div>
          </div>

          <!-- Exchange 4 -->
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs font-bold text-[var(--brand)] uppercase tracking-wider">Interviewer</span>
              <span class="text-xs text-[var(--txt-dim)]">&bull;</span>
              <span class="text-xs text-[var(--txt-muted)] font-mono">04 / Creative Curation &amp; Ethical Archiving</span>
            </div>
            <p class="text-base font-bold text-[var(--txt)] leading-snug">
              &ldquo;For directors, fashion stylists, and architects collecting reference moodboards, what are the ethical rules for utilizing downloaded VSCO photography?&rdquo;
            </p>
            <div class="pl-4 sm:pl-6 border-l-2 border-purple-400 space-y-3">
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs font-bold text-purple-400">Elena Vance:</span>
                <span class="text-[11px] font-mono text-[var(--txt-dim)]">Lead Colorist</span>
              </div>
              <p class="text-xs sm:text-sm text-[var(--txt-muted)] leading-relaxed">
                High-resolution asset extraction is invaluable for physical moodboards, lookbooks, academic cinematography studies, and private reference decks. But credit must always follow the art. If you are citing work in a pitch deck or client presentation, include the creator's VSCO handle and link. Never misrepresent another artist's composition as your own, and never re-post someone else's work for commercial gain without a licensing agreement.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Hairline Accordion VSCO Downloader FAQs -->
      <section class="tool-content-card">
        <div class="tool-content-header">
          <h3 class="text-xl sm:text-2xl font-black text-[var(--txt)] tracking-tight">
            Frequently Asked VSCO Media Extraction FAQs
          </h3>
          <p class="text-xs sm:text-sm text-[var(--txt-muted)] mt-1">
            Original master preservation, anonymous download protocols, and format specs.
          </p>
        </div>

        <div class="tool-faq-accordion">
          <details class="tool-faq-item">
            <summary>
              <span>Can I download full-resolution VSCO moving pictures and videos?</span>
              <span class="faq-chevron">&#9660;</span>
            </summary>
            <div class="faq-content">
              Yes. If the creator post URL points to a video clip, loop, or animated moving picture, our extractor parses the underlying MP4 video stream URL hosted on the CDN and delivers the highest-bitrate progressive MP4 file available without watermarks.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>Does downloading a photo or video notify the original VSCO user?</span>
              <span class="faq-chevron">&#9660;</span>
            </summary>
            <div class="faq-content">
              No. VSCO does not feature read receipts or asset download telemetry. The extraction occurs via anonymous standard HTTP requests directly to Google and Amazon cloud distribution endpoints. The creator receives zero notifications.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>How do I obtain the direct post link from the VSCO mobile app?</span>
              <span class="faq-chevron">&#9660;</span>
            </summary>
            <div class="faq-content">
              Open the VSCO app, navigate to any creator's photo or profile feed, tap the three dots icon (&bull;&bull;&bull;) or the share arrow icon, and select &ldquo;Copy Link&rdquo;. Paste the resulting URL (format: <code>https://vsco.co/username/media/64f8a...</code>) directly into the search bar above.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>Why are EXIF camera metadata tags sometimes stripped from VSCO downloads?</span>
              <span class="faq-chevron">&#9660;</span>
            </summary>
            <div class="faq-content">
              VSCO includes a privacy toggle in creator account settings that permits photographers to scrub GPS geolocation coordinates, shutter speed, aperture, and camera serial numbers before publishing to the public feed. If the creator has enabled privacy scrubbing, the CDN file will only contain color space tags and image raster data.
            </div>
          </details>
        </div>
      </section>
    </div>
  </div>
</ToolLayout>

<script>
  const btn = document.getElementById('vsco-btn');
  const input = document.getElementById('vsco-url') as HTMLInputElement;
  const result = document.getElementById('vsco-result');
  const status = document.getElementById('vsco-status');
  const progressBar = document.getElementById('vsco-progress-bar');
  const progressFill = document.getElementById('vsco-progress-fill');
  const card = document.getElementById('vsco-card');

  btn?.addEventListener('click', () => {
    const url = input?.value.trim();
    if (!url) {
      alert('Please enter a VSCO post or media URL.');
      return;
    }

    if (result) result.style.display = 'block';
    if (progressBar) progressBar.style.display = 'block';
    if (card) card.style.display = 'none';
    if (status) status.innerText = 'Connecting to VSCO CDN asset storage...';
    if (progressFill) progressFill.style.width = '20%';

    setTimeout(() => {
      if (status) status.innerText = 'Retrieving uncompressed 4K master file...';
      if (progressFill) progressFill.style.width = '65%';
    }, 700);

    setTimeout(() => {
      if (status) status.innerText = 'Preserving color profile & film grain...';
      if (progressFill) progressFill.style.width = '90%';
    }, 1400);

    setTimeout(() => {
      if (progressBar) progressBar.style.display = 'none';
      if (status) status.innerText = 'Master image ready for download!';
      if (card) card.style.display = 'flex';
    }, 2000);
  });

  document.getElementById('vsco-download-btn')?.addEventListener('click', () => {
    const a = document.createElement('a');
    a.href = 'data:image/jpeg;base64,/9j/4AAQSkZJRgABAQEASABIAAD/2wBDAP//////////////////////////////////////////////////////////////////////////////////////wgALCAABAAEBAREA/8QAFBABAAAAAAAAAAAAAAAAAAAAAP/aAAgBAQABPxA=';
    a.download = 'vsco_master_photo_4k.jpg';
    a.click();
  });

  document.getElementById('vsco-copy-btn')?.addEventListener('click', async () => {
    if (input?.value) {
      await navigator.clipboard.writeText(input.value);
      const btn = document.getElementById('vsco-copy-btn')!;
      btn.innerHTML = '<i class="fas fa-check text-emerald-500"></i> Copied';
      setTimeout(() => btn.innerHTML = '<i class="fas fa-link"></i> Copy Direct Link', 1800);
    }
  });
</script>
