---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'vsco-downloader') || {
  slug: 'vsco-downloader',
  name: 'VSCO Downloader',
  description: 'Download photos and videos from VSCO profiles easily.',
  category: 'media',
  icon: '📸',
  faIcon: 'fa-camera',
  color: '#DC2626',
  title: 'VSCO Downloader – Save VSCO Photos & Videos | Toolarsh',
  metaDescription: 'Download VSCO photos and videos in high quality, free and without watermarks.',
  keywords: 'vsco downloader, download vsco photos, vsco video downloader'
};
---

<ToolLayout tool={tool}>
  <div class="dl-box">
    <div class="dl-form shadow-sm">
      <div class="dl-input-group">
        <i class="fas fa-camera-retro dl-icon"></i>
        <input type="url" id="vsco-url" class="dl-input" placeholder="Paste VSCO photo or profile URL (e.g. https://vsco.co/username/media/...)" />
        <button class="btn btn-primary dl-btn" id="vsco-btn">
          <i class="fas fa-download"></i> Get VSCO Media
        </button>
      </div>
    </div>

    <!-- Result -->
    <div class="dl-result" id="vsco-result" style="display:none">
      <div class="dl-progress-bar" id="vsco-progress-bar" style="display:none">
        <div class="progress-fill" id="vsco-progress-fill"></div>
      </div>
      <div class="dl-status" id="vsco-status">Fetching VSCO image...</div>

      <div class="vsco-card" id="vsco-card" style="display:none">
        <div class="vsco-img-preview">
          <i class="fas fa-image"></i>
          <span>Full HD Image</span>
        </div>
        <div class="vsco-info">
          <h4>VSCO High-Res Aesthetic Photo</h4>
          <p class="vsco-meta">Resolution: 3840 x 2160 (Original Quality) &bull; Format: JPG</p>
          <div class="vsco-actions">
            <button class="btn btn-primary" id="vsco-download-btn"><i class="fas fa-download"></i> Download High-Res Image</button>
            <button class="btn btn-ghost" id="vsco-copy-btn"><i class="fas fa-link"></i> Copy Direct Image Link</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>

<style>
  .dl-box { display: flex; flex-direction: column; gap: 24px; }
  .dl-form { background: var(--bg-soft); border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: 24px; }
  .dl-input-group { display: flex; align-items: center; background: #fff; border: 2px solid var(--border); border-radius: var(--radius-md); padding: 6px 6px 6px 16px; gap: 12px; transition: border-color .2s; }
  .dl-input-group:focus-within { border-color: var(--brand); }
  .dl-icon { color: var(--txt-muted); font-size: 18px; }
  .dl-input { flex: 1; border: none; outline: none; font-size: 15px; background: transparent; }
  .dl-btn { flex-shrink: 0; }

  .dl-result { background: #fff; border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: 24px; text-align: center; }
  .dl-progress-bar { height: 8px; background: #E2E8F0; border-radius: 100px; overflow: hidden; margin-bottom: 16px; }
  .progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, #111827, #4B5563); transition: width 0.3s ease; }
  .dl-status { font-size: 14.5px; font-weight: 600; color: #111827; margin-bottom: 16px; }

  .vsco-card { display: flex; gap: 20px; text-align: left; background: var(--bg-soft); padding: 20px; border-radius: var(--radius-md); border: 1.5px solid var(--border); align-items: center; }
  .vsco-img-preview { width: 140px; height: 140px; background: #E2E8F0; color: #475569; border-radius: var(--radius-md); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; font-size: 36px; flex-shrink: 0; }
  .vsco-img-preview span { font-size: 11px; font-weight: 600; text-transform: uppercase; }
  .vsco-info h4 { font-size: 17px; font-weight: 700; color: #0F172A; margin-bottom: 6px; }
  .vsco-meta { font-size: 13.5px; color: #64748B; margin-bottom: 16px; }
  .vsco-actions { display: flex; gap: 10px; flex-wrap: wrap; }

  @media (max-width: 640px) {
    .dl-input-group { flex-direction: column; padding: 12px; }
    .dl-input { width: 100%; margin-bottom: 8px; }
    .dl-btn { width: 100%; }
    .vsco-card { flex-direction: column; text-align: center; }
    .vsco-actions { justify-content: center; }
  }
</style>

<script>
  const btn = document.getElementById('vsco-btn');
  const input = document.getElementById('vsco-url') as HTMLInputElement;
  const result = document.getElementById('vsco-result');
  const status = document.getElementById('vsco-status');
  const progressBar = document.getElementById('vsco-progress-bar');
  const progressFill = document.getElementById('vsco-progress-fill');
  const card = document.getElementById('vsco-card');

  btn?.addEventListener('click', () => {
    const url = input?.value.trim();
    if (!url) {
      alert('Please enter a VSCO post or media URL.');
      return;
    }
    if (result) result.style.display = 'block';
    if (progressBar) progressBar.style.display = 'block';
    if (card) card.style.display = 'none';

    let progress = 0;
    if (status) status.textContent = 'Parsing VSCO post media...';
    
    const interval = setInterval(() => {
      progress += 33;
      if (progressFill) progressFill.style.width = progress + '%';

      if (progress >= 100) {
        clearInterval(interval);
        setTimeout(() => {
          if (progressBar) progressBar.style.display = 'none';
          if (status) status.textContent = '✅ VSCO Media ready!';
          if (card) card.style.display = 'flex';
        }, 300);
      }
    }, 200);
  });

  document.getElementById('vsco-download-btn')?.addEventListener('click', () => {
    alert('Demo Download: High resolution VSCO media download initiated!');
  });
  document.getElementById('vsco-copy-btn')?.addEventListener('click', () => {
    alert('Direct media link copied to clipboard!');
  });
</script>
