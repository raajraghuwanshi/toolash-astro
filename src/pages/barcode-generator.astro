---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'barcode-generator')!;
---

<ToolLayout tool={tool}>
  <div class="bg-wrap">
    <div class="bg-form">
      <div class="bg-field">
        <label for="bg-value">Barcode Content</label>
        <input type="text" id="bg-value" class="bg-input" placeholder="Enter text, number, or URL…" value="123456789012" maxlength="50" />
      </div>
      <div class="bg-options">
        <div class="bg-opt">
          <label class="bg-opt-label">Barcode Type</label>
          <select id="bg-type" class="bg-select">
            <option value="EAN13">EAN-13 (12 digits + check)</option>
            <option value="CODE128" selected>Code 128 (alphanumeric)</option>
            <option value="CODE39">Code 39</option>
            <option value="UPC">UPC-A (11 digits)</option>
          </select>
        </div>
        <div class="bg-opt">
          <label class="bg-opt-label">Scale</label>
          <input type="number" id="bg-scale" class="bg-input-sm" value="2" min="1" max="5" />
        </div>
        <div class="bg-opt">
          <label class="bg-opt-label">Height (px)</label>
          <input type="number" id="bg-height" class="bg-input-sm" value="80" min="20" max="300" />
        </div>
        <div class="bg-opt">
          <label class="bg-opt-label">Show Text</label>
          <label class="bg-check"><input type="checkbox" id="bg-show-text" checked /> Show below barcode</label>
        </div>
      </div>
      <button class="btn btn-primary" id="bg-generate"><i class="fas fa-barcode"></i> Generate Barcode</button>
    </div>

    <div id="bg-result" class="bg-result" style="display:none">
      <div class="bg-preview" id="bg-preview"></div>
      <div class="bg-actions">
        <button class="btn btn-primary" id="bg-dl-png"><i class="fas fa-download"></i> Download PNG</button>
        <button class="btn btn-ghost" id="bg-dl-svg"><i class="fas fa-code"></i> Download SVG</button>
        <button class="btn btn-ghost" id="bg-copy-svg"><i class="fas fa-copy"></i> Copy SVG</button>
      </div>
    </div>

    <div class="bg-info">
      <div class="bg-info-title">Barcode Type Guide</div>
      <div class="bg-info-grid">
        <div><strong>EAN-13:</strong> Retail products worldwide</div>
        <div><strong>Code 128:</strong> Logistics, general purpose</div>
        <div><strong>Code 39:</strong> Industrial, alphanumeric</div>
        <div><strong>UPC-A:</strong> US/Canada retail products</div>
      </div>
    </div>
  </div>
</ToolLayout>

<style>
  .bg-wrap { display: flex; flex-direction: column; gap: 20px; }
  .bg-form { display: flex; flex-direction: column; gap: 16px; padding: 24px; background: var(--bg-soft); border: 1.5px solid var(--border); border-radius: var(--radius-md); }
  .bg-field { display: flex; flex-direction: column; gap: 8px; }
  .bg-field label { font-size: 14px; font-weight: 600; color: var(--txt); }
  .bg-input {
    width: 100%;
    padding: 12px 14px;
    font-size: 15px;
    font-family: 'Courier New', monospace;
    font-weight: 600;
    color: var(--txt);
    background: #fff;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    outline: none;
    transition: border-color .2s;
  }
  .bg-input:focus { border-color: var(--brand); }
  .bg-options { display: flex; gap: 16px; flex-wrap: wrap; }
  .bg-opt { display: flex; flex-direction: column; gap: 8px; }
  .bg-opt-label { font-size: 12px; font-weight: 700; color: var(--txt-muted); text-transform: uppercase; letter-spacing: .04em; }
  .bg-select { padding: 9px 12px; font-size: 13px; font-family: 'Inter', sans-serif; color: var(--txt); background: #fff; border: 1.5px solid var(--border); border-radius: var(--radius-sm); outline: none; cursor: pointer; }
  .bg-input-sm { padding: 9px 12px; font-size: 14px; font-family: 'Inter', sans-serif; color: var(--txt); background: #fff; border: 1.5px solid var(--border); border-radius: var(--radius-sm); outline: none; width: 80px; }
  .bg-check { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--txt); cursor: pointer; padding: 9px 0; }
  .bg-check input { accent-color: var(--brand); width: 14px; height: 14px; }

  .bg-result { display: flex; flex-direction: column; align-items: center; gap: 16px; animation: fadeIn .3s ease; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  .bg-preview { padding: 24px 32px; background: #fff; border: 1.5px solid var(--border); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-sm); }
  .bg-preview svg { display: block; }
  .bg-actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }

  .bg-info { padding: 14px 16px; background: #F8FAFC; border: 1.5px solid var(--border); border-radius: var(--radius-sm); }
  .bg-info-title { font-size: 12px; font-weight: 700; color: var(--txt-muted); text-transform: uppercase; margin-bottom: 10px; }
  .bg-info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 13px; color: var(--txt-muted); }
</style>

<script>
  let svgContent = '';

  // Encode Code128 B
  function encodeCode128(data: string): number[] {
    const CODE128_B = ' !"#$%&\'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~';
    const bars = [
      [2,1,2,2,2,2],[2,2,2,1,2,2],[2,2,2,2,2,1],[1,2,1,2,2,3],[1,2,1,3,2,2],[1,3,1,2,2,2],
      [1,2,2,2,1,3],[1,2,2,3,1,2],[1,3,2,2,1,2],[2,2,1,2,1,3],[2,2,1,3,1,2],[2,3,1,2,1,2],
      [1,1,2,2,3,2],[1,2,2,1,3,2],[1,2,2,2,3,1],[1,1,3,2,2,2],[1,2,3,1,2,2],[1,2,3,2,2,1],
      [2,2,3,2,1,1],[2,2,1,1,3,2],[2,2,1,2,3,1],[2,1,3,2,1,2],[2,2,3,1,1,2],[3,1,2,1,3,1],
      [3,1,1,2,2,2],[3,2,1,1,2,2],[3,2,1,2,2,1],[3,1,2,2,1,2],[3,2,2,1,1,2],[3,2,2,2,1,1],
      [2,1,2,1,2,3],[2,1,2,3,2,1],[2,3,2,1,2,1],[1,1,1,3,2,3],[1,3,1,1,3,1],[1,3,1,3,1,1],
      [1,1,2,3,1,3],[1,3,2,1,3,1],[1,3,2,3,1,1],[2,1,1,3,1,3],[2,3,1,1,1,3],[2,3,1,3,1,1],
      [1,1,2,1,3,3],[1,1,2,3,3,1],[1,3,2,1,1,3],[1,1,3,1,2,3],[1,1,3,3,2,1],[1,3,3,1,2,1],
      [3,1,3,1,2,1],[2,1,1,3,3,1],[2,3,1,1,3,1],[2,1,3,1,1,3],[2,1,3,3,1,1],[2,1,3,1,3,1],
      [3,1,1,1,2,3],[3,1,1,3,2,1],[3,3,1,1,2,1],[3,1,2,1,1,3],[3,1,2,3,1,1],[3,3,2,1,1,1],
      [3,1,4,1,1,1],[2,2,1,4,1,1],[4,3,1,1,1,1],[1,1,1,2,2,4],[1,1,1,4,2,2],[1,2,1,1,2,4],
      [1,2,1,4,2,1],[1,4,1,1,2,2],[1,4,1,2,2,1],[1,1,2,2,1,4],[1,1,2,4,1,2],[1,2,2,1,1,4],
      [1,2,2,4,1,1],[1,4,2,1,1,2],[1,4,2,2,1,1],[2,4,1,2,1,1],[2,2,1,1,1,4],[4,1,3,1,1,1],
      [2,4,1,1,1,2],[1,3,4,1,1,1],[1,1,1,2,4,2],[1,2,1,1,4,2],[1,2,1,2,4,1],[1,1,4,2,1,2],
      [1,2,4,1,1,2],[1,2,4,2,1,1],[4,1,1,2,1,2],[4,2,1,1,1,2],[4,2,1,2,1,1],[2,1,2,1,4,1],
      [2,1,4,1,2,1],[4,1,2,1,2,1],[1,1,1,1,4,3],[1,1,1,3,4,1],[1,3,1,1,4,1],[1,1,4,1,1,3],
      [1,1,4,3,1,1],[4,1,1,1,1,3],[4,1,1,3,1,1],[1,1,3,1,4,1],[1,1,4,1,3,1],[3,1,1,1,4,1],
      [4,1,1,1,3,1],[2,1,1,4,1,2],[2,1,1,2,1,4],[2,1,1,2,3,2],[2,3,3,1,1,1,2]
    ];
    // Start B = 104, Stop = 106
    const chars: number[] = [104]; // Start B
    let checksum = 104;
    for (let i = 0; i < data.length; i++) {
      const idx = CODE128_B.indexOf(data[i]);
      if (idx < 0) continue;
      chars.push(idx);
      checksum += (idx) * (i + 1);
    }
    chars.push(checksum % 103);
    chars.push(106); // Stop
    return chars.map(c => bars[c] || []).flat();
  }

  function generateSVG(): string {
    const value = (document.getElementById('bg-value') as HTMLInputElement).value;
    const height = parseInt((document.getElementById('bg-height') as HTMLInputElement).value) || 80;
    const scale = parseInt((document.getElementById('bg-scale') as HTMLInputElement).value) || 2;
    const showText = (document.getElementById('bg-show-text') as HTMLInputElement).checked;

    const widths = encodeCode128(value);
    const barWidth = scale;
    const quietZone = 10 * barWidth;
    const totalBarWidth = widths.reduce((a, b) => a + b, 0) * barWidth;
    const totalWidth = totalBarWidth + quietZone * 2;
    const textHeight = showText ? 16 : 0;
    const totalHeight = height + textHeight + 8;

    let x = quietZone;
    let barsHTML = '';
    for (let i = 0; i < widths.length; i++) {
      const w = widths[i] * barWidth;
      if (i % 2 === 0) {
        barsHTML += `<rect x="${x}" y="4" width="${w}" height="${height}" fill="#000"/>`;
      }
      x += w;
    }

    const textEl = showText ? `<text x="${totalWidth / 2}" y="${height + 4 + textHeight - 2}" font-family="monospace" font-size="10" text-anchor="middle" fill="#000">${value}</text>` : '';

    return `<svg xmlns="http://www.w3.org/2000/svg" width="${totalWidth}" height="${totalHeight}" viewBox="0 0 ${totalWidth} ${totalHeight}" style="background:#fff">
  ${barsHTML}
  ${textEl}
</svg>`;
  }

  document.getElementById('bg-generate')?.addEventListener('click', () => {
    svgContent = generateSVG();
    document.getElementById('bg-preview')!.innerHTML = svgContent;
    document.getElementById('bg-result')!.style.display = '';
  });

  document.getElementById('bg-dl-png')?.addEventListener('click', () => {
    const svg = document.getElementById('bg-preview')!.querySelector('svg')!;
    const canvas = document.createElement('canvas');
    const w = svg.width.baseVal.value, h = svg.height.baseVal.value;
    canvas.width = w * 2; canvas.height = h * 2;
    const ctx = canvas.getContext('2d')!;
    ctx.fillStyle = '#fff';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    const img = new Image();
    const blob = new Blob([svgContent], { type: 'image/svg+xml' });
    img.src = URL.createObjectURL(blob);
    img.onload = () => {
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      const a = document.createElement('a');
      a.download = 'barcode.png';
      a.href = canvas.toDataURL('image/png');
      a.click();
    };
  });

  document.getElementById('bg-dl-svg')?.addEventListener('click', () => {
    const a = document.createElement('a');
    a.download = 'barcode.svg';
    a.href = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svgContent);
    a.click();
  });

  document.getElementById('bg-copy-svg')?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(svgContent);
    const btn = document.getElementById('bg-copy-svg')!;
    btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
    setTimeout(() => btn.innerHTML = '<i class="fas fa-code"></i> Copy SVG', 2000);
  });

  document.getElementById('bg-generate')?.click();
</script>
