---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools, categoryMeta, type Category } from '../data/tools';

const categories: Category[] = ['writing', 'security', 'generators', 'calculators', 'converters', 'media'];

const catIcons: Record<string, string> = {
  writing: 'fa-pen-nib', security: 'fa-shield-halved',
  generators: 'fa-bolt', calculators: 'fa-calculator',
  converters: 'fa-arrows-rotate', media: 'fa-photo-film',
};
---

<BaseLayout
  title="Toolarsh – 35+ Free Online Tools, Calculators & Converters"
  description="Free online calculators, converters, generators, downloaders, and text tools. No sign-up, no installs — fast, accurate results right in your browser."
  keywords="free online tools, online calculators, converters, generators, text tools, toolarsh"
>
  <Navbar />
  <SearchModal />

  <main>

    <!-- ══════════════════════════ HERO ══════════════════════════ -->
    <section class="hero" aria-label="Hero">
      <!-- Ambient glows (Raycast-style) -->
      <div class="hero-glow hero-glow-1" aria-hidden="true"></div>
      <div class="hero-glow hero-glow-2" aria-hidden="true"></div>
      <div class="hero-glow hero-glow-3" aria-hidden="true"></div>
      <!-- Grid bg (Linear-style) -->
      <div class="hero-grid" aria-hidden="true"></div>

      <div class="container hero-inner">
        <!-- Top badge -->
        <div class="hero-badge" data-animate="fade-up">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span>35+ tools · Always free · No sign-up</span>
        </div>

        <!-- Headline -->
        <h1 class="hero-title" data-animate="fade-up">
          Every tool you need,<br/>
          <span class="shimmer-text">right in your browser.</span>
        </h1>

        <!-- Sub -->
        <p class="hero-sub" data-animate="fade-up">
          Free calculators, converters, generators, text tools and more.
          <br/>Open a tool and start in seconds — no sign-up, no installs.
        </p>

        <!-- Command bar (High contrast, crystal clear in light and dark) -->
        <div class="hero-cmd-wrap" data-animate="fade-up">
          <button class="hero-cmd" id="hero-search-trigger" aria-label="Open search — find any tool">
            <div class="hcmd-left">
              <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
              <span class="font-mono">Search 35+ tools… (or press ⌘K)</span>
            </div>
            <kbd aria-label="Keyboard shortcut Control K">⌘K</kbd>
          </button>
        </div>

        <!-- Category chips -->
        <div class="hero-chips" data-animate="fade-up" role="list" aria-label="Browse by category">
          {categories.map((cat, i) => {
            const m = categoryMeta[cat];
            const count = tools.filter(t => t.category === cat).length;
            return (
              <a
                class="hero-chip"
                href={`#${cat}`}
                role="listitem"
                style={`--cc: ${m.color}`}
                aria-label={`${m.label} — ${count} tools`}
              >
                <i class={`fas ${catIcons[cat]}`} style={`color: ${m.color}`} aria-hidden="true"></i>
                <span>{m.label}</span>
                <span class="chip-count">{count}</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════ ALL TOOLS ══════════════════════════ -->
    <section class="tools-section" id="all-tools" aria-labelledby="tools-h" data-animate="fade-up">
      <div class="container">
        <div class="section-header">
          <div>
            <span class="section-label"><i class="fas fa-toolbox" aria-hidden="true"></i> All Tools</span>
            <h2 id="tools-h" class="section-title">Pick one and start instantly</h2>
          </div>
          <div class="filter-row" role="tablist" aria-label="Filter tools">
            <button class="filter-pill active" data-filter="all" role="tab" aria-selected="true">All</button>
            {categories.map(cat => (
              <button class="filter-pill" data-filter={cat} role="tab" aria-selected="false"
                style={`--cc:${categoryMeta[cat].color}`}>
                {categoryMeta[cat].label}
              </button>
            ))}
          </div>
        </div>

        <div class="tools-grid" id="tools-grid" role="list" aria-label="All available tools">
          {tools.map(tool => (
            <div class="tool-grid-item" data-category={tool.category} role="listitem">
              <ToolCard tool={tool} />
            </div>
          ))}
        </div>
        <div class="no-results" id="no-results" style="display:none" role="status" aria-live="polite">
          <i class="fas fa-face-sad-tear" aria-hidden="true"></i>
          <p class="font-mono">Nothing here yet.</p>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════ CAT SECTIONS ══════════════════════════ -->
    {categories.map((cat, i) => {
      const m = categoryMeta[cat];
      const catTools = tools.filter(t => t.category === cat);
      return (
        <section
          class={`cat-section ${i % 2 === 1 ? 'cat-section-alt' : ''}`}
          id={cat}
          aria-labelledby={`cs-h-${cat}`}
          data-animate="fade-up"
        >
          <div class="container">
            <div class="cat-hd">
              <div class="cat-hd-icon" style={`background:${m.bg}; color:${m.color}`} aria-hidden="true">
                <i class={`fas ${catIcons[cat]}`}></i>
              </div>
              <div>
                <h2 id={`cs-h-${cat}`} class="cat-title">{m.label}</h2>
                <p class="cat-desc">{m.description}</p>
              </div>
              <a class="cat-all-link" href={`#${cat}`} aria-label={`See all ${m.label} tools`}>
                All {m.label} <i class="fas fa-arrow-right" aria-hidden="true"></i>
              </a>
            </div>
            <div class="tools-grid" role="list" aria-label={`${m.label} tools`}>
              {catTools.map(tool => <ToolCard tool={tool} />)}
            </div>
          </div>
        </section>
      );
    })}

    <!-- ══════════════════════════ FEATURES ══════════════════════════ -->
    <section class="features-section" aria-labelledby="feat-h" data-animate="fade-up">
      <div class="container">
        <div class="feat-top">
          <span class="section-label"><i class="fas fa-sparkles" aria-hidden="true"></i> Why Toolarsh</span>
          <h2 id="feat-h" class="section-title">Built for speed, privacy & simplicity.</h2>
        </div>
        <div class="feat-grid" role="list">
          {[
            { icon: 'fa-bolt', color: '#D97706', bg: 'rgba(217,119,6,0.1)', title: 'Instant results', desc: 'No upload queues. No processing delays. Tools run entirely in your browser for instant feedback.' },
            { icon: 'fa-shield-halved', color: '#059669', bg: 'rgba(5,150,105,0.1)', title: 'Private by design', desc: 'Your data never leaves your device. Zero tracking, zero storage, zero risk.' },
            { icon: 'fa-user-slash', color: '#EA580C', bg: 'rgba(234,88,12,0.1)', title: 'Zero sign-up', desc: 'No account. No email. No credit card. Every tool is open and ready, always.' },
            { icon: 'fa-mobile-screen', color: '#0D9488', bg: 'rgba(13,148,136,0.1)', title: 'Works everywhere', desc: 'Fully responsive. Open any tool on your phone, tablet, or desktop — it just works.' },
            { icon: 'fa-infinity', color: '#F59E0B', bg: 'rgba(245,158,11,0.1)', title: 'Unlimited usage', desc: 'No daily limits, no usage caps, no feature gates. Use every tool as often as you need.' },
            { icon: 'fa-code-branch', color: '#E11D48', bg: 'rgba(225,29,72,0.1)', title: 'Always improving', desc: 'New tools and improvements ship regularly. Bookmark the site and check back anytime.' },
          ].map(f => (
            <div class="feat-card" role="listitem">
              <div class="feat-icon" style={`background:${f.bg}; color:${f.color}`} aria-hidden="true">
                <i class={`fas ${f.icon}`}></i>
              </div>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════ FAQ ══════════════════════════ -->
    <section class="faq-section" aria-labelledby="faq-h">
      <div class="container">
        <div class="faq-inner">
          <div class="faq-left">
            <span class="section-label"><i class="fas fa-circle-question" aria-hidden="true"></i> FAQ</span>
            <h2 id="faq-h" class="section-title">Frequently asked</h2>
            <p class="faq-sub">Can't find your answer? <a href="/contact">Contact us →</a></p>
          </div>
          <div class="faq-list">
            {[
              { q: 'Are all tools completely free?', a: 'Yes — every single tool is 100% free, forever. No subscriptions, no hidden fees, no "pro" tier.' },
              { q: 'Do I need an account?', a: 'No. Just open any tool and use it. No account, no email, no password needed.' },
              { q: 'Is my data private?', a: 'Yes. Most tools run entirely in your browser — your input never reaches our servers.' },
              { q: 'What kinds of tools are available?', a: 'Text & writing, security, generators, calculators, converters, media tools — 35+ and growing.' },
              { q: 'Does Toolarsh work on mobile?', a: 'Absolutely. Every tool is fully responsive and optimized for phones, tablets, and desktops.' },
              { q: 'Are there usage limits?', a: 'None. No daily caps, no usage limits. Use any tool as often as you need, whenever you need.' },
            ].map((faq, i) => (
              <div class="faq-item" id={`faq-${i}`}>
                <button class="faq-question" aria-expanded="false" aria-controls={`faq-ans-${i}`} id={`faq-btn-${i}`}>
                  <span>{faq.q}</span>
                  <div class="faq-icon" aria-hidden="true"><i class="fas fa-plus"></i></div>
                </button>
                <div class="faq-answer" id={`faq-ans-${i}`} role="region" aria-labelledby={`faq-btn-${i}`}>
                  <p>{faq.a}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  /* ── HERO ───────────────────────────────────────────── */
  .hero {
    position: relative; overflow: hidden;
    padding: 96px 0 84px;
    border-bottom: 1px solid var(--border);
  }
  .hero-glow {
    position: absolute; border-radius: 50%;
    pointer-events: none; filter: blur(90px);
  }
  .hero-glow-1 {
    width: 700px; height: 500px;
    background: radial-gradient(ellipse, var(--brand-glow) 0%, transparent 70%);
    top: -200px; left: 50%; transform: translateX(-50%);
  }
  .hero-glow-2 {
    width: 450px; height: 320px;
    background: radial-gradient(ellipse, var(--amber-soft) 0%, transparent 70%);
    top: 0; right: 8%;
  }
  .hero-glow-3 {
    width: 350px; height: 240px;
    background: radial-gradient(ellipse, rgba(13, 148, 136, 0.08) 0%, transparent 70%);
    bottom: 0; left: 12%;
  }
  .hero-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, black 20%, transparent 80%);
    pointer-events: none;
  }
  .hero-inner {
    position: relative; z-index: 1;
    display: flex; flex-direction: column;
    align-items: center; text-align: center;
  }

  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 12px; font-weight: 600;
    color: var(--txt-muted); font-family: 'JetBrains Mono', monospace;
    background: var(--surface-2);
    border: 1px solid var(--border-mid);
    padding: 6px 16px; border-radius: 100px;
    margin-bottom: 28px;
    letter-spacing: .02em;
    box-shadow: var(--shadow-sm);
  }

  .hero-title {
    font-size: clamp(2.6rem, 5.5vw, 4.8rem);
    font-weight: 800;
    color: var(--txt);
    line-height: 1.1;
    letter-spacing: -1.8px;
    margin-bottom: 20px;
    max-width: 820px;
  }

  .hero-sub {
    font-size: 16.5px; color: var(--txt-muted);
    line-height: 1.65; margin-bottom: 36px;
    max-width: 520px;
  }

  /* Command bar (High contrast, crystal clear in light and dark) */
  .hero-cmd-wrap { width: 100%; max-width: 520px; margin-bottom: 32px; }
  .hero-cmd {
    display: flex; align-items: center; justify-content: space-between;
    width: 100%;
    background: var(--surface-2);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--webkit-glass-blur);
    border: 1.5px solid var(--border-mid);
    border-radius: var(--radius-lg);
    padding: 14px 20px;
    cursor: pointer; font-family: inherit;
    transition: all .2s ease;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05), var(--glass-inner-glow);
  }
  .hero-cmd:hover {
    background: var(--surface-solid);
    border-color: var(--brand);
    box-shadow: 0 6px 24px rgba(5, 150, 105, 0.16), 0 0 0 3px var(--brand-soft);
    transform: translateY(-2px);
  }
  .hcmd-left { display: flex; align-items: center; gap: 12px; }
  .hcmd-left i { font-size: 16px; color: var(--brand); }
  .hcmd-left span { font-size: 14px; color: var(--txt-dim); font-weight: 500; }

  /* Chips (Glassmorphic) */
  .hero-chips {
    display: flex; flex-wrap: wrap; gap: 8px;
    justify-content: center; max-width: 720px;
  }
  .hero-chip {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 7px 15px;
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--webkit-glass-blur);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 12.5px; font-weight: 500;
    color: var(--txt-muted);
    transition: all .18s ease;
    box-shadow: var(--shadow-sm);
  }
  .hero-chip:hover {
    border-color: var(--cc);
    color: var(--cc);
    background: var(--glass-bg-hover);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    transform: translateY(-2px);
  }
  .hero-chip i { font-size: 11px; }
  .chip-count {
    font-size: 10.5px; font-weight: 600;
    color: var(--txt-dim); font-family: 'JetBrains Mono', monospace;
    background: var(--surface-3); border-radius: 100px;
    padding: 1px 7px;
  }

  /* ── TOOLS SECTION ─────────────────────────────────── */
  .tools-section { padding: 80px 0; }
  .section-header {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 24px; margin-bottom: 32px; flex-wrap: wrap;
  }
  .section-title { font-size: clamp(1.4rem, 2.5vw, 1.9rem); font-weight: 700; color: var(--txt); margin-top: 6px; }
  .filter-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .tools-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .tool-grid-item { transition: opacity .2s; }
  .no-results { padding: 56px 0; text-align: center; color: var(--txt-dim); font-size: 13.5px; }
  .no-results i { font-size: 28px; opacity: .3; display: block; margin-bottom: 8px; }

  /* ── CAT SECTIONS ─────────────────────────────────── */
  .cat-section { padding: 68px 0; border-top: 1px solid var(--border); }
  .cat-section-alt { background: var(--surface); }
  .cat-hd {
    display: flex; align-items: flex-start; gap: 16px;
    margin-bottom: 28px;
  }
  .cat-hd-icon {
    width: 42px; height: 42px; border-radius: var(--radius-md);
    display: flex; align-items: center; justify-content: center;
    font-size: 17px; flex-shrink: 0;
    box-shadow: var(--shadow-sm);
  }
  .cat-title { font-size: 1.35rem; font-weight: 700; color: var(--txt); margin-bottom: 3px; }
  .cat-desc { font-size: 13.5px; color: var(--txt-muted); }
  .cat-all-link {
    margin-left: auto; flex-shrink: 0;
    font-size: 12.5px; font-weight: 600; color: var(--brand);
    font-family: 'JetBrains Mono', monospace;
    display: flex; align-items: center; gap: 6px;
    transition: gap .15s ease; padding-top: 2px;
  }
  .cat-all-link:hover { gap: 9px; }

  /* ── FEATURES (Glassmorphic) ─────────────────────── */
  .features-section {
    padding: 88px 0;
    border-top: 1px solid var(--border);
    background: var(--surface);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--webkit-glass-blur);
  }
  .feat-top { margin-bottom: 48px; }
  .feat-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl); overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .feat-card {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--webkit-glass-blur);
    padding: 30px 26px;
    transition: background .18s ease, transform .18s ease;
  }
  .feat-card:hover { background: var(--glass-bg-hover); }
  .feat-icon {
    width: 40px; height: 40px; border-radius: var(--radius-md);
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; margin-bottom: 16px;
    box-shadow: var(--shadow-sm);
  }
  .feat-card h3 { font-size: 15px; font-weight: 600; color: var(--txt); margin-bottom: 8px; }
  .feat-card p { font-size: 13px; color: var(--txt-muted); line-height: 1.65; }

  /* ── FAQ ──────────────────────────────────────────── */
  .faq-section { padding: 80px 0; border-top: 1px solid var(--border); }
  .faq-inner { display: grid; grid-template-columns: 280px 1fr; gap: 80px; align-items: start; }
  .faq-left { position: sticky; top: 84px; }
  .faq-left .section-label { margin-bottom: 10px; }
  .faq-sub { font-size: 13.5px; color: var(--txt-dim); margin-top: 14px; }
  .faq-sub a { color: var(--brand); text-decoration: none; font-weight: 500; }
  .faq-sub a:hover { text-decoration: underline; }

  /* ── RESPONSIVE ───────────────────────────────────── */
  @media (max-width: 1024px) {
    .tools-grid { grid-template-columns: repeat(3, 1fr); }
    .feat-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .hero { padding: 68px 0 60px; }
    .hero-title { letter-spacing: -1px; }
    .hero-sub { font-size: 15px; }
    .tools-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .section-header { flex-direction: column; align-items: flex-start; }
    .cat-hd { flex-wrap: wrap; }
    .cat-all-link { margin-left: 0; }
    .feat-grid { grid-template-columns: 1fr; }
    .faq-inner { grid-template-columns: 1fr; gap: 36px; }
    .faq-left { position: static; }
  }
  @media (max-width: 480px) {
    .tools-grid { grid-template-columns: 1fr; }
    .hero-chips { justify-content: flex-start; }
  }
</style>

<script>
  // Staggered animation for hero elements
  const heroItems = document.querySelectorAll('.hero [data-animate]');
  heroItems.forEach((el, i) => {
    (el as HTMLElement).style.transitionDelay = `${i * 0.08}s`;
  });

  document.getElementById('hero-search-trigger')?.addEventListener('click', () => {
    if (typeof (window as any).openSearchModal === 'function') { (window as any).openSearchModal(); }
    else { document.getElementById('search-overlay')?.classList.add('open'); (document.getElementById('search-input') as HTMLInputElement)?.focus(); }
  });

  const pills = document.querySelectorAll('.filter-pill');
  const items = document.querySelectorAll('.tool-grid-item');
  const noRes = document.getElementById('no-results');
  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      const f = (pill as HTMLElement).dataset.filter ?? 'all';
      pills.forEach(p => { p.classList.remove('active'); p.setAttribute('aria-selected','false'); });
      pill.classList.add('active'); pill.setAttribute('aria-selected','true');
      let v = 0;
      items.forEach(item => {
        const show = f === 'all' || (item as HTMLElement).dataset.category === f;
        (item as HTMLElement).style.display = show ? '' : 'none';
        if (show) v++;
      });
      if (noRes) noRes.style.display = v === 0 ? '' : 'none';
    });
  });

  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const isOpen = item?.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(el => { el.classList.remove('open'); el.querySelector('.faq-question')?.setAttribute('aria-expanded','false'); });
      if (!isOpen) { item?.classList.add('open'); btn.setAttribute('aria-expanded','true'); }
    });
  });
</script>
