---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
---

<BaseLayout
  title="About Us – Toolarsh"
  description="Learn about Toolarsh's mission to provide fast, free, and privacy-focused browser tools for everyone."
>
  <Navbar />
  <SearchModal />

  <main class="about-page">
    <div class="container">
      <div class="about-hero">
        <span class="badge badge-free"><i class="fas fa-heart"></i> Built for Everyone</span>
        <h1 class="font-display about-title">Free, Instant & Private Tools for the Modern Web</h1>
        <p class="about-subtitle">
          Toolarsh was created with a simple mission: build fast, clean, zero-friction utilities that help students, developers, and creators get work done without paywalls or sign-ups.
        </p>
      </div>

      <div class="about-grid">
        <div class="about-card">
          <div class="about-icon" style="background:var(--gen-bg); color:var(--gen-color)"><i class="fas fa-bolt"></i></div>
          <h3>Lightning Fast</h3>
          <p>Tools process data instantly in your browser without unnecessary server roundtrips or bloated page loads.</p>
        </div>

        <div class="about-card">
          <div class="about-icon" style="background:var(--security-bg); color:var(--security-color)"><i class="fas fa-shield-halved"></i></div>
          <h3>Privacy First</h3>
          <p>Your inputs remain on your device. We do not store, track, or sell your text, files, or calculations.</p>
        </div>

        <div class="about-card">
          <div class="about-icon" style="background:var(--writing-bg); color:var(--writing-color)"><i class="fas fa-user-slash"></i></div>
          <h3>100% Free Forever</h3>
          <p>No subscriptions, no hidden fees, and no account registrations required. Open any tool and start instantly.</p>
        </div>
      </div>

      <div class="about-section">
        <h2>What We Offer</h2>
        <p>
          Our suite covers 35+ utilities across Writing & Text, Security, Generators, Calculators, Converters, and Media downloaders. Whether you're formatting text, generating UUIDs, calculating EMIs, or translating content, Toolarsh is designed to be your default browser toolkit.
        </p>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .about-page { padding: 60px 0 80px; }
  .about-hero { text-align: center; max-width: 760px; margin: 0 auto 56px; }
  .about-title { font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 800; color: var(--txt); margin: 16px 0; line-height: 1.15; letter-spacing: -.6px; }
  .about-subtitle { font-size: 16.5px; color: var(--txt-muted); line-height: 1.65; }
  .about-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 56px; }
  .about-card {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--webkit-glass-blur);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 32px 24px;
    text-align: center;
    box-shadow: var(--shadow-sm), var(--glass-inner-glow);
    transition: transform .2s ease, background .2s ease;
  }
  .about-card:hover { transform: translateY(-3px); background: var(--glass-bg-hover); }
  .about-icon { width: 52px; height: 52px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 22px; margin: 0 auto 16px; box-shadow: var(--shadow-sm); }
  .about-card h3 { font-size: 17px; font-weight: 700; color: var(--txt); margin-bottom: 8px; }
  .about-card p { font-size: 13.5px; color: var(--txt-muted); line-height: 1.6; }
  .about-section {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--webkit-glass-blur);
    border-radius: var(--radius-xl);
    padding: 40px;
    border: 1px solid var(--glass-border);
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    box-shadow: var(--glass-shadow), var(--glass-inner-glow);
  }
  .about-section h2 { font-size: 22px; font-weight: 800; color: var(--txt); margin-bottom: 12px; letter-spacing: -.4px; }
  .about-section p { font-size: 14.5px; color: var(--txt-muted); line-height: 1.7; }
  @media (max-width: 768px) { .about-grid { grid-template-columns: 1fr; } }
</style>
