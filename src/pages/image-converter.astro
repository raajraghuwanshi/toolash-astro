---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'image-converter')!;
---

<ToolLayout tool={tool} customLayout={true}>
  <div class="tool-page-wrap">
    <!-- Hero Box -->
    <div class="tool-hero-box">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
        <div class="tool-hero-badge">
          <i class="fas fa-wand-magic-sparkles"></i>
          <span>CANVAS HARDWARE RASTER ENGINE &bull; 100% PRIVATE</span>
        </div>
        <div class="flex items-center gap-3 text-xs text-[var(--txt-dim)] font-mono">
          <span><i class="fas fa-lock text-[var(--brand)] mr-1"></i> No Server Uploads</span>
          <span>&bull;</span>
          <span><i class="fas fa-bolt text-[var(--amber)] mr-1"></i> Multi-Threading</span>
        </div>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--txt)] mb-2">
        Batch <span class="bg-gradient-to-r from-emerald-500 to-teal-400 bg-clip-text text-transparent">Image Converter & Resizer</span>
      </h1>
      <p class="text-sm sm:text-base text-[var(--txt-muted)] max-w-2xl leading-relaxed">
        Convert JPG, PNG, WEBP, BMP, and SVG files instantly in your browser. Fine-tune compression ratios, strip excess metadata, and resize dimensions with zero server uploads.
      </p>
    </div>

    <!-- Interactive Graphic Lab Studio -->
    <main class="space-y-8">
      <div class="tool-card-surface flex flex-col gap-6">
        
        <!-- Drag & Drop Upload Zone -->
        <div class="relative border-2 border-dashed border-[var(--border)] hover:border-[var(--brand)] rounded-3xl p-8 sm:p-12 text-center bg-[var(--surface-2)]/50 transition-all group cursor-pointer" id="ic-upload-area">
          <input type="file" id="ic-file" accept="image/*" multiple class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10" />
          <div class="w-14 h-14 rounded-2xl bg-[var(--brand)] text-white flex items-center justify-center text-xl mx-auto mb-3 group-hover:scale-105 shadow-md shadow-emerald-500/20 transition-transform">
            <i class="fas fa-cloud-arrow-up"></i>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-[var(--txt)] mb-1">
            Drop your images here, or <span class="text-[var(--brand)] underline">browse files</span>
          </h3>
          <p class="text-xs sm:text-sm text-[var(--txt-muted)]">
            Supports PNG, JPG, WEBP, BMP, GIF, and SVG &bull; Batch selection supported
          </p>
        </div>

        <!-- Conversion Settings Controls -->
        <div class="p-4 sm:p-5 rounded-2xl bg-[var(--surface-2)] border border-[var(--border)] grid grid-cols-1 md:grid-cols-3 gap-5">
          <!-- Target Format Selector -->
          <div>
            <label class="block text-xs font-mono font-bold uppercase text-[var(--txt-dim)] mb-2">Target Format</label>
            <div class="tool-tab-segment" role="tablist" aria-label="Target Format">
              <button class="tool-tab-btn ic-fmt-btn active" data-fmt="png" role="tab" aria-selected="true">PNG</button>
              <button class="tool-tab-btn ic-fmt-btn" data-fmt="jpeg" role="tab" aria-selected="false">JPG</button>
              <button class="tool-tab-btn ic-fmt-btn" data-fmt="webp" role="tab" aria-selected="false">WEBP</button>
              <button class="tool-tab-btn ic-fmt-btn" data-fmt="bmp" role="tab" aria-selected="false">BMP</button>
            </div>
          </div>

          <!-- Quality Slider -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="text-xs font-mono font-bold uppercase text-[var(--txt-dim)]">Compression Quality</label>
              <span id="ic-quality-val" class="text-xs font-bold text-[var(--brand)] font-mono">90%</span>
            </div>
            <input type="range" id="ic-quality" min="10" max="100" value="90" class="w-full accent-[var(--brand)] cursor-pointer" />
            <span class="text-[11px] text-[var(--txt-dim)] mt-1 block">Applies to JPG and WEBP compression</span>
          </div>

          <!-- Max Width Resize -->
          <div>
            <label class="block text-xs font-mono font-bold uppercase text-[var(--txt-dim)] mb-2" for="ic-max-width">Max Width Constraint (px)</label>
            <input
              type="number"
              id="ic-max-width"
              class="tool-control-input text-xs font-mono"
              placeholder="Leave blank for original width"
              min="1"
              max="8192"
            />
          </div>
        </div>

        <!-- Batch Processing Queue -->
        <div id="ic-queue" class="rounded-2xl border border-[var(--border)] overflow-hidden" style="display:none">
          <div class="px-5 py-3.5 bg-[var(--surface-2)] border-b border-[var(--border)] flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[var(--txt)]">
              Conversion Queue (<span id="ic-queue-count" class="text-[var(--brand)]">0</span>)
            </span>
            <button
              class="px-4 py-1.5 rounded-xl font-bold text-xs text-white bg-[var(--brand)] hover:opacity-95 shadow-sm transition-all flex items-center gap-1.5"
              id="ic-convert-all"
            >
              <i class="fas fa-arrows-rotate"></i> Convert All
            </button>
          </div>
          <div class="divide-y divide-[var(--border)] max-h-96 overflow-y-auto" id="ic-list"></div>
        </div>
      </div>

      <!-- Digital Image Science: Single Long-Form Article Archetype -->
      <!-- Image Compression Treatises & FAQ -->
      <div class="tool-content-wrap">
        <article class="tool-content-card space-y-12">
          <!-- Article Lead Header -->
          <div class="tool-content-header">
            <span class="tool-badge-pill mb-3">Computer Vision &amp; Compression Standards</span>
            <h2>The Physics and Mathematics of Digital Imagery: From Discrete Cosine Transforms to WebP Entropy Encoders</h2>
            <p>
              An engineering treatise on why modern digital images are never stored as raw pixels, how frequency-domain psychoacoustic models compress bitmap payloads by 90%, and how client-side hardware canvas pipelines eliminate server-side privacy risks.
            </p>
          </div>

        <!-- Chapter 1: The Raw Raster Bottleneck -->
        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-bold text-[var(--txt)] tracking-tight">
            1. The Raw Raster Bottleneck: Spatial Resolution vs. Quantization Depth
          </h3>
          <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
            At its electronic core, a digital display is a two-dimensional grid of discrete picture elements (pixels). In standard 24-bit Truecolor formats, every single pixel requires three 8-bit bytes (Red, Green, Blue), plus an optional fourth 8-bit byte for alpha channel transparency in 32-bit RGBA framebuffers.
          </p>
          <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
            Consider a typical modern 12-megapixel smartphone photograph captured at 4000 &times; 3000 pixels. Stored as raw uncompressed raster data (such as Windows BMP or memory canvas buffers):
          </p>

          <!-- Mathematical Box -->
          <div class="border border-[var(--border)] rounded-2xl p-5 bg-[var(--surface-2)]/40 font-mono text-xs space-y-2">
            <div class="text-[var(--txt)] font-bold">
              Uncompressed Memory Payload = Width &times; Height &times; Channels
            </div>
            <div class="text-[var(--txt-muted)]">
              4,000 &times; 3,000 &times; 4 bytes (RGBA) = 48,000,000 bytes &asymp; <strong class="text-rose-400">45.77 Megabytes</strong>
            </div>
            <p class="text-[11px] text-[var(--txt-dim)] font-sans mt-2">
              If websites delivered raw uncompressed raster graphics, a simple 10-image gallery would consume half a gigabyte of mobile cellular data and crash mobile browser memory pools. Image compression is not a mere convenience&mdash;it is the computational foundation of the visual web.
            </p>
          </div>
        </section>

        <!-- Chapter 2: The JPEG Standard and DCT -->
        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-bold text-[var(--txt)] tracking-tight">
            2. JPEG &amp; The Discrete Cosine Transform: Discarding What the Eye Cannot See
          </h3>
          <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
            Standardized in 1992 by the Joint Photographic Experts Group (ITU-T T.81), JPEG achieves extreme data reduction by exploiting human psychovisual limitations through a five-stage transformation pipeline:
          </p>
          <ol class="space-y-3 text-sm text-[var(--txt-muted)] list-decimal pl-5 leading-relaxed">
            <li>
              <strong class="text-[var(--txt)]">Color Space Translation (RGB to YC<sub>b</sub>C<sub>r</sub>):</strong>
              RGB channels are mathematically separated into Luminance (Y, brightness) and two Chrominance channels (C<sub>b</sub> blue-difference and C<sub>r</sub> red-difference).
            </li>
            <li>
              <strong class="text-[var(--txt)]">Chroma Subsampling (4:2:0):</strong>
              Because human retinal fovea contain approximately 120 million rod cells (light intensity) but only 6 to 7 million cone cells (color discrimination), chrominance resolution can be cut by 50% horizontally and vertically without perceived degradation.
            </li>
            <li>
              <strong class="text-[var(--txt)]">8&times;8 Block Partition &amp; 2D Discrete Cosine Transform (DCT):</strong>
              The spatial image is split into 64-pixel blocks. The DCT translates spatial pixel intensities into 64 sinusoidal frequency components: one DC coefficient (overall block brightness) and 63 AC coefficients representing fine diagonal, horizontal, and vertical details.
            </li>
            <li>
              <strong class="text-[var(--txt)]">Quantization (The Lossy Step):</strong>
              The frequency coefficients are divided by a psycho-visually weighted quantization matrix and rounded to the nearest integer. High-frequency noise that the human eye cannot perceive is rounded down to zero, collapsing vast arrays of coefficients.
            </li>
            <li>
              <strong class="text-[var(--txt)]">Zig-Zag Run-Length &amp; Huffman Entropy Coding:</strong>
              The quantized matrix is traversed in a diagonal zig-zag pattern, grouping the long strings of trailing zeros into compact run-length markers and Huffman-encoded byte streams.
            </li>
          </ol>
        </section>

        <!-- Chapter 3: Lossless PNG Architecture -->
        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-bold text-[var(--txt)] tracking-tight">
            3. PNG &amp; Deflate: Deterministic Lossless Fidelity for UI and Typography
          </h3>
          <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
            While JPEG excels at continuous-tone photography, it fails catastrophically on vector illustrations, computer user interfaces, screenshots, and typography. High-frequency sharp contrast edges (such as black text on white backgrounds) produce visible high-frequency &ldquo;ringing&rdquo; artifacts around letters due to DCT quantization error.
          </p>
          <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
            The Portable Network Graphics (PNG) specification solves this through deterministic lossless compression combining two mathematical techniques:
          </p>
          <div class="space-y-3 text-sm text-[var(--txt-muted)] pl-4 border-l-2 border-[var(--brand)]">
            <p>
              <strong class="text-[var(--txt)]">Pre-Compression Delta Filtering:</strong> Before compression, each horizontal scanline passes through one of five predictor filters (None, Sub, Up, Average, or Paeth). By recording only the difference between adjacent pixels rather than raw color values, flat blocks of solid UI colors transform into long sequences of zeros.
            </p>
            <p>
              <strong class="text-[var(--txt)]">DEFLATE Compression (LZ77 + Huffman):</strong> The filtered byte stream is compressed using the open-source DEFLATE algorithm, matching duplicated byte strings in a 32KB sliding window and encoding common tokens with variable-length Huffman bit sequences.
            </p>
          </div>
        </section>

        <!-- Chapter 4: Next-Gen WebP and AVIF Encoders -->
        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-bold text-[var(--txt)] tracking-tight">
            4. WebP &amp; Modern Vector Predictive Intra-Frame Encoding
          </h3>
          <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
            Introduced by Google and derived from the VP8 video keyframe codec, <strong>WebP</strong> bridges the gap between lossy and lossless algorithms. Unlike JPEG&rsquo;s rigid 8&times;8 blocks, WebP divides images into 16&times;16 macroblocks and applies directional intra-frame prediction across four discrete modes:
          </p>
          <ul class="space-y-2 text-sm text-[var(--txt-muted)] list-disc pl-5 leading-relaxed">
            <li><strong class="text-[var(--txt)]">H-Predict:</strong> Fills columns by predicting pixel values from the immediate left boundary.</li>
            <li><strong class="text-[var(--txt)]">V-Predict:</strong> Fills rows by predicting pixel values from the immediate top boundary.</li>
            <li><strong class="text-[var(--txt)]">DC-Predict:</strong> Fills the block with the single average luminosity of the surrounding perimeter.</li>
            <li><strong class="text-[var(--txt)]">TrueMotion:</strong> Uses spatial delta derivatives to preserve soft gradients without banding.</li>
          </ul>
          <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
            By encoding only the predictive residual errors rather than the raw pixel blocks, WebP files are typically <strong>26% smaller than comparable PNGs</strong> and <strong>25% to 34% smaller than comparable JPEGs</strong> at identical structural similarity index (SSIM) ratings, while retaining complete 8-bit alpha channel transparency.
          </p>
        </section>

        <!-- Chapter 5: In-Browser Hardware Canvas Acceleration -->
        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-bold text-[var(--txt)] tracking-tight">
            5. Client-Side Security: Why Canvas Hardware Rasterization Outperforms Server Uploads
          </h3>
          <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
            Traditional online image converters require users to upload confidential photos, invoices, and family documents to third-party cloud servers. These servers buffer your files on remote hard drives, execute batch ImageMagick scripts, and expose personal metadata (GPS coordinates, camera serial numbers, and timestamps).
          </p>
          <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
            Toolarsh Image Converter fundamentally eliminates this vulnerability by executing 100% of decoding, resizing, and re-encoding inside your computer&rsquo;s local browser runtime via the HTML5 <code>CanvasRenderingContext2D</code> and WebGL rendering APIs:
          </p>
          <div class="p-4 rounded-xl bg-[var(--surface-3)]/60 border border-[var(--border)] font-mono text-xs text-[var(--txt)] overflow-x-auto space-y-1">
            <div class="text-[var(--txt-muted)]">// Direct GPU-backed buffer rasterization in browser</div>
            <div>const canvas = document.createElement('canvas');</div>
            <div>const ctx = canvas.getContext('2d');</div>
            <div>ctx.drawImage(sourceImage, 0, 0, targetWidth, targetHeight);</div>
            <div>canvas.toBlob(blob =&gt; download(blob), 'image/webp', 0.90);</div>
          </div>
          <p class="text-xs sm:text-sm text-[var(--txt-muted)] leading-relaxed">
            No bytes leave your device. All intermediate memory buffers are immediately garbage-collected via <code>URL.revokeObjectURL()</code>, ensuring true zero-footprint processing.
          </p>
        </section>

        <!-- Chapter 6: Technical Inquiries FAQ (Hairline Accordion) -->
        <section class="border-t border-[var(--border)] pt-10 space-y-6">
          <h3 class="text-xl sm:text-2xl font-black text-[var(--txt)] tracking-tight">
            Frequently Asked Image Encoding Inquiries
          </h3>

          <div class="tool-faq-accordion">
            <details class="tool-faq-item">
              <summary>
                <span>Why does converting a simple PNG to JPEG sometimes increase file size?</span>
                <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
              </summary>
              <div class="faq-answer">
                PNG uses run-length delta encoding (DEFLATE), which collapses vast expanses of solid color into a handful of bytes. When converted to JPEG, the 8&times;8 Discrete Cosine Transform attempts to mathematically model flat fields using continuous cosine waves, which produces high-frequency mathematical noise and Huffman overhead, paradoxically resulting in a larger file than the clean lossless PNG.
              </div>
            </details>

            <details class="tool-faq-item">
              <summary>
                <span>Does converting an image back and forth degrade quality progressively?</span>
                <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
              </summary>
              <div class="faq-answer">
                Yes. Each time a lossy format (JPEG or lossy WebP) is re-encoded, the spatial pixels undergo a fresh Discrete Cosine Transform and quantization rounding cycle. Round-off errors compound, causing macroblocking and color drift. However, converting a JPEG into lossless PNG preserves the current state without introducing any further degradation, and converting from lossless PNG to WebP produces only a single initial compression pass.
              </div>
            </details>

            <details class="tool-faq-item">
              <summary>
                <span>How does setting a Max Width constraint improve web performance?</span>
                <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
              </summary>
              <div class="faq-answer">
                Raw smartphone camera photos frequently measure 4032 &times; 3024 pixels. Even on a 4K desktop monitor, a blog or product hero image is rarely displayed wider than 1200 to 1920 CSS pixels. Sending full-resolution photos forces the visitor's mobile CPU to decode and downscale 12 million pixels in memory. Downscaling to 1920px before upload reduces the pixel count by 77%, directly improving Core Web Vitals (Largest Contentful Paint) and reducing memory pressure on mobile devices.
              </div>
            </details>
          </div>
        </section>

      </article>
      </div>
    </main>
  </div>
</ToolLayout>

<script>
  let targetFormat = 'png';
  let files: { file: File; id: number }[] = [];
  let idCounter = 0;

  document.querySelectorAll('.ic-fmt-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.ic-fmt-btn').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      targetFormat = (btn as HTMLElement).dataset.fmt!;
    });
  });

  const qualitySlider = document.getElementById('ic-quality') as HTMLInputElement;
  const qualityVal = document.getElementById('ic-quality-val')!;
  qualitySlider.addEventListener('input', () => qualityVal.textContent = qualitySlider.value + '%');

  const uploadArea = document.getElementById('ic-upload-area')!;
  uploadArea.addEventListener('dragover', e => {
    e.preventDefault();
    uploadArea.classList.add('border-[var(--brand)]', 'bg-[var(--brand-glow)]');
  });
  uploadArea.addEventListener('dragleave', () => {
    uploadArea.classList.remove('border-[var(--brand)]', 'bg-[var(--brand-glow)]');
  });
  uploadArea.addEventListener('drop', (e: DragEvent) => {
    e.preventDefault();
    uploadArea.classList.remove('border-[var(--brand)]', 'bg-[var(--brand-glow)]');
    if (e.dataTransfer?.files) addFiles(e.dataTransfer.files);
  });

  document.getElementById('ic-file')?.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.files) addFiles(input.files);
  });

  function addFiles(fileList: FileList) {
    for (const file of Array.from(fileList)) {
      if (!file.type.startsWith('image/')) continue;
      const id = idCounter++;
      files.push({ file, id });
      renderItem({ file, id });
    }
    updateCount();
    document.getElementById('ic-queue')!.style.display = '';
  }

  function updateCount() {
    document.getElementById('ic-queue-count')!.textContent = String(files.length);
  }

  function renderItem({ file, id }: { file: File; id: number }) {
    const list = document.getElementById('ic-list')!;
    const div = document.createElement('div');
    div.className = 'p-4 flex items-center justify-between gap-4 bg-[var(--surface-2)]';
    div.id = `ic-item-${id}`;

    const url = URL.createObjectURL(file);
    div.innerHTML = `
      <div class="flex items-center gap-3 min-w-0">
        <img class="w-14 h-11 object-cover rounded-lg border border-[var(--border)] bg-[var(--surface-3)]" src="${url}" alt="${file.name}" />
        <div class="min-w-0">
          <div class="text-xs font-bold text-[var(--txt)] truncate max-w-xs">${file.name}</div>
          <div class="text-[11px] text-[var(--txt-dim)] font-mono">${(file.size / 1024).toFixed(1)} KB &bull; ${file.type}</div>
          <div class="text-[11px] text-[var(--brand)] font-medium" id="ic-status-${id}">Ready</div>
        </div>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        <button class="ic-dl-btn px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-[var(--brand)] hover:opacity-95 transition-all flex items-center gap-1.5" id="ic-convert-${id}">
          <i class="fas fa-arrows-rotate"></i> Convert
        </button>
        <button class="ic-del-btn p-1.5 text-[var(--txt-dim)] hover:text-rose-500 rounded-lg hover:bg-[var(--surface-3)] transition-colors">
          <i class="fas fa-trash-can"></i>
        </button>
      </div>
    `;
    list.appendChild(div);

    div.querySelector('.ic-dl-btn')!.addEventListener('click', () => convertItem(id));
    div.querySelector('.ic-del-btn')!.addEventListener('click', () => {
      files = files.filter(f => f.id !== id);
      div.remove();
      updateCount();
      URL.revokeObjectURL(url);
    });
  }

  async function convertItem(id: number): Promise<void> {
    const item = files.find(f => f.id === id);
    if (!item) return;

    const statusEl = document.getElementById(`ic-status-${id}`)!;
    statusEl.innerHTML = '<span class="text-[var(--brand)]"><i class="fas fa-spinner fa-spin"></i> Converting…</span>';

    const quality = parseInt(qualitySlider.value) / 100;
    const maxWidth = parseInt((document.getElementById('ic-max-width') as HTMLInputElement).value) || 0;

    const img = new Image();
    img.src = URL.createObjectURL(item.file);
    await new Promise(r => img.onload = r);

    const canvas = document.createElement('canvas');
    let w = img.naturalWidth, h = img.naturalHeight;
    if (maxWidth && w > maxWidth) {
      h = Math.round(h * maxWidth / w);
      w = maxWidth;
    }
    canvas.width = w;
    canvas.height = h;

    const ctx = canvas.getContext('2d')!;
    if (targetFormat === 'jpeg' || targetFormat === 'bmp') {
      ctx.fillStyle = '#fff';
      ctx.fillRect(0, 0, w, h);
    }
    ctx.drawImage(img, 0, 0, w, h);

    const mimeType = `image/${targetFormat}`;
    canvas.toBlob(blob => {
      if (!blob) { statusEl.textContent = 'Conversion failed'; return; }
      const outName = item.file.name.replace(/\.[^.]+$/, '') + '.' + (targetFormat === 'jpeg' ? 'jpg' : targetFormat);
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = outName;
      a.click();
      URL.revokeObjectURL(url);
      statusEl.innerHTML = `<span class="text-emerald-500 font-bold"><i class="fas fa-check"></i> Done (${(blob.size/1024).toFixed(1)} KB)</span>`;
    }, mimeType, quality);
  }

  document.getElementById('ic-convert-all')?.addEventListener('click', async () => {
    for (const item of files) await convertItem(item.id);
  });
</script>
