---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
---

<BaseLayout
  title="Contact Us – Toolarsh"
  description="Get in touch with the Toolarsh team for feedback, feature requests, or bug reports."
>
  <Navbar />
  <SearchModal />

  <main class="contact-page">
    <div class="container">
      <div class="contact-hero">
        <h1 class="font-display contact-title">Get in Touch</h1>
        <p class="contact-subtitle">Have a question, feedback, or a tool suggestion? We'd love to hear from you!</p>
      </div>

      <div class="contact-wrap">
        <form class="contact-form" onsubmit="alert('Thank you for reaching out! We will get back to you soon.'); return false;">
          <div class="form-group">
            <label for="c-name">Your Name</label>
            <input type="text" id="c-name" placeholder="John Doe" required class="form-input" />
          </div>
          <div class="form-group">
            <label for="c-email">Your Email</label>
            <input type="email" id="c-email" placeholder="john@example.com" required class="form-input" />
          </div>
          <div class="form-group">
            <label for="c-subject">Subject</label>
            <input type="text" id="c-subject" placeholder="Feature suggestion / Bug report" required class="form-input" />
          </div>
          <div class="form-group">
            <label for="c-message">Message</label>
            <textarea id="c-message" rows="5" placeholder="Tell us how we can help..." required class="form-input"></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="width: 100%;">
            <i class="fas fa-paper-plane"></i> Send Message
          </button>
        </form>

        <div class="contact-info">
          <div class="info-item">
            <div class="info-icon"><i class="fas fa-envelope"></i></div>
            <div>
              <h3>Email Us</h3>
              <p>support@toolarsh.com</p>
            </div>
          </div>
          <div class="info-item">
            <div class="info-icon"><i class="fas fa-comments"></i></div>
            <div>
              <h3>Feedback & Suggestions</h3>
              <p>We build tools based on user demand. Let us know what tool you need next!</p>
            </div>
          </div>
          <div class="info-item">
            <div class="info-icon"><i class="fas fa-clock"></i></div>
            <div>
              <h3>Response Time</h3>
              <p>We typically respond to inquiries within 24–48 hours.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .contact-page { padding: 60px 0 80px; }
  .contact-hero { text-align: center; max-width: 600px; margin: 0 auto 48px; }
  .contact-title { font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; color: #0F172A; margin-bottom: 12px; }
  .contact-subtitle { font-size: 16px; color: #475569; }
  .contact-wrap { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; max-width: 900px; margin: 0 auto; }
  .contact-form { background: #fff; border: 1.5px solid var(--border); border-radius: var(--radius-xl); padding: 32px; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 16px; }
  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-group label { font-size: 13.5px; font-weight: 600; color: var(--txt); }
  .form-input { padding: 12px 14px; border: 1.5px solid var(--border); border-radius: var(--radius-md); font-size: 14px; font-family: 'Inter', sans-serif; outline: none; background: var(--bg-soft); transition: border-color .15s; }
  .form-input:focus { border-color: var(--brand); background: #fff; }
  .contact-info { display: flex; flex-direction: column; gap: 24px; justify-content: center; }
  .info-item { display: flex; gap: 16px; align-items: flex-start; }
  .info-icon { width: 44px; height: 44px; border-radius: 12px; background: var(--brand-light); color: var(--brand); display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
  .info-item h3 { font-size: 16px; font-weight: 700; color: #0F172A; margin-bottom: 4px; font-family: 'Outfit', sans-serif; }
  .info-item p { font-size: 14px; color: #64748B; line-height: 1.5; }
  @media (max-width: 768px) { .contact-wrap { grid-template-columns: 1fr; } }
</style>
