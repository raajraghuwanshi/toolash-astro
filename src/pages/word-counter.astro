---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'word-counter')!;
---

<ToolLayout tool={tool}>
  <div class="wc-wrap">
    <div class="wc-editor">
      <label class="wc-label" for="wc-input">Paste or type your text below</label>
      <textarea
        id="wc-input"
        class="wc-textarea"
        placeholder="Start typing here — stats update in real-time…"
        rows="10"
        spellcheck="false"
      ></textarea>
      <div class="wc-actions">
        <button class="btn btn-ghost" id="wc-clear">
          <i class="fas fa-trash-alt"></i> Clear
        </button>
        <button class="btn btn-ghost" id="wc-copy">
          <i class="fas fa-copy"></i> Copy text
        </button>
      </div>
    </div>

    <div class="wc-stats-grid" id="wc-stats">
      <div class="wc-stat" id="wc-words">
        <div class="wc-stat-num">0</div>
        <div class="wc-stat-label">Words</div>
      </div>
      <div class="wc-stat" id="wc-chars">
        <div class="wc-stat-num">0</div>
        <div class="wc-stat-label">Characters</div>
      </div>
      <div class="wc-stat" id="wc-chars-no-space">
        <div class="wc-stat-num">0</div>
        <div class="wc-stat-label">Chars (no space)</div>
      </div>
      <div class="wc-stat" id="wc-sentences">
        <div class="wc-stat-num">0</div>
        <div class="wc-stat-label">Sentences</div>
      </div>
      <div class="wc-stat" id="wc-paragraphs">
        <div class="wc-stat-num">0</div>
        <div class="wc-stat-label">Paragraphs</div>
      </div>
      <div class="wc-stat" id="wc-lines">
        <div class="wc-stat-num">0</div>
        <div class="wc-stat-label">Lines</div>
      </div>
      <div class="wc-stat" id="wc-read">
        <div class="wc-stat-num">0 min</div>
        <div class="wc-stat-label">Reading Time</div>
      </div>
      <div class="wc-stat" id="wc-speak">
        <div class="wc-stat-num">0 min</div>
        <div class="wc-stat-label">Speaking Time</div>
      </div>
    </div>
  </div>
</ToolLayout>

<style>
  .wc-wrap { display: flex; flex-direction: column; gap: 24px; }
  .wc-label { font-size: 14px; font-weight: 600; color: var(--txt); display: block; margin-bottom: 8px; }
  .wc-textarea {
    width: 100%;
    min-height: 220px;
    padding: 16px;
    font-size: 15px;
    font-family: 'Inter', sans-serif;
    color: var(--txt);
    background: var(--bg-soft);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    resize: vertical;
    line-height: 1.65;
    outline: none;
    transition: border-color .2s, box-shadow .2s;
  }
  .wc-textarea:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px rgba(37,99,235,.1);
  }
  .wc-actions { display: flex; gap: 10px; margin-top: 12px; }
  .wc-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .wc-stat {
    background: var(--bg-soft);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 16px;
    text-align: center;
    transition: all .2s;
  }
  .wc-stat:hover { border-color: var(--brand); transform: translateY(-2px); box-shadow: var(--shadow-sm); }
  .wc-stat-num { font-size: 26px; font-weight: 800; color: var(--brand); font-family: 'Outfit', sans-serif; margin-bottom: 4px; }
  .wc-stat-label { font-size: 12px; color: var(--txt-muted); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }

  @media (max-width: 600px) { .wc-stats-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

<script>
  const textarea = document.getElementById('wc-input') as HTMLTextAreaElement;

  function update() {
    const text = textarea.value;
    const words = text.trim() === '' ? 0 : text.trim().split(/\s+/).length;
    const chars = text.length;
    const charsNoSpace = text.replace(/\s/g, '').length;
    const sentences = text.trim() === '' ? 0 : (text.match(/[.!?]+/g) || []).length;
    const paragraphs = text.trim() === '' ? 0 : text.split(/\n\s*\n/).filter(p => p.trim()).length;
    const lines = text === '' ? 0 : text.split('\n').length;
    const readMin = words > 0 ? Math.max(1, Math.round(words / 200)) : 0;
    const speakMin = words > 0 ? Math.max(1, Math.round(words / 130)) : 0;

    const set = (id: string, val: string | number) => {
      const el = document.querySelector(`#${id} .wc-stat-num`);
      if (el) el.textContent = String(val);
    };

    set('wc-words', words.toLocaleString());
    set('wc-chars', chars.toLocaleString());
    set('wc-chars-no-space', charsNoSpace.toLocaleString());
    set('wc-sentences', sentences.toLocaleString());
    set('wc-paragraphs', paragraphs.toLocaleString());
    set('wc-lines', lines.toLocaleString());
    set('wc-read', `${readMin} min`);
    set('wc-speak', `${speakMin} min`);
  }

  textarea?.addEventListener('input', update);

  document.getElementById('wc-clear')?.addEventListener('click', () => {
    textarea.value = '';
    update();
    textarea.focus();
  });

  document.getElementById('wc-copy')?.addEventListener('click', async () => {
    if (!textarea.value) return;
    await navigator.clipboard.writeText(textarea.value);
    const btn = document.getElementById('wc-copy')!;
    btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
    setTimeout(() => btn.innerHTML = '<i class="fas fa-copy"></i> Copy text', 2000);
  });
</script>
