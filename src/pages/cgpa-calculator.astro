---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'cgpa-calculator')!;
---

<ToolLayout tool={tool}>
  <div class="cgpa-wrap">
    <div class="cgpa-semesters" id="cgpa-semesters">
      <!-- Semesters added dynamically -->
    </div>

    <div class="cgpa-controls">
      <button class="btn btn-ghost" id="cgpa-add-sem">
        <i class="fas fa-plus"></i> Add Semester
      </button>
      <button class="btn btn-primary" id="cgpa-calc" style="flex:1; max-width:200px;">
        <i class="fas fa-graduation-cap"></i> Calculate CGPA
      </button>
      <button class="btn btn-ghost" id="cgpa-reset">
        <i class="fas fa-refresh"></i> Reset
      </button>
    </div>

    <div id="cgpa-result" class="cgpa-result" style="display:none">
      <div class="cgpa-result-main">
        <div class="cgpa-big-num" id="cgpa-val">0.00</div>
        <div class="cgpa-big-label">CGPA</div>
        <div class="cgpa-grade" id="cgpa-grade">—</div>
      </div>
      <div class="cgpa-stats-row">
        <div class="cgpa-stat">
          <div class="cgpa-stat-num" id="cgpa-total-credits">0</div>
          <div class="cgpa-stat-label">Total Credits</div>
        </div>
        <div class="cgpa-stat">
          <div class="cgpa-stat-num" id="cgpa-total-points">0.00</div>
          <div class="cgpa-stat-label">Quality Points</div>
        </div>
        <div class="cgpa-stat">
          <div class="cgpa-stat-num" id="cgpa-sems">0</div>
          <div class="cgpa-stat-label">Semesters</div>
        </div>
      </div>
    </div>

    <!-- Grade reference -->
    <div class="cgpa-ref">
      <div class="cgpa-ref-title">Grade Point Reference (10-Point Scale)</div>
      <div class="cgpa-ref-grid">
        <div class="cgpa-ref-item"><span class="cgpa-ref-grade" style="color:#22C55E">O</span> Outstanding = 10</div>
        <div class="cgpa-ref-item"><span class="cgpa-ref-grade" style="color:#22C55E">A+</span> Excellent = 9</div>
        <div class="cgpa-ref-item"><span class="cgpa-ref-grade" style="color:#84CC16">A</span> Very Good = 8</div>
        <div class="cgpa-ref-item"><span class="cgpa-ref-grade" style="color:#EAB308">B+</span> Good = 7</div>
        <div class="cgpa-ref-item"><span class="cgpa-ref-grade" style="color:#F59E0B">B</span> Above Avg = 6</div>
        <div class="cgpa-ref-item"><span class="cgpa-ref-grade" style="color:#EF4444">C</span> Average = 5</div>
        <div class="cgpa-ref-item"><span class="cgpa-ref-grade" style="color:#EF4444">F</span> Fail = 0</div>
      </div>
    </div>
  </div>
</ToolLayout>

<style>
  .cgpa-wrap { display: flex; flex-direction: column; gap: 20px; }
  .cgpa-semesters { display: flex; flex-direction: column; gap: 16px; }
  .cgpa-sem { border: 1.5px solid var(--border); border-radius: var(--radius-md); overflow: hidden; }
  .cgpa-sem-header { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: var(--bg-soft); border-bottom: 1px solid var(--border); }
  .cgpa-sem-title { font-size: 14px; font-weight: 700; color: var(--txt); }
  .cgpa-sem-del { background: none; border: none; color: #EF4444; cursor: pointer; font-size: 14px; padding: 4px 8px; border-radius: 4px; }
  .cgpa-sem-del:hover { background: #FEF2F2; }
  .cgpa-courses { padding: 12px; display: flex; flex-direction: column; gap: 8px; }
  .cgpa-course { display: grid; grid-template-columns: 1fr 80px 100px 32px; gap: 8px; align-items: center; }
  .cgpa-ci { padding: 9px 12px; font-size: 13.5px; font-family: 'Inter', sans-serif; color: var(--txt); background: var(--bg-soft); border: 1.5px solid var(--border); border-radius: var(--radius-sm); outline: none; transition: border-color .15s; width: 100%; }
  .cgpa-ci:focus { border-color: var(--brand); }
  .cgpa-course-del { background: none; border: none; color: var(--txt-muted); cursor: pointer; font-size: 12px; padding: 8px; border-radius: 4px; width: 32px; height: 36px; display: flex; align-items: center; justify-content: center; }
  .cgpa-course-del:hover { color: #EF4444; background: #FEF2F2; }
  .cgpa-add-course { padding: 8px 14px; background: none; border: 1.5px dashed var(--border); border-radius: var(--radius-sm); font-size: 13px; color: var(--txt-muted); cursor: pointer; width: 100%; text-align: center; transition: all .15s; margin: 0 12px 12px; width: calc(100% - 24px); }
  .cgpa-add-course:hover { border-color: var(--brand); color: var(--brand); }

  .cgpa-controls { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .cgpa-result { animation: fadeIn .4s ease; display: flex; flex-direction: column; gap: 16px; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .cgpa-result-main { text-align: center; padding: 28px; background: linear-gradient(135deg, #EFF6FF, #F5F3FF); border-radius: var(--radius-lg); border: 1.5px solid var(--border); }
  .cgpa-big-num { font-size: 4rem; font-weight: 900; color: var(--brand); font-family: 'Outfit', sans-serif; }
  .cgpa-big-label { font-size: 16px; font-weight: 700; color: var(--txt-muted); margin-top: 4px; }
  .cgpa-grade { font-size: 1.2rem; font-weight: 800; margin-top: 8px; }
  .cgpa-stats-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .cgpa-stat { background: var(--bg-soft); border: 1.5px solid var(--border); border-radius: var(--radius-md); padding: 14px; text-align: center; }
  .cgpa-stat-num { font-size: 22px; font-weight: 800; color: var(--brand); font-family: 'Outfit', sans-serif; }
  .cgpa-stat-label { font-size: 12px; color: var(--txt-muted); text-transform: uppercase; font-weight: 600; margin-top: 4px; }

  .cgpa-ref { padding: 14px 16px; background: var(--bg-soft); border: 1.5px solid var(--border); border-radius: var(--radius-sm); }
  .cgpa-ref-title { font-size: 12px; font-weight: 700; color: var(--txt-muted); text-transform: uppercase; letter-spacing: .04em; margin-bottom: 10px; }
  .cgpa-ref-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; font-size: 13px; color: var(--txt-muted); }
  .cgpa-ref-grade { font-weight: 800; font-size: 15px; margin-right: 4px; }

  @media (max-width: 480px) { .cgpa-course { grid-template-columns: 1fr 70px; } .cgpa-ref-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

<script>
  let semCount = 0;

  const gradePoints: Record<string, number> = {
    'O': 10, 'A+': 9, 'A': 8, 'B+': 7, 'B': 6, 'C': 5, 'D': 4, 'F': 0,
    '10': 10, '9': 9, '8': 8, '7': 7, '6': 6, '5': 5, '4': 4, '0': 0,
  };

  function gradeLabel(cgpa: number): { text: string; color: string } {
    if (cgpa >= 9) return { text: 'Outstanding 🏆', color: '#22C55E' };
    if (cgpa >= 8) return { text: 'Excellent ⭐', color: '#22C55E' };
    if (cgpa >= 7) return { text: 'Very Good 👏', color: '#84CC16' };
    if (cgpa >= 6) return { text: 'Good 👍', color: '#EAB308' };
    if (cgpa >= 5) return { text: 'Average', color: '#F59E0B' };
    return { text: 'Below Average', color: '#EF4444' };
  }

  function addCourse(semId: string) {
    const courses = document.getElementById(`courses-${semId}`)!;
    const div = document.createElement('div');
    div.className = 'cgpa-course';
    div.innerHTML = `
      <input type="text" class="cgpa-ci course-name" placeholder="Course name (optional)" />
      <input type="number" class="cgpa-ci course-credits" placeholder="Credits" min="1" max="10" value="3" />
      <select class="cgpa-ci course-grade">
        <option value="10">O (10)</option>
        <option value="9">A+ (9)</option>
        <option value="8" selected>A (8)</option>
        <option value="7">B+ (7)</option>
        <option value="6">B (6)</option>
        <option value="5">C (5)</option>
        <option value="4">D (4)</option>
        <option value="0">F (0)</option>
      </select>
      <button class="cgpa-course-del" title="Remove"><i class="fas fa-times"></i></button>
    `;
    div.querySelector('.cgpa-course-del')!.addEventListener('click', () => div.remove());
    courses.appendChild(div);
  }

  function addSemester() {
    semCount++;
    const id = `sem${semCount}`;
    const div = document.createElement('div');
    div.className = 'cgpa-sem';
    div.id = id;
    div.innerHTML = `
      <div class="cgpa-sem-header">
        <span class="cgpa-sem-title">Semester ${semCount}</span>
        <button class="cgpa-sem-del" title="Delete semester"><i class="fas fa-trash"></i></button>
      </div>
      <div class="cgpa-courses" id="courses-${id}"></div>
      <button class="cgpa-add-course" id="add-course-${id}"><i class="fas fa-plus"></i> Add Course</button>
    `;
    div.querySelector('.cgpa-sem-del')!.addEventListener('click', () => { div.remove(); semCount--; });
    div.querySelector(`#add-course-${id}`)!.addEventListener('click', () => addCourse(id));
    document.getElementById('cgpa-semesters')!.appendChild(div);
    // Add 4 default courses
    for (let i = 0; i < 4; i++) addCourse(id);
  }

  document.getElementById('cgpa-add-sem')?.addEventListener('click', addSemester);

  document.getElementById('cgpa-calc')?.addEventListener('click', () => {
    let totalPoints = 0, totalCredits = 0, semCount2 = 0;
    document.querySelectorAll('.cgpa-sem').forEach(sem => {
      semCount2++;
      sem.querySelectorAll('.cgpa-course').forEach(course => {
        const credits = parseFloat((course.querySelector('.course-credits') as HTMLInputElement).value) || 0;
        const grade = parseFloat((course.querySelector('.course-grade') as HTMLSelectElement).value) || 0;
        totalPoints += credits * grade;
        totalCredits += credits;
      });
    });

    if (totalCredits === 0) return;
    const cgpa = totalPoints / totalCredits;
    const { text, color } = gradeLabel(cgpa);

    document.getElementById('cgpa-val')!.textContent = cgpa.toFixed(2);
    document.getElementById('cgpa-grade')!.textContent = text;
    document.getElementById('cgpa-grade')!.style.color = color;
    document.getElementById('cgpa-total-credits')!.textContent = String(totalCredits);
    document.getElementById('cgpa-total-points')!.textContent = totalPoints.toFixed(2);
    document.getElementById('cgpa-sems')!.textContent = String(semCount2);
    document.getElementById('cgpa-result')!.style.display = '';
  });

  document.getElementById('cgpa-reset')?.addEventListener('click', () => {
    document.getElementById('cgpa-semesters')!.innerHTML = '';
    semCount = 0;
    document.getElementById('cgpa-result')!.style.display = 'none';
    addSemester();
  });

  addSemester();
  addSemester();
</script>
