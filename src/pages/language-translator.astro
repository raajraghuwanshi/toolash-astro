---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'language-translator')!;

const languages = [
  { code: 'en', name: 'English' },
  { code: 'hi', name: 'Hindi' },
  { code: 'es', name: 'Spanish' },
  { code: 'fr', name: 'French' },
  { code: 'de', name: 'German' },
  { code: 'it', name: 'Italian' },
  { code: 'pt', name: 'Portuguese' },
  { code: 'ru', name: 'Russian' },
  { code: 'zh', name: 'Chinese (Simplified)' },
  { code: 'ja', name: 'Japanese' },
  { code: 'ko', name: 'Korean' },
  { code: 'ar', name: 'Arabic' },
  { code: 'bn', name: 'Bengali' },
  { code: 'nl', name: 'Dutch' },
  { code: 'pl', name: 'Polish' },
  { code: 'sv', name: 'Swedish' },
  { code: 'no', name: 'Norwegian' },
  { code: 'da', name: 'Danish' },
  { code: 'fi', name: 'Finnish' },
  { code: 'tr', name: 'Turkish' },
  { code: 'id', name: 'Indonesian' },
  { code: 'ms', name: 'Malay' },
  { code: 'vi', name: 'Vietnamese' },
  { code: 'th', name: 'Thai' },
  { code: 'uk', name: 'Ukrainian' },
  { code: 'cs', name: 'Czech' },
  { code: 'sk', name: 'Slovak' },
  { code: 'ro', name: 'Romanian' },
  { code: 'hu', name: 'Hungarian' },
  { code: 'el', name: 'Greek' },
  { code: 'he', name: 'Hebrew' },
  { code: 'fa', name: 'Persian' },
  { code: 'ur', name: 'Urdu' },
  { code: 'ta', name: 'Tamil' },
  { code: 'te', name: 'Telugu' },
  { code: 'ml', name: 'Malayalam' },
  { code: 'kn', name: 'Kannada' },
  { code: 'mr', name: 'Marathi' },
  { code: 'gu', name: 'Gujarati' },
  { code: 'pa', name: 'Punjabi' },
  { code: 'af', name: 'Afrikaans' },
  { code: 'sq', name: 'Albanian' },
  { code: 'az', name: 'Azerbaijani' },
  { code: 'be', name: 'Belarusian' },
  { code: 'bs', name: 'Bosnian' },
  { code: 'bg', name: 'Bulgarian' },
  { code: 'ca', name: 'Catalan' },
  { code: 'hr', name: 'Croatian' },
  { code: 'et', name: 'Estonian' },
  { code: 'tl', name: 'Filipino' },
  { code: 'ka', name: 'Georgian' },
  { code: 'lv', name: 'Latvian' },
  { code: 'lt', name: 'Lithuanian' },
  { code: 'mk', name: 'Macedonian' },
  { code: 'mt', name: 'Maltese' },
  { code: 'sr', name: 'Serbian' },
  { code: 'sl', name: 'Slovenian' },
  { code: 'sw', name: 'Swahili' },
  { code: 'cy', name: 'Welsh' },
  { code: 'is', name: 'Icelandic' },
  { code: 'ga', name: 'Irish' },
  { code: 'lb', name: 'Luxembourgish' },
  { code: 'ne', name: 'Nepali' },
  { code: 'si', name: 'Sinhala' },
  { code: 'mn', name: 'Mongolian' },
  { code: 'my', name: 'Myanmar (Burmese)' },
  { code: 'km', name: 'Khmer' },
  { code: 'lo', name: 'Lao' },
  { code: 'uz', name: 'Uzbek' },
  { code: 'kk', name: 'Kazakh' },
  { code: 'hy', name: 'Armenian' }
];
---

<ToolLayout tool={tool} customLayout={true}>
  <div class="tool-page-wrap">
    <!-- Hero Box -->
    <div class="tool-hero-box">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
        <div class="tool-hero-badge">
          <i class="fas fa-language"></i>
          <span>GLOBAL POLYGLOT ENGINE &bull; 70+ DIALECTS</span>
        </div>
        <div class="flex items-center gap-3 text-xs text-[var(--txt-dim)] font-mono">
          <span><i class="fas fa-bolt text-[var(--amber)] mr-1"></i> Zero Latency</span>
          <span>&bull;</span>
          <span><i class="fas fa-shield-halved text-[var(--brand)] mr-1"></i> Free & Unlimited</span>
        </div>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--txt)] mb-2">
        Neural <span class="bg-gradient-to-r from-emerald-500 to-teal-400 bg-clip-text text-transparent">Language Translator</span>
      </h1>
      <p class="text-sm sm:text-base text-[var(--txt-muted)] max-w-2xl leading-relaxed">
        Translate sentences, paragraphs, and conversations across 70+ global languages with accurate contextual syntax, phonetics, and instant text-to-speech audio pronunciation.
      </p>

      <!-- Quick Language Chips -->
      <div class="mt-4 flex items-center gap-2 flex-wrap text-xs">
        <span class="text-[var(--txt-dim)] font-semibold">Translate to:</span>
        <button class="tr-chip px-2.5 py-1 rounded-lg bg-[var(--surface-2)] hover:bg-[var(--surface-3)] text-[var(--txt-muted)] hover:text-[var(--txt)] border border-[var(--border)] hover:border-[var(--brand)] transition-colors" data-to="es">🇪🇸 Spanish</button>
        <button class="tr-chip px-2.5 py-1 rounded-lg bg-[var(--surface-2)] hover:bg-[var(--surface-3)] text-[var(--txt-muted)] hover:text-[var(--txt)] border border-[var(--border)] hover:border-[var(--brand)] transition-colors" data-to="fr">🇫🇷 French</button>
        <button class="tr-chip px-2.5 py-1 rounded-lg bg-[var(--surface-2)] hover:bg-[var(--surface-3)] text-[var(--txt-muted)] hover:text-[var(--txt)] border border-[var(--border)] hover:border-[var(--brand)] transition-colors" data-to="de">🇩🇪 German</button>
        <button class="tr-chip px-2.5 py-1 rounded-lg bg-[var(--surface-2)] hover:bg-[var(--surface-3)] text-[var(--txt-muted)] hover:text-[var(--txt)] border border-[var(--border)] hover:border-[var(--brand)] transition-colors" data-to="ja">🇯🇵 Japanese</button>
        <button class="tr-chip px-2.5 py-1 rounded-lg bg-[var(--surface-2)] hover:bg-[var(--surface-3)] text-[var(--txt-muted)] hover:text-[var(--txt)] border border-[var(--border)] hover:border-[var(--brand)] transition-colors" data-to="zh">🇨🇳 Chinese</button>
        <button class="tr-chip px-2.5 py-1 rounded-lg bg-[var(--surface-2)] hover:bg-[var(--surface-3)] text-[var(--txt-muted)] hover:text-[var(--txt)] border border-[var(--border)] hover:border-[var(--brand)] transition-colors" data-to="ar">🇸🇦 Arabic</button>
        <button class="tr-chip px-2.5 py-1 rounded-lg bg-[var(--surface-2)] hover:bg-[var(--surface-3)] text-[var(--txt-muted)] hover:text-[var(--txt)] border border-[var(--border)] hover:border-[var(--brand)] transition-colors" data-to="hi">🇮🇳 Hindi</button>
        <button class="tr-chip px-2.5 py-1 rounded-lg bg-[var(--surface-2)] hover:bg-[var(--surface-3)] text-[var(--txt-muted)] hover:text-[var(--txt)] border border-[var(--border)] hover:border-[var(--brand)] transition-colors" data-to="ru">🇷🇺 Russian</button>
      </div>
    </div>

    <!-- Interactive Translation Workspace -->
    <main class="space-y-8">
      <div class="tool-card-surface overflow-hidden !p-0">
        <!-- Language Selector Bar -->
        <div class="p-4 sm:p-5 bg-[var(--surface-2)] border-b border-[var(--border)] flex flex-wrap items-center justify-between gap-4">
          <!-- Source Lang -->
          <div class="flex items-center gap-2 flex-1 min-w-[200px]">
            <span class="text-xs font-bold uppercase text-[var(--txt-dim)] font-mono">From:</span>
            <select id="tr-from" class="tool-control-input flex-1 font-semibold text-sm">
              {languages.map(l => (
                <option value={l.code} selected={l.code === 'en'}>{l.name}</option>
              ))}
            </select>
          </div>

          <!-- Swap Button -->
          <button
            id="tr-swap"
            class="w-10 h-10 rounded-full bg-[var(--surface-3)] hover:bg-[var(--surface-2)] text-[var(--brand)] border border-[var(--border)] flex items-center justify-center transition-all hover:rotate-180 active:scale-95 flex-shrink-0"
            title="Swap source and target language"
          >
            <i class="fas fa-arrows-rotate"></i>
          </button>

          <!-- Target Lang -->
          <div class="flex items-center gap-2 flex-1 min-w-[200px]">
            <span class="text-xs font-bold uppercase text-[var(--txt-dim)] font-mono">To:</span>
            <select id="tr-to" class="tool-control-input flex-1 font-semibold text-sm">
              {languages.map(l => (
                <option value={l.code} selected={l.code === 'hi'}>{l.name}</option>
              ))}
            </select>
          </div>
        </div>

        <!-- Split Editor Panes -->
        <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-[var(--border)]">
          <!-- Input Panel -->
          <div class="p-5 flex flex-col justify-between h-[360px] bg-[var(--surface-1)]">
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-[var(--border)] text-xs text-[var(--txt-muted)]">
              <span class="font-bold text-[var(--txt)]" id="tr-from-label">English</span>
              <div class="flex items-center gap-3">
                <button id="tr-copy-input" class="hover:text-[var(--brand)] transition-colors" title="Copy source text">
                  <i class="fas fa-copy"></i>
                </button>
                <button id="tr-clear-input" class="hover:text-rose-500 transition-colors" title="Clear text">
                  <i class="fas fa-xmark"></i>
                </button>
              </div>
            </div>

            <textarea
              id="tr-input"
              class="w-full flex-1 p-2 text-sm sm:text-base text-[var(--txt)] bg-transparent border-0 outline-none resize-none leading-relaxed placeholder:text-[var(--txt-dim)]"
              placeholder="Type or paste text to translate... (Ctrl + Enter to translate)"
              maxlength="5000"
            ></textarea>

            <div class="flex items-center justify-between pt-2 border-t border-[var(--border)] text-xs text-[var(--txt-dim)]">
              <span>Press <kbd class="px-1.5 py-0.5 rounded bg-[var(--surface-2)] border border-[var(--border)] text-[10px] font-mono text-[var(--txt)]">Ctrl</kbd> + <kbd class="px-1.5 py-0.5 rounded bg-[var(--surface-2)] border border-[var(--border)] text-[10px] font-mono text-[var(--txt)]">Enter</kbd></span>
              <div><span id="tr-char-count">0</span> / 5000</div>
            </div>
          </div>

          <!-- Output Panel -->
          <div class="p-5 flex flex-col justify-between h-[360px] bg-[var(--surface-2)]/40">
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-[var(--border)] text-xs text-[var(--txt-muted)]">
              <span class="font-bold text-[var(--brand)]" id="tr-to-label">Hindi</span>
              <div class="flex items-center gap-3">
                <button id="tr-speak-btn" class="hover:text-[var(--brand)] transition-colors" title="Listen to pronunciation">
                  <i class="fas fa-volume-high"></i>
                </button>
                <button id="tr-copy-output" class="hover:text-[var(--brand)] transition-colors" title="Copy translated text">
                  <i class="fas fa-copy"></i>
                </button>
              </div>
            </div>

            <div id="tr-output" class="flex-1 p-2 text-sm sm:text-base text-[var(--txt)] overflow-y-auto leading-relaxed">
              <span class="text-[var(--txt-dim)] italic">Translation will appear here…</span>
            </div>

            <div class="pt-2 border-t border-[var(--border)] flex items-center justify-between text-xs text-[var(--txt-dim)]">
              <div id="tr-status" class="text-[var(--brand)] font-medium">Ready</div>
              <span class="text-[11px]">Powered by MyMemory Neural DB</span>
            </div>
          </div>
        </div>

        <!-- Action Footer -->
        <div class="p-4 sm:p-5 bg-[var(--surface-2)] border-t border-[var(--border)] flex flex-wrap items-center justify-between gap-4">
          <button
            id="tr-translate-btn"
            class="px-6 py-2.5 rounded-xl font-bold text-sm text-white bg-[var(--brand)] hover:opacity-95 shadow-md shadow-emerald-500/20 active:scale-95 transition-all flex items-center gap-2"
          >
            <i class="fas fa-language"></i> Translate Now
          </button>
          <span class="text-xs text-[var(--txt-muted)]">
            Free, real-time contextual translation without character subscription gates.
          </span>
        </div>
      </div>

      <!-- Linguistic Architecture: Before / After Panel Archetype -->
      <div class="tool-content-wrap">
        <section class="tool-content-card space-y-10">
          <!-- Lead Editorial Header -->
          <div class="tool-content-header">
            <h2>Neural Attention vs. Literal Translation: Before &amp; After</h2>
            <p>
              Early machine translation failed because human language is not a mathematical lookup table. A single word carries different meanings based on surrounding syntax, tone, and cultural geography. Inspect the direct comparative panels below to see how neural attention mechanisms resolve ambiguities that confound naive dictionary lookup.
            </p>
          </div>

        <!-- Before / After Comparative Panels -->
        <div class="space-y-10">

          <!-- Panel Pair 01: Idiomatic Expressions -->
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--brand)]">Case 01</span>
              <span class="text-xs text-[var(--txt-muted)]">·</span>
              <span class="text-xs font-semibold text-[var(--txt)]">Idiomatic Figurative Semantics (Spanish &rarr; English)</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x border border-[var(--border)] rounded-2xl overflow-hidden">
              <!-- Before -->
              <div class="p-6 bg-rose-500/[0.03] space-y-3">
                <div class="flex items-center justify-between">
                  <span class="px-2.5 py-1 rounded text-[11px] font-mono font-bold uppercase bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20">
                    Before: Literal Dictionary Substitution
                  </span>
                  <span class="font-mono text-xs text-[var(--txt-dim)]">Word-by-Word</span>
                </div>
                <div class="p-3.5 rounded-xl bg-[var(--surface-1)] border border-[var(--border)] font-mono text-sm text-[var(--txt)]">
                  "No me tomes el pelo, por favor." &rarr; <span class="text-rose-500 font-bold">"Do not drink my hair, please."</span>
                </div>
                <p class="text-xs text-[var(--txt-muted)] leading-relaxed">
                  <strong class="text-[var(--txt)]">Catastrophic Failure:</strong> The verb <em>tomar</em> is blindly mapped to "drink/take" and <em>pelo</em> to "hair", creating an absurd, nonsensical output that erodes reader confidence.
                </p>
              </div>

              <!-- After -->
              <div class="p-6 bg-emerald-500/[0.03] space-y-3">
                <div class="flex items-center justify-between">
                  <span class="px-2.5 py-1 rounded text-[11px] font-mono font-bold uppercase bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                    After: Contextual Neural Transformer
                  </span>
                  <span class="font-mono text-xs text-emerald-600 dark:text-emerald-400 font-bold">Idiomatic Match</span>
                </div>
                <div class="p-3.5 rounded-xl bg-[var(--surface-1)] border border-[var(--border)] font-mono text-sm text-[var(--txt)]">
                  "No me tomes el pelo, por favor." &rarr; <span class="text-emerald-500 font-bold">"Don't pull my leg, please."</span>
                </div>
                <p class="text-xs text-[var(--txt-muted)] leading-relaxed">
                  <strong class="text-[var(--txt)]">Linguistic Resolution:</strong> The self-attention matrix identifies the multi-word expression <em>tomar el pelo</em> as an indivisible semantic unit and swaps in the authentic English figurative equivalent.
                </p>
              </div>
            </div>
          </div>

          <!-- Panel Pair 02: Formality & Honorific Registers -->
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--brand)]">Case 02</span>
              <span class="text-xs text-[var(--txt-muted)]">·</span>
              <span class="text-xs font-semibold text-[var(--txt)]">Formality Registers &amp; Professional Hierarchy (English &rarr; German)</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x border border-[var(--border)] rounded-2xl overflow-hidden">
              <!-- Before -->
              <div class="p-6 bg-rose-500/[0.03] space-y-3">
                <div class="flex items-center justify-between">
                  <span class="px-2.5 py-1 rounded text-[11px] font-mono font-bold uppercase bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20">
                    Before: Rigid Default Heuristic
                  </span>
                  <span class="font-mono text-xs text-[var(--txt-dim)]">Informal Default</span>
                </div>
                <div class="p-3.5 rounded-xl bg-[var(--surface-1)] border border-[var(--border)] font-mono text-sm text-[var(--txt)]">
                  "Can you send the signed contract?" &rarr; <span class="text-rose-500 font-bold">"Kannst du den unterschriebenen Vertrag schicken?"</span>
                </div>
                <p class="text-xs text-[var(--txt-muted)] leading-relaxed">
                  <strong class="text-[var(--txt)]">Social Gaffe:</strong> Defaults to the informal second-person pronoun (<em>du</em>), which is disrespectful in commercial, legal, and enterprise German communications.
                </p>
              </div>

              <!-- After -->
              <div class="p-6 bg-emerald-500/[0.03] space-y-3">
                <div class="flex items-center justify-between">
                  <span class="px-2.5 py-1 rounded text-[11px] font-mono font-bold uppercase bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                    After: Commercial Register Adaptation
                  </span>
                  <span class="font-mono text-xs text-emerald-600 dark:text-emerald-400 font-bold">Executive Sie-Form</span>
                </div>
                <div class="p-3.5 rounded-xl bg-[var(--surface-1)] border border-[var(--border)] font-mono text-sm text-[var(--txt)]">
                  "Can you send the signed contract?" &rarr; <span class="text-emerald-500 font-bold">"Könnten Sie bitte den unterzeichneten Vertrag zusenden?"</span>
                </div>
                <p class="text-xs text-[var(--txt-muted)] leading-relaxed">
                  <strong class="text-[var(--txt)]">Business Precision:</strong> Context clues like "signed contract" trigger the formal subjunctive polite request (<em>Könnten Sie...</em>), safeguarding commercial relationships.
                </p>
              </div>
            </div>
          </div>

          <!-- Panel Pair 03: Polysemy Disambiguation -->
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--brand)]">Case 03</span>
              <span class="text-xs text-[var(--txt-muted)]">·</span>
              <span class="text-xs font-semibold text-[var(--txt)]">Homonym &amp; Polysemy Disambiguation (English &rarr; French)</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x border border-[var(--border)] rounded-2xl overflow-hidden">
              <!-- Before -->
              <div class="p-6 bg-rose-500/[0.03] space-y-3">
                <div class="flex items-center justify-between">
                  <span class="px-2.5 py-1 rounded text-[11px] font-mono font-bold uppercase bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20">
                    Before: Frequency-Biased Lookup
                  </span>
                  <span class="font-mono text-xs text-[var(--txt-dim)]">Isolated Token</span>
                </div>
                <div class="p-3.5 rounded-xl bg-[var(--surface-1)] border border-[var(--border)] font-mono text-sm text-[var(--txt)]">
                  "The bank approved our enterprise mortgage." &rarr; <span class="text-rose-500 font-bold">"La rive a approuvé notre hypothèque d'entreprise."</span>
                </div>
                <p class="text-xs text-[var(--txt-muted)] leading-relaxed">
                  <strong class="text-[var(--txt)]">Domain Confusion:</strong> The word "bank" is wrongly matched to a geographical riverbank (<em>la rive</em>) rather than a commercial lender.
                </p>
              </div>

              <!-- After -->
              <div class="p-6 bg-emerald-500/[0.03] space-y-3">
                <div class="flex items-center justify-between">
                  <span class="px-2.5 py-1 rounded text-[11px] font-mono font-bold uppercase bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                    After: Attention-Weighted Embedding
                  </span>
                  <span class="font-mono text-xs text-emerald-600 dark:text-emerald-400 font-bold">Financial Domain</span>
                </div>
                <div class="p-3.5 rounded-xl bg-[var(--surface-1)] border border-[var(--border)] font-mono text-sm text-[var(--txt)]">
                  "The bank approved our enterprise mortgage." &rarr; <span class="text-emerald-500 font-bold">"La banque a approuvé notre prêt hypothécaire d'entreprise."</span>
                </div>
                <p class="text-xs text-[var(--txt-muted)] leading-relaxed">
                  <strong class="text-[var(--txt)]">Semantic Coherence:</strong> The cross-attention layer anchors "bank" to "mortgage" and "approved", accurately generating <em>la banque</em> and the native term <em>prêt hypothécaire</em>.
                </p>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- Hairline Accordion FAQ Section -->
      <section class="tool-content-card">
          <div class="tool-content-header">
            <h2>Linguistic &amp; Audio Processing FAQ</h2>
            <p>
              Right-to-left syntax, phonetic synthesizers, and privacy models.
            </p>
          </div>

          <div class="tool-faq-accordion">
            <details class="tool-faq-item">
              <summary>
                <span>Are Right-to-Left (RTL) writing systems like Arabic, Hebrew, and Urdu supported?</span>
                <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
              </summary>
              <div class="faq-answer">
                Yes. When selecting Arabic (ar), Hebrew (he), Persian (fa), or Urdu (ur), the output editor automatically switches text alignment to Right-to-Left (`dir="rtl"`), preserving authentic cursive ligatures and bidirectional numbering without typographical corruption.
              </div>
            </details>

            <details class="tool-faq-item">
              <summary>
                <span>How does the native Text-to-Speech audio pronunciation function?</span>
                <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
              </summary>
              <div class="faq-answer">
                When you click the speaker button, the tool leverages your browser's native Web Speech API (`window.speechSynthesis`). It queries your operating system's installed polyglot voice packs to articulate translated text with authentic phonemes, accents, and pitch curves without consuming external audio bandwidth.
              </div>
            </details>

            <details class="tool-faq-item">
              <summary>
                <span>Is my translated input confidential and retained on remote databases?</span>
                <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
              </summary>
              <div class="faq-answer">
                Toolarsh does not log, catalog, or sell your input strings. Translation queries are dispatched securely over HTTPS to public neural memory translation endpoints for ephemeral conversion, and the response is rendered immediately into your browser DOM.
              </div>
            </details>
          </div>
        </section>

      </div>
    </main>
  </div>
</ToolLayout>

<script>
  const langNames: Record<string, string> = {
    en: 'English', hi: 'Hindi', es: 'Spanish', fr: 'French', de: 'German',
    it: 'Italian', pt: 'Portuguese', ru: 'Russian', zh: 'Chinese (Simplified)',
    ja: 'Japanese', ko: 'Korean', ar: 'Arabic', bn: 'Bengali', nl: 'Dutch',
    pl: 'Polish', sv: 'Swedish', no: 'Norwegian', da: 'Danish', fi: 'Finnish',
    tr: 'Turkish', id: 'Indonesian', ms: 'Malay', vi: 'Vietnamese', th: 'Thai',
    uk: 'Ukrainian', cs: 'Czech', sk: 'Slovak', ro: 'Romanian', hu: 'Hungarian',
    el: 'Greek', he: 'Hebrew', fa: 'Persian', ur: 'Urdu', ta: 'Tamil',
    te: 'Telugu', ml: 'Malayalam', kn: 'Kannada', mr: 'Marathi', gu: 'Gujarati',
    pa: 'Punjabi', af: 'Afrikaans', az: 'Azerbaijani', bg: 'Bulgarian',
    ca: 'Catalan', hr: 'Croatian', et: 'Estonian', tl: 'Filipino', ka: 'Georgian',
    lv: 'Latvian', lt: 'Lithuanian', mk: 'Macedonian', mt: 'Maltese',
    sr: 'Serbian', sl: 'Slovenian', sw: 'Swahili', cy: 'Welsh', is: 'Icelandic',
    ga: 'Irish', ne: 'Nepali', si: 'Sinhala', mn: 'Mongolian', my: 'Myanmar (Burmese)',
    km: 'Khmer', lo: 'Lao', uz: 'Uzbek', kk: 'Kazakh', hy: 'Armenian',
    be: 'Belarusian', bs: 'Bosnian', sq: 'Albanian', lb: 'Luxembourgish'
  };

  const fromSel = document.getElementById('tr-from') as HTMLSelectElement;
  const toSel = document.getElementById('tr-to') as HTMLSelectElement;
  const input = document.getElementById('tr-input') as HTMLTextAreaElement;
  const output = document.getElementById('tr-output')!;
  const status = document.getElementById('tr-status')!;
  const fromLabel = document.getElementById('tr-from-label')!;
  const toLabel = document.getElementById('tr-to-label')!;
  const charCount = document.getElementById('tr-char-count')!;

  function updateLabels() {
    fromLabel.textContent = langNames[fromSel.value] ?? fromSel.value;
    toLabel.textContent = langNames[toSel.value] ?? toSel.value;
  }
  fromSel.addEventListener('change', updateLabels);
  toSel.addEventListener('change', updateLabels);
  updateLabels();

  input.addEventListener('input', () => {
    charCount.textContent = input.value.length.toString();
  });

  document.getElementById('tr-swap')?.addEventListener('click', () => {
    const tmpFrom = fromSel.value;
    const tmpFromText = output.innerText.trim();
    fromSel.value = toSel.value;
    toSel.value = tmpFrom;
    if (tmpFromText && !tmpFromText.startsWith('Translation will appear')) {
      input.value = tmpFromText;
      charCount.textContent = input.value.length.toString();
      output.innerHTML = '<span class="text-slate-400 italic">Translation will appear here…</span>';
    }
    updateLabels();
  });

  document.getElementById('tr-clear-input')?.addEventListener('click', () => {
    input.value = '';
    charCount.textContent = '0';
    output.innerHTML = '<span class="text-slate-400 italic">Translation will appear here…</span>';
    status.textContent = 'Ready';
  });

  document.getElementById('tr-copy-input')?.addEventListener('click', async () => {
    if (!input.value) return;
    await navigator.clipboard.writeText(input.value);
    const btn = document.getElementById('tr-copy-input')!;
    btn.innerHTML = '<i class="fas fa-check text-emerald-500"></i>';
    setTimeout(() => btn.innerHTML = '<i class="fas fa-copy"></i>', 1800);
  });

  document.getElementById('tr-copy-output')?.addEventListener('click', async () => {
    const text = output.innerText.trim();
    if (!text || text.startsWith('Translation will appear')) return;
    await navigator.clipboard.writeText(text);
    const btn = document.getElementById('tr-copy-output')!;
    btn.innerHTML = '<i class="fas fa-check text-emerald-500"></i>';
    setTimeout(() => btn.innerHTML = '<i class="fas fa-copy"></i>', 1800);
  });

  document.querySelectorAll('.tr-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const to = (chip as HTMLElement).dataset.to!;
      toSel.value = to;
      updateLabels();
      if (input.value.trim()) translate();
    });
  });

  // Text to speech
  document.getElementById('tr-speak-btn')?.addEventListener('click', () => {
    const text = output.innerText.trim();
    if (!text || text.startsWith('Translation will appear')) return;
    if ('speechSynthesis' in window) {
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = toSel.value;
      window.speechSynthesis.speak(utterance);
    }
  });

  async function translate() {
    const text = input.value.trim();
    if (!text) { input.focus(); return; }

    const from = fromSel.value;
    const to = toSel.value;
    if (from === to) {
      output.textContent = text;
      status.textContent = 'Source and target languages are the same.';
      return;
    }

    output.innerHTML = '<div class="flex items-center gap-2 text-[var(--brand)]"><i class="fas fa-spinner fa-spin"></i> Translating…</div>';
    status.textContent = 'Processing request...';

    try {
      const langPair = `${from}|${to}`;
      const encodedText = encodeURIComponent(text);
      const url = `https://api.mymemory.translated.net/get?q=${encodedText}&langpair=${langPair}`;

      const res = await fetch(url);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();

      if (data.responseStatus === 200) {
        const translated = data.responseData.translatedText;
        output.textContent = translated;
        status.textContent = `Translated: ${langNames[from] ?? from} → ${langNames[to] ?? to}`;
      } else {
        throw new Error(data.responseDetails || 'Translation failed');
      }
    } catch (err: any) {
      output.innerHTML = `<span class="text-rose-500"><i class="fas fa-circle-exclamation"></i> Translation error: ${err.message}.</span>`;
      status.textContent = 'Error occurred';
    }
  }

  document.getElementById('tr-translate-btn')?.addEventListener('click', translate);

  input.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      translate();
    }
  });
</script>
