---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools, getToolBySlug } from '../data/tools';

export function getStaticPaths() {
  // These are tools that don't have their own dedicated page file yet
  // They render using this dynamic page template
  const dedicatedPages = [
    'word-counter',
    'text-case-converter',
    'random-password-generator',
    'uuid-generator',
    'age-calculator',
    'bmi-calculator',
    'hex-to-rgb-converter',
    'remove-duplicates',
    'emi-calculator',
    'language-translator',
    // Newly built tools
    'compare',
    'color-contrast-checker',
    'keyboard-tester',
    'random-email-generator',
    'username-generator',
    'youtube-monetization-checker',
    'qr-code-generator',
    'barcode-generator',
    'business-name-generator',
    'stylish-name',
    'linkedin-post-generation',
    'percentage-calculator',
    'bitumen-calculator',
    'gematria-calculator',
    'bottleneck-calculator',
    'blood-pressure-calculator',
    'cgpa-calculator',
    'snow-day-calculator',
    'unit-converter',
    'image-converter',
    'cgpa-percentage-converter',
    'thumbnail-downloader',
    'pdf-converter',
    'youtube-to-mp3-converter',
    'video-downloader',
    'vsco-downloader',
    'instagram-downloader',
    'studocu-downloader',
    'issuu-downloader',
    'coursehero-downloader',
  ];
  return tools
    .filter(t => !dedicatedPages.includes(t.slug))
    .map(t => ({ params: { slug: t.slug } }));
}

const { slug } = Astro.params;
const tool = getToolBySlug(slug!)!;
---

<ToolLayout tool={tool}>
  <div class="stub-wrap">
    <div class="stub-hero">
      <div class="stub-icon">{tool.icon}</div>
      <h2 class="font-display stub-title">{tool.name}</h2>
      <p class="stub-desc">{tool.metaDescription}</p>
    </div>

    <div class="stub-features">
      <h3>What this tool does</h3>
      <ul>
        <li><i class="fas fa-check-circle"></i> {tool.description}</li>
        <li><i class="fas fa-check-circle"></i> Works entirely in your browser — no uploads to servers</li>
        <li><i class="fas fa-check-circle"></i> 100% free, no account or sign-up needed</li>
        <li><i class="fas fa-check-circle"></i> Instant results, available on any device</li>
      </ul>
    </div>

    <div class="stub-notice">
      <i class="fas fa-screwdriver-wrench"></i>
      <div>
        <strong>Full interactive tool coming soon!</strong>
        <p>This tool page is being built. The full interface will be available shortly. Check out our other tools in the meantime.</p>
      </div>
    </div>

    <a href="/" class="btn btn-primary" style="align-self: flex-start; margin-top: 8px;">
      <i class="fas fa-arrow-left"></i> Browse all tools
    </a>
  </div>
</ToolLayout>

<style>
  .stub-wrap { display: flex; flex-direction: column; gap: 24px; }
  .stub-hero { text-align: center; padding: 32px 20px; background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-lg); }
  .stub-icon { font-size: 52px; margin-bottom: 14px; }
  .stub-title { font-size: 1.8rem; font-weight: 800; color: var(--txt); margin-bottom: 10px; }
  .stub-desc { font-size: 15px; color: var(--txt-muted); max-width: 500px; margin: 0 auto; line-height: 1.6; }
  .stub-features h3 { font-size: 16px; font-weight: 700; color: var(--txt); margin-bottom: 12px; }
  .stub-features ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .stub-features li { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; color: var(--txt-muted); }
  .stub-features i { color: var(--brand); margin-top: 2px; flex-shrink: 0; }
  .stub-notice {
    display: flex;
    gap: 14px;
    padding: 16px 20px;
    background: var(--surface-2);
    border: 1.5px solid var(--amber);
    border-radius: var(--radius-md);
    align-items: flex-start;
  }
  .stub-notice > i { color: var(--amber); font-size: 18px; margin-top: 2px; flex-shrink: 0; }
  .stub-notice strong { display: block; font-size: 15px; color: var(--txt); margin-bottom: 4px; }
  .stub-notice p { font-size: 13.5px; color: var(--txt-muted); line-height: 1.5; }
</style>
