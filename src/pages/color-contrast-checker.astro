---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'color-contrast-checker')!;
---

<ToolLayout tool={tool}>
  <div class="cc-wrap">
    <div class="cc-inputs">
      <div class="cc-field">
        <label for="cc-fg">Foreground (Text) Color</label>
        <div class="cc-color-row">
          <input type="color" id="cc-fg-picker" value="#FFFFFF" class="cc-color-picker" />
          <input type="text" id="cc-fg" class="cc-hex" value="#FFFFFF" maxlength="7" spellcheck="false" />
        </div>
      </div>
      <div class="cc-swatch-preview" id="cc-preview">
        <span id="cc-preview-text">Sample Text Aa</span>
      </div>
      <div class="cc-field">
        <label for="cc-bg">Background Color</label>
        <div class="cc-color-row">
          <input type="color" id="cc-bg-picker" value="#1E293B" class="cc-color-picker" />
          <input type="text" id="cc-bg" class="cc-hex" value="#1E293B" maxlength="7" spellcheck="false" />
        </div>
      </div>
    </div>

    <div class="cc-results" id="cc-results">
      <div class="cc-ratio-box">
        <div class="cc-ratio-num" id="cc-ratio">—</div>
        <div class="cc-ratio-label">Contrast Ratio</div>
      </div>
      <div class="cc-wcag-grid">
        <div class="cc-wcag-item" id="w-aa-normal">
          <div class="cc-wcag-label">AA Normal</div>
          <div class="cc-wcag-req">≥ 4.5:1</div>
          <div class="cc-wcag-badge" id="b-aa-normal">—</div>
        </div>
        <div class="cc-wcag-item" id="w-aa-large">
          <div class="cc-wcag-label">AA Large</div>
          <div class="cc-wcag-req">≥ 3:1</div>
          <div class="cc-wcag-badge" id="b-aa-large">—</div>
        </div>
        <div class="cc-wcag-item" id="w-aaa-normal">
          <div class="cc-wcag-label">AAA Normal</div>
          <div class="cc-wcag-req">≥ 7:1</div>
          <div class="cc-wcag-badge" id="b-aaa-normal">—</div>
        </div>
        <div class="cc-wcag-item" id="w-aaa-large">
          <div class="cc-wcag-label">AAA Large</div>
          <div class="cc-wcag-req">≥ 4.5:1</div>
          <div class="cc-wcag-badge" id="b-aaa-large">—</div>
        </div>
      </div>
    </div>

    <div class="cc-swatches">
      <div class="cc-swatches-label">Quick presets</div>
      <div class="cc-swatches-row">
        <button class="cc-swatch-btn" data-fg="#FFFFFF" data-bg="#000000" style="background:#000;color:#fff">Black/White</button>
        <button class="cc-swatch-btn" data-fg="#FFFFFF" data-bg="#2563EB" style="background:#2563EB;color:#fff">Blue/White</button>
        <button class="cc-swatch-btn" data-fg="#1E293B" data-bg="#F8FAFC" style="background:#F8FAFC;color:#1E293B;border-color:#E2E8F0">Light Mode</button>
        <button class="cc-swatch-btn" data-fg="#F1F5F9" data-bg="#0F172A" style="background:#0F172A;color:#F1F5F9">Dark Mode</button>
        <button class="cc-swatch-btn" data-fg="#FFFFFF" data-bg="#DC2626" style="background:#DC2626;color:#fff">Red/White</button>
        <button class="cc-swatch-btn" data-fg="#FFFFFF" data-bg="#7C3AED" style="background:#7C3AED;color:#fff">Purple/White</button>
      </div>
    </div>
  </div>
</ToolLayout>

<style>
  .cc-wrap { display: flex; flex-direction: column; gap: 24px; }
  .cc-inputs { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .cc-field { display: flex; flex-direction: column; gap: 8px; flex: 1; min-width: 180px; }
  .cc-field label { font-size: 13px; font-weight: 700; color: var(--txt-muted); text-transform: uppercase; letter-spacing: .04em; }
  .cc-color-row { display: flex; gap: 10px; align-items: center; }
  .cc-color-picker { width: 48px; height: 42px; border: 1.5px solid var(--border); border-radius: var(--radius-sm); cursor: pointer; padding: 3px; background: var(--bg-soft); }
  .cc-hex {
    flex: 1;
    padding: 10px 14px;
    font-size: 15px;
    font-family: 'Courier New', monospace;
    font-weight: 600;
    color: var(--txt);
    background: var(--bg-soft);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    outline: none;
    transition: border-color .15s;
  }
  .cc-hex:focus { border-color: var(--brand); }
  .cc-swatch-preview {
    flex: 1;
    min-height: 80px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--border);
    padding: 16px;
  }
  #cc-preview-text { font-size: 22px; font-weight: 700; font-family: 'Inter', sans-serif; }

  .cc-results { display: flex; gap: 16px; flex-wrap: wrap; align-items: stretch; }
  .cc-ratio-box {
    padding: 24px 32px;
    background: linear-gradient(135deg, #EFF6FF, #F5F3FF);
    border-radius: var(--radius-lg);
    text-align: center;
    min-width: 140px;
    border: 1.5px solid var(--border);
    display: flex; flex-direction: column; justify-content: center;
  }
  .cc-ratio-num { font-size: 2.8rem; font-weight: 900; color: var(--brand); font-family: 'Outfit', sans-serif; }
  .cc-ratio-label { font-size: 12px; font-weight: 700; color: var(--txt-muted); text-transform: uppercase; margin-top: 4px; }

  .cc-wcag-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; flex: 1; }
  .cc-wcag-item { padding: 14px 16px; background: var(--bg-soft); border: 1.5px solid var(--border); border-radius: var(--radius-md); display: flex; flex-direction: column; gap: 4px; }
  .cc-wcag-label { font-size: 13px; font-weight: 700; color: var(--txt); }
  .cc-wcag-req { font-size: 11px; color: var(--txt-muted); }
  .cc-wcag-badge { font-size: 14px; font-weight: 800; margin-top: 4px; }
  .badge-pass { color: #22C55E; }
  .badge-fail { color: #EF4444; }

  .cc-swatches-label { font-size: 13px; font-weight: 600; color: var(--txt-muted); margin-bottom: 10px; }
  .cc-swatches-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .cc-swatch-btn {
    padding: 8px 14px;
    border-radius: 100px;
    border: 1.5px solid rgba(0,0,0,.15);
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: transform .15s, box-shadow .15s;
    font-family: 'Inter', sans-serif;
  }
  .cc-swatch-btn:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,0,0,.15); }
</style>

<script>
  function hexToRgb(hex: string): [number,number,number] | null {
    const r = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    if (!r) return null;
    return [parseInt(r[1], 16), parseInt(r[2], 16), parseInt(r[3], 16)];
  }

  function relativeLuminance([r, g, b]: [number,number,number]): number {
    const sRGB = [r, g, b].map(c => {
      const s = c / 255;
      return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
    });
    return 0.2126 * sRGB[0] + 0.7152 * sRGB[1] + 0.0722 * sRGB[2];
  }

  function contrastRatio(hex1: string, hex2: string): number | null {
    const rgb1 = hexToRgb(hex1);
    const rgb2 = hexToRgb(hex2);
    if (!rgb1 || !rgb2) return null;
    const l1 = relativeLuminance(rgb1);
    const l2 = relativeLuminance(rgb2);
    const lighter = Math.max(l1, l2);
    const darker = Math.min(l1, l2);
    return (lighter + 0.05) / (darker + 0.05);
  }

  function setBadge(id: string, pass: boolean) {
    const el = document.getElementById(id)!;
    if (pass) { el.textContent = '✓ Pass'; el.className = 'cc-wcag-badge badge-pass'; }
    else { el.textContent = '✗ Fail'; el.className = 'cc-wcag-badge badge-fail'; }
  }

  function update() {
    const fgVal = (document.getElementById('cc-fg') as HTMLInputElement).value;
    const bgVal = (document.getElementById('cc-bg') as HTMLInputElement).value;
    const preview = document.getElementById('cc-preview')!;
    preview.style.background = bgVal;
    document.getElementById('cc-preview-text')!.style.color = fgVal;

    const ratio = contrastRatio(fgVal, bgVal);
    if (ratio === null) return;

    document.getElementById('cc-ratio')!.textContent = ratio.toFixed(2) + ':1';
    setBadge('b-aa-normal', ratio >= 4.5);
    setBadge('b-aa-large', ratio >= 3);
    setBadge('b-aaa-normal', ratio >= 7);
    setBadge('b-aaa-large', ratio >= 4.5);
  }

  function syncPicker(pickerId: string, hexId: string) {
    const picker = document.getElementById(pickerId) as HTMLInputElement;
    const hex = document.getElementById(hexId) as HTMLInputElement;
    picker.addEventListener('input', () => { hex.value = picker.value.toUpperCase(); update(); });
    hex.addEventListener('input', () => {
      const v = hex.value;
      if (/^#[0-9A-Fa-f]{6}$/.test(v)) { picker.value = v; update(); }
    });
  }

  syncPicker('cc-fg-picker', 'cc-fg');
  syncPicker('cc-bg-picker', 'cc-bg');

  document.querySelectorAll('.cc-swatch-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const fg = (btn as HTMLElement).dataset.fg!;
      const bg = (btn as HTMLElement).dataset.bg!;
      (document.getElementById('cc-fg') as HTMLInputElement).value = fg;
      (document.getElementById('cc-bg') as HTMLInputElement).value = bg;
      (document.getElementById('cc-fg-picker') as HTMLInputElement).value = fg;
      (document.getElementById('cc-bg-picker') as HTMLInputElement).value = bg;
      update();
    });
  });

  update();
</script>
