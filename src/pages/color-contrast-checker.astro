<script>
  function hexToRgb(hex: string): [number,number,number] | null {
    const r = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    if (!r) return null;
    return [parseInt(r[1], 16), parseInt(r[2], 16), parseInt(r[3], 16)];
  }

  function relativeLuminance([r, g, b]: [number,number,number]): number {
    const sRGB = [r, g, b].map(c => {
      const s = c / 255;
      return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
    });
    return 0.2126 * sRGB[0] + 0.7152 * sRGB[1] + 0.0722 * sRGB[2];
  }

  function contrastRatio(hex1: string, hex2: string): number | null {
    const rgb1 = hexToRgb(hex1);
    const rgb2 = hexToRgb(hex2);
    if (!rgb1 || !rgb2) return null;
    const l1 = relativeLuminance(rgb1);
    const l2 = relativeLuminance(rgb2);
    const lighter = Math.max(l1, l2);
    const darker = Math.min(l1, l2);
    return (lighter + 0.05) / (darker + 0.05);
  }

  function setBadge(id: string, pass: boolean) {
    const el = document.getElementById(id);
    if (!el) return;
    if (pass) {
      el.textContent = '✓ PASS';
      el.className = 'text-xs font-black px-2 py-1 rounded-lg bg-emerald-500/20 text-emerald-400 border border-emerald-500/30';
    } else {
      el.textContent = '✗ FAIL';
      el.className = 'text-xs font-black px-2 py-1 rounded-lg bg-red-500/20 text-red-400 border border-red-500/30';
    }
  }

  function update() {
    const fgVal = (document.getElementById('cc-fg') as HTMLInputElement).value;
    const bgVal = (document.getElementById('cc-bg') as HTMLInputElement).value;

    const preview = document.getElementById('cc-preview');
    const previewHeading = document.getElementById('cc-preview-heading');
    const previewText = document.getElementById('cc-preview-text');
    const previewBtn = document.getElementById('cc-preview-button');

    if (preview) preview.style.backgroundColor = bgVal;
    if (previewHeading) previewHeading.style.color = fgVal;
    if (previewText) previewText.style.color = fgVal;
    if (previewBtn) {
      previewBtn.style.backgroundColor = fgVal;
      previewBtn.style.color = bgVal;
    }

    const ratio = contrastRatio(fgVal, bgVal);
    if (ratio === null) return;

    const ratioEl = document.getElementById('cc-ratio');
    if (ratioEl) ratioEl.textContent = ratio.toFixed(2) + ':1';

    const verdictEl = document.getElementById('cc-verdict');
    if (verdictEl) {
      if (ratio >= 7) {
        verdictEl.textContent = 'AAA PASS';
        verdictEl.className = 'text-xs font-black text-emerald-300 bg-emerald-500/20 border border-emerald-500/40 px-2.5 py-1 rounded-md text-center';
      } else if (ratio >= 4.5) {
        verdictEl.textContent = 'AA PASS';
        verdictEl.className = 'text-xs font-black text-teal-300 bg-teal-500/20 border border-teal-500/40 px-2.5 py-1 rounded-md text-center';
      } else if (ratio >= 3) {
        verdictEl.textContent = 'LARGE TEXT ONLY';
        verdictEl.className = 'text-xs font-black text-amber-300 bg-amber-500/20 border border-amber-500/40 px-2.5 py-1 rounded-md text-center';
      } else {
        verdictEl.textContent = 'FAIL WCAG';
        verdictEl.className = 'text-xs font-black text-red-300 bg-red-500/20 border border-red-500/40 px-2.5 py-1 rounded-md text-center';
      }
    }

    setBadge('b-aa-normal', ratio >= 4.5);
    setBadge('b-aa-large', ratio >= 3);
    setBadge('b-aaa-normal', ratio >= 7);
    setBadge('b-aaa-large', ratio >= 4.5);
  }

  function syncPicker(pickerId: string, hexId: string) {
    const picker = document.getElementById(pickerId) as HTMLInputElement;
    const hex = document.getElementById(hexId) as HTMLInputElement;
    if (!picker || !hex) return;
    picker.addEventListener('input', () => { hex.value = picker.value.toUpperCase(); update(); });
    hex.addEventListener('input', () => {
      const v = hex.value;
      if (/^#[0-9A-Fa-f]{6}$/.test(v)) { picker.value = v; update(); }
    });
  }

  syncPicker('cc-fg-picker', 'cc-fg');
  syncPicker('cc-bg-picker', 'cc-bg');

  document.querySelectorAll('.cc-swatch-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const fg = (btn as HTMLElement).dataset.fg!;
      const bg = (btn as HTMLElement).dataset.bg!;
      (document.getElementById('cc-fg') as HTMLInputElement).value = fg;
      (document.getElementById('cc-bg') as HTMLInputElement).value = bg;
      (document.getElementById('cc-fg-picker') as HTMLInputElement).value = fg;
      (document.getElementById('cc-bg-picker') as HTMLInputElement).value = bg;
      update();
    });
  });

  update();
</script>
