---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'random-password-generator')!;
---

<ToolLayout tool={tool} customLayout={true}>
  <div class="tool-page-wrap">
    <!-- Cybersecurity Vault Hero -->
    <div class="tool-hero-box">
      <div class="inline-flex items-center gap-2 tool-badge-pill mb-3">
        <i class="fas fa-shield-alt text-[var(--brand)]"></i> Client-Side Cryptographic RNG
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-[var(--txt)]">
        Random <span class="bg-gradient-to-r from-[var(--brand)] to-[var(--brand-dark)] bg-clip-text text-transparent">Password Generator</span>
      </h1>
      <p class="text-sm sm:text-base mt-2 max-w-2xl text-[var(--txt-muted)] leading-relaxed">
        Generate ultra-secure, cryptographically random passwords in your browser. Complete memory isolation with zero server transmission.
      </p>
    </div>

    <!-- Password Output Terminal Card -->
    <div class="tool-card-surface space-y-6 mb-10">
      <!-- Display Field with Copy Button -->
      <div class="relative flex items-center tool-inner-panel p-2 transition-all focus-within:border-[var(--brand)]">
        <input
          type="text"
          id="pg-result"
          readonly
          placeholder="Generating password..."
          class="w-full bg-transparent text-[var(--brand)] font-mono text-lg sm:text-2xl font-bold px-3 py-2 outline-none tracking-wide select-all"
        />
        <div class="flex items-center gap-1.5 pr-1">
          <button
            id="pg-copy"
            class="px-5 py-2.5 rounded-xl bg-[var(--brand)] hover:opacity-90 active:scale-[0.98] text-white font-extrabold text-xs transition-all shadow-md inline-flex items-center gap-1.5 cursor-pointer"
          >
            <i class="fas fa-copy"></i> Copy
          </button>
        </div>
      </div>

      <!-- Entropy Strength Bar -->
      <div id="pg-strength-wrap" class="space-y-1.5">
        <div class="flex justify-between items-center text-xs">
          <span class="text-[var(--txt-muted)] font-mono uppercase text-[11px]">Entropy Assessment</span>
          <span id="pg-strength-text" class="font-bold font-mono text-[var(--brand)]">Strong</span>
        </div>
        <div class="h-2 rounded-full bg-[var(--surface-3)] overflow-hidden">
          <div id="pg-strength-fill" class="h-full bg-[var(--brand)] transition-all duration-300" style="width: 75%;"></div>
        </div>
      </div>

      <!-- Configuration Controls -->
      <div class="pt-4 border-t border-[var(--border)] space-y-5">
        <!-- Slider -->
        <div>
          <div class="flex justify-between items-center mb-2">
            <label for="pg-length" class="text-xs font-bold uppercase tracking-wider text-[var(--txt-muted)]">
              Password Length
            </label>
            <span class="px-2.5 py-0.5 rounded-md bg-[var(--brand)]/15 border border-[var(--brand)]/30 text-[var(--brand)] font-mono font-bold text-xs" id="pg-len-display">
              16
            </span>
          </div>
          <input
            type="range"
            id="pg-length"
            min="6"
            max="64"
            value="16"
            class="w-full accent-[var(--brand)] cursor-pointer h-2 bg-[var(--surface-3)] rounded-lg"
          />
        </div>

        <!-- Checkbox Options -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <label class="flex items-center gap-2 p-3 rounded-xl tool-inner-panel hover:border-[var(--brand)] text-xs text-[var(--txt)] cursor-pointer transition-all">
            <input type="checkbox" id="pg-upper" checked class="accent-[var(--brand)] rounded" />
            <span>Uppercase (A-Z)</span>
          </label>
          <label class="flex items-center gap-2 p-3 rounded-xl tool-inner-panel hover:border-[var(--brand)] text-xs text-[var(--txt)] cursor-pointer transition-all">
            <input type="checkbox" id="pg-lower" checked class="accent-[var(--brand)] rounded" />
            <span>Lowercase (a-z)</span>
          </label>
          <label class="flex items-center gap-2 p-3 rounded-xl tool-inner-panel hover:border-[var(--brand)] text-xs text-[var(--txt)] cursor-pointer transition-all">
            <input type="checkbox" id="pg-numbers" checked class="accent-[var(--brand)] rounded" />
            <span>Numbers (0-9)</span>
          </label>
          <label class="flex items-center gap-2 p-3 rounded-xl tool-inner-panel hover:border-[var(--brand)] text-xs text-[var(--txt)] cursor-pointer transition-all">
            <input type="checkbox" id="pg-symbols" class="accent-[var(--brand)] rounded" />
            <span>Symbols (!@#$)</span>
          </label>
        </div>

        <button
          id="pg-generate"
          class="w-full py-3.5 px-6 rounded-xl tool-inner-panel hover:border-[var(--brand)] active:scale-[0.98] text-[var(--txt)] font-extrabold text-sm transition-all flex items-center justify-center gap-2 cursor-pointer shadow-sm"
        >
          <i class="fas fa-arrows-rotate text-[var(--brand)]"></i> Generate New Password
        </button>
      </div>
    </div>

    <!-- How to Use -->
    <div class="tool-content-wrap">

      <section class="tool-content-card">
        <div class="tool-content-header">
          <span class="tool-badge-pill mb-3">
            <i class="fas fa-list-ol text-[var(--brand)]"></i> Step-by-Step Guide
          </span>
          <h2>How to Generate a Strong Password</h2>
          <p>Create a secure, random password in seconds with full control over length and character types.</p>
        </div>
        <ol class="mt-6 space-y-4">
          <li class="flex gap-4 items-start">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[var(--brand-soft)] border border-[var(--brand)]/30 flex items-center justify-center text-[var(--brand)] font-black text-sm font-mono">1</span>
            <div>
              <strong class="text-[var(--txt)] text-sm block mb-1">Set the password length</strong>
              <span class="text-sm text-[var(--txt-muted)] leading-relaxed">Drag the slider to choose your desired length. For most accounts, 16 characters or more is recommended. For critical accounts like banking or email, aim for 20+.</span>
            </div>
          </li>
          <li class="flex gap-4 items-start">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[var(--brand-soft)] border border-[var(--brand)]/30 flex items-center justify-center text-[var(--brand)] font-black text-sm font-mono">2</span>
            <div>
              <strong class="text-[var(--txt)] text-sm block mb-1">Choose your character types</strong>
              <span class="text-sm text-[var(--txt-muted)] leading-relaxed">Toggle uppercase letters, lowercase letters, numbers, and special symbols. The more types you include, the larger the character pool and the harder the password is to crack.</span>
            </div>
          </li>
          <li class="flex gap-4 items-start">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[var(--brand-soft)] border border-[var(--brand)]/30 flex items-center justify-center text-[var(--brand)] font-black text-sm font-mono">3</span>
            <div>
              <strong class="text-[var(--txt)] text-sm block mb-1">Generate and check the strength</strong>
              <span class="text-sm text-[var(--txt-muted)] leading-relaxed">Click <strong>Generate New Password</strong>. The entropy bar updates instantly to show Weak, Fair, Strong, or Very Strong. Keep regenerating until you're happy.</span>
            </div>
          </li>
          <li class="flex gap-4 items-start">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[var(--brand-soft)] border border-[var(--brand)]/30 flex items-center justify-center text-[var(--brand)] font-black text-sm font-mono">4</span>
            <div>
              <strong class="text-[var(--txt)] text-sm block mb-1">Copy and save it in a password manager</strong>
              <span class="text-sm text-[var(--txt-muted)] leading-relaxed">Click <strong>Copy</strong> and paste directly into your password manager (1Password, Bitwarden, Dashlane, etc.). Never store passwords in plain text or reuse them across sites.</span>
            </div>
          </li>
        </ol>
      </section>

    <!-- Entropy & Cryptanalysis Stream (Technical Content Module) -->
    <div style="margin-top:0">
      
      <section class="tool-content-card">
        <!-- Section Header -->
        <div class="tool-content-header">
          <h2>Cryptographic Entropy &amp; Hardware Attack Physics</h2>
          <p>
            Modern authentication security does not rely on obscure symbols or frequent expiration cycles—it rests on pure mathematical unpredictability. Explore the real-time entropy sidebar and flowing cryptanalysis stream below to understand how client-side CSPRNG isolates you from automated credential compromise.
          </p>
        </div>

        <!-- Two-Column Frame: Sticky Sidebar + Flowing Stream -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start pt-6 border-t border-[var(--border)]">
          
          <!-- Left Column: Sticky Sidebar (4 cols) -->
          <aside class="lg:col-span-4 lg:sticky lg:top-24 space-y-8 self-start">
            
            <!-- Stream Index Navigation -->
            <div class="space-y-3 pb-6 border-b border-[var(--border)]">
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--txt-muted)] block">
                Cryptanalysis Index
              </span>
              <nav class="flex flex-col space-y-2 text-xs font-mono">
                <a href="#entropy-math" class="text-[var(--txt)] hover:text-[var(--brand)] transition-colors py-1">
                  01 &bull; Shannon Entropy Formula
                </a>
                <a href="#brute-force" class="text-[var(--txt-muted)] hover:text-[var(--brand)] transition-colors py-1">
                  02 &bull; GPU Brute-Force Physics
                </a>
                <a href="#csprng" class="text-[var(--txt-muted)] hover:text-[var(--brand)] transition-colors py-1">
                  03 &bull; Hardware CSPRNG Architecture
                </a>
                <a href="#passphrases" class="text-[var(--txt-muted)] hover:text-[var(--brand)] transition-colors py-1">
                  04 &bull; Diceware &amp; Passphrases
                </a>
                <a href="#faq" class="text-[var(--txt-muted)] hover:text-[var(--brand)] transition-colors py-1">
                  05 &bull; Security Audit FAQs
                </a>
              </nav>
            </div>

            <!-- Shannon Entropy Quick Reference Matrix -->
            <div class="space-y-3 pb-6 border-b border-[var(--border)] font-mono text-xs">
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--txt-muted)] block">
                Pool Permutations (N^L)
              </span>
              <div class="space-y-2 text-[var(--txt-muted)]">
                <div class="flex justify-between py-1 border-b border-[var(--border)]/50">
                  <span>Numbers Only (10)</span>
                  <span class="text-[var(--txt)] font-bold">3.32 bits / char</span>
                </div>
                <div class="flex justify-between py-1 border-b border-[var(--border)]/50">
                  <span>Lowercase Only (26)</span>
                  <span class="text-[var(--txt)] font-bold">4.70 bits / char</span>
                </div>
                <div class="flex justify-between py-1 border-b border-[var(--border)]/50">
                  <span>Alphanumeric (62)</span>
                  <span class="text-[var(--txt)] font-bold">5.95 bits / char</span>
                </div>
                <div class="flex justify-between py-1">
                  <span>Full Special Set (94)</span>
                  <span class="text-[var(--brand)] font-bold">6.55 bits / char</span>
                </div>
              </div>
            </div>

            <!-- NIST SP 800-63B Standards Checklist -->
            <div class="space-y-3 font-mono text-xs">
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--txt-muted)] block">
                NIST 800-63B Compliance
              </span>
              <ul class="space-y-2 text-[var(--txt-muted)]">
                <li class="flex items-start gap-2">
                  <span class="text-[var(--brand)] font-bold">&check;</span>
                  <span>Minimum 16 characters recommended for general accounts.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-[var(--brand)] font-bold">&check;</span>
                  <span>Eliminates arbitrary 90-day periodic password expirations.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-[var(--brand)] font-bold">&check;</span>
                  <span>Screens against breached password databases (HIBP).</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-[var(--brand)] font-bold">&check;</span>
                  <span>Permits copy/paste to encourage password manager adoption.</span>
                </li>
              </ul>
            </div>

          </aside>

          <!-- Right Column: Flowing Narrative Stream (8 cols) -->
          <div class="lg:col-span-8 space-y-12">

            <!-- Stream Item 01: Shannon Entropy -->
            <article id="entropy-math" class="space-y-4">
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--brand)]">Stream 01</span>
                <span class="text-xs text-[var(--txt-muted)] font-mono">Mathematical Foundation</span>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-[var(--txt)] tracking-tight">
                The Shannon Entropy Equation: Why Length Outperforms Complexity
              </h3>
              <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
                Information entropy measures the uncertainty or unpredictability of a password string. Mathematically, for a character set of size <em>N</em> and a password length of <em>L</em>, total bits of entropy <em>H</em> are expressed as:
              </p>
              <div class="p-4 rounded-xl bg-[var(--surface-2)] border border-[var(--border)] font-mono text-sm text-[var(--txt)]">
                H = L &times; log<sub>2</sub>(N)
              </div>
              <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
                Notice the mathematical implication: increasing character set size <em>N</em> (such as adding exclamation marks or dollar signs) operates on a logarithmic scale, whereas increasing password length <em>L</em> multiplies entropy linearly. An 8-character password composed of complex symbols yields roughly 52 bits of entropy. A 16-character password using only lowercase letters yields over 75 bits—making the longer, simpler password 8 million times more resistant to mathematical exhaustion.
              </p>
            </article>

            <!-- Stream Item 02: GPU Brute-Force Physics -->
            <article id="brute-force" class="space-y-4">
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--brand)]">Stream 02</span>
                <span class="text-xs text-[var(--txt-muted)] font-mono">Hardware Threat Modeling</span>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-[var(--txt)] tracking-tight">
                The Physics of Modern GPU Brute-Force Exhaustion
              </h3>
              <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
                Adversaries who exfiltrate a hashed database do not guess passwords through web forms—they launch offline distributed cracking rigs utilizing Hashcat and custom ASIC or GPU arrays. An 8-card RTX 4090 rig evaluates standard NTLM or MD5 hashes at over 300 billion guesses per second (300 GH/s).
              </p>
              <div class="tool-specs-table-wrap">
                <table class="tool-specs-table">
                  <thead>
                    <tr>
                      <th>Length &amp; Character Set</th>
                      <th>Permutations</th>
                      <th>Time at 300 GH/s</th>
                      <th>Practical Security</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td class="font-bold text-rose-500">8 chars (Numbers only)</td>
                      <td>10<sup>8</sup></td>
                      <td class="text-rose-500">0.0003 ms</td>
                      <td class="text-rose-500 font-semibold">Instant Collapse</td>
                    </tr>
                    <tr>
                      <td class="font-bold text-rose-500">8 chars (All characters)</td>
                      <td>6.09 &times; 10<sup>15</sup></td>
                      <td class="text-rose-500">5.6 hours</td>
                      <td class="text-rose-500 font-semibold">High Vulnerability</td>
                    </tr>
                    <tr>
                      <td class="font-bold text-amber-500">12 chars (All characters)</td>
                      <td>4.75 &times; 10<sup>23</sup></td>
                      <td class="text-amber-500">50,200 years</td>
                      <td class="text-amber-500 font-semibold">Strong Defense</td>
                    </tr>
                    <tr>
                      <td class="font-bold text-emerald-500">16 chars (All characters)</td>
                      <td>3.71 &times; 10<sup>31</sup></td>
                      <td class="text-emerald-500">3.9 &times; 10<sup>12</sup> years</td>
                      <td class="text-emerald-500 font-semibold">Astronomically Immune</td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
                At 16 characters or above, the thermodynamic energy required to iterate through keyspace exceeds the total power output of planetary civilization. The only viable attack vectors against such passwords are social engineering, phishing, or malware keylogging.
              </p>
            </article>

            <!-- Stream Item 03: Hardware CSPRNG Architecture -->
            <article id="csprng" class="space-y-4">
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--brand)]">Stream 03</span>
                <span class="text-xs text-[var(--txt-muted)] font-mono">Randomness Source</span>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-[var(--txt)] tracking-tight">
                Hardware CSPRNG: Why Standard Math.random() is Cryptographically Fatal
              </h3>
              <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
                Many naive web tools generate passwords using JavaScript's built-in <code class="text-[var(--brand)] font-mono">Math.random()</code>. This is an immense vulnerability. <code class="text-[var(--brand)] font-mono">Math.random()</code> uses pseudo-random algorithms like XorShift128+, designed solely for rendering speed and gaming physics. An attacker observing as few as two generated outputs can reverse-engineer the generator's internal state and predict every past and future password created in that session.
              </p>
              <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
                Toolarsh strictly calls <code class="text-[var(--brand)] font-mono">crypto.getRandomValues()</code>. This interface hooks directly into operating system entropy pools—gathering genuine hardware thermal jitter, mouse movements, keyboard timings, and hardware interrupt noise from CPU ring buffers. It satisfies FIPS 140-2 cryptographic randomness standards with zero predictability.
              </p>
            </article>

            <!-- Stream Item 04: Diceware Passphrases -->
            <article id="passphrases" class="space-y-4">
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--brand)]">Stream 04</span>
                <span class="text-xs text-[var(--txt-muted)] font-mono">Human Ergonomics</span>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-[var(--txt)] tracking-tight">
                Passphrases &amp; Diceware: The Supremacy of Memory Ergonomics
              </h3>
              <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
                When humans are forced to create 16-character gibberish passwords (e.g., <code class="font-mono">zK7#v9!qP2$mR8@x</code>), they predictably write them on sticky notes, reuse them across multiple platforms, or alter only the final digit when prompted to change them.
              </p>
              <p class="text-sm sm:text-base text-[var(--txt-muted)] leading-relaxed">
                The Diceware methodology resolves human cognitive limits. By chaining together 5 or 6 randomly chosen dictionary words (such as <code class="font-mono text-[var(--brand)]">correct horse battery staple</code>), each word selected from a curated list of 7,776 entries provides 12.9 bits of entropy. A 5-word passphrase produces ~65 bits of entropy, while remaining effortlessly memorable and completely resistant to automated dictionary attacks.
              </p>
            </article>

          </div>
        </div>
      </section>

      <!-- Stream Item 05: Hairline FAQ Accordion -->
      <section id="faq" class="tool-content-card">
        <div class="tool-content-header">
          <h2>Cryptographic Security Frequently Asked Questions</h2>
          <p>
            Hardware RNG mechanics, zero-knowledge isolation, and compliance standards.
          </p>
        </div>

        <div class="tool-faq-accordion">
          <details class="tool-faq-item">
            <summary>
              <span>Why does NIST SP 800-63B advise against mandatory 90-day password changes?</span>
              <svg class="faq-chevron" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="faq-answer">
              Decades of empirical cybersecurity research demonstrated that frequent forced expirations lead users to choose predictable patterns (e.g., Spring2024! becoming Summer2024!). NIST recommends retaining strong, long passwords indefinitely unless an active breach or unauthorized exfiltration has been detected.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>Are generated credentials transmitted or stored on any cloud server?</span>
              <svg class="faq-chevron" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="faq-answer">
              No. The generation script executes entirely in client-side JavaScript memory using your browser's native Web Cryptography API. There are zero POST requests, telemetry beacons, or database connections. The generated string exists solely in volatile device RAM and is destroyed the moment the tab is refreshed.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>Could future quantum computers instantly decrypt 16-character passwords?</span>
              <svg class="faq-chevron" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="faq-answer">
              Grover's quantum algorithm offers a quadratic speedup for unstructured database searches (halving effective bit security from 128 bits to 64 bits). However, passwords hashed with modern memory-hard key derivation functions (like Argon2id or Scrypt) require substantial physical memory per guess, neutralizing quantum parallelism and keeping 16+ character passwords secure against quantum cryptanalysis.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>Does this tool store or log the passwords it generates?</span>
              <svg class="faq-chevron" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="faq-answer">
              No. Passwords are generated entirely in your browser using JavaScript and the Web Crypto API. Nothing is sent to a server, stored in a database, or logged in analytics. Once you close or refresh the tab, the password is gone. This is by design.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>What makes a password strong &mdash; length or complexity?</span>
              <svg class="faq-chevron" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="faq-answer">
              Both matter, but length has a bigger impact. Every additional character multiplies the number of possible combinations by the size of the character pool. A 20-character alphanumeric password is far harder to crack than a 12-character password using symbols. NIST SP 800-63B now prioritizes length (8+ characters minimum, 15+ recommended) over mandatory complexity rules.
            </div>
          </details>
        </div>
      </section>

    </div>
    </div>
  </div>
</ToolLayout>


<script>
  const resultEl = document.getElementById('pg-result') as HTMLInputElement;
  const lenSlider = document.getElementById('pg-length') as HTMLInputElement;
  const lenDisplay = document.getElementById('pg-len-display')!;

  const charSets = {
    upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
    lower: 'abcdefghijklmnopqrstuvwxyz',
    numbers: '0123456789',
    symbols: '!@#$%^&*()-_=+[]{}|;:,.<>?',
  };

  function generate() {
    const len = parseInt(lenSlider.value);
    const useUpper = (document.getElementById('pg-upper') as HTMLInputElement).checked;
    const useLower = (document.getElementById('pg-lower') as HTMLInputElement).checked;
    const useNums = (document.getElementById('pg-numbers') as HTMLInputElement).checked;
    const useSyms = (document.getElementById('pg-symbols') as HTMLInputElement).checked;

    let pool = '';
    if (useUpper) pool += charSets.upper;
    if (useLower) pool += charSets.lower;
    if (useNums) pool += charSets.numbers;
    if (useSyms) pool += charSets.symbols;
    if (!pool) { resultEl.value = '⚠️ Select at least one character type'; return; }

    let pwd = '';
    const arr = new Uint32Array(len);
    crypto.getRandomValues(arr);
    arr.forEach(n => pwd += pool[n % pool.length]);
    resultEl.value = pwd;

    // Strength
    const types = [useUpper, useLower, useNums, useSyms].filter(Boolean).length;
    const score = Math.min(4, types) * (len >= 16 ? 1 : len >= 10 ? .75 : .5);
    const pct = Math.round((score / 4) * 100);
    const fill = document.getElementById('pg-strength-fill')!;
    const text = document.getElementById('pg-strength-text')!;
    const wrap = document.getElementById('pg-strength-wrap')!;
    wrap.style.display = '';
    fill.style.width = `${pct}%`;
    if (pct < 40) { fill.style.background = '#EF4444'; text.textContent = 'Weak'; }
    else if (pct < 70) { fill.style.background = '#F59E0B'; text.textContent = 'Fair'; }
    else if (pct < 90) { fill.style.background = '#22C55E'; text.textContent = 'Strong'; }
    else { fill.style.background = '#2563EB'; text.textContent = 'Very Strong'; }
  }

  lenSlider?.addEventListener('input', () => { lenDisplay.textContent = lenSlider.value; generate(); });
  document.getElementById('pg-generate')?.addEventListener('click', generate);

  document.getElementById('pg-copy')?.addEventListener('click', async () => {
    if (!resultEl.value || resultEl.value.startsWith('⚠️')) return;
    await navigator.clipboard.writeText(resultEl.value);
    const btn = document.getElementById('pg-copy')!;
    btn.innerHTML = '<i class="fas fa-check"></i>';
    setTimeout(() => btn.innerHTML = '<i class="fas fa-copy"></i>', 2000);
  });

  // Auto-generate on load
  generate();
</script>
