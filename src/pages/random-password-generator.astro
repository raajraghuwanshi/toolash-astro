---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'random-password-generator')!;
---

<ToolLayout tool={tool}>
  <div class="pg-wrap">
    <div class="pg-output">
      <input type="text" id="pg-result" class="pg-result" readonly placeholder="Click Generate →" />
      <button class="btn btn-ghost pg-copy" id="pg-copy">
        <i class="fas fa-copy"></i>
      </button>
    </div>

    <div class="pg-controls">
      <div class="pg-control-row">
        <label class="pg-label">Password Length: <strong id="pg-len-display">16</strong></label>
        <input type="range" id="pg-length" min="6" max="64" value="16" class="pg-slider" />
      </div>

      <div class="pg-checkboxes">
        <label class="pg-check"><input type="checkbox" id="pg-upper" checked /> Uppercase (A–Z)</label>
        <label class="pg-check"><input type="checkbox" id="pg-lower" checked /> Lowercase (a–z)</label>
        <label class="pg-check"><input type="checkbox" id="pg-numbers" checked /> Numbers (0–9)</label>
        <label class="pg-check"><input type="checkbox" id="pg-symbols" /> Symbols (!@#$…)</label>
      </div>

      <div class="pg-actions">
        <button class="btn btn-primary" id="pg-generate" style="flex:1;">
          <i class="fas fa-refresh"></i> Generate Password
        </button>
      </div>

      <div class="pg-strength-bar" id="pg-strength-wrap" style="display:none">
        <div class="pg-strength-label">Strength: <strong id="pg-strength-text">—</strong></div>
        <div class="pg-strength-track">
          <div class="pg-strength-fill" id="pg-strength-fill"></div>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>

<style>
  .pg-wrap { display: flex; flex-direction: column; gap: 20px; }
  .pg-output { display: flex; gap: 10px; align-items: center; }
  .pg-result {
    flex: 1;
    padding: 14px 18px;
    font-size: 16px;
    font-family: 'Courier New', monospace;
    font-weight: 600;
    color: var(--txt);
    background: var(--bg-soft);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    outline: none;
    letter-spacing: .05em;
  }
  .pg-copy { padding: 14px 18px; border-radius: var(--radius-md); }
  .pg-controls { display: flex; flex-direction: column; gap: 16px; }
  .pg-control-row { display: flex; flex-direction: column; gap: 8px; }
  .pg-label { font-size: 14px; font-weight: 600; color: var(--txt); }
  .pg-slider { width: 100%; accent-color: var(--brand); height: 4px; cursor: pointer; }
  .pg-checkboxes { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .pg-check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--txt);
    cursor: pointer;
    padding: 10px 14px;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    transition: all .15s;
  }
  .pg-check:hover { border-color: var(--brand); background: var(--brand-light); }
  .pg-check input { accent-color: var(--brand); width: 15px; height: 15px; }
  .pg-actions { display: flex; gap: 10px; }
  .pg-strength-bar { margin-top: 4px; }
  .pg-strength-label { font-size: 13px; font-weight: 600; color: var(--txt-muted); margin-bottom: 6px; }
  .pg-strength-track { height: 6px; background: var(--border); border-radius: 100px; overflow: hidden; }
  .pg-strength-fill { height: 100%; border-radius: 100px; transition: width .3s ease, background .3s; width: 0; }
</style>

<script>
  const resultEl = document.getElementById('pg-result') as HTMLInputElement;
  const lenSlider = document.getElementById('pg-length') as HTMLInputElement;
  const lenDisplay = document.getElementById('pg-len-display')!;

  const charSets = {
    upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
    lower: 'abcdefghijklmnopqrstuvwxyz',
    numbers: '0123456789',
    symbols: '!@#$%^&*()-_=+[]{}|;:,.<>?',
  };

  function generate() {
    const len = parseInt(lenSlider.value);
    const useUpper = (document.getElementById('pg-upper') as HTMLInputElement).checked;
    const useLower = (document.getElementById('pg-lower') as HTMLInputElement).checked;
    const useNums = (document.getElementById('pg-numbers') as HTMLInputElement).checked;
    const useSyms = (document.getElementById('pg-symbols') as HTMLInputElement).checked;

    let pool = '';
    if (useUpper) pool += charSets.upper;
    if (useLower) pool += charSets.lower;
    if (useNums) pool += charSets.numbers;
    if (useSyms) pool += charSets.symbols;
    if (!pool) { resultEl.value = '⚠️ Select at least one character type'; return; }

    let pwd = '';
    const arr = new Uint32Array(len);
    crypto.getRandomValues(arr);
    arr.forEach(n => pwd += pool[n % pool.length]);
    resultEl.value = pwd;

    // Strength
    const types = [useUpper, useLower, useNums, useSyms].filter(Boolean).length;
    const score = Math.min(4, types) * (len >= 16 ? 1 : len >= 10 ? .75 : .5);
    const pct = Math.round((score / 4) * 100);
    const fill = document.getElementById('pg-strength-fill')!;
    const text = document.getElementById('pg-strength-text')!;
    const wrap = document.getElementById('pg-strength-wrap')!;
    wrap.style.display = '';
    fill.style.width = `${pct}%`;
    if (pct < 40) { fill.style.background = '#EF4444'; text.textContent = 'Weak'; }
    else if (pct < 70) { fill.style.background = '#F59E0B'; text.textContent = 'Fair'; }
    else if (pct < 90) { fill.style.background = '#22C55E'; text.textContent = 'Strong'; }
    else { fill.style.background = '#2563EB'; text.textContent = 'Very Strong'; }
  }

  lenSlider?.addEventListener('input', () => { lenDisplay.textContent = lenSlider.value; generate(); });
  document.getElementById('pg-generate')?.addEventListener('click', generate);

  document.getElementById('pg-copy')?.addEventListener('click', async () => {
    if (!resultEl.value || resultEl.value.startsWith('⚠️')) return;
    await navigator.clipboard.writeText(resultEl.value);
    const btn = document.getElementById('pg-copy')!;
    btn.innerHTML = '<i class="fas fa-check"></i>';
    setTimeout(() => btn.innerHTML = '<i class="fas fa-copy"></i>', 2000);
  });

  // Auto-generate on load
  generate();
</script>
