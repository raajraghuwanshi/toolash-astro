---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'uuid-generator')!;
---

<ToolLayout tool={tool}>
  <div class="uuid-wrap">
    <div class="uuid-output-group">
      <div class="uuid-count-row">
        <label class="uuid-label">Generate how many UUIDs?</label>
        <select id="uuid-count" class="uuid-select">
          <option value="1">1 UUID</option>
          <option value="5">5 UUIDs</option>
          <option value="10" selected>10 UUIDs</option>
          <option value="25">25 UUIDs</option>
          <option value="50">50 UUIDs</option>
          <option value="100">100 UUIDs</option>
        </select>
      </div>
      <div class="uuid-output-wrap">
        <textarea id="uuid-output" class="uuid-output" readonly rows="8" placeholder="UUIDs will appear here…"></textarea>
        <div class="uuid-actions">
          <button class="btn btn-primary" id="uuid-generate">
            <i class="fas fa-bolt"></i> Generate UUIDs
          </button>
          <button class="btn btn-ghost" id="uuid-copy">
            <i class="fas fa-copy"></i> Copy All
          </button>
          <button class="btn btn-ghost" id="uuid-clear">
            <i class="fas fa-trash-alt"></i> Clear
          </button>
        </div>
      </div>
    </div>

    <div class="uuid-info">
      <i class="fas fa-circle-info"></i>
      UUIDs are generated using <strong>crypto.getRandomValues()</strong> — cryptographically secure, version 4 format.
    </div>
  </div>
</ToolLayout>

<style>
  .uuid-wrap { display: flex; flex-direction: column; gap: 20px; }
  .uuid-count-row { display: flex; align-items: center; gap: 16px; margin-bottom: 12px; flex-wrap: wrap; }
  .uuid-label { font-size: 14px; font-weight: 600; color: var(--txt); }
  .uuid-select {
    padding: 8px 12px;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-family: 'Inter', sans-serif;
    color: var(--txt);
    background: var(--bg-soft);
    cursor: pointer;
    outline: none;
    transition: border-color .15s;
  }
  .uuid-select:focus { border-color: var(--brand); }
  .uuid-output-wrap { display: flex; flex-direction: column; gap: 12px; }
  .uuid-output {
    width: 100%;
    padding: 16px;
    font-family: 'Courier New', monospace;
    font-size: 14px;
    color: var(--txt);
    background: var(--bg-soft);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    resize: vertical;
    outline: none;
    line-height: 1.9;
  }
  .uuid-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .uuid-info {
    font-size: 13px;
    color: var(--txt-muted);
    background: var(--bg-soft);
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--brand);
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .uuid-info i { color: var(--brand); margin-top: 2px; flex-shrink: 0; }
</style>

<script>
  function generateUUID(): string {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
      const r = crypto.getRandomValues(new Uint8Array(1))[0] & 15;
      return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
    });
  }

  function generate() {
    const count = parseInt((document.getElementById('uuid-count') as HTMLSelectElement).value);
    const uuids = Array.from({ length: count }, generateUUID).join('\n');
    (document.getElementById('uuid-output') as HTMLTextAreaElement).value = uuids;
  }

  document.getElementById('uuid-generate')?.addEventListener('click', generate);

  document.getElementById('uuid-copy')?.addEventListener('click', async () => {
    const val = (document.getElementById('uuid-output') as HTMLTextAreaElement).value;
    if (!val) return;
    await navigator.clipboard.writeText(val);
    const btn = document.getElementById('uuid-copy')!;
    btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
    setTimeout(() => btn.innerHTML = '<i class="fas fa-copy"></i> Copy All', 2000);
  });

  document.getElementById('uuid-clear')?.addEventListener('click', () => {
    (document.getElementById('uuid-output') as HTMLTextAreaElement).value = '';
  });

  generate();
</script>
