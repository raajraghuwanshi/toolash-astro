---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'unit-converter')!;

const categories = [
  { id: 'length', label: 'Length', icon: 'fa-ruler', units: [
    { id: 'mm', label: 'Millimeter (mm)', factor: 0.001 },
    { id: 'cm', label: 'Centimeter (cm)', factor: 0.01 },
    { id: 'm', label: 'Meter (m)', factor: 1 },
    { id: 'km', label: 'Kilometer (km)', factor: 1000 },
    { id: 'in', label: 'Inch (in)', factor: 0.0254 },
    { id: 'ft', label: 'Foot (ft)', factor: 0.3048 },
    { id: 'yd', label: 'Yard (yd)', factor: 0.9144 },
    { id: 'mi', label: 'Mile (mi)', factor: 1609.344 },
    { id: 'nmi', label: 'Nautical mile (nmi)', factor: 1852 },
  ]},
  { id: 'weight', label: 'Weight', icon: 'fa-weight-scale', units: [
    { id: 'mg', label: 'Milligram (mg)', factor: 0.000001 },
    { id: 'g', label: 'Gram (g)', factor: 0.001 },
    { id: 'kg', label: 'Kilogram (kg)', factor: 1 },
    { id: 't', label: 'Metric Ton (t)', factor: 1000 },
    { id: 'oz', label: 'Ounce (oz)', factor: 0.0283495 },
    { id: 'lb', label: 'Pound (lb)', factor: 0.453592 },
    { id: 'st', label: 'Stone (st)', factor: 6.35029 },
    { id: 'ton', label: 'Short ton (ton)', factor: 907.185 },
  ]},
  { id: 'temperature', label: 'Temperature', icon: 'fa-temperature-half', units: [
    { id: 'c', label: 'Celsius (°C)', factor: 1 },
    { id: 'f', label: 'Fahrenheit (°F)', factor: 1 },
    { id: 'k', label: 'Kelvin (K)', factor: 1 },
  ]},
  { id: 'area', label: 'Area', icon: 'fa-square', units: [
    { id: 'mm2', label: 'mm²', factor: 0.000001 },
    { id: 'cm2', label: 'cm²', factor: 0.0001 },
    { id: 'm2', label: 'm²', factor: 1 },
    { id: 'km2', label: 'km²', factor: 1000000 },
    { id: 'ha', label: 'Hectare (ha)', factor: 10000 },
    { id: 'in2', label: 'in²', factor: 0.00064516 },
    { id: 'ft2', label: 'ft²', factor: 0.092903 },
    { id: 'ac', label: 'Acre (ac)', factor: 4046.86 },
    { id: 'mi2', label: 'mi²', factor: 2589988 },
  ]},
  { id: 'speed', label: 'Speed', icon: 'fa-gauge-high', units: [
    { id: 'mps', label: 'm/s', factor: 1 },
    { id: 'kmh', label: 'km/h', factor: 0.277778 },
    { id: 'mph', label: 'mph', factor: 0.44704 },
    { id: 'kn', label: 'Knots (kn)', factor: 0.514444 },
    { id: 'fps', label: 'ft/s', factor: 0.3048 },
  ]},
  { id: 'volume', label: 'Volume', icon: 'fa-flask', units: [
    { id: 'ml', label: 'Milliliter (ml)', factor: 0.001 },
    { id: 'l', label: 'Liter (l)', factor: 1 },
    { id: 'm3', label: 'm³', factor: 1000 },
    { id: 'tsp', label: 'Teaspoon (tsp)', factor: 0.00492892 },
    { id: 'tbsp', label: 'Tablespoon (tbsp)', factor: 0.0147868 },
    { id: 'floz', label: 'fl oz', factor: 0.0295735 },
    { id: 'cup', label: 'Cup', factor: 0.236588 },
    { id: 'pt', label: 'Pint (pt)', factor: 0.473176 },
    { id: 'gal', label: 'Gallon (gal)', factor: 3.78541 },
  ]},
];
---

<ToolLayout tool={tool} customLayout={true}>
  <div class="tool-page-wrap">
    <!-- Toolarsh Dimensional Engine Hero -->
    <div class="tool-hero-box">
      <div class="inline-flex items-center gap-2 tool-badge-pill mb-3">
        <i class="fas fa-atom text-[var(--brand)]"></i> BIPM & NIST Dimensional Metric Engine
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-[var(--txt)]">
        Universal <span class="bg-gradient-to-r from-[var(--brand)] to-[var(--brand-dark)] bg-clip-text text-transparent">Unit Converter</span>
      </h1>
      <p class="text-sm sm:text-base mt-2 max-w-2xl text-[var(--txt-muted)] leading-relaxed">
        Instantly convert between SI metric standards and US customary imperial units with 64-bit IEEE floating-point precision.
      </p>
    </div>

    <!-- Category Tabs Selector -->
    <div class="tool-tab-nav mb-8" id="uc-category-tabs" role="tablist" aria-label="Measurement Categories">
      {categories.map((cat, i) => (
        <button class={`tool-tab-btn uc-tab ${i === 0 ? 'active' : ''}`} data-cat={cat.id} role="tab" aria-selected={i === 0 ? 'true' : 'false'}>
          <i class={`fas ${cat.icon}`}></i> {cat.label}
        </button>
      ))}
    </div>

    <!-- Main Dual Conversion Deck -->
    <div class="tool-card-surface space-y-6 mb-10">
      <div class="grid grid-cols-1 md:grid-cols-11 gap-4 items-center">
        <!-- From Input Card (5 cols) -->
        <div class="md:col-span-5 tool-inner-panel p-5 space-y-3">
          <div class="flex justify-between items-center text-xs font-mono text-[var(--txt-muted)]">
            <span class="font-semibold uppercase tracking-wider">Input Value</span>
            <span class="text-[var(--brand)] font-bold">SOURCE</span>
          </div>
          <input type="number" id="uc-from-val" value="1" step="any" class="w-full bg-transparent text-[var(--txt)] font-mono text-3xl font-black outline-none" />
          <select id="uc-from-unit" class="tool-control-input text-xs font-medium cursor-pointer"></select>
        </div>

        <!-- Swap Action Button (1 col) -->
        <div class="md:col-span-1 flex justify-center py-2 md:py-0">
          <button id="uc-swap" class="w-12 h-12 rounded-2xl bg-[var(--brand)] hover:opacity-90 text-white text-base flex items-center justify-center cursor-pointer transition-all shadow-lg shadow-[var(--brand)]/20" title="Swap Units">
            <i class="fas fa-arrows-left-right"></i>
          </button>
        </div>

        <!-- To Result Card (5 cols) -->
        <div class="md:col-span-5 tool-inner-panel p-5 space-y-3">
          <div class="flex justify-between items-center text-xs font-mono text-[var(--txt-muted)]">
            <span class="font-semibold uppercase tracking-wider">Converted Result</span>
            <span class="text-[var(--amber)] font-bold">TARGET</span>
          </div>
          <input type="text" id="uc-to-val" readonly class="w-full bg-transparent text-[var(--brand)] font-mono text-3xl font-black outline-none" />
          <select id="uc-to-unit" class="tool-control-input text-xs font-medium cursor-pointer"></select>
        </div>
      </div>

      <!-- Real-time Mathematical Equivalence String -->
      <div class="text-center p-3.5 rounded-xl border border-[var(--border)] bg-[var(--surface-2)] text-xs font-mono text-[var(--brand)] font-semibold" id="uc-formula">
        <!-- populated via script -->
      </div>

      <!-- Simultaneous Category Units Table -->
      <div class="pt-6 border-t border-[var(--border)]">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--brand)]">
            Simultaneous Multi-Unit Equivalency Matrix (<span id="uc-table-from">1 m</span>)
          </span>
          <span class="text-xs font-mono text-[var(--txt-dim)]">IEEE 64-bit Real Precision</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3" id="uc-table">
          <!-- Populated dynamically via script -->
        </div>
      </div>
    </div>

    <!-- Metrological Governance: Content Architecture Wrap -->
    <div class="tool-content-wrap">

      <!-- Historical Metrology Treatise Card -->
      <section class="tool-content-card space-y-12">
        <div class="tool-content-header">
          <span class="tool-badge-pill mb-3">
            <i class="fas fa-atom text-[var(--brand)]"></i> Metrological Governance &amp; Invariant Constants
          </span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-[var(--txt)] tracking-tight">
            The Quantum Redefinition of Physical Units: From Artifacts to Invariants
          </h2>
          <p>
            Every measurement converted on this screen rests upon the 2019 landmark BIPM redefinition of the International System of Units (SI). Human measurement has abandoned physical brass bars and platinum cylinders in favor of seven immutable physical constants of the cosmos.
          </p>
        </div>

        <!-- Pull-Quote 1: The Meter & Speed of Light -->
        <div class="space-y-4">
          <blockquote class="border-l-4 border-[var(--brand)] pl-6 py-2 bg-[var(--surface-2)] rounded-r-2xl">
            <p class="text-lg sm:text-xl lg:text-2xl font-serif italic text-[var(--txt)] leading-snug">
              &ldquo;The meter is no longer a scratch on a platinum-iridium bar locked in a Parisian vault; it is the exact distance electromagnetic radiation traverses through vacuum in 1/299,792,458 of a second.&rdquo;
            </p>
            <footer class="mt-2 font-mono text-xs text-[var(--brand)] uppercase tracking-wider font-bold">
              &mdash; 17th Conf&eacute;rence G&eacute;n&eacute;rale des Poids et Mesures (1983 Resolution)
            </footer>
          </blockquote>
          <p class="text-sm text-[var(--txt-muted)] leading-relaxed pl-6">
            Prior to 1983, measuring distance meant comparing an unknown length against physical prototype rods that warped under ambient atmospheric humidity, barometric pressure, and temperature fluctuation. By pinning the speed of light in vacuum (<em>c</em>) to exactly 299,792,458 meters per second without uncertainty, physicists inverted the equation: length measurement became an ultra-precise measurement of time, accessible to any laboratory equipped with a cesium fountain atomic clock.
          </p>
        </div>

        <!-- Pull-Quote 2: Le Grand K & Planck's Constant -->
        <div class="space-y-4">
          <blockquote class="border-l-4 border-[var(--amber)] pl-6 py-2 bg-[var(--surface-2)] rounded-r-2xl">
            <p class="text-lg sm:text-xl lg:text-2xl font-serif italic text-[var(--txt)] leading-snug">
              &ldquo;For 130 years, an error-prone metal cylinder called &lsquo;Le Grand K&rsquo; governed the world's kilogram, until surface contamination drift proved physical matter too volatile for quantum metrology.&rdquo;
            </p>
            <footer class="mt-2 font-mono text-xs text-[var(--amber)] uppercase tracking-wider font-bold">
              &mdash; National Institute of Standards and Technology (NIST Metrology Brief)
            </footer>
          </blockquote>
          <p class="text-sm text-[var(--txt-muted)] leading-relaxed pl-6">
            Manufactured in 1889, the International Prototype of the Kilogram (IPK) rested under three bell jars in S&egrave;vres, France. Periodic comparisons revealed that identical sister copies had drifted in mass by approximately 50 micrograms due to microscopic surface gas absorption and cleaning abrasion. On World Metrology Day (May 20, 2019), the BIPM unanimously voted to decommission Le Grand K, linking the kilogram directly to Planck&rsquo;s quantum constant (<em>h</em> = 6.62607015 &times; 10<sup>-34</sup> J&middot;s) via the electro-magnetic Kibble balance.
          </p>
        </div>

        <!-- Pull-Quote 3: The 1959 Imperial Accord -->
        <div class="space-y-4">
          <blockquote class="border-l-4 border-[var(--brand)] pl-6 py-2 bg-[var(--surface-2)] rounded-r-2xl">
            <p class="text-lg sm:text-xl lg:text-2xl font-serif italic text-[var(--txt)] leading-snug">
              &ldquo;The American inch, the British imperial inch, and the Canadian inch were mathematically discordant until 1959, when an international treaty anchored every imperial unit directly to metric wavelengths.&rdquo;
            </p>
            <footer class="mt-2 font-mono text-xs text-[var(--brand)] uppercase tracking-wider font-bold">
              &mdash; International Yard and Pound Treaty of 1959
            </footer>
          </blockquote>
          <p class="text-sm text-[var(--txt-muted)] leading-relaxed pl-6">
            Contrary to popular belief, United States Customary units (inches, feet, pounds, gallons) do not possess independent physical primary standards. Under the 1959 treaty, 1 international inch was codified by law as <em>exactly 0.0254 meters</em>, and 1 international pound was codified as <em>exactly 0.45359237 kilograms</em>. When you convert pounds to kilograms or miles to kilometers on this platform, you are not performing an approximation&mdash;you are applying the legal statutory definitions of the Anglo-American legal code.
          </p>
        </div>

        <!-- Pull-Quote 4: The Mars Climate Orbiter Disaster -->
        <div class="space-y-4">
          <blockquote class="border-l-4 border-rose-500 pl-6 py-2 bg-[var(--surface-2)] rounded-r-2xl">
            <p class="text-lg sm:text-xl lg:text-2xl font-serif italic text-[var(--txt)] leading-snug">
              &ldquo;A failure to translate pound-force seconds of impulse into newton-seconds incinerated a $327 million robotic spacecraft in the Martian upper atmosphere&mdash;a permanent cautionary monument to dimensional conversion integrity.&rdquo;
            </p>
            <footer class="mt-2 font-mono text-xs text-rose-500 uppercase tracking-wider font-bold">
              &mdash; NASA Mars Climate Orbiter Mishap Investigation Board (Phase I Report)
            </footer>
          </blockquote>
          <p class="text-sm text-[var(--txt-muted)] leading-relaxed pl-6">
            In September 1999, the Mars Climate Orbiter plunged into the Martian atmosphere at an altitude of 57 km instead of its designated safe insertion corridor of 140&ndash;150 km. Subcontractor ground software generated trajectory impulse telemetry in US customary pound-seconds (lbf&middot;s), while NASA trajectory navigation code expected SI standard newton-seconds (N&middot;s). This 4.45&times; dimensional discrepancy accumulated over 286 days of cruise flight, demonstrating why this engine uses a rigid two-pass SI base normalization pipeline rather than chained unit approximations.
          </p>
        </div>
      </section>

      <!-- Hairline Accordion Metrological FAQs Card -->
      <section class="tool-content-card">
        <div class="tool-content-header">
          <span class="tool-badge-pill mb-3">
            <i class="fas fa-circle-question text-[var(--brand)]"></i> Common Inquiries
          </span>
          <h3>Dimensional Analysis &amp; Metrology Frequently Asked Questions</h3>
          <p>
            Insights on SI normalization, the US survey foot sunset, and thermodynamic scales.
          </p>
        </div>

        <div class="tool-faq-accordion">
          <details class="tool-faq-item">
            <summary>
              <span>Why does this engine convert to an SI base unit first instead of chaining unit ratios?</span>
              <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
            </summary>
            <div class="faq-answer">
              In multi-unit software, chaining ratios (e.g. Yard &rarr; Foot &rarr; Inch &rarr; Centimeter &rarr; Millimeter) introduces cumulative floating-point rounding errors at each intermediate multiplication. By converting every source unit directly into its fundamental SI dimension (meters, kilograms, kelvin) using 64-bit IEEE 754 double precision and then projecting directly to the target unit in a single calculation step, precision is preserved to 15 significant digits.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>What was the difference between the US Survey Foot and the International Foot?</span>
              <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
            </summary>
            <div class="faq-answer">
              The 1959 international foot was set at exactly 0.3048 meters. However, US geodetic surveyors retained the &ldquo;US Survey Foot&rdquo; defined as 1200/3937 meters (~0.30480061 m) to avoid recalculating millions of historical state boundary deeds. This minuscule 2-parts-per-million offset produced systematic multi-meter mapping errors over transcontinental state plane coordinate systems. On January 1, 2023, the National Geodetic Survey (NOAA) officially deprecated the US Survey Foot in favor of the unified international foot.
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>Why is temperature conversion non-linear compared to length or mass?</span>
              <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
            </summary>
            <div class="faq-answer">
              Units of length, mass, and time are ratio scales with a shared natural zero point (zero meters represents the absolute absence of distance). Celsius and Fahrenheit are interval scales with arbitrarily assigned zero benchmarks (ice melting at sea level for Celsius; an ammonium chloride brine mixture for Fahrenheit). Converting between them requires both scale multiplication (9/5 or 5/9) and an affine zero-point translation (&plusmn;32), whereas thermodynamic Kelvin anchors directly to absolute zero molecular kinetic motion (−273.15&deg;C).
            </div>
          </details>

          <details class="tool-faq-item">
            <summary>
              <span>What is a Nautical Mile and why is it distinct from a Statute Mile?</span>
              <span class="faq-chevron"><i class="fas fa-chevron-down"></i></span>
            </summary>
            <div class="faq-answer">
              A statute mile (5,280 feet or ~1,609.34 meters) originated from the Roman <em>mille passus</em> (1,000 double paces). A nautical mile (exactly 1,852 meters) is fundamentally navigational: it represents exactly one minute of arc (1/60th of a degree) along any meridian of the Earth. This planetary geometric relationship allows maritime and aerospace navigators to read nautical distance directly off the latitude scale of a Mercator projection map without physical conversion rulers.
            </div>
          </details>
        </div>
      </section>

    </div>
  </div>
</ToolLayout>

<script>
  const categories = {
    length: { units: [
      { id: 'mm', label: 'Millimeter', short: 'mm', factor: 0.001 },
      { id: 'cm', label: 'Centimeter', short: 'cm', factor: 0.01 },
      { id: 'm', label: 'Meter', short: 'm', factor: 1 },
      { id: 'km', label: 'Kilometer', short: 'km', factor: 1000 },
      { id: 'in', label: 'Inch', short: 'in', factor: 0.0254 },
      { id: 'ft', label: 'Foot', short: 'ft', factor: 0.3048 },
      { id: 'yd', label: 'Yard', short: 'yd', factor: 0.9144 },
      { id: 'mi', label: 'Mile', short: 'mi', factor: 1609.344 },
      { id: 'nmi', label: 'Nautical mile', short: 'nmi', factor: 1852 },
    ]},
    weight: { units: [
      { id: 'mg', label: 'Milligram', short: 'mg', factor: 0.000001 },
      { id: 'g', label: 'Gram', short: 'g', factor: 0.001 },
      { id: 'kg', label: 'Kilogram', short: 'kg', factor: 1 },
      { id: 't', label: 'Metric Ton', short: 't', factor: 1000 },
      { id: 'oz', label: 'Ounce', short: 'oz', factor: 0.0283495 },
      { id: 'lb', label: 'Pound', short: 'lb', factor: 0.453592 },
      { id: 'st', label: 'Stone', short: 'st', factor: 6.35029 },
      { id: 'ton', label: 'Short ton', short: 'ton', factor: 907.185 },
    ]},
    temperature: { units: [
      { id: 'c', label: 'Celsius', short: '°C', factor: 1 },
      { id: 'f', label: 'Fahrenheit', short: '°F', factor: 1 },
      { id: 'k', label: 'Kelvin', short: 'K', factor: 1 },
    ]},
    area: { units: [
      { id: 'mm2', label: 'mm²', short: 'mm²', factor: 0.000001 },
      { id: 'cm2', label: 'cm²', short: 'cm²', factor: 0.0001 },
      { id: 'm2', label: 'm²', short: 'm²', factor: 1 },
      { id: 'km2', label: 'km²', short: 'km²', factor: 1000000 },
      { id: 'ha', label: 'Hectare', short: 'ha', factor: 10000 },
      { id: 'in2', label: 'in²', short: 'in²', factor: 0.00064516 },
      { id: 'ft2', label: 'ft²', short: 'ft²', factor: 0.092903 },
      { id: 'ac', label: 'Acre', short: 'ac', factor: 4046.86 },
      { id: 'mi2', label: 'mi²', short: 'mi²', factor: 2589988 },
    ]},
    speed: { units: [
      { id: 'mps', label: 'm/s', short: 'm/s', factor: 1 },
      { id: 'kmh', label: 'km/h', short: 'km/h', factor: 0.277778 },
      { id: 'mph', label: 'mph', short: 'mph', factor: 0.44704 },
      { id: 'kn', label: 'Knots', short: 'kn', factor: 0.514444 },
      { id: 'fps', label: 'ft/s', short: 'ft/s', factor: 0.3048 },
    ]},
    volume: { units: [
      { id: 'ml', label: 'Milliliter', short: 'ml', factor: 0.001 },
      { id: 'l', label: 'Liter', short: 'l', factor: 1 },
      { id: 'm3', label: 'm³', short: 'm³', factor: 1000 },
      { id: 'tsp', label: 'Teaspoon', short: 'tsp', factor: 0.00492892 },
      { id: 'tbsp', label: 'Tablespoon', short: 'tbsp', factor: 0.0147868 },
      { id: 'floz', label: 'fl oz', short: 'fl oz', factor: 0.0295735 },
      { id: 'cup', label: 'Cup', short: 'cup', factor: 0.236588 },
      { id: 'pt', label: 'Pint', short: 'pt', factor: 0.473176 },
      { id: 'gal', label: 'Gallon', short: 'gal', factor: 3.78541 },
    ]},
  };

  let currentCat = 'length';

  function toBase(val: number, fromId: string, cat: string): number {
    if (cat === 'temperature') {
      if (fromId === 'c') return val + 273.15;
      if (fromId === 'f') return (val - 32) * 5/9 + 273.15;
      return val;
    }
    const unit = (categories as any)[cat].units.find((u: any) => u.id === fromId);
    return val * unit.factor;
  }

  function fromBase(kelvin: number, toId: string, cat: string): number {
    if (cat === 'temperature') {
      if (toId === 'c') return kelvin - 273.15;
      if (toId === 'f') return (kelvin - 273.15) * 9/5 + 32;
      return kelvin;
    }
    const unit = (categories as any)[cat].units.find((u: any) => u.id === toId);
    return kelvin / unit.factor;
  }

  function fmt(n: number): string {
    if (Math.abs(n) >= 0.001 && Math.abs(n) < 1e9) {
      return parseFloat(n.toPrecision(8)).toString();
    }
    return n.toExponential(4);
  }

  function populateSelects(cat: string) {
    const units = (categories as any)[cat].units;
    const fromSel = document.getElementById('uc-from-unit') as HTMLSelectElement;
    const toSel = document.getElementById('uc-to-unit') as HTMLSelectElement;
    if (!fromSel || !toSel) return;
    fromSel.innerHTML = units.map((u: any) => `<option value="${u.id}">${u.label}</option>`).join('');
    toSel.innerHTML = units.map((u: any) => `<option value="${u.id}">${u.label}</option>`).join('');
    toSel.selectedIndex = 1;
  }

  function convert() {
    const fromVal = parseFloat((document.getElementById('uc-from-val') as HTMLInputElement).value);
    const fromId = (document.getElementById('uc-from-unit') as HTMLSelectElement).value;
    const toId = (document.getElementById('uc-to-unit') as HTMLSelectElement).value;
    if (isNaN(fromVal)) return;

    const base = toBase(fromVal, fromId, currentCat);
    const result = fromBase(base, toId, currentCat);
    (document.getElementById('uc-to-val') as HTMLInputElement).value = fmt(result);

    const fromUnit = (categories as any)[currentCat].units.find((u: any) => u.id === fromId);
    const toUnit = (categories as any)[currentCat].units.find((u: any) => u.id === toId);
    const formulaEl = document.getElementById('uc-formula');
    if (formulaEl) {
      formulaEl.textContent = `${fromVal} ${fromUnit?.short} = ${fmt(result)} ${toUnit?.short}`;
    }

    // Update table
    const units = (categories as any)[currentCat].units;
    const tableFromEl = document.getElementById('uc-table-from');
    if (tableFromEl) tableFromEl.textContent = `${fromVal} ${fromUnit?.short}`;

    const table = document.getElementById('uc-table');
    if (table) {
      table.innerHTML = units.map((u: any) => {
        const v = fromBase(base, u.id, currentCat);
        return `
          <div class="tool-inner-panel p-3.5 flex items-center justify-between">
            <span class="text-xs font-medium text-[var(--txt-muted)]">${u.label}</span>
            <div class="text-right font-mono">
              <span class="text-sm font-bold text-[var(--txt)]">${fmt(v)}</span>
              <span class="text-[10px] text-[var(--brand)] font-semibold block">${u.short}</span>
            </div>
          </div>
        `;
      }).join('');
    }
  }

  document.querySelectorAll('.uc-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.uc-tab').forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      currentCat = (tab as HTMLElement).dataset.cat!;
      populateSelects(currentCat);
      convert();
    });
  });

  document.getElementById('uc-from-val')?.addEventListener('input', convert);
  document.getElementById('uc-from-unit')?.addEventListener('change', convert);
  document.getElementById('uc-to-unit')?.addEventListener('change', convert);
  document.getElementById('uc-swap')?.addEventListener('click', () => {
    const fromSel = document.getElementById('uc-from-unit') as HTMLSelectElement;
    const toSel = document.getElementById('uc-to-unit') as HTMLSelectElement;
    const tmp = fromSel.value;
    fromSel.value = toSel.value;
    toSel.value = tmp;
    convert();
  });

  populateSelects('length');
  convert();
</script>
