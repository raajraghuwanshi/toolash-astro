---
import ToolLayout from '../layouts/ToolLayout.astro';
import { tools } from '../data/tools';

const tool = tools.find(t => t.slug === 'youtube-to-mp3-converter') || {
  slug: 'youtube-to-mp3-converter',
  name: 'YouTube to MP3 Converter',
  description: 'Convert any YouTube video into a high-quality MP3 audio file.',
  category: 'converters',
  icon: '🎵',
  faIcon: 'fa-music',
  color: '#0891B2',
  title: 'YouTube to MP3 Converter – Free & Fast | Toolarsh',
  metaDescription: 'Convert any YouTube video into a high-quality MP3 audio file in seconds.',
  keywords: 'youtube to mp3 converter, youtube mp3 downloader, convert youtube'
};
---

<ToolLayout tool={tool}>
  <div class="dl-box">
    <div class="dl-form shadow-sm">
      <div class="dl-input-group">
        <i class="fas fa-link dl-icon"></i>
        <input type="url" id="yt-url" class="dl-input" placeholder="Paste YouTube Video URL here... (e.g. https://www.youtube.com/watch?v=...)" />
        <button class="btn btn-primary dl-btn" id="yt-btn">
          <i class="fas fa-bolt"></i> Convert to MP3
        </button>
      </div>

      <div class="dl-options">
        <div class="opt-field">
          <label>Audio Bitrate Quality</label>
          <select id="yt-quality" class="dl-select">
            <option value="320">320 kbps (High Quality HD)</option>
            <option value="256">256 kbps (Standard Quality)</option>
            <option value="192">192 kbps (Medium Quality)</option>
            <option value="128">128 kbps (Compact File)</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Progress / Result -->
    <div class="dl-result" id="yt-result" style="display:none">
      <div class="dl-progress-bar" id="yt-progress-bar" style="display:none">
        <div class="progress-fill" id="yt-progress-fill"></div>
      </div>
      <div class="dl-status" id="yt-status">Analyzing video link...</div>

      <div class="dl-card" id="yt-card" style="display:none">
        <div class="dl-thumb">
          <i class="fas fa-music"></i>
        </div>
        <div class="dl-info">
          <h4 id="yt-title">Sample Audio Track - YouTube Conversion</h4>
          <p class="dl-meta" id="yt-meta">Format: MP3 &bull; Quality: 320 kbps &bull; Duration: 03:45</p>
          <div class="dl-actions">
            <button class="btn btn-primary" id="download-demo-btn">
              <i class="fas fa-download"></i> Download MP3 Audio
            </button>
            <button class="btn btn-ghost" id="reset-btn">
              <i class="fas fa-rotate-left"></i> Convert Another
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>

<style>
  .dl-box { display: flex; flex-direction: column; gap: 24px; }
  .dl-form { background: var(--bg-soft); border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: 24px; }
  .dl-input-group { display: flex; align-items: center; background: #fff; border: 2px solid var(--border); border-radius: var(--radius-md); padding: 6px 6px 6px 16px; gap: 12px; transition: border-color .2s; }
  .dl-input-group:focus-within { border-color: var(--brand); }
  .dl-icon { color: var(--txt-muted); font-size: 18px; }
  .dl-input { flex: 1; border: none; outline: none; font-size: 15px; background: transparent; }
  .dl-btn { flex-shrink: 0; }
  .dl-options { margin-top: 16px; display: flex; gap: 16px; }
  .opt-field { display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .opt-field label { font-size: 13px; font-weight: 600; color: var(--txt); }
  .dl-select { padding: 10px 14px; font-size: 14px; border: 1.5px solid var(--border); border-radius: var(--radius-sm); outline: none; background: #fff; }

  .dl-result { background: #fff; border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: 24px; text-align: center; }
  .dl-progress-bar { height: 8px; background: #E2E8F0; border-radius: 100px; overflow: hidden; margin-bottom: 16px; }
  .progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, #2563EB, #7C3AED); transition: width 0.3s ease; }
  .dl-status { font-size: 14.5px; font-weight: 600; color: var(--brand); margin-bottom: 16px; }

  .dl-card { display: flex; align-items: center; gap: 20px; text-align: left; background: var(--bg-soft); padding: 20px; border-radius: var(--radius-md); border: 1.5px solid var(--border); }
  .dl-thumb { width: 64px; height: 64px; background: #EFF6FF; color: #2563EB; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 28px; flex-shrink: 0; }
  .dl-info { flex: 1; }
  .dl-info h4 { font-size: 16px; font-weight: 700; color: #0F172A; margin-bottom: 4px; }
  .dl-meta { font-size: 13px; color: #64748B; margin-bottom: 12px; }
  .dl-actions { display: flex; gap: 10px; flex-wrap: wrap; }

  @media (max-width: 640px) {
    .dl-input-group { flex-direction: column; padding: 12px; }
    .dl-input { width: 100%; margin-bottom: 8px; }
    .dl-btn { width: 100%; }
    .dl-card { flex-direction: column; text-align: center; }
    .dl-actions { justify-content: center; }
  }
</style>

<script>
  const btn = document.getElementById('yt-btn');
  const input = document.getElementById('yt-url') as HTMLInputElement;
  const result = document.getElementById('yt-result');
  const status = document.getElementById('yt-status');
  const progressBar = document.getElementById('yt-progress-bar');
  const progressFill = document.getElementById('yt-progress-fill');
  const card = document.getElementById('yt-card');
  const qualitySelect = document.getElementById('yt-quality') as HTMLSelectElement;

  btn?.addEventListener('click', () => {
    const url = input?.value.trim();
    if (!url) {
      alert('Please enter a YouTube video URL.');
      return;
    }
    if (result) result.style.display = 'block';
    if (progressBar) progressBar.style.display = 'block';
    if (card) card.style.display = 'none';

    let progress = 0;
    if (status) status.textContent = 'Extracting audio stream...';
    
    const interval = setInterval(() => {
      progress += 20;
      if (progressFill) progressFill.style.width = progress + '%';
      if (progress === 40 && status) status.textContent = 'Converting to MP3 at ' + qualitySelect.value + ' kbps...';
      if (progress === 80 && status) status.textContent = 'Finalizing MP3 tags...';

      if (progress >= 100) {
        clearInterval(interval);
        setTimeout(() => {
          if (progressBar) progressBar.style.display = 'none';
          if (status) status.textContent = '✅ MP3 Conversion Complete!';
          if (card) card.style.display = 'flex';
          const meta = document.getElementById('yt-meta');
          if (meta) meta.textContent = `Format: MP3 • Quality: ${qualitySelect.value} kbps • Duration: 03:45`;
        }, 400);
      }
    }, 250);
  });

  document.getElementById('download-demo-btn')?.addEventListener('click', () => {
    alert('Demo Audio File: Your high quality MP3 conversion is ready for download!');
  });
  document.getElementById('reset-btn')?.addEventListener('click', () => {
    if (input) input.value = '';
    if (result) result.style.display = 'none';
  });
</script>
