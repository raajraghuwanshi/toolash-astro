---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import ToolCard from '../components/ToolCard.astro';
import ToolContentSection from '../components/ToolContentSection.astro';
import { tools, categoryMeta, type Tool } from '../data/tools';

export interface Props {
  tool: Tool;
  relatedTools?: Tool[];
  customFaqs?: Array<{ q: string; a: string }>;
}

const { tool, relatedTools: propRelated, customFaqs } = Astro.props;
const meta = categoryMeta[tool.category];
const related = propRelated ?? tools.filter(t => t.category === tool.category && t.slug !== tool.slug).slice(0, 4);
---

<BaseLayout title={tool.title} description={tool.metaDescription} keywords={tool.keywords}>
  <Navbar />
  <SearchModal />

  <main>
    <!-- Tool Header -->
    <div class="tool-header">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <i class="fas fa-chevron-right" aria-hidden="true"></i>
          <a href={`/#${tool.category}`}>{meta.label}</a>
          <i class="fas fa-chevron-right" aria-hidden="true"></i>
          <span aria-current="page">{tool.name}</span>
        </nav>

        <div class="tool-header-inner" data-animate="fade-up">
          <div class="tool-icon-box" style={`background:${meta.bg}; color:${meta.color}`} aria-hidden="true">
            <i class={`fas ${tool.faIcon}`}></i>
          </div>
          <div class="tool-header-text">
            <div class="tool-cat-badge" style={`background:${meta.bg}; color:${meta.color}; border-color:rgba(from ${meta.color} r g b / .25)`}>
              {meta.emoji} {meta.label}
            </div>
            <h1 class="tool-name">{tool.name}</h1>
            <p class="tool-desc">{tool.description}</p>
            <div class="tool-tags">
              <span class="badge badge-free"><span class="pulse-dot" aria-hidden="true"></span> Free</span>
              <span class="badge" style="background:var(--surface-3); color:var(--txt-muted); border:1px solid var(--border-mid)">
                <i class="fas fa-globe" aria-hidden="true"></i> Browser-Based
              </span>
              <span class="badge" style="background:var(--amber-soft); color:var(--amber); border:1px solid rgba(217,119,6,.25)">
                <i class="fas fa-lock" aria-hidden="true"></i> No Sign-up
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tool Body -->
    <div class="tool-body">
      <div class="container">
        <div class="tool-card-wrap">
          <slot />
        </div>
        <ToolContentSection tool={tool} customFaqs={customFaqs} />
      </div>
    </div>

    <!-- Related -->
    {related.length > 0 && (
      <section class="related-section" aria-labelledby="related-h">
        <div class="container">
          <span class="section-label" id="related-h">
            <i class="fas fa-grid-2" aria-hidden="true"></i>
            More {meta.label} Tools
          </span>
          <div class="related-grid" role="list" aria-label={`More ${meta.label} tools`}>
            {related.map(t => <ToolCard tool={t} />)}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</BaseLayout>

<style>
  .tool-header {
    background: var(--surface);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--webkit-glass-blur);
    border-bottom: 1px solid var(--border);
    padding: 40px 0 48px;
  }
  .breadcrumb {
    display: flex; align-items: center; gap: 8px;
    font-size: 11.5px; color: var(--txt-dim);
    margin-bottom: 28px; flex-wrap: wrap;
    font-family: 'JetBrains Mono', monospace;
  }
  .breadcrumb a { color: var(--txt-dim); text-decoration: none; transition: color .12s; }
  .breadcrumb a:hover { color: var(--brand); }
  .breadcrumb i { font-size: 8px; }
  .breadcrumb span { color: var(--txt-muted); }

  .tool-header-inner { display: flex; align-items: flex-start; gap: 24px; }
  .tool-icon-box {
    width: 64px; height: 64px; border-radius: var(--radius-lg);
    display: flex; align-items: center; justify-content: center;
    font-size: 26px; flex-shrink: 0;
    box-shadow: var(--shadow-sm);
  }
  .tool-cat-badge {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 11.5px; font-weight: 600;
    border: 1px solid transparent; border-radius: 100px;
    padding: 3px 12px; margin-bottom: 12px;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: .02em;
  }
  .tool-name {
    font-size: clamp(2rem, 3.8vw, 2.8rem);
    font-weight: 800; color: var(--txt);
    margin-bottom: 10px; letter-spacing: -.6px;
  }
  .tool-desc { font-size: 15px; color: var(--txt-muted); margin-bottom: 18px; line-height: 1.65; max-width: 620px; }
  .tool-tags { display: flex; gap: 8px; flex-wrap: wrap; }

  .tool-body { padding: 44px 0 76px; }
  .tool-card-wrap {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--webkit-glass-blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    padding: 36px;
    box-shadow: var(--glass-shadow), var(--glass-inner-glow);
  }

  .related-section {
    padding: 60px 0;
    border-top: 1px solid var(--border);
    background: var(--surface);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--webkit-glass-blur);
  }
  .related-section .section-label { margin-bottom: 24px; display: flex; }
  .related-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }

  @media (max-width: 768px) {
    .tool-header-inner { flex-direction: column; }
    .tool-icon-box { width: 52px; height: 52px; font-size: 20px; }
    .tool-card-wrap { padding: 22px 16px; }
    .related-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) { .related-grid { grid-template-columns: 1fr; } }
</style>
