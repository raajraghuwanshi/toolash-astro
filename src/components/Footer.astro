<style>
  .site-footer {
    background: var(--surface);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--webkit-glass-blur);
    border-top: 1px solid var(--border);
    padding: 64px 0 0;
    color: var(--txt-dim);
  }
  .footer-top {
    display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr 1fr; gap: 40px;
    max-width: 1160px; margin: 0 auto;
    padding: 0 28px 52px;
    border-bottom: 1px solid var(--border);
  }
  /* Brand */
  .fb-brand a {
    display: inline-flex; align-items: center; gap: 7px;
    text-decoration: none; margin-bottom: 14px; display: flex;
  }
  .fb-icon {
    width: 24px; height: 24px; background: var(--brand);
    border-radius: 6px; display: flex; align-items: center; justify-content: center;
    font-size: 11px; color: #fff;
    box-shadow: 0 2px 8px rgba(5, 150, 105, 0.35);
  }
  .fb-name { font-size: 14px; font-weight: 700; color: var(--txt); letter-spacing: -.2px; }
  .fb-name span { color: var(--brand); }
  .fb-tagline { font-size: 12.5px; color: var(--txt-dim); line-height: 1.65; max-width: 210px; margin-bottom: 20px; }
  .fb-stats { display: flex; gap: 18px; margin-bottom: 20px; }
  .fbs .n { display: block; font-size: 15px; font-weight: 700; color: var(--brand); font-family: 'JetBrains Mono', monospace; }
  .fbs .l { font-size: 9.5px; color: var(--txt-dim); text-transform: uppercase; letter-spacing: .08em; font-family: 'JetBrains Mono', monospace; }
  .fb-social { display: flex; gap: 6px; }
  .soc {
    width: 32px; height: 32px; border-radius: var(--radius-sm);
    border: 1px solid var(--border); background: var(--surface-2);
    color: var(--txt-dim); display: flex; align-items: center; justify-content: center;
    font-size: 12px; text-decoration: none; transition: all .15s ease;
    box-shadow: var(--shadow-sm);
  }
  .soc:hover { border-color: var(--brand); color: var(--brand); transform: translateY(-2px); }

  /* Cols */
  .fc-hd {
    font-size: 9.5px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase;
    color: var(--txt-dim); margin-bottom: 14px; display: block;
    font-family: 'JetBrains Mono', monospace;
  }
  .fc-links { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .fc-links a { font-size: 12.5px; color: var(--txt-muted); text-decoration: none; transition: color .12s; }
  .fc-links a:hover { color: var(--brand); }

  /* Newsletter */
  .footer-nl {
    max-width: 1160px; margin: 0 auto;
    padding: 26px 28px;
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px; flex-wrap: wrap;
    border-bottom: 1px solid var(--border);
  }
  .fnl-copy h3 { font-size: 14px; font-weight: 600; color: var(--txt); margin-bottom: 2px; }
  .fnl-copy p { font-size: 12px; color: var(--txt-dim); font-family: 'JetBrains Mono', monospace; }
  .fnl-form { display: flex; gap: 8px; }
  .fnl-form input {
    width: 220px; background: var(--surface-2);
    border: 1px solid var(--border-mid); border-radius: var(--radius-md);
    padding: 9px 14px; font-size: 13px; color: var(--txt);
    font-family: inherit; outline: none; transition: border-color .15s;
  }
  .fnl-form input::placeholder { color: #94A3B8; }
  .fnl-form input:focus { border-color: var(--brand); box-shadow: 0 0 0 2px var(--brand-soft); }
  .fnl-form button {
    background: var(--brand); color: #fff; border: none;
    border-radius: var(--radius-md); padding: 9px 18px;
    font-size: 13px; font-weight: 600;
    cursor: pointer; font-family: inherit;
    transition: background .15s, transform .15s;
  }
  .fnl-form button:hover { background: var(--brand-hover); transform: translateY(-1px); }

  /* Bottom */
  .footer-bottom {
    max-width: 1160px; margin: 0 auto;
    padding: 16px 28px 22px;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 12px;
  }
  .fc-copy { font-size: 11px; color: var(--txt-dim); font-family: 'JetBrains Mono', monospace; }
  .fc-copy .heart { color: #F472B6; }
  .fb-blinks { display: flex; gap: 18px; list-style: none; }
  .fb-blinks a { font-size: 11px; color: var(--txt-dim); text-decoration: none; transition: color .12s; font-family: 'JetBrains Mono', monospace; }
  .fb-blinks a:hover { color: var(--txt-muted); }

  @media (max-width: 1000px) { .footer-top { grid-template-columns: 1fr 1fr 1fr; } .footer-top > div:first-child { grid-column: 1/-1; } }
  @media (max-width: 640px) {
    .footer-top { grid-template-columns: 1fr 1fr; gap: 24px; padding: 0 20px 40px; }
    .footer-nl { flex-direction: column; align-items: flex-start; padding: 24px 20px; }
    .fnl-form { width: 100%; flex-direction: column; }
    .fnl-form input { width: 100%; }
    .footer-bottom { flex-direction: column; align-items: flex-start; padding: 14px 20px 22px; }
    .fb-blinks { flex-wrap: wrap; gap: 12px; }
  }
</style>

