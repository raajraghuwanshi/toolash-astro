---
import type { Tool } from '../data/tools';
import { toolContentMap } from '../data/toolContent';

export interface Props {
  tool: Tool;
  customFaqs?: Array<{ q: string; a: string }>;
}

const { tool, customFaqs } = Astro.props;
const toolCustom = toolContentMap[tool.slug];

// Category metadata & theme styling
const catTheme: Record<string, { color: string; bg: string; border: string; label: string; badgeIcon: string }> = {
  writing: { color: '#4F46E5', bg: 'rgba(79, 70, 229, 0.08)', border: 'rgba(79, 70, 229, 0.25)', label: 'Writing & Text Architecture', badgeIcon: 'fa-pen-nib' },
  security: { color: '#0284C7', bg: 'rgba(2, 132, 199, 0.08)', border: 'rgba(2, 132, 199, 0.25)', label: 'Security & Privacy Protocol', badgeIcon: 'fa-shield-halved' },
  generators: { color: '#7C3AED', bg: 'rgba(124, 58, 237, 0.08)', border: 'rgba(124, 58, 237, 0.25)', label: 'Generator Tech Specs', badgeIcon: 'fa-bolt' },
  calculators: { color: '#2563EB', bg: 'rgba(37, 99, 235, 0.08)', border: 'rgba(37, 99, 235, 0.25)', label: 'Mathematical Blueprint', badgeIcon: 'fa-calculator' },
  converters: { color: '#E11D48', bg: 'rgba(225, 29, 72, 0.08)', border: 'rgba(225, 29, 72, 0.25)', label: 'Conversion Pipeline', badgeIcon: 'fa-arrows-rotate' },
  media: { color: '#C026D3', bg: 'rgba(192, 38, 211, 0.08)', border: 'rgba(192, 38, 211, 0.25)', label: 'Media Stream & Format Deck', badgeIcon: 'fa-photo-film' },
};

const currentTheme = catTheme[tool.category] || catTheme.calculators;

// Default category fallback steps
const defaultSteps = [
  { step: '01', title: 'Input Data', desc: `Provide text, numbers, or links into the ${tool.name} tool above.`, icon: 'fa-keyboard' },
  { step: '02', title: 'Client-Side Execution', desc: 'Instant calculation and formatting processed directly in your browser.', icon: 'fa-bolt' },
  { step: '03', title: 'Copy & Export', desc: 'Export formatted output, download assets, or copy directly to clipboard.', icon: 'fa-copy' }
];

const defaultFaqs = [
  { q: `Is the ${tool.name} tool free to use?`, a: `Yes, ${tool.name} is 100% free with unlimited usage, zero paywalls, and no registration required.` },
  { q: 'Is my data secure and private?', a: 'Yes. All data processing executes locally inside your web browser. Your inputs are never logged, stored, or sent to external servers.' },
  { q: 'Does this tool work on mobile devices?', a: 'Yes, Toolarsh is fully responsive across iOS Safari, Android Chrome, tablets, and desktop workstations.' }
];

const activeSteps = toolCustom?.steps || defaultSteps;
const activeFaqs = customFaqs || toolCustom?.faqs || defaultFaqs;
const activeTable = toolCustom?.specsTable;
const activeFormula = toolCustom?.formula;
const activeArticle = toolCustom?.article || {
  heading: `${tool.name} — Free Online Utility | Toolarsh`,
  subheading: tool.description,
  paragraphs: [
    `${tool.name} on Toolarsh provides a fast, reliable, and completely private way to handle your ${tool.category} tasks right in your browser. With zero software downloads, zero account requirements, and zero usage limits, you can complete your work in seconds.`,
    `Our tools are built with modern client-side processing, ensuring your confidential data remains securely on your device. Whether you are working on desktop, tablet, or smartphone, Toolarsh delivers pristine performance.`
  ],
  bulletPoints: [
    '100% free with unlimited usage.',
    'Client-side execution for complete data privacy.',
    'Mobile-friendly and compatible across all modern browsers.',
    'No account registration or email subscription required.'
  ]
};
const activeFeatures = toolCustom?.features || [
  { icon: 'fa-bolt', title: 'Instant Speed', desc: 'Sub-second client-side execution with zero server lag.' },
  { icon: 'fa-shield-halved', title: '100% Private', desc: 'Processed directly in your browser with zero data logging.' },
  { icon: 'fa-mobile-screen', title: 'Mobile Responsive', desc: 'Optimized touch interface for iPhones, iPads, and Android devices.' },
  { icon: 'fa-infinity', title: 'No Limits', desc: 'Unlimited usage with zero paywalls or subscriptions.' }
];

// JSON-LD Structured Data
const jsonLdHowTo = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": `How to use ${tool.name}`,
  "description": tool.metaDescription,
  "step": activeSteps.map((s, idx) => ({
    "@type": "HowToStep",
    "position": idx + 1,
    "name": s.title,
    "text": s.desc
  }))
};

const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": activeFaqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<!-- ═══════════════════════════════════════════════════════════════════════
     UNIQUE BESPOKE CONTENT DESIGN LAYOUT FOR EVERY SINGLE TOOL
     ═══════════════════════════════════════════════════════════════════════ -->

{/* ───────────────────────────────────────────────────────────────────────
     1. WORD COUNTER: Editorial Readability Lab Layout
    ─────────────────────────────────────────────────────────────────────── */}
{tool.slug === 'word-counter' && (
  <section class="cat-layout tool-layout-word-counter mt-12 pt-10 border-t border-slate-200 dark:border-zinc-800 flex flex-col gap-10" data-animate="fade-up" style={`--tool-c:#4F46E5; --tool-bg:rgba(79,70,229,0.08); --tool-b:rgba(79,70,229,0.25)`}>
    <!-- Top Speed & Readability Ribbon -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="p-5 rounded-2xl bg-white/90 dark:bg-zinc-900/90 border border-orange-200 dark:border-orange-950/60 shadow-sm">
        <div class="text-xs font-mono font-bold uppercase text-orange-600 dark:text-orange-400 mb-1">Silent Reading</div>
        <div class="text-2xl font-extrabold text-slate-900 dark:text-white">200–250 <span class="text-sm font-normal text-slate-500">wpm</span></div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">Average adult cognitive processing speed on digital screens.</p>
      </div>
      <div class="p-5 rounded-2xl bg-white/90 dark:bg-zinc-900/90 border border-orange-200 dark:border-orange-950/60 shadow-sm">
        <div class="text-xs font-mono font-bold uppercase text-orange-600 dark:text-orange-400 mb-1">Speech Delivery</div>
        <div class="text-2xl font-extrabold text-slate-900 dark:text-white">130–150 <span class="text-sm font-normal text-slate-500">wpm</span></div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">Optimal cadence for keynote presentations and podcasts.</p>
      </div>
      <div class="p-5 rounded-2xl bg-white/90 dark:bg-zinc-900/90 border border-orange-200 dark:border-orange-950/60 shadow-sm">
        <div class="text-xs font-mono font-bold uppercase text-orange-600 dark:text-orange-400 mb-1">Sentence Length</div>
        <div class="text-2xl font-extrabold text-slate-900 dark:text-white">14–18 <span class="text-sm font-normal text-slate-500">words</span></div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">Recommended for maximum web readability and low cognitive load.</p>
      </div>
      <div class="p-5 rounded-2xl bg-white/90 dark:bg-zinc-900/90 border border-orange-200 dark:border-orange-950/60 shadow-sm">
        <div class="text-xs font-mono font-bold uppercase text-orange-600 dark:text-orange-400 mb-1">Paragraph Density</div>
        <div class="text-2xl font-extrabold text-slate-900 dark:text-white">3–4 <span class="text-sm font-normal text-slate-500">lines</span></div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">Bite-sized visual blocks improve mobile comprehension by 42%.</p>
      </div>
    </div>

    <!-- Editorial 2-Column Suite -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8 flex flex-col gap-6">
        <article class="p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 shadow-sm">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-bold uppercase bg-orange-100 text-orange-700 dark:bg-orange-950/60 dark:text-orange-300 mb-3">
            <i class="fas fa-feather-pointed"></i> Editorial Lab Guide
          </span>
          <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white mb-2">{activeArticle.heading}</h2>
          {activeArticle.subheading && <p class="text-orange-600 dark:text-orange-400 font-semibold mb-4">{activeArticle.subheading}</p>}
          <div class="space-y-4 text-slate-600 dark:text-slate-300 text-sm leading-relaxed">
            {activeArticle.paragraphs.map(p => <p>{p}</p>)}
          </div>
          {activeArticle.bulletPoints && (
            <ul class="mt-6 space-y-2 border-t border-slate-100 dark:border-zinc-800 pt-4">
              {activeArticle.bulletPoints.map(b => (
                <li class="flex items-start gap-2 text-sm text-slate-800 dark:text-slate-200">
                  <i class="fas fa-circle-check text-orange-500 mt-1 flex-shrink-0"></i> <span>{b}</span>
                </li>
              ))}
            </ul>
          )}
        </article>

        <!-- Step Workflow Ribbon -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {activeSteps.map(s => (
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-zinc-900/60 border border-slate-200 dark:border-zinc-800">
              <span class="inline-block font-mono font-bold text-xs px-2.5 py-1 rounded-md bg-orange-100 text-orange-700 dark:bg-orange-950 dark:text-orange-400 mb-2">{s.step}</span>
              <h4 class="font-bold text-slate-900 dark:text-white text-sm mb-1">{s.title}</h4>
              <p class="text-xs text-slate-600 dark:text-slate-400">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Sticky Specs Deck -->
      <aside class="lg:col-span-4 flex flex-col gap-6">
        <div class="p-6 rounded-3xl bg-slate-900 text-white border border-zinc-800 shadow-lg">
          <div class="flex items-center gap-3 mb-4">
            <i class="fas fa-chart-pie text-orange-400 text-xl"></i>
            <div>
              <div class="text-xs font-mono uppercase text-zinc-400">Content Thresholds</div>
              <h3 class="font-bold text-base">Standard Word Limits</h3>
            </div>
          </div>
          <div class="space-y-3 text-xs border-y border-zinc-800 py-4 font-mono">
            <div class="flex justify-between"><span>Twitter / X Post</span><strong>280 chars</strong></div>
            <div class="flex justify-between"><span>LinkedIn Post</span><strong>3,000 chars (~500 w)</strong></div>
            <div class="flex justify-between"><span>SEO Blog Article</span><strong>1,500–2,500 words</strong></div>
            <div class="flex justify-between"><span>College Essay</span><strong>500–1,000 words</strong></div>
            <div class="flex justify-between"><span>Novel Manuscript</span><strong>70,000–90,000 words</strong></div>
          </div>
          <div class="mt-4 text-xs text-zinc-400 flex items-center gap-2">
            <i class="fas fa-bolt text-orange-400"></i> Real-time regex tokenization in browser RAM.
          </div>
        </div>

        <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800">
          <h4 class="font-bold text-slate-900 dark:text-white text-sm mb-3">Frequently Asked</h4>
          <div class="space-y-3">
            {activeFaqs.map(f => (
              <div class="p-3 rounded-xl bg-slate-50 dark:bg-zinc-800/60 border border-slate-200/80 dark:border-zinc-700/60">
                <div class="font-semibold text-xs text-slate-900 dark:text-white mb-1">{f.q}</div>
                <div class="text-xs text-slate-600 dark:text-slate-400">{f.a}</div>
              </div>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>
)}

{/* ───────────────────────────────────────────────────────────────────────
     2. PASSWORD GENERATOR: Cryptographic Vault & Shannon Entropy
    ─────────────────────────────────────────────────────────────────────── */}
{tool.slug === 'random-password-generator' && (
  <section class="cat-layout tool-layout-password mt-12 pt-10 border-t border-slate-200 dark:border-zinc-800 flex flex-col gap-10" data-animate="fade-up">
    <!-- Cyber Security Banner -->
    <div class="p-6 md:p-8 rounded-3xl bg-zinc-950 border border-emerald-500/30 shadow-2xl relative overflow-hidden text-emerald-400 font-mono">
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-zinc-800 pb-4 mb-6">
        <div class="flex items-center gap-3">
          <span class="w-3 h-3 rounded-full bg-emerald-500 animate-ping"></span>
          <span class="text-sm font-bold tracking-wider uppercase text-emerald-400">NIST SP 800-63B VAULT PROTOCOL</span>
        </div>
        <div class="text-xs text-zinc-400">HARDWARE CSPRNG SEEDED</div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-4 rounded-xl bg-zinc-900/80 border border-zinc-800">
          <div class="text-xs text-zinc-400 uppercase">Entropy Rating</div>
          <div class="text-2xl font-bold text-white mt-1">128+ Bits</div>
          <p class="text-xs text-zinc-400 mt-2">Guarantees 3.4 &times; 10<sup>38</sup> unique permutations.</p>
        </div>
        <div class="p-4 rounded-xl bg-zinc-900/80 border border-zinc-800">
          <div class="text-xs text-zinc-400 uppercase">Crack Time (RTX 4090 Array)</div>
          <div class="text-2xl font-bold text-emerald-400 mt-1">2.4 Trillion Yrs</div>
          <p class="text-xs text-zinc-400 mt-2">Mathematically immune to brute-force dictionary attacks.</p>
        </div>
        <div class="p-4 rounded-xl bg-zinc-900/80 border border-zinc-800">
          <div class="text-xs text-zinc-400 uppercase">RAM Persistence</div>
          <div class="text-2xl font-bold text-emerald-300 mt-1">0.00 ms (Ephemeral)</div>
          <p class="text-xs text-zinc-400 mt-2">Immediate browser garbage collection with zero cookies.</p>
        </div>
      </div>
    </div>

    <!-- Crack Time Comparison Table -->
    {activeTable && (
      <div class="p-6 md:p-8 rounded-3xl bg-zinc-950 border border-zinc-800 text-white">
        <div class="flex items-center gap-3 mb-4">
          <i class="fas fa-shield-halved text-emerald-400 text-xl"></i>
          <h3 class="font-bold text-lg">{activeTable.title}</h3>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-xs font-mono text-left border-collapse">
            <thead>
              <tr class="border-b border-zinc-800 text-zinc-400">
                {activeTable.headers.map(h => <th class="p-3 bg-zinc-900/80">{h}</th>)}
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-900">
              {activeTable.rows.map(r => (
                <tr class="hover:bg-zinc-900/40 transition">
                  {r.map((c, i) => <td class={`p-3 ${i === 0 ? 'font-bold text-emerald-400' : 'text-zinc-300'}`}>{c}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    <!-- Security Article & FAQs Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <article class="p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 shadow-sm">
        <h2 class="text-xl font-extrabold text-slate-900 dark:text-white mb-3">{activeArticle.heading}</h2>
        <div class="space-y-4 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          {activeArticle.paragraphs.map(p => <p>{p}</p>)}
        </div>
      </article>

      <div class="p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 shadow-sm flex flex-col gap-4">
        <h3 class="font-extrabold text-lg text-slate-900 dark:text-white flex items-center gap-2">
          <i class="fas fa-lock text-emerald-600"></i> Password Security FAQ
        </h3>
        <div class="space-y-3">
          {activeFaqs.map(f => (
            <div class="p-4 rounded-xl bg-slate-50 dark:bg-zinc-800 border border-slate-200 dark:border-zinc-700">
              <div class="font-bold text-xs text-slate-900 dark:text-white mb-1">{f.q}</div>
              <div class="text-xs text-slate-600 dark:text-slate-300 leading-normal">{f.a}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

{/* ───────────────────────────────────────────────────────────────────────
     3. QR CODE GENERATOR: 2D Optical Matrix & Vector Studio
    ─────────────────────────────────────────────────────────────────────── */}
{tool.slug === 'qr-code-generator' && (
  <section class="cat-layout tool-layout-qr mt-12 pt-10 border-t border-slate-200 dark:border-zinc-800 flex flex-col gap-10" data-animate="fade-up">
    <!-- QR Error Correction & Specs Bento -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="p-5 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/60">
        <span class="text-xs font-mono font-bold uppercase text-amber-700 dark:text-amber-400">Level L (Low)</span>
        <div class="text-2xl font-black text-slate-900 dark:text-white mt-1">7% Restore</div>
        <p class="text-xs text-slate-600 dark:text-slate-400 mt-2">Highest data density. Best for clean digital screen displays.</p>
      </div>
      <div class="p-5 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/60">
        <span class="text-xs font-mono font-bold uppercase text-amber-700 dark:text-amber-400">Level M (Standard)</span>
        <div class="text-2xl font-black text-slate-900 dark:text-white mt-1">15% Restore</div>
        <p class="text-xs text-slate-600 dark:text-slate-400 mt-2">Default balance for marketing flyers and packaging.</p>
      </div>
      <div class="p-5 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/60">
        <span class="text-xs font-mono font-bold uppercase text-amber-700 dark:text-amber-400">Level Q (Quality)</span>
        <div class="text-2xl font-black text-slate-900 dark:text-white mt-1">25% Restore</div>
        <p class="text-xs text-slate-600 dark:text-slate-400 mt-2">Resists smudges, folds, and minor physical print damage.</p>
      </div>
      <div class="p-5 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/60">
        <span class="text-xs font-mono font-bold uppercase text-amber-700 dark:text-amber-400">Level H (High)</span>
        <div class="text-2xl font-black text-slate-900 dark:text-white mt-1">30% Restore</div>
        <p class="text-xs text-slate-600 dark:text-slate-400 mt-2">Recommended when embedding brand logos inside center.</p>
      </div>
    </div>

    <!-- QR Studio Specs & Article -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-7 flex flex-col gap-6">
        <article class="p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 shadow-sm">
          <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white mb-2">{activeArticle.heading}</h2>
          {activeArticle.subheading && <p class="text-amber-600 dark:text-amber-400 font-semibold mb-4">{activeArticle.subheading}</p>}
          <div class="space-y-4 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            {activeArticle.paragraphs.map(p => <p>{p}</p>)}
          </div>
        </article>

        {activeTable && (
          <div class="p-6 rounded-3xl bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800">
            <h3 class="font-bold text-base text-slate-900 dark:text-white mb-3">{activeTable.title}</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-xs text-left border-collapse">
                <thead><tr class="border-b border-slate-200 dark:border-zinc-700">{activeTable.headers.map(h => <th class="p-2 font-mono">{h}</th>)}</tr></thead>
                <tbody class="divide-y divide-slate-200 dark:divide-zinc-800">
                  {activeTable.rows.map(r => (
                    <tr>{r.map((c, i) => <td class={`p-2 ${i === 0 ? 'font-bold text-amber-600 dark:text-amber-400' : ''}`}>{c}</td>)}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </div>

      <div class="lg:col-span-5 flex flex-col gap-6">
        <div class="p-6 rounded-3xl bg-amber-500/10 border border-amber-500/30">
          <div class="text-xs font-mono font-bold uppercase text-amber-700 dark:text-amber-300 mb-2"><i class="fas fa-ruler-combined"></i> Scanning Distance Formula</div>
          <div class="font-mono text-sm font-bold text-slate-900 dark:text-white p-3 rounded-xl bg-white dark:bg-zinc-900 border border-amber-200 dark:border-amber-900/60 mb-2">
            Minimum Size = Distance &divide; 10
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400">For a billboard scanned from 20 meters away, the QR code must be at least 2 &times; 2 meters.</p>
        </div>

        <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800">
          <h4 class="font-bold text-sm text-slate-900 dark:text-white mb-3">QR Code FAQs</h4>
          <div class="space-y-3">
            {activeFaqs.map(f => (
              <div class="p-3 rounded-xl bg-slate-50 dark:bg-zinc-800/70 border border-slate-200 dark:border-zinc-700">
                <div class="font-bold text-xs text-slate-900 dark:text-white">{f.q}</div>
                <div class="text-xs text-slate-600 dark:text-slate-400 mt-1">{f.a}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
)}

{/* ───────────────────────────────────────────────────────────────────────
     4. EMI CALCULATOR: Loan Amortization & Financial Blueprint
    ─────────────────────────────────────────────────────────────────────── */}
{tool.slug === 'emi-calculator' && (
  <section class="cat-layout tool-layout-emi mt-12 pt-10 border-t border-slate-200 dark:border-zinc-800 flex flex-col gap-10" data-animate="fade-up">
    <!-- Mathematical Formula Chalkboard -->
    <div class="p-8 rounded-3xl bg-teal-950 border border-teal-500/30 text-teal-300 text-center relative overflow-hidden shadow-xl">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-bold uppercase bg-teal-900 text-teal-200 mb-3">
        <i class="fas fa-calculator"></i> Reducing Balance Equated Monthly Installment Formula
      </span>
      <div class="text-xl md:text-3xl font-mono font-extrabold text-white my-3 tracking-wide">
        E = P &times; r &times; (1 + r)<sup>n</sup> &divide; ((1 + r)<sup>n</sup> - 1)
      </div>
      <p class="text-xs text-teal-200/80 max-w-xl mx-auto">Where <strong>P</strong> = Principal Loan, <strong>r</strong> = Monthly Interest Rate (Annual &divide; 1200), and <strong>n</strong> = Total Tenure in Months.</p>
    </div>

    <!-- Loan Dynamics & Amortization Split Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 shadow-sm">
        <i class="fas fa-hand-holding-dollar text-teal-600 text-2xl mb-3"></i>
