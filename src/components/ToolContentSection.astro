---
import type { Tool } from '../data/tools';
import { toolContentMap } from '../data/toolContent';

export interface Props {
  tool: Tool;
  customFaqs?: Array<{ q: string; a: string }>;
}

const { tool, customFaqs } = Astro.props;
const toolCustom = toolContentMap[tool.slug];

// Category metadata & styling
const catTheme: Record<string, { color: string; bg: string; border: string; label: string; badgeIcon: string }> = {
  writing: { color: '#EA580C', bg: 'rgba(234, 88, 12, 0.08)', border: 'rgba(234, 88, 12, 0.25)', label: 'Writing & Text Architecture', badgeIcon: 'fa-pen-nib' },
  security: { color: '#059669', bg: 'rgba(5, 150, 105, 0.08)', border: 'rgba(5, 150, 105, 0.25)', label: 'Security & Privacy Protocol', badgeIcon: 'fa-shield-halved' },
  generators: { color: '#D97706', bg: 'rgba(217, 119, 6, 0.08)', border: 'rgba(217, 119, 6, 0.25)', label: 'Generator Tech Specs', badgeIcon: 'fa-bolt' },
  calculators: { color: '#0D9488', bg: 'rgba(13, 148, 136, 0.08)', border: 'rgba(13, 148, 136, 0.25)', label: 'Mathematical Blueprint', badgeIcon: 'fa-calculator' },
  converters: { color: '#E11D48', bg: 'rgba(225, 29, 72, 0.08)', border: 'rgba(225, 29, 72, 0.25)', label: 'Conversion Pipeline', badgeIcon: 'fa-arrows-rotate' },
  media: { color: '#F97316', bg: 'rgba(249, 115, 22, 0.08)', border: 'rgba(249, 115, 22, 0.25)', label: 'Media Stream & Format Deck', badgeIcon: 'fa-photo-film' },
};

const currentTheme = catTheme[tool.category] || catTheme.calculators;

// Default category fallback steps
const categorySteps: Record<string, Array<{ step: string; title: string; desc: string; icon: string }>> = {
  writing: [
    { step: '01', title: 'Input Content', desc: 'Paste or type text directly into the live editor.', icon: 'fa-paste' },
    { step: '02', title: 'Real-Time Analysis', desc: 'Instant calculation across all tokens, words, and characters.', icon: 'fa-bolt' },
    { step: '03', title: 'Copy & Export', desc: 'Copy formatted text or metrics directly to your clipboard.', icon: 'fa-copy' }
  ],
  security: [
    { step: '01', title: 'Set Cryptographic Options', desc: 'Select length, character mix, and hardware entropy.', icon: 'fa-sliders' },
    { step: '02', title: 'Generate Token', desc: 'Client-side Web Crypto API creates randomized keys.', icon: 'fa-shield-halved' },
    { step: '03', title: 'Zero-Trace Copy', desc: 'Ephemeral memory copy with zero server persistence.', icon: 'fa-lock' }
  ],
  generators: [
    { step: '01', title: 'Enter Target Data', desc: 'Input URLs, text, keywords, or configuration options.', icon: 'fa-keyboard' },
    { step: '02', title: 'Algorithmic Render', desc: 'Computes error-corrected matrix, vectors, or creative names.', icon: 'fa-wand-magic-sparkles' },
    { step: '03', title: 'Save Output', desc: 'Download SVG, high-res PNG, or copy output directly.', icon: 'fa-download' }
  ],
  calculators: [
    { step: '01', title: 'Supply Inputs', desc: 'Fill in principal, dimensions, interest rate, or readings.', icon: 'fa-hashtag' },
    { step: '02', title: 'Formula Calculation', desc: 'Applies verified mathematical formulas with floating precision.', icon: 'fa-calculator' },
    { step: '03', title: 'Analyze Metrics', desc: 'Inspect full amortizations, percentages, or health stages.', icon: 'fa-chart-pie' }
  ],
  converters: [
    { step: '01', title: 'Select Base Units', desc: 'Choose origin measurement system or upload file format.', icon: 'fa-arrow-right-arrow-left' },
    { step: '02', title: 'Real-Time Factor', desc: 'Instant recalculation as numbers or formats adjust.', icon: 'fa-arrows-rotate' },
    { step: '03', title: 'Export Conversion', desc: 'Copy exact numeric results or download converted files.', icon: 'fa-file-export' }
  ],
  media: [
    { step: '01', title: 'Paste Public Link', desc: 'Copy the shareable URL of the public video, reel, or photo.', icon: 'fa-link' },
    { step: '02', title: 'Select Stream Tier', desc: 'Choose between 1080p Full HD, original photo, or MP3 audio.', icon: 'fa-cloud-arrow-down' },
    { step: '03', title: 'Direct Download', desc: 'Save un-watermarked high-bitrate media directly to device.', icon: 'fa-circle-down' }
  ]
};

// Default fallback FAQs
const defaultCategoryFaqs: Record<string, Array<{ q: string; a: string }>> = {
  writing: [
    { q: `Is the ${tool.name} tool completely free to use?`, a: `Yes, ${tool.name} is 100% free with no usage limits, no premium paywalls, and no registration required.` },
    { q: 'Is my text private when using this tool?', a: 'Yes. All text processing occurs client-side in your web browser. Your text is never stored, logged, or transmitted to any server.' },
    { q: 'Does this tool work on mobile devices?', a: 'Yes, Toolarsh tools are fully responsive and work seamlessly on iPhones, Android devices, tablets, and desktop computers.' }
  ],
  security: [
    { q: `Is ${tool.name} cryptographically secure?`, a: 'Yes! It utilizes the browser native window.crypto CSPRNG API with hardware entropy seeds to guarantee true mathematical randomness.' },
    { q: 'Do you store or log generated credentials?', a: 'Never. All generation happens locally in your device temporary RAM with zero data persistence.' }
  ],
  generators: [
    { q: `Can I use outputs from ${tool.name} commercially?`, a: 'Yes, all generated outputs (QR codes, barcodes, UUIDs, business names) are 100% royalty-free for personal and commercial applications.' },
    { q: 'Do generated items expire?', a: 'No, static generated codes and outputs never expire and have zero scan or usage caps.' }
  ],
  calculators: [
    { q: `What formula is used in the ${tool.name}?`, a: 'Our calculator implements standard, verified mathematical and financial formulas to guarantee exact computational precision.' },
    { q: 'Can I calculate values using decimal numbers?', a: 'Yes, our calculation engine supports full 64-bit IEEE 754 floating-point arithmetic with multi-decimal precision.' }
  ],
  converters: [
    { q: `How accurate is the ${tool.name}?`, a: 'Our conversion factors are aligned with international BIPM and NIST measurement standards with zero rounding bias.' },
    { q: 'Can I convert between Metric and Imperial units?', a: 'Yes, seamless bidirectional conversion between Metric (SI) and US/UK Imperial units is fully supported.' }
  ],
  media: [
    { q: `Is it free to download media using ${tool.name}?`, a: 'Yes, Toolarsh media downloaders are 100% free with no download caps, no subscriptions, and no hidden fees.' },
    { q: 'Does this tool add watermarks to downloaded files?', a: 'Never. All media is fetched in original uncompressed quality without injected logos or watermarks.' }
  ]
};

const activeSteps = toolCustom?.steps || categorySteps[tool.category] || categorySteps.calculators;
const activeFaqs = customFaqs || toolCustom?.faqs || defaultCategoryFaqs[tool.category] || defaultCategoryFaqs.calculators;
const activeTable = toolCustom?.specsTable;
const activeFormula = toolCustom?.formula;
const activeArticle = toolCustom?.article || {
  heading: `${tool.name} — Free Online Tool | Toolarsh`,
  subheading: tool.description,
  paragraphs: [
    `${tool.name} on Toolarsh provides a fast, reliable, and completely private way to handle your ${tool.category} tasks right in your browser. With zero software downloads, zero account requirements, and zero usage limits, you can complete your work in seconds.`,
    `Our tools are built with modern client-side processing, ensuring your confidential data remains securely on your device. Whether you are working on desktop, tablet, or smartphone, Toolarsh delivers pristine performance.`
  ],
  bulletPoints: [
    '100% free with unlimited usage.',
    'Client-side execution for complete data privacy.',
    'Mobile-friendly and compatible across all modern browsers.',
    'No account registration or email subscription required.'
  ]
};
const activeFeatures = toolCustom?.features || [
  { icon: 'fa-bolt', title: 'Instant Speed', desc: 'Sub-second client-side execution with zero server lag.' },
  { icon: 'fa-shield-halved', title: '100% Private', desc: 'Processed directly in your browser with zero data logging.' },
  { icon: 'fa-mobile-screen', title: 'Mobile Responsive', desc: 'Optimized touch interface for iPhones, iPads, and Android devices.' },
  { icon: 'fa-infinity', title: 'No Limits', desc: 'Unlimited usage with zero paywalls or subscriptions.' }
];

// JSON-LD Structured Data
const jsonLdHowTo = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": `How to use ${tool.name}`,
  "description": tool.metaDescription,
  "step": activeSteps.map((s, idx) => ({
    "@type": "HowToStep",
    "position": idx + 1,
    "name": s.title,
    "text": s.desc
  }))
};

const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": activeFaqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<!-- ═══════════════════════════════════════════════════════════════════════
     DYNAMIC ARCHITECTURAL LAYOUTS PER CATEGORY (6 COMPLETELY DIFFERENT DESIGNS)
     ═══════════════════════════════════════════════════════════════════════ -->

{/* ───────────────────────────────────────────────────────────────────────
     LAYOUT 1: WRITING & TEXT (Editorial Desk & Sidebar Layout)
    ─────────────────────────────────────────────────────────────────────── */}
{tool.category === 'writing' && (
  <section class="cat-layout layout-writing" data-animate="fade-up" style={`--cat-c:${currentTheme.color}; --cat-bg:${currentTheme.bg}; --cat-b:${currentTheme.border}`}>
    <div class="writing-grid">
      <!-- Left Sticky Editorial Sidebar (30%) -->
      <aside class="writing-sidebar">
        <div class="editorial-card">
          <div class="ed-header">
            <i class="fas fa-feather-pointed ed-icon"></i>
            <div>
              <span class="ed-label">Editorial Benchmarks</span>
              <h4>Text Dynamics</h4>
            </div>
          </div>
          <div class="ed-stats-list">
            <div class="ed-stat-row">
              <span>Silent Reading Rate</span>
              <strong>230 wpm</strong>
            </div>
            <div class="ed-stat-row">
              <span>Public Speaking Rate</span>
              <strong>130 wpm</strong>
            </div>
            <div class="ed-stat-row">
              <span>Optimal Line Length</span>
              <strong>50–75 chars</strong>
            </div>
            <div class="ed-stat-row">
              <span>Target Sentence Length</span>
              <strong>15–20 words</strong>
            </div>
          </div>
          <div class="ed-footer-tip">
            <i class="fas fa-lightbulb"></i>
            <span>Short paragraphs of 2-3 sentences maximize reader retention on mobile displays.</span>
          </div>
        </div>
      </aside>

      <!-- Right Main Editorial Stream (70%) -->
      <main class="writing-main">
        <!-- Step Capsules Ribbon -->
        <div class="step-capsules">
          {activeSteps.map(s => (
            <div class="step-capsule">
              <span class="cap-num">{s.step}</span>
              <div class="cap-info">
                <strong>{s.title}</strong>
                <span>{s.desc}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- Rich Editorial Article Block -->
        <article class="editorial-article-box">
          <div class="art-header">
            <span class="art-badge"><i class="fas fa-book-open"></i> In-Depth Guide</span>
            <h2>{activeArticle.heading}</h2>
            {activeArticle.subheading && <p class="art-subheading">{activeArticle.subheading}</p>}
          </div>

          <div class="art-body">
            {activeArticle.paragraphs.map(p => <p>{p}</p>)}
          </div>

          {activeArticle.bulletPoints && (
            <ul class="art-bullets">
              {activeArticle.bulletPoints.map(b => (
                <li><i class="fas fa-circle-check"></i> <span>{b}</span></li>
              ))}
            </ul>
          )}
        </article>

        <!-- Feature Highlights Grid -->
        <div class="features-block">
          <h3 class="section-subhd"><i class="fas fa-sparkles"></i> Key Capabilities</h3>
          <div class="feature-card-grid">
            {activeFeatures.map(f => (
              <div class="feature-card">
                <div class="feature-icon"><i class={`fas ${f.icon}`}></i></div>
                <h4>{f.title}</h4>
                <p>{f.desc}</p>
              </div>
            ))}
          </div>
        </div>

        {/* Reference Table if available */}
        {activeTable && (
          <div class="writing-table-card">
            <h3 class="section-subhd"><i class="fas fa-table"></i> {activeTable.title}</h3>
            <div class="table-wrap">
              <table class="writing-table">
                <thead>
                  <tr>{activeTable.headers.map((h: string) => <th>{h}</th>)}</tr>
                </thead>
                <tbody>
                  {activeTable.rows.map((r: string[]) => (
                    <tr>{r.map((c: string, idx: number) => <td class={idx === 0 ? 'ed-bold' : ''}>{c}</td>)}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        <!-- 2-Column FAQ Cards -->
        <div class="writing-faq-wrap">
          <h3 class="section-subhd"><i class="fas fa-circle-question"></i> Editorial Questions & Answers</h3>
          <div class="faq-two-col">
            {activeFaqs.map(f => (
              <div class="faq-card-static">
                <h4>{f.q}</h4>
                <p>{f.a}</p>
              </div>
            ))}
          </div>
        </div>
      </main>
    </div>
  </section>
)}

{/* ───────────────────────────────────────────────────────────────────────
     LAYOUT 2: CALCULATORS (Mathematical Blueprint / Dashboard)
    ─────────────────────────────────────────────────────────────────────── */}
{tool.category === 'calculators' && (
  <section class="cat-layout layout-calculators" data-animate="fade-up" style={`--cat-c:${currentTheme.color}; --cat-bg:${currentTheme.bg}; --cat-b:${currentTheme.border}`}>
    <!-- Top Math Chalkboard / Canvas Banner -->
    {activeFormula && (
      <div class="calc-math-canvas">
        <div class="math-canvas-badge">
          <i class="fas fa-square-root-variable"></i> Verified Computational Formula
        </div>
        <div class="math-formula-code font-mono">
          {activeFormula.latex}
        </div>
        <p class="math-explanation">{activeFormula.explanation}</p>
      </div>
    )}

    <!-- 50/50 Split Blueprint Grid -->
    <div class="calc-split-grid">
      <!-- Left: Step Algorithm Recipe -->
      <div class="calc-recipe-card">
        <div class="card-hd">
          <i class="fas fa-list-check card-hd-icon"></i>
          <div>
            <span class="card-hd-badge">Algorithm Flow</span>
            <h3>How Calculations Execute</h3>
          </div>
        </div>
        <div class="calc-steps-stack">
          {activeSteps.map(s => (
            <div class="calc-step-row">
              <div class="calc-step-bubble font-mono">{s.step}</div>
              <div>
                <h4>{s.title}</h4>
                <p>{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Pre-Calculated Benchmark Table -->
      <div class="calc-table-card">
        <div class="card-hd">
          <i class="fas fa-chart-column card-hd-icon"></i>
          <div>
            <span class="card-hd-badge">Benchmark Matrix</span>
            <h3>{activeTable?.title || `${tool.name} Standards`}</h3>
          </div>
        </div>
        {activeTable?.rows ? (
          <div class="table-wrap">
            <table class="calc-table">
              <thead>
                <tr>{activeTable.headers.map((h: string) => <th>{h}</th>)}</tr>
              </thead>
              <tbody>
                {activeTable.rows.map((r: string[]) => (
                  <tr>{r.map((c: string, idx: number) => <td class={idx === 0 ? 'calc-cell-hd' : ''}>{c}</td>)}</tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="calc-placeholder-specs">
            <div class="spec-row"><span>Arithmetic Precision</span><strong>64-bit IEEE 754</strong></div>
            <div class="spec-row"><span>Error Tolerance</span><strong>&lt; 0.00001%</strong></div>
            <div class="spec-row"><span>Execution Speed</span><strong>&lt; 1 millisecond</strong></div>
          </div>
        )}
      </div>
    </div>

    <!-- Editorial Article Block -->
    <article class="calc-article-card">
      <div class="art-header">
        <span class="art-badge"><i class="fas fa-book-open"></i> Mathematical Analysis</span>
        <h2>{activeArticle.heading}</h2>
        {activeArticle.subheading && <p class="art-subheading">{activeArticle.subheading}</p>}
      </div>
      <div class="art-body">
        {activeArticle.paragraphs.map(p => <p>{p}</p>)}
      </div>
      {activeArticle.bulletPoints && (
        <ul class="art-bullets">
          {activeArticle.bulletPoints.map(b => (
            <li><i class="fas fa-circle-check"></i> <span>{b}</span></li>
          ))}
        </ul>
      )}
    </article>

    <!-- 4 Feature Cards -->
    <div class="calc-features-grid">
      {activeFeatures.map(f => (
        <div class="calc-feature-pill">
          <div class="calc-feat-icon"><i class={`fas ${f.icon}`}></i></div>
          <div>
            <h4>{f.title}</h4>
            <p>{f.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- FAQ Drawer Accordion -->
    <div class="calc-faq-section">
      <div class="calc-faq-header">
        <span class="card-hd-badge">Calculation FAQ</span>
        <h3>Answers to Common Formulas & Queries</h3>
      </div>
      <div class="calc-faq-list">
        {activeFaqs.map((f, i) => (
          <details class="calc-faq-drawer" id={`c-faq-${i}`}>
            <summary class="calc-faq-summary">
              <span>{f.q}</span>
              <i class="fas fa-chevron-down"></i>
            </summary>
            <div class="calc-faq-body">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

{/* ───────────────────────────────────────────────────────────────────────
     LAYOUT 3: SECURITY & PRIVACY (Cyber Dossier & Terminal Architecture)
    ─────────────────────────────────────────────────────────────────────── */}
{tool.category === 'security' && (
  <section class="cat-layout layout-security" data-animate="fade-up" style={`--cat-c:${currentTheme.color}; --cat-bg:${currentTheme.bg}; --cat-b:${currentTheme.border}`}>
    <!-- Terminal-style Security Dossier Banner -->
    <div class="cyber-terminal">
      <div class="terminal-bar">
        <div class="term-dots"><span></span><span></span><span></span></div>
        <span class="term-title font-mono">ENCRYPTION_PROTOCOL // CLIENT_SIDE_ONLY</span>
        <span class="term-status font-mono"><i class="fas fa-circle-check"></i> ZERO_PERSISTENCE</span>
      </div>
      <div class="terminal-body font-mono">
        <div class="term-line"><span class="t-green">&gt; INITIALIZING_CIPHER:</span> WebCryptoAPI CSPRNG (Cryptographically Secure Pseudo-Random Number Generator)</div>
        <div class="term-line"><span class="t-green">&gt; MEMORY_LIFECYCLE:</span> Ephemeral JavaScript heap memory &bull; Zero server telemetry &bull; Immediate GC release</div>
        <div class="term-line"><span class="t-green">&gt; ENTROPY_STANDARD:</span> NIST SP 800-90A / FIPS 140-2 compliance verified</div>
      </div>
    </div>

    <!-- 3 Pillars of Security Architecture -->
    <div class="cyber-pillars">
      <div class="pillar-card">
        <div class="pillar-icon"><i class="fas fa-microchip"></i></div>
        <h4>Local Web Crypto</h4>
        <p>Uses hardware-accelerated OS entropy seeds directly in your browser. No strings are ever transmitted across networks.</p>
      </div>
      <div class="pillar-card">
        <div class="pillar-icon"><i class="fas fa-hard-drive"></i></div>
        <h4>Zero Disk Persistence</h4>
        <p>All values exist strictly in temporary RAM. No cookies, local storage, or server logs retain your sensitive credentials.</p>
      </div>
      <div class="pillar-card">
        <div class="pillar-icon"><i class="fas fa-shield-virus"></i></div>
        <h4>Brute Force Immunity</h4>
        <p>High entropy distributions ensure mathematical resistance against state-sponsored rainbow tables and GPU cracking arrays.</p>
      </div>
    </div>

    <!-- Security Editorial Article -->
    <article class="cyber-article-card">
      <div class="art-header">
        <span class="art-badge"><i class="fas fa-user-shield"></i> Security Dossier</span>
        <h2>{activeArticle.heading}</h2>
        {activeArticle.subheading && <p class="art-subheading">{activeArticle.subheading}</p>}
      </div>
      <div class="art-body">
        {activeArticle.paragraphs.map(p => <p>{p}</p>)}
      </div>
      {activeArticle.bulletPoints && (
        <ul class="art-bullets">
          {activeArticle.bulletPoints.map(b => (
            <li><i class="fas fa-shield-check"></i> <span>{b}</span></li>
          ))}
        </ul>
      )}
    </article>

    {/* NIST Table if available */}
    {activeTable && (
      <div class="cyber-table-wrap">
        <div class="cyber-tbl-header">
          <i class="fas fa-server"></i>
          <h4>{activeTable.title}</h4>
        </div>
        <table class="cyber-table font-mono">
          <thead>
            <tr>{activeTable.headers.map((h: string) => <th>{h}</th>)}</tr>
          </thead>
          <tbody>
            {activeTable.rows.map((r: string[]) => (
              <tr>{r.map((c: string, idx: number) => <td class={idx === 0 ? 'cyber-col-1' : ''}>{c}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <!-- Security Protocol FAQs -->
    <div class="cyber-faq-deck">
      <h3 class="cyber-faq-title font-mono"><i class="fas fa-shield-halved"></i> SECURITY_FAQ_ARCHIVE</h3>
      <div class="cyber-faq-grid">
        {activeFaqs.map(f => (
          <div class="cyber-faq-box font-mono">
            <div class="q-row"><span class="t-green">?</span> <strong>{f.q}</strong></div>
            <div class="a-row"><span class="t-dim">&gt;</span> {f.a}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{/* ───────────────────────────────────────────────────────────────────────
     LAYOUT 4: GENERATORS (Studio & Tech Specs Matrix)
    ─────────────────────────────────────────────────────────────────────── */}
{tool.category === 'generators' && (
  <section class="cat-layout layout-generators" data-animate="fade-up" style={`--cat-c:${currentTheme.color}; --cat-bg:${currentTheme.bg}; --cat-b:${currentTheme.border}`}>
    <!-- Generator Bento Studio Grid -->
    <div class="gen-bento-grid">
      <!-- Main Tech Feature (2 col span) -->
      <div class="gen-bento-tile bento-main">
        <div class="gen-tile-badge"><i class="fas fa-wand-magic-sparkles"></i> Vector Engine</div>
        <h2>Instant Vector Generation</h2>
        <p>Generates high-resolution raster and vector graphics with sub-millisecond precision. Output formats are mathematically optimized for crisp physical print and high-DPI screens.</p>
        <div class="gen-format-tags">
          <span class="gen-tag"><i class="fas fa-check"></i> SVG Vector</span>
          <span class="gen-tag"><i class="fas fa-check"></i> High-Res PNG</span>
          <span class="gen-tag"><i class="fas fa-check"></i> Plain Text</span>
          <span class="gen-tag"><i class="fas fa-check"></i> 100% Commercial Free</span>
        </div>
      </div>

      <!-- Quick Steps Tile -->
      <div class="gen-bento-tile bento-steps">
        <div class="gen-tile-badge"><i class="fas fa-arrows-split-up-and-left"></i> Workflow</div>
        <div class="gen-step-list">
          {activeSteps.map(s => (
            <div class="gen-mini-step">
              <span class="gen-step-num font-mono">{s.step}</span>
              <div>
                <strong>{s.title}</strong>
                <p>{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Generator Editorial Article -->
    <article class="gen-article-card">
      <div class="art-header">
        <span class="art-badge"><i class="fas fa-bolt"></i> Generator Studio Guide</span>
        <h2>{activeArticle.heading}</h2>
        {activeArticle.subheading && <p class="art-subheading">{activeArticle.subheading}</p>}
      </div>
      <div class="art-body">
        {activeArticle.paragraphs.map(p => <p>{p}</p>)}
      </div>
      {activeArticle.bulletPoints && (
        <ul class="art-bullets">
          {activeArticle.bulletPoints.map(b => (
