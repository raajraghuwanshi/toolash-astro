---
import { tools } from '../data/tools';

const navCategories = [
  {
    label: 'Writing',
    emoji: '✍️',
    href: '/#writing',
    color: '#7C3AED',
    items: tools.filter(t => t.category === 'writing').slice(0, 6),
  },
  {
    label: 'Security',
    emoji: '🔒',
    href: '/#security',
    color: '#059669',
    items: tools.filter(t => t.category === 'security').slice(0, 4),
  },
  {
    label: 'Generators',
    emoji: '⚡',
    href: '/#generators',
    color: '#EA580C',
    items: tools.filter(t => t.category === 'generators').slice(0, 6),
  },
  {
    label: 'Calculators',
    emoji: '🧮',
    href: '/#calculators',
    color: '#2563EB',
    items: tools.filter(t => t.category === 'calculators').slice(0, 6),
  },
  {
    label: 'Converters',
    emoji: '🔄',
    href: '/#converters',
    color: '#0891B2',
    items: tools.filter(t => t.category === 'converters').slice(0, 5),
  },
  {
    label: 'Media',
    emoji: '🎬',
    href: '/#media',
    color: '#DC2626',
    items: tools.filter(t => t.category === 'media').slice(0, 5),
  },
];
---

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 200;
    background: rgba(255,255,255,.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 64px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  /* Logo */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Outfit', sans-serif;
    font-size: 20px;
    font-weight: 900;
    color: var(--txt);
    text-decoration: none;
    margin-right: 12px;
    flex-shrink: 0;
  }
  .nav-logo .logo-icon {
    width: 34px;
    height: 34px;
    background: linear-gradient(135deg, #2563EB, #7C3AED);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
  }
  .nav-logo span { letter-spacing: -.5px; }
  .nav-logo .dot { color: var(--brand); }

  /* Desktop nav items */
  .nav-items {
    display: flex;
    align-items: center;
    gap: 2px;
    flex: 1;
    list-style: none;
  }
  .nav-item { position: relative; }
  .nav-link {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 8px 12px;
    font-size: 14px;
    font-weight: 600;
    color: var(--txt-muted);
    border-radius: 8px;
    transition: color .15s, background .15s;
    cursor: pointer;
  }
  .nav-link:hover { color: var(--txt); background: var(--bg-soft); }
  .nav-link .arrow {
    font-size: 10px;
    transition: transform .2s;
  }
  .nav-item:hover .arrow { transform: rotate(180deg); }

  /* Mega Dropdown */
  .dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(-8px);
    background: #fff;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 16px;
    min-width: 240px;
    box-shadow: 0 20px 60px rgba(0,0,0,.12);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity .18s ease, transform .18s ease, visibility .18s;
    z-index: 300;
  }
  .nav-item:hover .dropdown,
  .nav-item:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .dropdown-header {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    margin-bottom: 8px;
    padding: 0 6px;
  }
  .dropdown-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 8px;
    border-radius: 8px;
    font-size: 13.5px;
    color: var(--txt-muted);
    transition: all .12s;
  }
  .dropdown-link:hover {
    background: var(--bg-soft);
    color: var(--txt);
  }
  .dropdown-link i {
    font-size: 12px;
    width: 18px;
    text-align: center;
  }

  /* Right side */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: 100px;
    border: 1.5px solid var(--border);
    background: var(--bg-soft);
    font-size: 13.5px;
    color: var(--txt-muted);
    cursor: pointer;
    transition: all .15s;
  }
  .search-trigger:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  .search-trigger kbd {
    font-size: 11px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1px 5px;
    font-family: 'Inter', sans-serif;
  }
  .free-badge {
    background: #DCFCE7;
    color: #15803D;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 100px;
    white-space: nowrap;
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    cursor: pointer;
    margin-left: auto;
  }
  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--txt);
    border-radius: 2px;
    transition: all .2s;
  }

  /* Mobile menu */
  .mobile-menu {
    display: none;
    background: #fff;
    border-top: 1px solid var(--border);
    padding: 16px;
  }
  .mobile-menu.open { display: block; }
  .mobile-cat-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--txt-muted);
    padding: 12px 0 6px;
  }
  .mobile-cat-title:first-child { padding-top: 0; }
  .mobile-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--txt);
    border-bottom: 1px solid var(--border);
  }
  .mobile-link:last-child { border-bottom: none; }

  @media (max-width: 900px) {
    .nav-items, .free-badge, .search-trigger { display: none; }
    .hamburger { display: flex; }
    .nav-inner { gap: 0; }
  }
</style>

<nav class="navbar" id="main-navbar">
  <div class="nav-inner">
    <!-- Logo -->
    <a href="/" class="nav-logo">
      <div class="logo-icon">🧰</div>
      <span>Toolarsh<span class="dot">.</span></span>
    </a>

    <!-- Desktop nav -->
    <ul class="nav-items">
      {navCategories.map(cat => (
        <li class="nav-item">
          <button class="nav-link">
            {cat.emoji} {cat.label}
            <i class="fas fa-chevron-down arrow"></i>
          </button>
          <div class="dropdown">
            <div class="dropdown-header" style={`color: ${cat.color}`}>{cat.label}</div>
            {cat.items.map(tool => (
              <a class="dropdown-link" href={`/${tool.slug}`}>
                <i class={`fas ${tool.faIcon}`} style={`color: ${cat.color}`}></i>
                {tool.name}
              </a>
            ))}
            <a class="dropdown-link" href={cat.href} style="margin-top: 4px; font-weight: 600;">
              <i class="fas fa-grid-2" style={`color: ${cat.color}`}></i>
              View all →
            </a>
          </div>
        </li>
      ))}
    </ul>

    <!-- Right actions -->
    <div class="nav-right">
      <button class="search-trigger" id="search-open-btn" aria-label="Search tools">
        <i class="fas fa-search"></i>
        Search tools…
        <kbd>Ctrl K</kbd>
      </button>
      <span class="free-badge">100% Free</span>
    </div>

    <!-- Hamburger -->
    <button class="hamburger" id="hamburger-btn" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="mobile-menu" id="mobile-menu">
    {navCategories.map(cat => (
      <>
        <div class="mobile-cat-title" style={`color: ${cat.color}`}>{cat.emoji} {cat.label}</div>
        {cat.items.map(tool => (
          <a class="mobile-link" href={`/${tool.slug}`}>
            <i class={`fas ${tool.faIcon}`} style={`color: ${cat.color}`}></i>
            {tool.name}
          </a>
        ))}
      </>
    ))}
  </div>
</nav>

<script>
  // Hamburger toggle
  document.getElementById('hamburger-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('open');
  });

  // Search open
  document.getElementById('search-open-btn')?.addEventListener('click', () => {
    if (typeof (window as any).openSearchModal === 'function') {
      (window as any).openSearchModal();
    } else {
      document.getElementById('search-overlay')?.classList.add('open');
      (document.getElementById('search-input') as HTMLInputElement)?.focus();
    }
  });

  // Keyboard shortcut Ctrl+K / Cmd+K
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      if (typeof (window as any).openSearchModal === 'function') {
        (window as any).openSearchModal();
      } else {
        document.getElementById('search-overlay')?.classList.add('open');
        (document.getElementById('search-input') as HTMLInputElement)?.focus();
      }
    }
    if (e.key === 'Escape') {
      document.getElementById('search-overlay')?.classList.remove('open');
    }
  });
</script>
