---
import { tools } from '../data/tools';

const cats = [
  { label: 'Writing',     href: '/#writing',     count: tools.filter(t=>t.category==='writing').length,     items: tools.filter(t=>t.category==='writing').slice(0,5) },
  { label: 'Security',    href: '/#security',    count: tools.filter(t=>t.category==='security').length,    items: tools.filter(t=>t.category==='security').slice(0,4) },
  { label: 'Generators',  href: '/#generators',  count: tools.filter(t=>t.category==='generators').length,  items: tools.filter(t=>t.category==='generators').slice(0,5) },
  { label: 'Calculators', href: '/#calculators', count: tools.filter(t=>t.category==='calculators').length, items: tools.filter(t=>t.category==='calculators').slice(0,5) },
  { label: 'Converters',  href: '/#converters',  count: tools.filter(t=>t.category==='converters').length,  items: tools.filter(t=>t.category==='converters').slice(0,4) },
  { label: 'Media',       href: '/#media',       count: tools.filter(t=>t.category==='media').length,       items: tools.filter(t=>t.category==='media').slice(0,4) },
];
---

<style>
  .nav {
    position: sticky; top: 0; z-index: 200;
    padding: 10px 0;
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    transition: border-color .2s, background-color .25s;
  }
  .nav.scrolled {
    border-bottom-color: var(--border-mid);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }
  html[data-theme="dark"] .nav.scrolled {
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  }

  .nav-inner {
    display: flex; align-items: center;
    height: 40px;
    max-width: 1160px; margin: 0 auto; padding: 0 28px;
    gap: 0;
  }

  /* Logo */
  .nav-logo {
    display: flex; align-items: center; gap: 8px;
    text-decoration: none; margin-right: 24px; flex-shrink: 0;
  }
  .nav-logo-icon {
    width: 28px; height: 28px;
    background: var(--brand);
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; color: #fff;
    box-shadow: 0 2px 10px rgba(5, 150, 105, 0.35);
    transition: transform .2s ease;
  }
  .nav-logo:hover .nav-logo-icon { transform: scale(1.05); }
  .nav-logo-text {
    font-size: 16px; font-weight: 800;
    color: var(--txt); letter-spacing: -.4px;
  }
  .nav-logo-text span { color: var(--brand); }

  /* Nav links */
  .nav-links { display: flex; align-items: center; gap: 2px; list-style: none; flex: 1; }
  .nav-item { position: relative; }
  .nav-btn {
    padding: 6px 12px;
    font-size: 13.5px; font-weight: 500;
    color: var(--txt-muted);
    border-radius: var(--radius-md);
    transition: color .15s, background .15s;
    cursor: pointer; background: none; border: none;
    font-family: inherit; display: flex; align-items: center; gap: 5px;
  }
  .nav-btn:hover { color: var(--txt); background: var(--surface-3); }
  .nav-btn .ch { font-size: 8px; transition: transform .2s; color: var(--txt-dim); }
  .nav-item:hover .ch { transform: rotate(180deg); color: var(--brand); }

  /* Dropdown (Glassmorphic) */
  .nav-drop {
    position: absolute; top: calc(100% + 8px); left: 0;
    background: var(--surface-2);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--border-mid);
    border-radius: var(--radius-lg);
    padding: 8px;
    min-width: 220px;
    box-shadow: var(--shadow-lg), var(--glass-inner-glow);
    opacity: 0; visibility: hidden; pointer-events: none;
    transform: translateY(-6px);
    transition: opacity .18s ease, transform .18s ease, visibility .18s;
    z-index: 300;
  }
  .nav-item:hover .nav-drop,
  .nav-item:focus-within .nav-drop {
    opacity: 1; visibility: visible; pointer-events: auto; transform: translateY(0);
  }
  .drop-hd {
    font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    color: var(--txt-dim); padding: 4px 10px 6px; font-family: 'JetBrains Mono', monospace;
  }
  .drop-link {
    display: flex; align-items: center; gap: 10px;
    padding: 7px 10px; border-radius: var(--radius-md);
    font-size: 13px; color: var(--txt-muted);
    transition: background .12s, color .12s, transform .12s;
  }
  .drop-link i { font-size: 11px; width: 16px; text-align: center; opacity: .8; }
  .drop-link:hover { background: var(--surface-3); color: var(--txt); transform: translateX(2px); }
  .drop-sep { height: 1px; background: var(--border); margin: 5px 0; }
  .drop-all { color: var(--brand) !important; font-size: 12px; font-weight: 600; }
  .drop-all:hover { background: var(--brand-soft) !important; }

  /* Right */
  .nav-right { display: flex; align-items: center; gap: 10px; margin-left: auto; }
  .nav-search-btn {
    display: flex; align-items: center; gap: 10px;
    padding: 6px 14px;
    border: 1px solid var(--border-mid);
    border-radius: var(--radius-md);
    background: var(--surface-2);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 13px; color: var(--txt-muted);
    font-weight: 500;
    cursor: pointer; transition: all .15s ease;
    font-family: inherit;
    box-shadow: var(--shadow-sm);
  }
  .nav-search-btn:hover {
    border-color: var(--brand);
    color: var(--txt);
    background: var(--surface-3);
    transform: translateY(-1px);
    box-shadow: 0 2px 10px rgba(5, 150, 105, 0.12);
  }
  .nav-search-btn i { font-size: 12px; color: var(--brand); }
  .nav-dot {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 11.5px; color: var(--txt-dim); font-weight: 500;
    border: 1px solid var(--border); border-radius: 100px;
    padding: 4px 12px; white-space: nowrap;
    background: var(--surface-2);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  /* Hamburger */
  .ham {
    display: none; flex-direction: column; gap: 4px; padding: 6px;
    cursor: pointer; background: none; border: none; margin-left: auto;
  }
  .ham span { display: block; width: 18px; height: 1.8px; background: var(--txt); transition: all .2s; border-radius: 2px; }

  /* Mobile */
  .mob {
    display: none;
    background: var(--surface-2);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-top: 1px solid var(--border);
    padding: 16px 20px 24px;
    max-height: calc(100vh - 58px);
    overflow-y: auto;
    box-shadow: var(--shadow-lg);
  }
  .mob.open { display: block; }
  .mob-actions {
    display: flex; align-items: center; justify-content: space-between;
    padding-bottom: 14px; margin-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .mob-cat {
    font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    color: var(--txt-dim); padding: 12px 0 6px; font-family: 'JetBrains Mono', monospace;
  }
  .mob-cat:first-child { padding-top: 0; }
  .mob-link {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 0; font-size: 13.5px; color: var(--txt-muted);
    border-bottom: 1px solid var(--border);
    transition: color .12s;
  }
  .mob-link:hover { color: var(--txt); }
  .mob-link:last-child { border-bottom: none; }
  .mob-link i { font-size: 12px; opacity: .7; }

  @media (max-width: 900px) {
    .nav-links, .nav-right { display: none; }
    .ham { display: flex; }
  }
</style>

<nav class="nav" id="main-navbar" aria-label="Main navigation">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Toolarsh — Free Online Tools">
      <div class="nav-logo-icon" aria-hidden="true"><i class="fas fa-layer-group"></i></div>
      <span class="nav-logo-text">Toolarsh<span>.</span></span>
    </a>

    <ul class="nav-links" role="menubar">
      {cats.map(cat => (
        <li class="nav-item" role="none">
          <button class="nav-btn" role="menuitem" aria-haspopup="true" aria-expanded="false" aria-label={`${cat.label} tools`}>
            {cat.label}
            <i class="fas fa-chevron-down ch" aria-hidden="true"></i>
          </button>
          <div class="nav-drop" role="menu" aria-label={`${cat.label} submenu`}>
            <div class="drop-hd">{cat.label} · {cat.count} tools</div>
            {cat.items.map(tool => (
              <a class="drop-link" href={`/${tool.slug}`} role="menuitem">
                <i class={`fas ${tool.faIcon}`} aria-hidden="true"></i>
                {tool.name}
              </a>
            ))}
            <div class="drop-sep" aria-hidden="true"></div>
            <a class="drop-link drop-all" href={cat.href} role="menuitem">
              View all {cat.label.toLowerCase()} →
            </a>
          </div>
        </li>
      ))}
    </ul>

    <div class="nav-right">
      <button class="nav-search-btn" id="search-open-btn" aria-label="Search tools (Ctrl+K)">
        <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
        <span>Search tools</span>
        <kbd aria-label="Keyboard shortcut Control K">⌘K</kbd>
      </button>

      <!-- Light / Dark Theme Toggle Button -->
      <button class="theme-toggle-btn" id="theme-toggle-desktop" aria-label="Toggle dark and light theme" title="Switch theme">
        <i class="fas fa-moon" aria-hidden="true"></i>
        <i class="fas fa-sun" aria-hidden="true"></i>
      </button>

      <div class="nav-dot">
        <span class="pulse-dot" aria-hidden="true"></span>
        Free Forever
      </div>
    </div>

    <button class="ham" id="hamburger-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mob" id="mobile-menu" role="navigation" aria-label="Mobile navigation">
    <div class="mob-actions">
      <button class="nav-search-btn" id="mob-search-btn" style="flex:1; justify-content:center;">
        <i class="fas fa-magnifying-glass"></i> Search 35+ tools
      </button>
      <button class="theme-toggle-btn" id="theme-toggle-mobile" aria-label="Toggle theme" style="margin-left: 8px;">
        <i class="fas fa-moon" aria-hidden="true"></i>
        <i class="fas fa-sun" aria-hidden="true"></i>
      </button>
    </div>

    {cats.map(cat => (
      <>
        <div class="mob-cat">{cat.label}</div>
        {cat.items.map(tool => (
          <a class="mob-link" href={`/${tool.slug}`}>
            <i class={`fas ${tool.faIcon}`} aria-hidden="true"></i>
            {tool.name}
          </a>
        ))}
      </>
    ))}
  </div>
</nav>

<script>
  // Navbar scroll glass effect
  const nav = document.getElementById('main-navbar');
  window.addEventListener('scroll', () => nav?.classList.toggle('scrolled', window.scrollY > 4), { passive: true });

  // Mobile menu
  const ham = document.getElementById('hamburger-btn');
  const mob = document.getElementById('mobile-menu');
  ham?.addEventListener('click', () => {
    const o = mob?.classList.toggle('open');
    ham.setAttribute('aria-expanded', String(o));
  });

  // Search openers
  const openSearch = () => {
    if (typeof (window as any).openSearchModal === 'function') {
      (window as any).openSearchModal();
    } else {
      document.getElementById('search-overlay')?.classList.add('open');
      (document.getElementById('search-input') as HTMLInputElement)?.focus();
    }
  };
  document.getElementById('search-open-btn')?.addEventListener('click', openSearch);
  document.getElementById('mob-search-btn')?.addEventListener('click', openSearch);
  document.addEventListener('keydown', e => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); openSearch(); }
    if (e.key === 'Escape') document.getElementById('search-overlay')?.classList.remove('open');
  });

  // Theme toggle function
  function toggleTheme() {
    const current = document.documentElement.getAttribute('data-theme') || 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    if (next === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
    try {
      localStorage.setItem('theme', next);
    } catch (e) {}
  }

  document.getElementById('theme-toggle-desktop')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);
</script>
