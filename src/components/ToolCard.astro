---
import type { Tool } from '../data/tools';

export interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const catColors: Record<string, string> = {
  writing: 'var(--writing-color)',
  security: 'var(--security-color)',
  generators: 'var(--gen-color)',
  calculators: 'var(--calc-color)',
  converters: 'var(--conv-color)',
  media: 'var(--media-color)',
};
const catBgs: Record<string, string> = {
  writing: 'var(--writing-bg)',
  security: 'var(--security-bg)',
  generators: 'var(--gen-bg)',
  calculators: 'var(--calc-bg)',
  converters: 'var(--conv-bg)',
  media: 'var(--media-bg)',
};

const color = catColors[tool.category] ?? 'var(--brand)';
const bg = catBgs[tool.category] ?? 'var(--brand-light)';
---

<a
  href={`/${tool.slug}`}
  class="tool-card"
  style={`--card-color: ${color}`}
  aria-label={`${tool.name} — ${tool.description}`}
>
  <div class="tool-card-icon" style={`background: ${bg}; color: ${color}`} aria-hidden="true">
    <i class={`fas ${tool.faIcon}`} aria-hidden="true"></i>
  </div>
  <h3>{tool.name}</h3>
  <p>{tool.description}</p>
  <span class="tool-card-link" aria-hidden="true">
    Open tool <i class="fas fa-arrow-right" style="font-size:10px" aria-hidden="true"></i>
  </span>
</a>
